name: Apply CandidateCVEdit redesign

on:
  push:
    branches:
      - agent/candidate-cv-edit-redesign

permissions:
  contents: write

jobs:
  apply-redesign:
    if: github.actor != 'github-actions[bot]'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Apply reviewed files
        shell: bash
        run: |
          python3 <<'PY'
          from pathlib import Path
          import base64
          import json
          
          payload = json.loads(base64.b64decode("", validate=True).decode("utf-8"))
          for relative_path, content in payload.items():
              path = Path(relative_path)
              path.parent.mkdir(parents=True, exist_ok=True)
              path.write_text(content, encoding="utf-8")
          
          scss = base64.b64decode("").decode("utf-8")
          themes = [
              "halo",
              "havana",
              "helium",
              "hover",
              "hunttech-modern",
              "hunttech-modern-light",
              "hunttech-modern-dark",
          ]
          for theme in themes:
              scss_path = Path("modules/web/themes") / theme / "com.company.hunttech" / "candidate-cv-editor.scss"
              scss_path.parent.mkdir(parents=True, exist_ok=True)
              scss_path.write_text(scss, encoding="utf-8")
          
              styles_path = Path("modules/web/themes") / theme / "styles.scss"
              styles = styles_path.read_text(encoding="utf-8")
              import_anchor = '@import "com.company.hunttech/settings-window-sections";'
              import_line = '@import "com.company.hunttech/candidate-cv-editor";'
              include_anchor = '  @include settings-window-sections;'
              include_line = '  @include candidate-cv-editor-theme;'
          
              if import_line not in styles:
                  if import_anchor not in styles:
                      raise RuntimeError("Не найден SCSS import anchor: " + str(styles_path))
                  styles = styles.replace(import_anchor, import_anchor + "\n" + import_line, 1)
          
              if include_line not in styles:
                  if include_anchor not in styles:
                      raise RuntimeError("Не найден SCSS include anchor: " + str(styles_path))
                  styles = styles.replace(include_anchor, include_anchor + "\n" + include_line, 1)
          
              styles_path.write_text(styles, encoding="utf-8")
          
          readme_path = Path("docs/ui/README.md")
          readme = readme_path.read_text(encoding="utf-8")
          top_row_anchor = "| `JobCandidateEdit` | [JobCandidateEdit_Spec.md](JobCandidateEdit_Spec.md) | Карточка кандидата, вкладки, история вакансий, анализ навыков и защита от OOM |"
          top_row = "| `CandidateCVEdit` | [CandidateCVEdit_Spec.md](CandidateCVEdit_Spec.md) | Подготовка резюме, сопроводительного письма, дерева навыков, фотографии и дополнительных файлов без изменения lazy-init |"
          if top_row not in readme:
              if top_row_anchor not in readme:
                  raise RuntimeError("Не найдена верхняя строка JobCandidateEdit в docs/ui/README.md")
              readme = readme.replace(top_row_anchor, top_row_anchor + "\n" + top_row, 1)
          
          candidate_section = """### CandidateCV
          
          | Форма | Controller | Документ |
          |-------|------------|----------|
          | Edit | `hunttech_CandidateCV.edit` | [CandidateCVEdit_Spec.md](CandidateCVEdit_Spec.md) |
          
          """
          if "### CandidateCV\n" not in readme:
              open_position_anchor = "### OpenPosition\n"
              if open_position_anchor not in readme:
                  raise RuntimeError("Не найден раздел OpenPosition в docs/ui/README.md")
              readme = readme.replace(open_position_anchor, candidate_section + open_position_anchor, 1)
          
          history_header = "| Дата | Изменение |\n|------|-----------|"
          history_row = "| 2026-07-25 | В каталог добавлена спецификация визуального и функционального контракта `CandidateCVEdit` с локальным SCSS для семи тем |"
          if history_row not in readme:
              if history_header not in readme:
                  raise RuntimeError("Не найдена история docs/ui/README.md")
              readme = readme.replace(history_header, history_header + "\n" + history_row, 1)
          
          readme_path.write_text(readme, encoding="utf-8")
          
          workflow_path = Path(".github/workflows/candidate-cv-redesign-apply.yml")
          if workflow_path.exists():
              workflow_path.unlink()
          PY
      - name: Amend atomic commit
        shell: bash
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit --amend --no-edit
          git push --force-with-lease origin HEAD:agent/candidate-cv-edit-redesign
