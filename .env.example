# Опциональный DEV-only PostgreSQL. Стандартный LOCAL-профиль приложения
# подключается к 192.168.1.135 и этот файл не используется.
# Скопируйте в .env.local и задайте пароль вне Git перед docker compose up.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=HuntTech
POSTGRES_USER=cuba
POSTGRES_PASSWORD=__SET_OUTSIDE_GIT__

# JDBC URL (для справки; в проекте задаётся в modules/core/web/META-INF/context.xml)
# jdbc:postgresql://localhost:5432/HuntTech
