# Copy to a secure location outside Git and export variables before running scripts.
# Do not put real passwords or production credentials into this file.

PGHOST=hr.hunttech.ru
PGPORT=5432
PGDATABASE=itpearls
PGUSER=postgres
BACKUP_BASE=/var/backups/hunttech-hrm
BACKUP_LABEL=manual

# Optional local restore variables.
RESTORE_HOST=127.0.0.1
RESTORE_PORT=5432
RESTORE_USER=postgres
RESTORE_DB_PREFIX=hunttech_prod_restore_test
