# Copy to a private env file outside Git or export variables in the shell.
# Never store passwords here.

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres

EXPECTED_SERVER_VERSION=11.22
SOURCE_DB=hunttech_prod_restore_test_YYYYMMDD_HHMMSS
TARGET_DB=hunttech_migration_target_YYYYMMDD_HHMMSS
TARGET_OWNER=cuba

# Must be "local-test" for local test migration.
MIGRATION_MODE=local-test
MIGRATION_ID=manual-YYYYMMDD-HHMMSS
