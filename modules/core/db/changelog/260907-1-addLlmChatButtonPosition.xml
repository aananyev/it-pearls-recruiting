<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <preConditions onFail="HALT" onError="HALT">
        <dbms type="postgresql"/>
        <tableExists tableName="HUNTTECH_USER_SETTINGS"/>
    </preConditions>

    <changeSet id="260907-1-addLlmChatButtonPosition" author="hunttech">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="HUNTTECH_USER_SETTINGS" columnName="LLM_CHAT_BUTTON_POSITION"/>
            </not>
        </preConditions>
        <addColumn tableName="HUNTTECH_USER_SETTINGS">
            <column name="LLM_CHAT_BUTTON_POSITION" type="varchar(255)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="HUNTTECH_USER_SETTINGS" columnName="LLM_CHAT_BUTTON_POSITION"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
