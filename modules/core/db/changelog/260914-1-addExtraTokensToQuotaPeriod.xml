<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="260914-1-addExtraTokensToQuotaPeriod" author="hunttech">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="HUNTTECH_LLM_CHAT_QUOTA_PERIOD"/>
            <not>
                <columnExists tableName="HUNTTECH_LLM_CHAT_QUOTA_PERIOD" columnName="EXTRA_TOKENS"/>
            </not>
        </preConditions>
        <addColumn tableName="HUNTTECH_LLM_CHAT_QUOTA_PERIOD">
            <column name="EXTRA_TOKENS" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="HUNTTECH_LLM_CHAT_QUOTA_PERIOD" columnName="EXTRA_TOKENS"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
