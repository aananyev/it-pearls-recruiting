<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
        Исторические changelog-файлы сохранены в репозитории, но больше не включаются
        напрямую: их частично применяли CUBA SQL-скриптами вне Liquibase, поэтому
        последовательное выполнение может повторно создать уже существующие объекты.

        Заменены единым reconciliation-changelog:
        - 260627-1-addAiEntities.xml
        - 260722-1-addUserAiProfile.xml
        - 260722-2-migrateUserAiProfileToHunttech.xml
        - 260723-1-addPreferPersonalAiApiSettings.xml
        - 260724-1-enablePersonalAiPreferences.xml
    -->
    <include file="260727-1-reconcileProductionSchema.xml"
             relativeToChangelogFile="true"/>

    <!-- Дополняет уже существующую частично созданную таблицу ИИ-профиля. -->
    <include file="260727-2-completeUserAiProfileColumns.xml"
             relativeToChangelogFile="true"/>

    <!-- Создает таблицы и базовые справочники бухгалтерского Telegram-бота. -->
    <include file="260729-1-addAccountingBotEntities.xml"
             relativeToChangelogFile="true"/>

    <!-- AI Control Plane: корпоративные credentials, функции и персональные per-function override. -->
    <include file="260812-1-addAiFunctionControlPlane.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit upload: административно управляемая AI-функция обработки описания проекта. -->
    <include file="260812-2-addProjectDescriptionAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- Канонические русские административные prompt для PROJECT_DESCRIPTION_GENERATE. -->
    <include file="260813-1-localizeProjectDescriptionAiPrompts.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit upload: AI-функция удаления фона логотипа проекта (capability IMAGE_GENERATION). -->
    <include file="260813-2-addProjectLogoAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit «Кратко»: колонка SHORT_DESCRIPTION в HUNTTECH_PROJECT. -->
    <include file="260814-1-addProjectShortDescriptionColumn.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit «Кратко»: AI-функция генерации краткого описания проекта (capability TEXT_GENERATION). -->
    <include file="260814-2-addProjectShortDescriptionAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit «Кратко»: сокращение AI-генерации в 4 раза (одно предложение, MAX_TOKENS 125) для существующих сред. -->
    <include file="260814-3-shortenProjectShortDescriptionPrompt.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit «Кратко»: увеличение AI-генерации в 2 раза (два предложения, MAX_TOKENS 250) для существующих сред. -->
    <include file="260814-4-increaseProjectShortDescriptionPrompt.xml"
             relativeToChangelogFile="true"/>

    <!-- SkillAnalysisService: AI-функция извлечения навыков из текста резюме/вакансии
         (capability TEXT_GENERATION, уровни ALL/MAIN/SECONDARY/TERTIARY). -->
    <include file="260815-1-addSkillAnalysisAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- CandidateSkill: сущность «Навыки кандидата» со связью на Candidate и SkillTree, признаком критичности. -->
    <include file="260815-2-addCandidateSkillEntity.xml"
             relativeToChangelogFile="true"/>

</databaseChangeLog>
