<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
        Исторические changelog-файлы сохранены в репозитории, но больше не включаются
        напрямую: их частично применяли CUBA SQL-скриптами вне Liquibase, поэтому
        последовательное выполнение может повторно создать уже существующие объекты.

        Заменены единым reconciliation-changelog:
        - 260627-1-addAiEntities.xml
        - 260722-1-addUserAiProfile.xml
        - 260722-2-migrateUserAiProfileToHunttech.xml
        - 260723-1-addPreferPersonalAiApiSettings.xml
        - 260724-1-enablePersonalAiPreferences.xml
    -->
    <include file="260727-1-reconcileProductionSchema.xml"
             relativeToChangelogFile="true"/>

    <!-- Дополняет уже существующую частично созданную таблицу ИИ-профиля. -->
    <include file="260727-2-completeUserAiProfileColumns.xml"
             relativeToChangelogFile="true"/>

    <!-- Создает таблицы и базовые справочники бухгалтерского Telegram-бота. -->
    <include file="260729-1-addAccountingBotEntities.xml"
             relativeToChangelogFile="true"/>

    <!-- AI Control Plane: корпоративные credentials, функции и персональные per-function override. -->
    <include file="260812-1-addAiFunctionControlPlane.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit upload: административно управляемая AI-функция обработки описания проекта. -->
    <include file="260812-2-addProjectDescriptionAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- Канонические русские административные prompt для PROJECT_DESCRIPTION_GENERATE. -->
    <include file="260813-1-localizeProjectDescriptionAiPrompts.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit upload: AI-функция удаления фона логотипа проекта (capability IMAGE_GENERATION). -->
    <include file="260813-2-addProjectLogoAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit «Кратко»: колонка SHORT_DESCRIPTION в HUNTTECH_PROJECT. -->
    <include file="260814-1-addProjectShortDescriptionColumn.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit «Кратко»: AI-функция генерации краткого описания проекта (capability TEXT_GENERATION). -->
    <include file="260814-2-addProjectShortDescriptionAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit «Кратко»: сокращение AI-генерации в 4 раза (одно предложение, MAX_TOKENS 125) для существующих сред. -->
    <include file="260814-3-shortenProjectShortDescriptionPrompt.xml"
             relativeToChangelogFile="true"/>

    <!-- ProjectEdit «Кратко»: увеличение AI-генерации в 2 раза (два предложения, MAX_TOKENS 250) для существующих сред. -->
    <include file="260814-4-increaseProjectShortDescriptionPrompt.xml"
             relativeToChangelogFile="true"/>

    <!-- SkillAnalysisService: AI-функция извлечения навыков из текста резюме/вакансии
         (capability TEXT_GENERATION, уровни ALL/MAIN/SECONDARY/TERTIARY). -->
    <include file="260815-1-addSkillAnalysisAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- CandidateSkill: сущность «Навыки кандидата» со связью на Candidate и SkillTree, признаком критичности. -->
    <include file="260815-2-addCandidateSkillEntity.xml"
             relativeToChangelogFile="true"/>

    <!-- TextProcessingService: AI-функции умного форматирования текста в HTML и Plain Text. -->
    <include file="260816-1-addTextProcessingAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- OpenPositionSkill: сущность «Требуемые навыки вакансии» со связью на OpenPosition и SkillTree. -->
    <include file="260816-2-addOpenPositionSkill.xml"
             relativeToChangelogFile="true"/>

    <!-- SkillAnalysisService: модернизация SYSTEM_PROMPT SKILLS_EXTRACT — AI возвращает
         ОДИН навык опыта (общий стаж кандидата в годах), а не последовательность значений. -->
    <include file="260816-3-updateSkillAnalysisSingleExperiencePrompt.xml"
             relativeToChangelogFile="true"/>

    <!-- SkillAnalysisService: модернизация SYSTEM_PROMPT SKILLS_EXTRACT — AI относит
         каждый навык РОВНО к одному уровню (MAIN, SECONDARY, TERTIARY; без дублей между
         уровнями), иначе вторичные навыки резюме не попадают в сайдбар. -->
    <include file="260816-5-updateSkillAnalysisDisjointLevelsPrompt.xml"
             relativeToChangelogFile="true"/>
    <!-- TextProcessingService: модернизация SYSTEM_PROMPT TEXT_SMART_FORMAT_HTML —
         AI удаляет из итогового HTML все пустые строки и пустые абзацы исходника. -->
    <include file="260816-4-updateTextProcessingHtmlPrompt.xml"
             relativeToChangelogFile="true"/>

    <!-- AiFunctionConfiguration: колонка-флаг INCLUDE_USER_CONTEXT (персонализация
         «Обо мне» / UserAiProfile, этап B). -->
    <include file="260817-1-addIncludeUserContextFlag.xml"
             relativeToChangelogFile="true"/>

    <!-- Дефолты INCLUDE_USER_CONTEXT по матрице уместности персонализации (этап B). -->
    <include file="260817-2-setIncludeUserContextDefaults.xml"
             relativeToChangelogFile="true"/>

    <!-- AiCallLog: колонки аудита CONTEXT_INCLUDED / CONTEXT_CODE_POINTS (этап E). -->
    <include file="260817-3-addAiCallLogContextColumns.xml"
             relativeToChangelogFile="true"/>

    <!-- Консолидированная миграция административных AI-промптов (2026-08-18):
         создаёт таблицы AI Control Plane, если они отсутствуют (прод-снапшот
         get_base.sh 2026-08-18 их не содержит), и загружает ВСЕ канонические
         административные промпты AI-функций (последние редакции 260813-1..260816-5
         + новая STANDARDIZE_VACANCY по legacy-контракту 260812-4).
         Административные настройки, изменённые администратором, не перезаписываются.
         Ручной деплой на прод: 260818-1-addAdminAiPromptSeed.sql. -->
    <include file="260818-1-addAdminAiPromptSeed.xml"
             relativeToChangelogFile="true"/>

    <!-- SmartCvIngestService: AI-функция умного парсинга резюме из произвольного файла в JSON. -->
    <include file="260820-1-addSmartCvParseAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- ExtUser: добавление поля TELEGRAM для пользователей. -->
    <include file="260820-2-addTelegramToSecUser.xml"
             relativeToChangelogFile="true"/>

    <!-- SmartOpenPositionIngestService: AI-функция умного парсинга описания вакансии и проекта в JSON. -->
    <include file="260820-3-addSmartVacancyParseAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- Company: добавление колонок официальных реквизитов компании. -->
    <include file="260821-1-addCompanyRequisitesColumns.xml"
             relativeToChangelogFile="true"/>

    <!-- CompanyRequisitesIngestService: AI-функция парсинга реквизитов компании из карточки в JSON. -->
    <include file="260821-2-addCompanyRequisitesAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- JobHistory: снятие NOT NULL с CURRENT_POSITION_ID и добавление полей опыта кандидата. -->
    <include file="260821-3-addJobHistoryFields.xml"
             relativeToChangelogFile="true"/>

    <!-- SmartCvIngestService: обновление AI-функции CV_SMART_PARSE_JSON для поддержки мест работы и образования. -->
    <include file="260821-4-updateSmartCvParseAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- CompanyRequisitesIngestService: обновление AI-функции COMPANY_REQUISITES_PARSE_JSON с гео-разбиением. -->
    <include file="260821-5-updateCompanyRequisitesAiFunctionWithGeo.xml"
             relativeToChangelogFile="true"/>

    <!-- Company: добавление колонки LEGAL_ENTITY_NAME (Юридическое лицо). -->
    <include file="260821-6-addCompanyLegalEntityName.xml"
             relativeToChangelogFile="true"/>

    <!-- ApplicationSetup: настройка и активация Telegram бота. -->
    <include file="260821-7-configureTelegramBotSetup.xml"
             relativeToChangelogFile="true"/>

    <!-- CompanySearchAiService: Seed AI-функции COMPANY_WEB_SEARCH_PARSE_JSON для интеллектуального поиска компаний в интернете. -->
    <include file="260822-2-addCompanyWebSearchAiFunction.xml"
             relativeToChangelogFile="true"/>

    <!-- AI-сгенерированные данные навыков: кандидат + вакансия (подготовлено, НЕ запущено на проде). -->
    <include file="260824-5-6-mergeCandidateAndVacancySkillsData.xml"
             relativeToChangelogFile="true"/>

    <!-- Добавление 144 недостающих технологических навыков из логов AI-анализа вакансий (Embedded, Web/Frontend, Backend, Blockchain, DevOps, Data/ML). -->
    <include file="260902-1-add-missing-tech-skills.xml"
             relativeToChangelogFile="true"/>

</databaseChangeLog>
