<Context>

    <!-- Switch off session serialization -->
    <Manager pathname=""/>
    <Resource driverClassName="org.postgresql.Driver"
              maxIdle="2"
              maxTotal="20"
              maxWaitMillis="5000"
              name="jdbc/CubaDS"
              password="${env.HUNTTECH_DB_PASSWORD}"
              type="javax.sql.DataSource"
              url="${env.HUNTTECH_DB_JDBC_URL}"
              username="${env.HUNTTECH_DB_USER}"/>
    <!-- Database connection-->

</Context>
