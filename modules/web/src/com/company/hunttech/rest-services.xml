<?xml version="1.0" encoding="UTF-8"?>
<services xmlns="http://schemas.haulmont.com/cuba/rest-services-v2.xsd">

    <!-- Сервис выдачи нормализованных справочников внешним системам (BL-2026-029) -->
    <service name="hunttech_ExternalReferenceDataService">
        <method name="getCities">
            <param name="filter" type="com.company.hunttech.dto.integration.ReferenceFilterDto"/>
        </method>
        <method name="getPositions">
            <param name="filter" type="com.company.hunttech.dto.integration.ReferenceFilterDto"/>
        </method>
        <method name="getGrades">
            <param name="filter" type="com.company.hunttech.dto.integration.ReferenceFilterDto"/>
        </method>
        <method name="getInteractionTypes">
            <param name="filter" type="com.company.hunttech.dto.integration.ReferenceFilterDto"/>
        </method>
        <method name="getSkills">
            <param name="filter" type="com.company.hunttech.dto.integration.ReferenceFilterDto"/>
        </method>
        <method name="getCountries">
            <param name="filter" type="com.company.hunttech.dto.integration.ReferenceFilterDto"/>
        </method>
    </service>

    <!-- Сервис внешних интеграций HRM HuntTech (BL-2026-036) -->
    <service name="hunttech_ExternalIntegrationService">
        <method name="createCompany">
            <param name="request" type="com.company.hunttech.dto.integration.CompanyCreateRequestDto"/>
        </method>
        <method name="createProjectAndVacancy">
            <param name="request" type="com.company.hunttech.dto.integration.ProjectVacancyCreateRequestDto"/>
        </method>
        <method name="createCandidateCV">
            <param name="request" type="com.company.hunttech.dto.integration.CandidateCvCreateRequestDto"/>
        </method>
        <method name="createInteraction">
            <param name="request" type="com.company.hunttech.dto.integration.InteractionCreateRequestDto"/>
        </method>
        <method name="createCandidateWithDetails">
            <param name="request" type="com.company.hunttech.dto.integration.CandidateCompositeCreateRequestDto"/>
        </method>
    </service>

</services>

