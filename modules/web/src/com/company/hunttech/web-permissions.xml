<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<permission-config xmlns="http://schemas.haulmont.com/cuba/permissions.xsd">
    <!-- Корпоративные AI credentials требуют отдельного explicit grant помимо screen/entity permissions. -->
    <specific>
        <category id="hunttech.ai">
            <permission id="hunttech.ai.manageCorporateCredentials"/>
            <permission id="hunttech.ai.viewChatHistoryAdmin"/>
            <permission id="hunttech.ai.reconcileChatQuota"/>
            <!-- LLM-chat access boundaries. Grant only to the corresponding CUBA roles. -->
            <permission id="hunttech.ai.useLocalChat"/>
            <permission id="hunttech.ai.useManagerHermesWrite"/>
        </category>
    </specific>
</permission-config>
