                <entry key="hunttech_ResumeRecognitionService"
                       value="com.company.hunttech.core.ResumeRecognitionService"/>
                <entry key="hunttech_EmailGenerationService" value="com.company.hunttech.core.EmailGenerationService"/>
                <entry key="hunttech_ParseCVService" value="com.company.hunttech.core.ParseCVService"/>
                <!-- <entry key="hunttech_IteractionService" value="com.company.hunttech.core.IteractionService"/> -->
                <entry key="hunttech_WebLoadService" value="com.company.hunttech.core.WebLoadService"/>
                <entry key="hunttech_InteractionService" value="com.company.hunttech.core.InteractionService"/>
                <entry key="hunttech_StrSimpleService" value="com.company.hunttech.core.StrSimpleService"/>
