                <entry key="hunttech_ImageProcessingService"
                       value="com.company.hunttech.app.ImageProcessingService"/>
                <entry key="hunttech_ProjectLogoImageProcessingService"
                       value="com.company.hunttech.app.ProjectLogoImageProcessingService"/>
                <entry key="hunttech_UserAiContextService"
                       value="com.company.hunttech.service.UserAiContextService"/>
                <entry key="hunttech_SkillAnalysisService"
                       value="com.company.hunttech.service.SkillAnalysisService"/>
            </map>
        </property>
    </bean>

</beans>
