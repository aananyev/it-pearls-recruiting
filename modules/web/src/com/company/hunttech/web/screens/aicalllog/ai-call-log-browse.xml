<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://browseCaption"
        focusComponent="aiCallLogsTable"
        messagesPack="com.company.hunttech.web.screens.aicalllog">
    <data>
        <collection id="aiCallLogsDc"
                    class="com.company.hunttech.entity.ai.AiCallLog"
                    view="ai-call-log-edit-view">
            <loader id="aiCallLogsDl">
                <query><![CDATA[select e from hunttech_AiCallLog e order by e.callTime desc]]></query>
            </loader>
        </collection>
    </data>
    <dialogMode width="1300" height="750"/>
    <layout expand="mainSplit" spacing="true" stylename="browse-screen-layout edit-screen-layout">
        <filter id="filter" dataLoader="aiCallLogsDl" applyTo="aiCallLogsTable"
                collapsable="true" collapsed="true">
            <properties include=".*"/>
        </filter>
        <hbox id="buttonsPanel" spacing="true" stylename="edit-toolbar">
            <button id="refreshBtn" action="aiCallLogsTable.refresh" icon="REFRESH" stylename="primary"/>
            <button id="removeBtn" action="aiCallLogsTable.remove" icon="REMOVE"/>
        </hbox>
        <split id="mainSplit" orientation="vertical" width="100%" pos="65" stylename="edit-card candidate-table-card">
            <groupTable id="aiCallLogsTable" width="100%" height="100%" dataContainer="aiCallLogsDc">
                <actions>
                    <action id="refresh" type="refresh"/>
                    <action id="remove" type="remove"/>
                </actions>
                <columns>
                    <column id="callTime" caption="msg://callTime" width="140px"/>
                    <column id="userDisplay" caption="msg://user" width="130px"/>
                    <column id="callerSource" caption="msg://callerSource" width="120px"/>
                    <column id="functionName" caption="msg://function" width="160px"/>
                    <column id="providerCode" caption="msg://provider" width="110px"/>
                    <column id="modelName" caption="msg://model" width="150px"/>
                    <column id="tokensDisplay" caption="msg://tokens" width="130px"/>
                    <column id="costDisplay" caption="msg://cost" width="100px"/>
                    <column id="durationDisplay" caption="msg://duration" width="90px"/>
                    <column id="statusDisplay" caption="msg://status" width="110px"/>
                </columns>
                <rowsCount/>
            </groupTable>
            <tabSheet id="detailsTabSheet" width="100%" height="100%" stylename="edit-tabs">
                <tab id="promptTab" caption="msg://promptTab" margin="true">
                    <textArea id="promptTextArea" width="100%" height="100%" editable="false"/>
                </tab>
                <tab id="responseTab" caption="msg://responseTab" margin="true">
                    <textArea id="responseTextArea" width="100%" height="100%" editable="false"/>
                </tab>
                <tab id="errorTab" caption="msg://errorTab" margin="true">
                    <textArea id="errorTextArea" width="100%" height="100%" editable="false"/>
                </tab>
            </tabSheet>
        </split>
    </layout>
</window>
