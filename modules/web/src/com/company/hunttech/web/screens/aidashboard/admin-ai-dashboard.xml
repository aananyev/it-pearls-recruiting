<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:chart="http://schemas.haulmont.com/charts/charts.xsd"
        caption="msg://adminDashboardCaption"
        messagesPack="com.company.hunttech.web.screens.aidashboard">
    <data>
        <keyValueCollection id="userSummaryDc">
            <properties>
                <property name="userName" datatype="string"/>
                <property name="totalCalls" datatype="int"/>
                <property name="promptTokens" datatype="long"/>
                <property name="completionTokens" datatype="long"/>
                <property name="totalTokens" datatype="long"/>
                <property name="estimatedCost" datatype="decimal"/>
                <property name="errorCount" datatype="int"/>
                <property name="lastCallTime" datatype="dateTime"/>
            </properties>
        </keyValueCollection>
    </data>
    <layout stylename="ai-dashboard-root" expand="mainScroll" spacing="true">
        <scrollBox id="mainScroll" width="100%" height="100%" spacing="true" stylename="ai-scrollbox">
            
            <!-- Dashboard Header Banner -->
            <vbox id="adminHeaderCard" width="100%" spacing="true" stylename="ai-header-card">
                <hbox width="100%" spacing="true" alignment="MIDDLE_LEFT">
                    <vbox spacing="false" width="100%" expand="adminSubtitle">
                        <hbox spacing="true" alignment="MIDDLE_LEFT">
                            <label value="msg://adminDashboardTitle" stylename="ai-page-title bold"/>
                            <label value="msg://badgeAdminMonitoring" stylename="ai-chip-badge badge-admin"/>
                        </hbox>
                        <label id="adminSubtitle" value="msg://adminDashboardSubtitle" stylename="ai-page-subtitle"/>
                    </vbox>
                </hbox>

                <!-- Filter Toolbar 2-row layout -->
                <vbox id="filterPanel" spacing="true" width="100%" stylename="ai-dashboard-filter-bar">
                    <!-- Filter Row 1: Time range -->
                    <hbox spacing="true" width="100%" alignment="BOTTOM_LEFT">
                        <lookupField id="periodLookup" caption="msg://periodLabel" width="200px" nullOptionVisible="false"/>
                        <dateField id="dateFromField" caption="msg://dateFrom" resolution="DAY"/>
                        <dateField id="dateToField" caption="msg://dateTo" resolution="DAY"/>
                    </hbox>
                    <!-- Filter Row 2: Entity selectors & Actions -->
                    <hbox spacing="true" width="100%" alignment="BOTTOM_LEFT">
                        <lookupPickerField id="userPicker" caption="msg://userFilter" width="220px">
                            <actions>
                                <action id="lookup" type="picker_lookup"/>
                                <action id="clear" type="picker_clear"/>
                            </actions>
                        </lookupPickerField>
                        <lookupField id="providerLookup" caption="msg://providerFilter" width="180px"/>
                        <lookupField id="ownerLookup" caption="msg://ownerFilter" width="180px"/>
                        <button id="applyFilterBtn" caption="msg://apply" icon="SEARCH" stylename="primary ai-action-btn"/>
                        <button id="resetFilterBtn" caption="msg://reset" icon="ERASER" stylename="ai-secondary-btn"/>
                    </hbox>
                </vbox>
            </vbox>

            <!-- Top KPI Cards Grid -->
            <hbox id="kpiPanel" spacing="true" width="100%" stylename="ai-kpi-grid">
                <vbox id="spendCard" stylename="ai-kpi-card kpi-blue" width="25%" spacing="false">
                    <hbox width="100%" alignment="MIDDLE_LEFT">
                        <label value="msg://totalSpend" stylename="kpi-title" width="100%"/>
                        <label value="💰" stylename="kpi-icon"/>
                    </hbox>
                    <label id="totalSpendLabel" value="$ 0.00" stylename="kpi-value"/>
                    <label id="spendSubLabel" value="Corp: $0 | User: $0" stylename="kpi-sub"/>
                </vbox>
                <vbox id="activeUsersCard" stylename="ai-kpi-card kpi-purple" width="25%" spacing="false">
                    <hbox width="100%" alignment="MIDDLE_LEFT">
                        <label value="msg://activeUsers" stylename="kpi-title" width="100%"/>
                        <label value="👥" stylename="kpi-icon"/>
                    </hbox>
                    <label id="activeUsersLabel" value="0" stylename="kpi-value"/>
                    <label id="topSpenderLabel" value="—" stylename="kpi-sub"/>
                </vbox>
                <vbox id="totalVolumeCard" stylename="ai-kpi-card kpi-green" width="25%" spacing="false">
                    <hbox width="100%" alignment="MIDDLE_LEFT">
                        <label value="msg://totalCallsAndTokens" stylename="kpi-title" width="100%"/>
                        <label value="📊" stylename="kpi-icon"/>
                    </hbox>
                    <label id="totalCallsLabel" value="0" stylename="kpi-value"/>
                    <label id="totalTokensLabel" value="0 токенов" stylename="kpi-sub"/>
                </vbox>
                <vbox id="reliabilityCard" stylename="ai-kpi-card kpi-orange" width="25%" spacing="false">
                    <hbox width="100%" alignment="MIDDLE_LEFT">
                        <label value="msg://reliabilityAndSpeed" stylename="kpi-title" width="100%"/>
                        <label value="⚠️" stylename="kpi-icon"/>
                    </hbox>
                    <label id="errorRateLabel" value="0.0% ошибок" stylename="kpi-value"/>
                    <label id="avgLatencyLabel" value="Ср. задержка: 0.00 с" stylename="kpi-sub"/>
                </vbox>
            </hbox>

            <!-- Dashboard TabSheet for Structured Analytics -->
            <tabSheet id="dashboardTabSheet" width="100%" stylename="framed ai-dashboard-tabsheet">
                
                <!-- Tab 1: Charts & Analytics -->
                <tab id="analyticsTab" caption="msg://analyticsTabTitle" icon="LINE_CHART" spacing="true">
                    <vbox width="100%" spacing="true">
                        <!-- Charts Row 1 -->
                        <hbox id="chartsRow1" spacing="true" width="100%" height="380px">
                            <vbox id="costDynamicsBox" stylename="ai-chart-card" width="60%" height="100%" spacing="true">
                                <label value="msg://costDynamicsTitle" stylename="ai-card-header"/>
                                <chart:serialChart id="costDynamicsChart"
                                                   categoryField="date"
                                                   height="100%"
                                                   width="100%">
                                    <chart:valueAxes>
                                        <chart:axis position="LEFT" title="USD ($)"/>
                                    </chart:valueAxes>
                                    <chart:graphs>
                                        <chart:graph id="costGraph"
                                                     type="LINE"
                                                     lineThickness="2"
                                                     bullet="ROUND"
                                                     valueField="cost"
                                                     color="#2980b9"
                                                     title="msg://spendCost"/>
                                    </chart:graphs>
                                    <chart:chartCursor cursorAlpha="0.1"/>
                                </chart:serialChart>
                            </vbox>

                            <vbox id="modelsPieBox" stylename="ai-chart-card" width="40%" height="100%" spacing="true">
                                <label value="msg://modelsDistributionTitle" stylename="ai-card-header"/>
                                <chart:pieChart id="modelsPieChart"
                                                titleField="model"
                                                valueField="cost"
                                                innerRadius="40%"
                                                height="100%"
                                                width="100%">
                                    <chart:legend position="BOTTOM" autoMargins="false"/>
                                    <chart:balloon text="[[title]]: $[[value]] ([[percents]]%)"/>
                                </chart:pieChart>
                            </vbox>
                        </hbox>

                        <!-- Charts Row 2 -->
                        <hbox id="chartsRow2" spacing="true" width="100%" height="380px">
                            <vbox id="tasksPieBox" stylename="ai-chart-card" width="50%" height="100%" spacing="true">
                                <label value="msg://tasksDistributionTitle" stylename="ai-card-header"/>
                                <chart:pieChart id="tasksPieChart"
                                                titleField="functionName"
                                                valueField="count"
                                                innerRadius="40%"
                                                height="100%"
                                                width="100%">
                                    <chart:legend position="BOTTOM" autoMargins="false"/>
                                    <chart:balloon text="[[title]]: [[value]] ([[percents]]%)"/>
                                </chart:pieChart>
                            </vbox>

                            <vbox id="volumeDynamicsBox" stylename="ai-chart-card" width="50%" height="100%" spacing="true">
                                <label value="msg://callsAndTokensDynamicsTitle" stylename="ai-card-header"/>
                                <chart:serialChart id="volumeDynamicsChart"
                                                   categoryField="date"
                                                   height="100%"
                                                   width="100%">
                                    <chart:valueAxes>
                                        <chart:axis id="callsAxis" position="LEFT" title="msg://axisCallsCount"/>
                                    </chart:valueAxes>
                                    <chart:graphs>
                                        <chart:graph id="callsGraph"
                                                     type="COLUMN"
                                                     fillAlphas="0.8"
                                                     valueField="calls"
                                                     color="#27ae60"
                                                     title="msg://axisCallsCount"/>
                                    </chart:graphs>
                                    <chart:chartCursor cursorAlpha="0.1"/>
                                </chart:serialChart>
                            </vbox>
                        </hbox>
                    </vbox>
                </tab>

                <!-- Tab 2: User Summary Table -->
                <tab id="usersTab" caption="msg://usersTabTitle" icon="TABLE" spacing="true">
                    <vbox id="userSummaryBox" stylename="ai-table-card" width="100%" spacing="true">
                        <hbox width="100%" alignment="MIDDLE_LEFT">
                            <label value="msg://userSummaryTitle" stylename="ai-card-header" width="100%"/>
                        </hbox>
                        <table id="userSummaryTable" width="100%" height="440px" dataContainer="userSummaryDc" stylename="ai-dashboard-table">
                            <columns>
                                <column id="userName" caption="msg://colUser" width="200px"/>
                                <column id="totalCalls" caption="msg://colCalls" width="110px"/>
                                <column id="promptTokens" caption="msg://colPromptTokens" width="140px"/>
                                <column id="completionTokens" caption="msg://colCompletionTokens" width="150px"/>
                                <column id="totalTokens" caption="msg://colTotalTokens" width="140px"/>
                                <column id="estimatedCost" caption="msg://colCostUsd" width="120px"/>
                                <column id="errorCount" caption="msg://colErrors" width="100px"/>
                                <column id="lastCallTime" caption="msg://colLastActive" width="160px"/>
                            </columns>
                            <rowsCount/>
                        </table>
                    </vbox>
                </tab>
            </tabSheet>
        </scrollBox>
    </layout>
</window>
