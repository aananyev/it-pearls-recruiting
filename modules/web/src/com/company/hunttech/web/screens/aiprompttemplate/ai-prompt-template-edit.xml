<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://aiPromptTemplateEdit.caption"
        focusComponent="nameField"
        messagesPack="com.company.hunttech.web.screens.aiprompttemplate">
    <data>
        <instance id="aiPromptTemplateDc"
                  class="com.company.hunttech.entity.AiPromptTemplate"
                  view="aiPromptTemplate-edit-view">
            <loader/>
        </instance>
    </data>
    <dialogMode height="800"
                width="900"
                modal="true"
                forceDialog="true"/>
    <layout expand="contentScrollBox"
            spacing="true"
            margin="true"
            height="100%"
            width="100%">
        <scrollBox id="contentScrollBox"
                   height="100%"
                   width="100%">
            <form id="form"
                  dataContainer="aiPromptTemplateDc"
                  captionPosition="TOP"
                  width="100%">
                <column width="100%">
                    <textField id="nameField"
                               property="name"
                               caption="msg://AiPromptTemplate.name"
                               required="true"
                               width="100%"/>
                    <textField id="codeField"
                               property="code"
                               caption="msg://AiPromptTemplate.code"
                               required="true"
                               width="100%"/>
                    <textField id="entityClassField"
                               property="entityClass"
                               caption="msg://AiPromptTemplate.entityClass"
                               required="true"
                               width="100%"/>
                    <textArea id="descriptionField"
                              property="description"
                              caption="msg://AiPromptTemplate.description"
                              width="100%"
                              rows="3"/>
                    <textArea id="promptTextField"
                              property="promptText"
                              caption="msg://AiPromptTemplate.promptText"
                              required="true"
                              width="100%"
                              rows="14"/>
                    <textArea id="availablePlaceholdersField"
                              property="availablePlaceholders"
                              caption="msg://AiPromptTemplate.availablePlaceholders"
                              width="100%"
                              rows="5"/>
                    <checkBox id="activeField"
                              property="active"
                              caption="msg://AiPromptTemplate.active"/>
                </column>
            </form>
        </scrollBox>
        <hbox id="editActions" spacing="true">
            <button id="commitAndCloseBtn" action="windowCommitAndClose"/>
            <button id="closeBtn" action="windowClose"/>
        </hbox>
    </layout>
</window>
