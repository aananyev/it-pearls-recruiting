<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://dialogCaption"
        messagesPack="com.company.hunttech.web.screens.candidatecontactsenrichment">
    <layout width="680px" height="560px" spacing="true" expand="scrollArea">
        <vbox id="infoBanner" spacing="false" width="100%" stylename="card-surface" margin="false,false,true,false">
            <label id="candidateNameLabel" stylename="h2 bold"/>
            <label id="metaInfoLabel" stylename="subheading"/>
        </vbox>

        <scrollBox id="scrollArea" width="100%" height="100%" spacing="true">
            <!-- Секция извлеченных контактов -->
            <vbox id="contactsBox" width="100%" spacing="true" stylename="card-surface">
                <hbox width="100%" alignment="MIDDLE_LEFT">
                    <label value="msg://extractedContactsTitle" stylename="bold h3" width="100%"/>
                    <label id="contactsCountBadge" value="0" stylename="ai-chip-badge badge-green"/>
                </hbox>
                <form id="contactsForm" width="100%">
                    <textField id="phoneField" caption="msg://colPhone" editable="false" width="100%"/>
                    <textField id="emailField" caption="msg://colEmail" editable="false" width="100%"/>
                    <textField id="telegramField" caption="msg://colTelegram" editable="false" width="100%"/>
                    <textField id="cityField" caption="msg://colCity" editable="false" width="100%"/>
                </form>
            </vbox>

            <!-- Секция фотографии кандидата -->
            <vbox id="photoBox" width="100%" spacing="true" stylename="card-surface">
                <hbox width="100%" alignment="MIDDLE_LEFT">
                    <label value="msg://photoTitle" stylename="bold h3" width="100%"/>
                    <label id="photoBadge" value="НЕТ" stylename="ai-chip-badge"/>
                </hbox>
                <label id="photoDetailLabel" value="—"/>
            </vbox>

            <!-- Секция обновленных полей -->
            <vbox id="updatedFieldsBox" width="100%" spacing="true" stylename="card-surface">
                <hbox width="100%" alignment="MIDDLE_LEFT">
                    <label value="msg://updatedFieldsTitle" stylename="bold h3" width="100%"/>
                    <label id="updatedCountBadge" value="0" stylename="ai-chip-badge badge-blue"/>
                </hbox>
                <flowBox id="updatedFieldsFlow" width="100%" spacing="true"/>
            </vbox>
        </scrollBox>

        <hbox width="100%" spacing="true" alignment="MIDDLE_RIGHT">
            <button id="closeBtn" caption="msg://btnClose" icon="CLOSE" stylename="primary"/>
        </hbox>
    </layout>
</window>
