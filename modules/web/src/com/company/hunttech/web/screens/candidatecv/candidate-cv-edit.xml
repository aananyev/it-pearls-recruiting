<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://editorCaption"
        messagesPack="com.company.hunttech.web.screens.candidatecv"
        icon="FILE_WORD_O">
    <data>
        <collection id="openPositionsDc"
                    class="com.company.hunttech.entity.OpenPosition">
            <!-- CandidateCVEdit vacancy picker needs only picker fields plus letter/comment data used by this screen. -->
            <view extends="openPosition-candidate-cv-picker-view"/>
            <loader id="openPositionsDl"
                    cacheable="true">
                <query>
                    <![CDATA[select e from hunttech_OpenPosition e order by e.openClose, e.vacansyName]]>
                    <condition>
                        <c:jpql>
                            <c:where>
                                e in (select k.openPosition from hunttech_RecrutiesTasks k
                                where k.reacrutier = :subscriber
                                and k.closed = false
                                and current_date between k.startDate and k.endDate)
                            </c:where>
                        </c:jpql>
                    </condition>
                </query>
            </loader>
        </collection>
        <instance id="candidateCVDc"
                  class="com.company.hunttech.entity.CandidateCV">
            <!-- Основной контейнер сохраняет candidateCV-view и composition-коллекции.
                 Локальное расширение view загружает только поля, которые экран читает напрямую. -->
            <view extends="candidateCV-view">
                <!-- Фото CandidateCV читается контроллером при открытии формы.
                     Атрибут загружается заранее, чтобы detached getter не обращался к ValueHolder без session. -->
                <property name="fileImageFace" view="_minimal"/>
                <property name="toVacancy" view="_local">
                    <property name="projectName" view="_local">
                        <property name="projectDepartment" view="_local"/>
                    </property>
                    <property name="grade" view="_local"/>
                </property>
                <property name="candidate" view="_local">
                    <property name="fileImageFace" view="_local"/>
                    <property name="personPosition" view="_local"/>
                </property>
                <property name="someFiles" view="_local">
                    <property name="fileType" view="_minimal"/>
                    <property name="fileDescriptor" view="_minimal"/>
                    <property name="fileOwner" view="_minimal"/>
                </property>
            </view>
            <loader/>
            <collection id="someFilesesDc"
                        property="someFiles"/>
            <collection id="skillTreesDc"
                        property="skillTree">
                <view extends="skillTree-cv-tab-view"/>
            </collection>
        </instance>
        <collection id="resumePositionsDc"
                    class="com.company.hunttech.entity.Position"
                    view="_local">
            <loader id="resumePositionsLc"
                    cacheable="true">
                <query>
                    <![CDATA[select e from hunttech_Position e where e.positionRuName not like '%(не использовать)%' order by e.positionRuName]]>
                </query>
            </loader>
        </collection>
        <collection id="usersDc"
                    class="com.haulmont.cuba.security.entity.User"
                    view="_local">
            <loader id="usersDl"
                    cacheable="true">
                <query>
                    <![CDATA[select e from sec$User e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="800"
                modal="true"
                width="1200"/>
    <layout expand="candidateCvMainLayout"
            spacing="false"
            height="100%"
            width="100%"
            stylename="candidate-cv-editor">
        <hbox id="candidateCvMainLayout"
              width="100%"
              height="100%"
              spacing="false"
              expand="candidateCvWorkspace"
              stylename="candidate-cv-main-layout">
            <!-- Постоянная левая панель повторяет профильный паттерн JobCandidateEdit.
                 Все отображаемые значения привязаны к candidateCVDc, поэтому изменения picker-полей
                 сразу отражаются в sidebar без копирования данных и дополнительных loader. -->
            <vbox id="candidateCvSidebar"
                  width="320px"
                  height="100%"
                  spacing="true"
                  expand="candidateCvSidebarSpacer"
                  stylename="edit-sidebar candidate-cv-sidebar">
                <hbox id="candidateLabel"
                      width="100%"
                      spacing="false"
                      stylename="candidate-cv-profile-header">
                    <vbox id="candidateContextMain"
                          width="100%"
                          align="TOP_CENTER"
                          spacing="true">
                        <!-- Единый OvaFallbackImage показывает сохранённую фотографию или theme fallback
                             без параллельного Image и ручного переключения visibility в контроллере. -->
                        <vbox id="dropZone"
                              spacing="true"
                              width="196px"
                              height="238px"
                              align="TOP_CENTER"
                              expand="picVBox"
                              stylename="dropzone-container candidate-cv-photo-dropzone">
                            <vbox id="picVBox"
                                  width="176px"
                                  height="176px"
                                  align="TOP_CENTER"
                                  stylename="candidate-cv-photo-frame">
                                <ovaFallbackImage id="candidatePic"
                                                  dataContainer="candidateCVDc"
                                                  property="fileImageFace"
                                                  width="176px"
                                                  height="176px"
                                                  ovalWidth="176px"
                                                  ovalHeight="176px"
                                                  align="TOP_CENTER"
                                                  stylename="widget-border candidate-cv-photo"
                                                  scaleMode="SCALE_DOWN"
                                                  fallbackThemePath="icons/no-programmer.jpeg"/>
                            </vbox>
                            <upload id="fileImageFaceUpload"
                                    fileStoragePutMode="IMMEDIATE"
                                    dataContainer="candidateCVDc"
                                    align="BOTTOM_CENTER"
                                    showFileName="false"
                                    dropZone="dropZone"
                                    showClearButton="true"
                                    property="fileImageFace"/>
                        </vbox>
                        <label id="iteractionListLabelCandidate"
                               width="100%"
                               stylename="h2 candidate-cv-context-title"
                               align="MIDDLE_CENTER"
                               dataContainer="candidateCVDc"
                               property="candidate.fullName"/>
                        <label id="iteractionListLabelPosition"
                               width="100%"
                               stylename="h3 candidate-cv-context-position"
                               align="MIDDLE_CENTER"
                               dataContainer="candidateCVDc"
                               property="candidate.personPosition"/>
                    </vbox>
                </hbox>

                <!-- Сведения о целевой позиции: блок «Резюме для вакансии» без рамки на уровень выше навигации -->
                <vbox id="candidateCvSidebarTargetCard"
                      width="100%"
                      spacing="false"
                      stylename="job-candidate-profile-contacts edit-sidebar-summary candidate-cv-sidebar-card">
                    <!-- Заголовок «Резюме для вакансии»: лаконичный заголовок раздела -->
                    <label value="Резюме для вакансии"
                           width="100%"
                           stylename="label-nav-title job-candidate-section-title candidate-cv-sidebar-card-title"/>
                    <grid spacing="true" width="100%">
                        <columns count="1"/>
                        <rows>
                            <row>
                                <hbox spacing="false" width="100%">
                                    <label value="Должность:"
                                           stylename="small candidate-cv-sidebar-field-label"
                                           width="52px"/>
                                    <label id="candidateCvSidebarResumePosition"
                                           width="100%"
                                           dataContainer="candidateCVDc"
                                           property="resumePosition"
                                           stylename="small bold"/>
                                </hbox>
                            </row>
                            <row>
                                <hbox spacing="false" width="100%">
                                    <label value="Вакансия:"
                                           stylename="small candidate-cv-sidebar-field-label"
                                           width="52px"/>
                                    <label id="candidateCvSidebarVacancy"
                                           width="100%"
                                           dataContainer="candidateCVDc"
                                           property="toVacancy"
                                           stylename="small"/>
                                </hbox>
                            </row>
                            <row>
                                <hbox spacing="false" width="100%">
                                    <label value="Проект:"
                                           stylename="small candidate-cv-sidebar-field-label"
                                           width="52px"/>
                                    <label id="candidateCvSidebarProject"
                                           width="100%"
                                           dataContainer="candidateCVDc"
                                           property="toVacancy.projectName"
                                           stylename="small"/>
                                </hbox>
                            </row>
                        </rows>
                    </grid>
                </vbox>

                <!-- Обязательный порядок Edit-sidebar HRM HuntTech:
                     визуальный образ, наименование, label-навигация, детализация, прочее. -->
                <vbox id="candidateCvSectionNavigation"
                      width="100%"
                      spacing="false"
                      stylename="job-candidate-navigation label-navigation candidate-cv-navigation">
                    <!-- Заголовок навигации «Разделы»: полоса-заголовок с двумя
                         горизонтальными inset-линиями (контракт §4.1). -->
                    <label width="100%"
                           value="msg://candidateCvNavigationTitle"
                           stylename="label-nav-title job-candidate-section-title candidate-cv-navigation-title"/>
                    <vbox id="candidateCvCandidateNavigation"
                          width="100%"
                          spacing="false"
                          stylename="candidate-cv-tab-navigation">
                        <button id="candidateCvMainDataNav" caption="msg://candidateCvNavMainData" icon="font-icon:USER" width="100%" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item candidate-cv-nav-item-active" invoke="navigateCandidateMainData"/>
                        <button id="candidateCvOriginalCvNav" caption="msg://candidateCvNavOriginalCv" icon="font-icon:FILE_TEXT_O" width="100%" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item" invoke="navigateCandidateOriginalCv"/>
                        <button id="candidateCvHuntTechCvNav" caption="msg://candidateCvNavHuntTechCv" icon="font-icon:FILE_WORD_O" width="100%" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item" invoke="navigateCandidateHuntTechCv"/>
                    </vbox>
                    <vbox id="candidateCvCvNavigation"
                          width="100%"
                          spacing="false"
                          visible="false"
                          stylename="candidate-cv-tab-navigation">
                        <button id="candidateCvTextNav" caption="msg://candidateCvNavCvText" icon="font-icon:ALIGN_LEFT" width="100%" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item candidate-cv-nav-item-active" invoke="navigateCvText"/>
                        <button id="candidateCvRecommendationNav" caption="msg://candidateCvNavCvRecommendations" icon="font-icon:COMMENT" width="100%" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item" invoke="navigateCvRecommendations"/>
                    </vbox>
                    <vbox id="candidateCvLetterNavigation"
                          width="100%"
                          spacing="false"
                          visible="false"
                          stylename="candidate-cv-tab-navigation">
                        <button id="candidateCvLetterTemplateNav" caption="msg://candidateCvNavLetterTemplate" icon="font-icon:FILE_TEXT_O" width="100%" visible="false" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item" invoke="navigateLetterTemplate"/>
                        <button id="candidateCvLetterBodyNav" caption="msg://candidateCvNavLetter" icon="font-icon:SEND" width="100%" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item candidate-cv-nav-item-active" invoke="navigateLetterBody"/>
                        <button id="candidateCvLetterCommentNav" caption="msg://candidateCvNavLetterComment" icon="font-icon:COMMENT" width="100%" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item" invoke="navigateLetterComment"/>
                        <button id="candidateCvLetterRecommendationNav" caption="msg://candidateCvNavLetterRecommendations" icon="font-icon:COMMENT" width="100%" visible="false" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item" invoke="navigateLetterRecommendations"/>
                    </vbox>
                    <vbox id="candidateCvSkillNavigation"
                          width="100%"
                          spacing="false"
                          visible="false"
                          stylename="candidate-cv-tab-navigation">
                        <button id="candidateCvSkillActionsNav" caption="msg://candidateCvNavSkillActions" icon="font-icon:MAGIC" width="100%" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item candidate-cv-nav-item-active" invoke="navigateSkillActions"/>
                        <button id="candidateCvSkillTreeNav" caption="msg://candidateCvNavSkillTree" icon="font-icon:SITEMAP" width="100%" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item" invoke="navigateSkillTree"/>
                    </vbox>
                    <vbox id="candidateCvFilesNavigation"
                          width="100%"
                          spacing="false"
                          visible="false"
                          stylename="candidate-cv-tab-navigation">
                        <button id="candidateCvFilesTableNav" caption="msg://candidateCvNavFiles" icon="font-icon:FOLDER_O" width="100%" stylename="borderless job-candidate-nav-item label-nav-item candidate-cv-nav-item candidate-cv-nav-item-active" invoke="navigateFilesTable"/>
                    </vbox>
                </vbox>

                <!-- Основные навыки кандидата, определенные нейросетью -->
                <vbox id="candidateProfileSkills"
                      width="100%"
                      spacing="true"
                      stylename="job-candidate-navigation label-navigation">
                    <label value="msg://msgMainSkillsTitle"
                           width="100%"
                           stylename="label-nav-title job-candidate-section-title candidate-cv-skills-title"/>
                    <label id="candidateSkillsLabels"
                           width="100%"
                           htmlEnabled="true"
                           stylename="candidate-skills-chips"/>
                </vbox>

                <vbox id="candidateCvSidebarMetaCard"
                      width="100%"
                      spacing="true"
                      stylename="job-candidate-profile-contacts job-candidate-sidebar-card edit-sidebar-summary candidate-cv-sidebar-card candidate-cv-sidebar-meta">
                    <label id="labelLastRecrutier"
                           width="100%"
                           stylename="candidate-cv-context-meta"/>
                    <label id="machRegexpFromCV"
                           width="100%"
                           stylename="candidate-cv-context-meta"/>
                    <hbox width="100%"
                          visible="false"
                          expand="quoteTextArea"
                          stylename="candidate-cv-quote">
                        <textArea id="quoteTextArea"
                                  width="100%"
                                  visible="false"
                                  editable="false"
                                  rows="2"
                                  height="100%"
                                  stylename="candidate-cv-quote"/>
                    </hbox>
                </vbox>

                <vbox id="candidateCvSidebarSpacer"
                      width="100%"
                      height="100%"
                      stylename="job-candidate-sidebar-spacer edit-sidebar-spacer candidate-cv-sidebar-spacer"/>
            </vbox>

            <vbox id="candidateCvWorkspace"
                  width="100%"
                  height="100%"
                  spacing="false"
                  expand="tabSheet"
                  stylename="candidate-cv-workspace-shell">
        <!-- Имена и порядок вкладок являются lifecycle-контрактом CandidateCVEdit.java. -->
        <tabSheet id="tabSheet"
                  width="100%"
                  height="100%"
                  stylename="candidate-cv-tabs">
            <tab id="tabCandidate"
                 caption="msg://msgCandidate"
                 expand="candidateScrolBox"
                 margin="false"
                 spacing="false">
                <scrollBox id="candidateScrolBox"
                           width="100%"
                           height="100%"
                           stylename="candidate-cv-scroll">
                    <hbox id="candidateVbox"
                          spacing="true"
                          width="100%"
                          align="TOP_LEFT"
                          expand="groupBox"
                          stylename="candidate-cv-candidate-layout">
                        <vbox id="groupBox"
                              spacing="true"
                              width="100%"
                              stylename="candidate-cv-column">
                            <vbox spacing="true"
                                  width="100%"
                                  stylename="candidate-cv-card candidate-cv-main-card">
                                <label value="Основные данные"
                                       stylename="candidate-cv-card-title"/>
                                <suggestionPickerField id="candidateField"
                                                       inputPrompt="mainMsg://msgStartInput"
                                                       minSearchStringLength="3"
                                                       rowspan="1"
                                                       colspan="1"
                                                       caption="msg://msgCandidate"
                                                       width="100%"
                                                       required="true"
                                                       dataContainer="candidateCVDc"
                                                       property="candidate">
                                    <actions>
                                        <action id="lookup" type="picker_lookup"/>
                                        <action id="open" type="picker_open"/>
                                    </actions>
                                    <query entityClass="com.company.hunttech.entity.JobCandidate"
                                           escapeValueForLike="true"
                                           searchStringFormat="%$searchString%">
                                        select e
                                        from hunttech_JobCandidate e
                                        where lower(e.fullName) like lower(:searchString) escape '\'
                                        and e.middleName not like '(не использовать)'
                                        and not e.blockCandidate = true
                                        order by e.fullName
                                    </query>
                                </suggestionPickerField>
                                <lookupPickerField id="resumePositionField"
                                                   optionsContainer="resumePositionsDc"
                                                   dataContainer="candidateCVDc"
                                                   property="resumePosition"
                                                   caption="msg://msgPosition"
                                                   required="true"
                                                   width="100%">
                                    <actions>
                                        <action id="lookup" type="picker_lookup"/>
                                    </actions>
                                </lookupPickerField>
                                <vbox width="100%"
                                      spacing="true"
                                      stylename="candidate-cv-vacancy-group">
                                    <lookupPickerField id="candidateCVFieldOpenPosition"
                                                       dataContainer="candidateCVDc"
                                                       optionsContainer="openPositionsDc"
                                                       property="toVacancy"
                                                       caption="mainMsg://msgVacancy"
                                                       width="100%">
                                        <actions>
                                            <action id="lookup"
                                                    type="picker_lookup"/>
                                            <action id="open"
                                                    type="picker_open"/>
                                        </actions>
                                    </lookupPickerField>
                                    <checkBox id="onlyMySubscribeCheckBox"
                                              align="TOP_RIGHT"
                                              width="AUTO"
                                              description="msg://msgOnlyMySebscribeDec"
                                              caption="msg://msgOnlyMySubscribe"/>
                                </vbox>
                                <lookupField id="СandidateCVField"
                                             dataContainer="candidateCVDc"
                                             optionsContainer="usersDc"
                                             caption="mainMsg://msgOwner"
                                             property="owner"
                                             width="100%"/>
                            </vbox>

                            <vbox expand="fileOriginalCVField"
                                  width="100%"
                                  spacing="true"
                                  stylename="candidate-cv-card candidate-cv-document-card">
                                <label value="Оригинальное резюме"
                                       stylename="candidate-cv-card-title"/>
                                <hbox width="100%"
                                      expand="textFieldIOriginalCV"
                                      spacing="true"
                                      stylename="candidate-cv-link-row">
                                    <textField id="textFieldIOriginalCV"
                                               dataContainer="candidateCVDc"
                                               property="linkOriginalCv"
                                               caption="mainMsg://msgLinkOriginalCV"
                                               width="100%"
                                               align="MIDDLE_LEFT"/>
                                    <button id="loadToCVTextArea"
                                            icon="font-icon:DOWNLOAD"
                                            align="BOTTOM_LEFT"
                                            caption="msg://msgLoadToCVTextArea"
                                            enable="false"
                                            description="msg://msgLoarToTextAreaDecription"
                                            invoke="loadToCVTextArea"/>
                                    <link id="originalCVLink"
                                          icon="font-icon:FILE_WORD_O"
                                          align="BOTTOM_LEFT"
                                          target="_blank"
                                          width="AUTO"
                                          caption="msg://msgGoTo"
                                          description="msg://msgGoTo"/>
                                </hbox>
                                <upload id="fileOriginalCVField"
                                        property="originalFileCV"
                                        showFileName="true"
                                        align="TOP_LEFT"
                                        width="100%"
                                        description="msg://msgOriginalCV"
                                        dataContainer="candidateCVDc"
                                        fileStoragePutMode="IMMEDIATE"
                                        showClearButton="true"/>
                            </vbox>

                            <vbox expand="fileCVField"
                                  width="100%"
                                  spacing="true"
                                  stylename="candidate-cv-card candidate-cv-document-card">
                                <label value="Резюме HRM HuntTech"
                                       stylename="candidate-cv-card-title"/>
                                <hbox width="100%"
                                      expand="textFieldHuntTechCV"
                                      spacing="true"
                                      stylename="candidate-cv-link-row">
                                    <textField id="textFieldHuntTechCV"
                                               dataContainer="candidateCVDc"
                                               property="linkHuntTechCV"
                                               caption="mainMsg://msgLinkToHuntTechCV"
                                               width="100%"
                                               align="MIDDLE_LEFT"/>
                                    <link id="HuntTechCVLink"
                                          icon="font-icon:FILE_WORD_O"
                                          align="BOTTOM_LEFT"
                                          target="_blank"
                                          width="AUTO"
                                          caption="msg://msgGoTo"
                                          description="msg://msgGoTo"/>
                                </hbox>
                                <upload id="fileCVField"
                                        fileStoragePutMode="IMMEDIATE"
                                        property="fileCV"
                                        showFileName="true"
                                        align="TOP_LEFT"
                                        width="100%"
                                        description="msg://msgCV"
                                        dataContainer="candidateCVDc"
                                        showClearButton="true"/>
                            </vbox>
                        </vbox>
                    </hbox>
                </scrollBox>
            </tab>

            <tab id="tabCV"
                 caption="msg://msgCV"
                 margin="false"
                 expand="cvVbox"
                 spacing="false">
                <vbox id="cvVbox"
                      spacing="true"
                      width="100%"
                      height="100%"
                      expand="candidateCVHBox"
                      stylename="candidate-cv-tab-content">
                    <hbox spacing="true"
                          width="100%"
                          stylename="candidate-cv-toolbar">
                        <!-- Выпадающая кнопка «Действия» выровнена справа -->
                        <popupButton id="cvActionsPopupButton"
                                     caption="msg://msgActions"
                                     icon="font-icon:BARS"
                                     showActionIcons="true"
                                     align="MIDDLE_RIGHT"
                                     stylename="primary candidate-cv-actions-btn">
                            <actions>
                                <action id="scanSkillsAction"
                                        caption="msg://msgScanCandidateSkills"
                                        icon="font-icon:MAGIC"/>
                                <action id="smartFormatCvAction"
                                        caption="msg://msgConvertToText"
                                        icon="font-icon:ALIGN_LEFT"/>
                                <action id="rescanCvAction"
                                        caption="msg://msgRescanResume"
                                        icon="font-icon:REPEAT"/>
                                <action id="resumeRecognitionAction"
                                        caption="msg://msgResumeRecognition"
                                        icon="font-icon:USER"/>
                                <action id="showOriginalAction"
                                        caption="msg://msgShowOriginal"
                                        icon="font-icon:FILE_TEXT_O"/>
                            </actions>
                        </popupButton>
                    </hbox>
                    <hbox id="candidateCVHBox"
                          expand="candidateCVRichTextArea"
                          height="100%"
                          spacing="true"
                          width="100%"
                          stylename="candidate-cv-workspace">
                        <richTextArea id="candidateCVRichTextArea"
                                      width="100%"
                                      height="100%"
                                      box.expandRatio="4"
                                      captionAsHtml="true"
                                      descriptionAsHtml="true"
                                      required="true"
                                      stylename="candidate-cv-rich-editor"/>
                        <richTextArea id="cvResomandation"
                                      width="100%"
                                      height="100%"
                                      editable="false"
                                      box.expandRatio="1"
                                      stylename="borderless candidate-cv-recommendation"/>
                    </hbox>
                </vbox>
            </tab>

            <tab id="tabLetter"
                 caption="msg://msgLetter"
                 margin="false"
                 expand="letterTabVbox"
                 spacing="false">
                <vbox id="letterTabVbox"
                      spacing="true"
                      width="100%"
                      height="100%"
                      expand="letterHBox"
                      stylename="candidate-cv-tab-content">
                    <hbox spacing="true"
                          width="100%"
                          stylename="candidate-cv-toolbar">
                        <popupButton id="letterActionsPopupButton"
                                     caption="msg://msgActions"
                                     icon="font-icon:BARS"
                                     showActionIcons="true"
                                     align="MIDDLE_RIGHT"
                                     stylename="primary candidate-cv-actions-btn">
                            <actions>
                                <action id="smartFormatLetterAction"
                                        caption="msg://msgConvertToText"
                                        icon="font-icon:ALIGN_LEFT"/>
                            </actions>
                        </popupButton>
                    </hbox>
                    <hbox id="letterHBox"
                          width="100%"
                          expand="letterVbox"
                          spacing="true"
                          height="100%"
                          stylename="candidate-cv-workspace">
                        <vbox id="letterVbox"
                              spacing="true"
                              width="100%"
                              height="100%"
                              box.expandRatio="4"
                              expand="letterRichTextArea"
                              stylename="candidate-cv-card candidate-cv-letter-editor">
                            <richTextArea id="questionLetterRichTextArea"
                                          width="100%"
                                          editable="false"
                                          visible="false"
                                          caption="msg://msgPatternLetter"
                                          stylename="text-field-title-form candidate-cv-letter-template"
                                          height="100%"/>
                            <richTextArea id="letterRichTextArea"
                                          dataContainer="candidateCVDc"
                                          property="letter"
                                          height="100%"
                                          width="100%"
                                          stylename="candidate-cv-rich-editor"/>
                            <richTextArea id="commentLetterRichTextArea"
                                          dataContainer="candidateCVDc"
                                          property="commentLetter"
                                          caption="msg://msgCommentLetter"
                                          height="25%"
                                          width="100%"
                                          stylename="candidate-cv-letter-comment"/>
                        </vbox>
                        <richTextArea id="letterRecommendation"
                                      width="100%"
                                      height="100%"
                                      stylename="borderless candidate-cv-recommendation"
                                      visible="false"
                                      editable="false"
                                      box.expandRatio="1"/>
                    </hbox>
                </vbox>
            </tab>

            <tab id="tabSkillTree"
                 caption="msg://msgCVSkillTree"
                 margin="false"
                 expand="skillBox"
                 spacing="false">
                <vbox id="skillBox"
                      width="100%"
                      height="100%"
                      expand="skillTreesTable"
                      spacing="true"
                      stylename="candidate-cv-tab-content">
                    <hbox spacing="true"
                          width="100%"
                          stylename="candidate-cv-toolbar">
                        <popupButton id="skillActionsPopupButton"
                                     caption="msg://msgAdditional"
                                     icon="font-icon:BARS"
                                     showActionIcons="true"
                                     align="MIDDLE_RIGHT"
                                     stylename="primary candidate-cv-actions-btn">
                            <actions>
                                <action id="scanSkillsAction"
                                        caption="msg://msgScanCandidateSkills"
                                        icon="font-icon:MAGIC"/>
                                <action id="rescanCvAction"
                                        caption="msg://msgRescanResume"
                                        icon="font-icon:REPEAT"/>
                                <action id="checkSkillFromJDAction"
                                        caption="msg://msgCheckSkills"
                                        icon="font-icon:CHECK_SQUARE_O"/>
                            </actions>
                        </popupButton>
                    </hbox>
                    <treeDataGrid id="skillTreesTable"
                                  width="100%"
                                  height="100%"
                                  dataContainer="skillTreesDc"
                                  hierarchyColumn="skillName"
                                  hierarchyProperty="skillTree"
                                  stylename="candidate-cv-table-card">
                        <columns>
                            <column id="skillName"
                                    caption="mainMsg://msgSkill"
                                    width="300px"
                                    maximumWidth="350px"
                                    sort="ASCENDING"
                                    property="skillName"/>
                            <column id="specialisation"
                                    width="300px"
                                    maximumWidth="350px"
                                    property="specialisation"
                                    caption="msg://msgSpecialisation"/>
                            <column id="wikiPage"
                                    maximumWidth="500px"
                                    width="500px"
                                    caption="msg://msgWikiPage">
                                <componentRenderer/>
                            </column>
                            <column id="isComment"
                                    caption="msg://msgIsComment"
                                    width="100px"
                                    maximumWidth="120px">
                                <iconRenderer/>
                            </column>
                        </columns>
                        <rowsCount/>
                    </treeDataGrid>
                </vbox>
            </tab>

            <tab id="tabFiles"
                 caption="mainMsg://msgFiles"
                 margin="false"
                 spacing="false"
                 expand="someFilesVbox">
                <vbox id="someFilesVbox"
                      spacing="true"
                      expand="someFilesTable"
                      width="100%"
                      height="100%"
                      stylename="candidate-cv-tab-content">
                    <table id="someFilesTable"
                           height="100%"
                           width="100%"
                           dataContainer="someFilesesDc"
                           stylename="candidate-cv-table-card">
                        <columns>
                            <column id="fileDescription"/>
                            <column id="fileType.nameFileType"/>
                            <column id="fileComment"/>
                            <column id="fileDescriptor.size"/>
                            <column id="fileOwner.name" caption="mainMsg://msgOwner"/>
                        </columns>
                        <buttonsPanel stylename="candidate-cv-toolbar">
                            <button action="someFilesTable.create"/>
                            <button action="someFilesTable.edit"/>
                            <button action="someFilesTable.remove"/>
                        </buttonsPanel>
                        <actions>
                            <action id="add" type="add"/>
                            <action type="create" id="create"/>
                            <action id="edit" type="edit"/>
                            <action id="remove" type="remove"/>
                        </actions>
                    </table>
                </vbox>
            </tab>
        </tabSheet>

        <hbox id="editActions"
              spacing="true"
              width="100%"
              height="AUTO"
              margin="false"
              align="MIDDLE_LEFT"
              expand="footerActions"
              stylename="candidate-cv-footer">
            <dateField id="datePostField"
                       align="MIDDLE_LEFT"
                       dataContainer="candidateCVDc"
                       property="datePost"
                       caption="msg://msgDatePost"
                       width="AUTO"/>
            <hbox id="footerActions"
                  align="MIDDLE_RIGHT"
                  spacing="true"
                  width="100%">
                <label value=""
                       box.expandRatio="1"/>
                <button action="windowCommitAndClose"
                        icon="font-icon:CHECK"
                        stylename="primary candidate-cv-primary-action"
                        align="MIDDLE_RIGHT"/>
                <button action="windowClose"
                        icon="font-icon:TIMES"
                        align="MIDDLE_RIGHT"/>
            </hbox>
        </hbox>
        </vbox>
    </hbox>
    </layout>
</window>
