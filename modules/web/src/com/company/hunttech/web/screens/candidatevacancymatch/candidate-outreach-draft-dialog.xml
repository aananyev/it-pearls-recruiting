<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="Предложение кандидату (AI Draft)"
        messagesPack="com.company.hunttech.web.screens.candidatevacancymatch">
    <layout spacing="true" width="800px" height="620px" expand="messageArea">
        <vbox spacing="false" width="100%">
            <label id="headerLabel" value="Предложение рассмотреть вакансию" stylename="bold h3"/>
            <label id="subHeaderLabel" value="Кандидат: — | Вакансия: —" stylename="h4 text-muted"/>
            <label value="Отредактируйте текст перед отправкой или сохранением во взаимодействие. AI не отправляет сообщения автоматически." stylename="text-muted small"/>
        </vbox>

        <textArea id="messageArea" width="100%" height="100%" stylename="outreach-draft-area"/>

        <hbox spacing="true" width="100%" alignment="MIDDLE_RIGHT">
            <button id="regenerateBtn" caption="Сгенерировать заново" icon="font-icon:REFRESH"/>
            <button id="copyBtn" caption="Копировать" icon="font-icon:COPY"/>
            <button id="createInteractionBtn" caption="Создать взаимодействие" icon="font-icon:COMMENTS" stylename="primary"/>
            <button id="closeBtn" caption="Закрыть" icon="font-icon:TIMES"/>
        </hbox>
    </layout>
</window>
