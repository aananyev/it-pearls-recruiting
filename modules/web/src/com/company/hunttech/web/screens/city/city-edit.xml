<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Edit-экран города: двухпанельная композиция по общему контракту Edit-экранов HRM HuntTech.
     Сохраняет исходные loaders, bindings (cityDc, cityRegionsDc) и actions. -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://editorCaption"
        focusComponent="cityRuNameField"
        messagesPack="com.company.hunttech.web.screens.city"
        icon="BANK">
    <!-- Секция данных: контейнер города и справочник регионов. -->
    <data>
        <!-- Корневой контейнер города с view city-edit-view. -->
        <instance id="cityDc" class="com.company.hunttech.entity.City" view="city-edit-view">
            <loader/>
        </instance>
        <!-- Справочник регионов для picker-поля «Регион» (кэшируется). -->
        <collection id="cityRegionsDc" class="com.company.hunttech.entity.Region" view="region-picker-view">
            <loader id="cityRegionsLc" cacheable="true">
                <query><![CDATA[select e from hunttech_Region e]]></query>
            </loader>
        </collection>
    </data>
    <dialogMode height="100%" width="100%" modal="true"/>
    <!-- Корневой layout формы: локальный namespace city-editor + общий контракт Edit-экранов. -->
    <layout stylename="city-editor" expand="cityMainLayout" spacing="false" width="100%" height="100%">
        <hbox id="cityMainLayout" stylename="edit-screen-layout" expand="cityWorkspace" spacing="false" width="100%" height="100%">
            <!-- Левая контекстная панель: идентификация, label-навигация, сводка и подсказка. -->
            <vbox id="citySidebar" stylename="edit-sidebar" width="270px" height="100%" spacing="true" expand="citySidebarSpacer">
                <vbox id="cityIdentity" stylename="edit-sidebar-identity" width="100%" spacing="true">
                    <label value="Город" stylename="edit-sidebar-subtitle" width="100%"/>
                    <label id="citySidebarTitle" dataContainer="cityDc" property="cityRuName" stylename="edit-sidebar-title" width="100%"/>
                </vbox>
                <!-- Label-навигация повторяет фактическую информационную архитектуру правой области. -->
                <vbox id="cityNavigation" stylename="label-navigation" width="100%" spacing="false">
                    <label value="Разделы" stylename="label-nav-title" width="100%"/>
                    <button id="cityIdentityNav" caption="Наименование" stylename="borderless label-nav-item label-nav-item-active" width="100%" invoke="focusIdentitySection"/>
                    <button id="cityRegionNav" caption="Регион и связь" stylename="borderless label-nav-item" width="100%" invoke="focusRegionSection"/>
                </vbox>
                <vbox id="citySidebarSummary" stylename="edit-sidebar-summary" width="100%" spacing="true">
                    <label value="Регион" stylename="edit-sidebar-subtitle"/>
                    <label dataContainer="cityDc" property="cityRegion.regionRuName" width="100%"/>
                </vbox>
                <vbox id="citySidebarSpacer" stylename="edit-sidebar-spacer"/>
                <label value="Город используется в адресах кандидатов, компаний и вакансий HRM HuntTech." stylename="edit-sidebar-hint" width="100%"/>
            </vbox>
            <!-- Правая рабочая область: toolbar, логические карточки и footer-actions. -->
            <vbox id="cityWorkspace" stylename="edit-workspace" expand="cityWorkspaceScroll" width="100%" height="100%" spacing="false">
                <hbox id="cityToolbar" stylename="edit-toolbar" width="100%" spacing="true">
                    <vbox id="cityToolbarText" width="100%" spacing="false">
                        <label value="Карточка города" stylename="edit-toolbar-title"/>
                        <label value="Наименование, телефонный код и принадлежность региону" stylename="edit-toolbar-description"/>
                    </vbox>
                </hbox>
                <scrollBox id="cityWorkspaceScroll" stylename="edit-workspace-scroll" width="100%" height="100%">
                    <vbox id="citySections" width="100%" spacing="true">
                        <!-- Наименование и телефонный код образуют единый идентификационный блок. -->
                        <groupBox id="cityIdentitySection" caption="Наименование" stylename="edit-card" width="100%" spacing="true">
                            <form id="cityIdentityForm" dataContainer="cityDc" width="100%">
                                <column width="100%">
                                    <textField id="cityRuNameField" property="cityRuName" caption="mainMsg://msgCityRuName" width="100%" stylename="edit-form-control"/>
                                    <textField id="cityPhoneCodeField" property="cityPhoneCode" caption="mainMsg://msgCityPhoneCode" width="100%" stylename="edit-form-control"/>
                                </column>
                            </form>
                        </groupBox>
                        <!-- Связь с регионом вынесена в отдельную карточку без изменения binding и picker action. -->
                        <groupBox id="cityRegionSection" caption="Регион и связь" stylename="edit-card" width="100%" spacing="true">
                            <form id="cityRegionForm" dataContainer="cityDc" width="100%">
                                <column width="100%">
                                    <lookupPickerField id="cityRegionField" optionsContainer="cityRegionsDc" property="cityRegion" caption="mainMsg://msgCityRegion" width="100%" stylename="edit-form-control">
                                        <actions><action id="lookup" type="picker_lookup"/></actions>
                                    </lookupPickerField>
                                </column>
                            </form>
                        </groupBox>
                    </vbox>
                </scrollBox>
                <hbox id="editActions" stylename="edit-footer-actions" spacing="true" width="100%">
                    <vbox id="cityActionsSpacer" width="100%"/>
                    <button action="windowCommitAndClose"/>
                    <button action="windowClose"/>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>
