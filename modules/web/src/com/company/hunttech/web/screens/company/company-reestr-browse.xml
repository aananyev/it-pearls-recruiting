<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://companyReestrCaption"
        focusComponent="companiesTable"
        messagesPack="com.company.hunttech.web.screens.company"
        icon="BUILDING">
    <data readOnly="true">
        <collection id="companiesDc"
                    class="com.company.hunttech.entity.Company">
            <view extends="company-browse-view">
                <property name="addressOfCompany"/>
                <property name="companyDescription"/>
                <property name="workingConditions"/>
                <property name="companyGroup" view="_minimal">
                    <property name="companyRuGroupName"/>
                </property>
                <property name="companyOwnership" view="_minimal">
                    <property name="shortType"/>
                    <property name="longType"/>
                </property>
                <property name="countryOfCompany" view="_minimal">
                    <property name="countryRuName"/>
                </property>
                <property name="cityOfCompany" view="_minimal">
                    <property name="cityRuName"/>
                </property>
                <property name="fileCompanyLogo" view="_minimal"/>
                <property name="companyDirector" view="person-picker-view">
                    <property name="firstName"/>
                    <property name="secondName"/>
                    <property name="phone"/>
                    <property name="mobPhone"/>
                    <property name="email"/>
                </property>
            </view>
            <loader id="companiesDl">
                <query><![CDATA[select e from hunttech_Company e order by e.comanyName]]>
                    <condition>
                        <and>
                            <c:jpql>
                                <c:where>e.ourClient = :setOurClient</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.ourLegalEntity = :setOurLegalEntity</c:where>
                            </c:jpql>
                        </and>
                    </condition>
                </query>
            </loader>
        </collection>
    </data>

    <dialogMode height="700" width="1100"/>

    <layout expand="splitMainLayout" spacing="false" width="100%" height="100%" stylename="job-candidate-editor edit-screen-layout">
        <hbox id="splitMainLayout" width="100%" height="100%" spacing="true" expand="workspaceBox" stylename="job-candidate-main-layout edit-screen-layout">
            <!-- ЛЕВЫЙ САЙДБАР (312px) -->
            <vbox id="detailPane" width="312px" height="100%" spacing="true" stylename="job-candidate-sidebar edit-sidebar">
                <scrollBox id="sidebarScrollBox" width="100%" height="100%" orientation="vertical">
                    <vbox width="100%" spacing="true">
                        <!-- Шапка профиля компании -->
                        <vbox id="profileHeader" width="100%" spacing="true" align="TOP_CENTER" stylename="job-candidate-profile-header edit-sidebar-visual">
                            <ovaFallbackImage id="logoPic" width="120px" height="120px" ovalWidth="120px" ovalHeight="120px"
                                              align="TOP_CENTER" stylename="job-candidate-avatar" fallbackThemePath="icons/no-company.png" scaleMode="SCALE_DOWN"/>
                            <vbox width="100%" spacing="false" align="MIDDLE_CENTER" stylename="edit-sidebar-identity">
                                <label id="detailTitle" value="Выберите компанию" width="100%" stylename="edit-sidebar-title h2 candidate-sidebar-fullname" align="MIDDLE_CENTER"/>
                                <label id="detailSubtitle" value="-" width="100%" stylename="edit-sidebar-subtitle h4 candidate-sidebar-position" align="MIDDLE_CENTER"/>
                                <label id="detailLocation" value="-" width="100%" stylename="edit-help candidate-sidebar-city" align="MIDDLE_CENTER"/>
                            </vbox>
                        </vbox>

                        <!-- Кнопки действий сайдбара -->
                        <vbox id="sidebarActionsCard" width="100%" spacing="true" stylename="edit-sidebar-summary">
                            <button id="openEditCardBtn" caption="Открыть карточку" icon="EDIT_ACTION" stylename="primary" enabled="false" width="100%"/>
                            <button id="createProjectFromCompanyBtn" caption="Создать проект" icon="PLUS" enabled="false" width="100%"/>
                        </vbox>

                        <!-- Секция: Реквизиты и статус -->
                        <vbox id="termsCard" width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="РЕКВИЗИТЫ И СТАТУС" width="100%" stylename="label-nav-title job-candidate-section-title" align="MIDDLE_CENTER"/>
                            <grid id="termsGrid" spacing="true" width="100%" stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row><label value="Наш клиент:" stylename="bold"/><label id="detailOurClient" htmlEnabled="true" value="-"/></row>
                                    <row><label value="Наше юр. лицо:" stylename="bold"/><label id="detailOurLegalEntity" htmlEnabled="true" value="-"/></row>
                                    <row><label value="Холдинг / Группа:" stylename="bold"/><label id="detailCompanyGroup" value="-"/></row>
                                    <row><label value="Форма собств.:" stylename="bold"/><label id="detailOwnership" value="-"/></row>
                                    <row><label value="Руководитель:" stylename="bold"/><label id="detailDirector" value="-"/></row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Секция: Активность и статистика -->
                        <vbox id="statsCard" width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="СТАТИСТИКА" width="100%" stylename="label-nav-title job-candidate-section-title" align="MIDDLE_CENTER"/>
                            <grid id="statsGrid" spacing="true" width="100%" stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row><label value="Проектов в работе:" stylename="bold"/><label id="detailProjectsCount" value="0" stylename="bold"/></row>
                                    <row><label value="Открытых вакансий:" stylename="bold"/><label id="detailPositionsCount" value="0" stylename="bold" css="color: #2563eb;"/></row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Секция: Описание компании -->
                        <vbox id="descriptionCard" width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="ОПИСАНИЕ И УСЛОВИЯ" width="100%" stylename="label-nav-title job-candidate-section-title" align="MIDDLE_CENTER"/>
                            <label id="detailDescription" htmlEnabled="true" width="100%" stylename="edit-help"/>
                        </vbox>
                    </vbox>
                </scrollBox>
            </vbox>

            <!-- ПРАВАЯ РАБОЧАЯ ОБЛАСТЬ -->
            <vbox id="workspaceBox" width="100%" height="100%" spacing="true" stylename="edit-workspace candidate-reestr-workspace" expand="tableCard" margin="true,true,true,false">
                
                <!-- Командный тулбар -->
                <hbox id="tableFilterBar" width="100%" spacing="true" align="MIDDLE_LEFT" stylename="candidate-filter-bar edit-card" expand="toolbarSpacer">
                    <hbox id="leftActionButtons" spacing="true" align="MIDDLE_LEFT" stylename="filter-buttons-panel">
                        <button id="createBtn" caption="Создать компанию" icon="CREATE_ACTION" stylename="primary candidate-btn candidate-create-btn" action="companiesTable.create"/>
                        <button id="smartUploadBtn" caption="msg://msgSmartUpload" icon="font-icon:MAGIC" stylename="primary candidate-btn candidate-smartload-btn"/>
                        <button id="editBtn" caption="Редактировать" icon="EDIT_ACTION" stylename="secondary candidate-btn" action="companiesTable.edit"/>
                        <button id="removeBtn" caption="Удалить" icon="REMOVE_ACTION" stylename="secondary candidate-btn" action="companiesTable.remove"/>
                    </hbox>
                    <hbox id="toolbarSpacer" width="100%"/>
                    <hbox id="rightActionButtons" spacing="true" align="MIDDLE_RIGHT" stylename="filter-buttons-panel">
                        <popupButton id="filterPopupButton" caption="Все компании" icon="FILTER" stylename="secondary candidate-btn">
                            <actions>
                                <action id="filterAll" caption="Все компании"/>
                                <action id="filterClientsOnly" caption="Только наши клиенты"/>
                                <action id="filterLegalEntitiesOnly" caption="Только наши юр. лица"/>
                            </actions>
                        </popupButton>
                        <popupButton id="actionsPopupButton" caption="Действия" icon="BARS" stylename="primary candidate-btn">
                            <actions>
                                <action id="refreshAction" caption="Обновить данные" icon="REFRESH"/>
                                <action id="excelExportAction" caption="Выгрузить в Excel" icon="FILE_EXCEL_O"/>
                            </actions>
                        </popupButton>
                    </hbox>
                </hbox>

                <!-- Generic Filter -->
                <filter id="filter"
                        applyTo="companiesTable"
                        dataLoader="companiesDl"
                        defaultMode="generic"
                        width="100%"
                        collapsable="true"
                        collapsed="true"
                        stylename="candidate-generic-filter">
                    <properties include=".*"
                                excludeProperties="addressOfCompany,companyDescription,workingConditions,departmentOfCompany,version,createTs,createdBy,updateTs,updatedBy,deleteTs,deletedBy"/>
                </filter>

                <!-- Карточка таблицы с rowsCount -->
                <vbox id="tableCard" width="100%" height="100%" spacing="false" stylename="edit-card candidate-table-card" expand="companiesTable">
                    <groupTable id="companiesTable"
                                width="100%"
                                height="100%"
                                dataContainer="companiesDc"
                                stylename="borderless grid candidate-browse-grid">
                        <actions>
                            <action id="create" type="create"/>
                            <action id="edit" type="edit"/>
                            <action id="remove" type="remove"/>
                            <action id="excel" type="excel"/>
                            <action id="refresh" type="refresh"/>
                        </actions>
                        <columns>
                            <column id="companyLogoColumn" caption="Лого" width="50px" sortable="false"/>
                            <column id="comanyName" caption="Компания / Бренд" expandRatio="3"/>
                            <column id="ourClientIconColumn" caption="Клиент" width="95px" sortable="false"/>
                            <column id="ourCompanyIconColumn" caption="Наше ЮЛ" width="95px" sortable="false"/>
                            <column id="cityOfCompany" caption="Город" width="135px"/>
                            <column id="countryOfCompany" caption="Страна" width="120px"/>
                        </columns>
                        <rowsCount/>
                    </groupTable>
                </vbox>
            </vbox>
        </hbox>
    </layout>
</window>
