<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://companyGroupReestrCaption"
        focusComponent="companyGroupsTable"
        messagesPack="com.company.hunttech.web.screens.companygroup"
        icon="BUILDING_O">
    <data readOnly="true">
        <collection id="companyGroupsDc"
                    class="com.company.hunttech.entity.CompanyGroup">
            <view extends="companyGroup-browse-view">
                <property name="companyRuGroupName"/>
            </view>
            <loader id="companyGroupsDl">
                <query><![CDATA[select e from hunttech_CompanyGroup e order by e.companyRuGroupName]]></query>
            </loader>
        </collection>
    </data>

    <dialogMode height="700" width="1100"/>

    <layout expand="splitMainLayout" spacing="false" width="100%" height="100%" stylename="job-candidate-editor edit-screen-layout">
        <hbox id="splitMainLayout" width="100%" height="100%" spacing="true" expand="workspaceBox" stylename="job-candidate-main-layout edit-screen-layout">
            <!-- ЛЕВЫЙ САЙДБАР (312px) -->
            <vbox id="detailPane" width="312px" height="100%" spacing="true" stylename="job-candidate-sidebar edit-sidebar">
                <scrollBox id="sidebarScrollBox" width="100%" height="100%" orientation="vertical">
                    <vbox width="100%" spacing="true">
                        <!-- Шапка группы компаний -->
                        <vbox id="profileHeader" width="100%" spacing="true" align="TOP_CENTER" stylename="job-candidate-profile-header edit-sidebar-visual">
                            <ovaFallbackImage id="logoPic" width="120px" height="120px" ovalWidth="120px" ovalHeight="120px"
                                              align="TOP_CENTER" stylename="job-candidate-avatar" fallbackThemePath="icons/no-company.png" scaleMode="SCALE_DOWN"/>
                            <vbox width="100%" spacing="false" align="MIDDLE_CENTER" stylename="edit-sidebar-identity">
                                <label id="detailTitle" value="Выберите группу" width="100%" stylename="edit-sidebar-title h2 candidate-sidebar-fullname" align="MIDDLE_CENTER"/>
                                <label id="detailSubtitle" value="Холдинг / Группа компаний" width="100%" stylename="edit-sidebar-subtitle h4 candidate-sidebar-position" align="MIDDLE_CENTER"/>
                            </vbox>
                        </vbox>

                        <!-- Кнопки действий сайдбара -->
                        <vbox id="sidebarActionsCard" width="100%" spacing="true" stylename="edit-sidebar-summary">
                            <button id="openEditCardBtn" caption="Открыть карточку группы" icon="EDIT_ACTION" stylename="primary" enabled="false" width="100%"/>
                        </vbox>

                        <!-- Секция: Статистика холдинга -->
                        <vbox id="statsCard" width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="СТАТИСТИКА" width="100%" stylename="label-nav-title job-candidate-section-title"/>
                            <grid id="statsGrid" spacing="true" width="100%" stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row><label value="Компаний в группе:" stylename="bold"/><label id="detailCompaniesCount" value="0" stylename="bold" css="color: #2563eb;"/></row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Секция: Список компаний холдинга -->
                        <vbox id="companiesListCard" width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="КОМПАНИИ ХОЛДИНГА" width="100%" stylename="label-nav-title job-candidate-section-title"/>
                            <label id="detailCompaniesList" htmlEnabled="true" width="100%" stylename="edit-help"/>
                        </vbox>
                    </vbox>
                </scrollBox>
            </vbox>

            <!-- ПРАВАЯ РАБОЧАЯ ОБЛАСТЬ -->
            <vbox id="workspaceBox" width="100%" height="100%" spacing="true" stylename="edit-workspace candidate-reestr-workspace" expand="tableCard" margin="true,true,true,false">
                
                <!-- Командный тулбар -->
                <hbox id="tableFilterBar" width="100%" spacing="true" align="MIDDLE_LEFT" stylename="candidate-filter-bar edit-card" expand="toolbarSpacer">
                    <hbox id="leftActionButtons" spacing="true" align="MIDDLE_LEFT" stylename="filter-buttons-panel">
                        <button id="createBtn" caption="Создать группу" icon="CREATE_ACTION" stylename="primary candidate-btn candidate-create-btn" action="companyGroupsTable.create"/>
                        <button id="editBtn" caption="Редактировать" icon="EDIT_ACTION" stylename="secondary candidate-btn" action="companyGroupsTable.edit"/>
                        <button id="removeBtn" caption="Удалить" icon="REMOVE_ACTION" stylename="secondary candidate-btn" action="companyGroupsTable.remove"/>
                    </hbox>
                    <hbox id="toolbarSpacer" width="100%"/>
                    <hbox id="rightActionButtons" spacing="true" align="MIDDLE_RIGHT" stylename="filter-buttons-panel">
                        <popupButton id="actionsPopupButton" caption="Действия" icon="BARS" stylename="primary candidate-btn">
                            <actions>
                                <action id="refreshAction" caption="Обновить данные" icon="REFRESH"/>
                                <action id="excelExportAction" caption="Выгрузить в Excel" icon="FILE_EXCEL_O"/>
                            </actions>
                        </popupButton>
                    </hbox>
                </hbox>

                <!-- Generic Filter -->
                <filter id="filter"
                        applyTo="companyGroupsTable"
                        dataLoader="companyGroupsDl"
                        defaultMode="generic"
                        width="100%"
                        collapsable="true"
                        collapsed="true"
                        stylename="candidate-generic-filter">
                    <properties include=".*"
                                excludeProperties="version,createTs,createdBy,updateTs,updatedBy,deleteTs,deletedBy"/>
                </filter>

                <!-- Карточка таблицы с rowsCount -->
                <vbox id="tableCard" width="100%" height="100%" spacing="false" stylename="edit-card candidate-table-card" expand="companyGroupsTable">
                    <dataGrid id="companyGroupsTable"
                              width="100%"
                              height="100%"
                              dataContainer="companyGroupsDc"
                              stylename="borderless grid candidate-browse-grid">
                        <actions>
                            <action id="create" type="create"/>
                            <action id="edit" type="edit"/>
                            <action id="remove" type="remove"/>
                            <action id="excel" type="excel"/>
                            <action id="refresh" type="refresh"/>
                        </actions>
                        <columns>
                            <column id="companyRuGroupName"
                                    property="companyRuGroupName"
                                    caption="Группа компаний / Холдинг"
                                    expandRatio="3"/>
                            <column id="companiesCountColumn"
                                    caption="Компаний"
                                    width="120px">
                                <componentRenderer/>
                            </column>
                        </columns>
                        <rowsCount/>
                    </dataGrid>
                </vbox>
            </vbox>
        </hbox>
    </layout>
</window>
