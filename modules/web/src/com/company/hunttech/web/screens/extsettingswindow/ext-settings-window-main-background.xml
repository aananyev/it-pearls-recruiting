<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/window.xsd"
        xmlns:ext="http://schemas.haulmont.com/cuba/window-ext.xsd"
        class="com.company.hunttech.web.screens.extsettingswindow.ExtSettingsWindowMainBackground"
        extends="/com/company/hunttech/web/screens/extsettingswindow/ext-settings-window-email-navigation.xml">
    <layout>
        <hbox id="settingsMainLayout" width="100%" height="100%" spacing="false" expand="settingsWorkspaceBox"
              stylename="edit-screen-layout">
            <vbox id="settingsWorkspaceBox" width="100%" height="100%" spacing="false" expand="settingsTabSheet"
                  stylename="edit-workspace settings-workspace">
                <!-- 2026-09-04: height="100%" убран (фикс D1 «поехавшей» компоновки) —
                     высоту tabSheet отдаёт expand родителя; stylename продублирован явно (A-7). -->
                <tabSheet id="settingsTabSheet" width="100%" stylename="framed ext-settings-tabs">
                    <tab id="msgInterface">
                        <scrollBox id="interfaceSettingsContentScrollBox">
                            <vbox id="interfaceSettingsContent">
                                <!-- Карточка изолирована собственным CSS namespace.
                                     Соседние блоки вкладки «Интерфейс» не перестраиваются. -->
                                <vbox id="mainScreenBackgroundCard"
                                      width="100%"
                                      spacing="true"
                                      stylename="settings-section-card interface-settings-card main-screen-background-card edit-card">
                                    <hbox id="mainScreenBackgroundHeader"
                                          width="100%"
                                          spacing="true"
                                          expand="mainScreenBackgroundHeaderText"
                                          stylename="main-screen-background-header">
                                        <vbox id="mainScreenBackgroundHeaderText"
                                              width="100%"
                                              spacing="false">
                                            <label value="Фон главного экрана"
                                                   stylename="h3 settings-section-card-title edit-card-title"/>
                                            <label value="Выберите персональное изображение или системный каталог активной темы."
                                                   width="100%"
                                                   stylename="settings-section-help main-screen-background-header-help"/>
                                        </vbox>
                                        <label id="mainScreenBackgroundStatusLabel"
                                               align="MIDDLE_RIGHT"
                                               stylename="main-screen-background-status"/>
                                    </hbox>

                                    <hbox id="mainScreenBackgroundOptions"
                                          width="100%"
                                          spacing="true"
                                          stylename="main-screen-background-options">
                                        <vbox id="mainScreenBackgroundCustomOption"
                                              width="100%"
                                              box.expandRatio="1"
                                              spacing="true"
                                              stylename="main-screen-background-option main-screen-background-custom-option">
                                            <label value="Персональное изображение"
                                                   stylename="main-screen-background-option-title bold"/>
                                            <label value="PNG, JPG, JPEG или WEBP до 15 МБ. Файл проверяется, уменьшается и сохраняется без EXIF."
                                                   width="100%"
                                                   stylename="settings-section-help main-screen-background-option-help edit-help"/>
                                            <!-- uploadButtonCaption управляет реальной Vaadin-кнопкой выбора файла.
                                                 Явная высота исключает схлопывание интерактивной области. -->
                                            <upload id="mainScreenBackgroundUpload"
                                                    fileStoragePutMode="IMMEDIATE"
                                                    uploadButtonCaption="Выбрать изображение"
                                                    width="100%"
                                                    height="36px"
                                                    accept="*.png,*.jpg,*.jpeg,*.webp"
                                                    permittedExtensions=".png,.jpg,.jpeg,.webp"
                                                    fileSizeLimit="15728640"
                                                    showFileName="true"
                                                    showClearButton="false"
                                                    stylename="main-screen-background-upload"/>
                                        </vbox>

                                        <vbox id="mainScreenBackgroundDefaultOption"
                                              width="100%"
                                              box.expandRatio="1"
                                              spacing="true"
                                              stylename="main-screen-background-option main-screen-background-default-option">
                                            <label value="Системные фоны"
                                                   stylename="main-screen-background-option-title bold"/>
                                            <label value="Для каждой темы доступно 10 вариантов без немедленного повторения. Новый фон применяется после сохранения."
                                                   width="100%"
                                                   stylename="settings-section-help main-screen-background-option-help edit-help"/>
                                            <button id="clearMainScreenBackgroundBtn"
                                                    caption="Использовать системные фоны"
                                                    width="100%"
                                                    invoke="clearMainScreenBackground"
                                                    stylename="main-screen-background-default-button secondary"/>
                                        </vbox>
                                    </hbox>

                                    <label value="Персональное изображение всегда имеет приоритет. После очистки используется случайный фон активной темы."
                                           width="100%"
                                           stylename="settings-section-help main-screen-background-note edit-help"/>
                                </vbox>

                                <!-- Карточка настройки положения кнопки AI-чата -->
                                <vbox id="llmChatButtonCard"
                                      width="100%"
                                      spacing="true"
                                      stylename="settings-section-card interface-settings-card edit-card">
                                    <hbox id="llmChatButtonHeader"
                                          width="100%"
                                          spacing="true"
                                          expand="llmChatButtonHeaderText"
                                          stylename="main-screen-background-header">
                                        <vbox id="llmChatButtonHeaderText"
                                              width="100%"
                                              spacing="false">
                                            <label value="Кнопка вызова AI-чата"
                                                   stylename="h3 settings-section-card-title edit-card-title"/>
                                            <label value="Управление положением плавающей кнопки вызова ассистента."
                                                   width="100%"
                                                   stylename="settings-section-help edit-help"/>
                                        </vbox>
                                        <label id="llmChatButtonPositionStatusLabel"
                                               align="MIDDLE_RIGHT"
                                               stylename="main-screen-background-status"/>
                                    </hbox>

                                    <vbox id="llmChatButtonBody"
                                          width="100%"
                                          spacing="true"
                                          stylename="main-screen-background-options">
                                        <label value="Кнопка вызова AI-чата и её плавающий контейнер объединены в единый интерактивный элемент. Кнопку можно зажать мышью и свободно перемещать в любую точку экрана. При необходимости вы можете вернуть её в правый нижний край экрана или применить это положение для всех пользователей."
                                               width="100%"
                                               stylename="settings-section-help edit-help"/>
                                        <vbox id="llmChatButtonActions" spacing="true">
                                            <button id="resetMyLlmChatPositionBtn"
                                                    caption="Переместить в правый нижний край"
                                                    invoke="resetMyLlmChatPosition"
                                                    stylename="primary"/>
                                            <button id="resetAllUsersLlmChatPositionBtn"
                                                    caption="Переместить у всех пользователей в правый нижний край"
                                                    invoke="resetAllUsersLlmChatPosition"
                                                    stylename="secondary"/>
                                        </vbox>
                                    </vbox>
                                </vbox>
                            </vbox>
                        </scrollBox>
                    </tab>
                </tabSheet>
            </vbox>
        </hbox>
    </layout>
</window>
