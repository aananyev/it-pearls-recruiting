<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/window.xsd"
        xmlns:ext="http://schemas.haulmont.com/cuba/window-ext.xsd"
        class="com.company.hunttech.web.screens.extsettingswindow.ExtSettingsWindow"
        caption="msg://msgSettings"
        messagesPack="com.company.hunttech.web.screens.extsettingswindow">
    <dsContext>
        <!-- Legacy datasource-контракты сохраняются, чтобы не менять логику базового SettingsWindow. -->
        <datasource id="userSettingsDs"
                    view="userSettings-view"
                    class="com.company.hunttech.entity.UserSettings"
                    allowCommit="true"/>
        <datasource id="extUserDs"
                    class="com.company.hunttech.entity.ExtUser"
                    view="extUser-view"
                    allowCommit="true"/>
        <!-- Профессиональный ИИ-профиль редактируется в том же dsContext и сохраняется атомарно контроллером. -->
        <datasource id="userAiProfileDs"
                    class="com.company.hunttech.entity.UserAiProfile"
                    view="userAiProfile-view"
                    allowCommit="true"/>
        <!-- Персональные AI-подключения ограничены текущим пользователем через extUserDs. -->
        <collectionDatasource id="userAiConfigsDs"
                              class="com.company.hunttech.entity.UserAiConfiguration"
                              view="userAiConfiguration-view">
            <query><![CDATA[select e from hunttech_UserAiConfiguration e where e.user = :ds$extUserDs]]></query>
        </collectionDatasource>
    </dsContext>

    <!-- Полновысотный Split-View: фиксированный сайдбар слева на всю высоту экрана, TabSheet и рабочая область справа -->
    <layout expand="settingsMainLayout" stylename="ext-settings-window edit-screen-layout" spacing="false" width="100%" height="100%">
        <hbox id="settingsMainLayout" width="100%" height="100%" spacing="false" expand="settingsWorkspaceBox" stylename="edit-screen-layout">
            <!-- ЛЕВЫЙ САЙДБАР (270px) НА ВСЮ ВЫСОТУ ЭКРАНА -->
            <vbox id="userAiProfileSidebar"
                  width="270px"
                  height="100%"
                  spacing="false"
                  stylename="user-ai-profile-sidebar edit-sidebar">
                <scrollBox id="sidebarScrollBox" width="100%" height="100%" orientation="vertical" scrollBars="vertical">
                    <vbox width="100%" spacing="true">
                        <!-- DropZone & Avatar -->
                        <vbox id="dropZone"
                              spacing="true"
                              width="200px"
                              height="236px"
                              align="TOP_CENTER"
                              expand="picVBox"
                              stylename="dropzone-container user-ai-profile-avatar edit-sidebar-visual">
                            <vbox id="picVBox" align="TOP_CENTER" spacing="true">
                                <ovaFallbackImage id="userPic"
                                                  width="176px"
                                                  height="176px"
                                                  ovalWidth="176px"
                                                  ovalHeight="176px"
                                                  fallbackThemePath="icons/no-programmer.jpeg"
                                                  visible="true"
                                                  align="TOP_CENTER"
                                                  scaleMode="SCALE_DOWN"/>
                                <image id="defaultPic" width="100%" visible="false" align="TOP_CENTER" stylename="widget-border" scaleMode="FILL">
                                    <theme path="icons/no-programmer.jpeg"/>
                                </image>
                            </vbox>
                            <upload id="userAvatarUpload"
                                    fileStoragePutMode="IMMEDIATE"
                                    datasource="extUserDs"
                                    property="userAvatar"
                                    align="BOTTOM_CENTER"
                                    width="100%"
                                    showFileName="false"
                                    dropZone="dropZone"
                                    showClearButton="true"/>
                        </vbox>
                        
                        <!-- Идентификация пользователя -->
                        <vbox id="userAiProfileIdentity" width="100%" spacing="false" stylename="user-ai-profile-identity edit-sidebar-identity">
                            <label id="userProfileNameLabel" width="100%" stylename="h2 user-ai-profile-name edit-sidebar-title" align="MIDDLE_CENTER"/>
                            <label id="currentPositionSidebarLabel" width="100%" stylename="h4 user-ai-profile-position edit-sidebar-subtitle" align="MIDDLE_CENTER"/>
                        </vbox>
                        
                        <!-- Сводка и статус -->
                        <vbox id="userAiProfileSummary" width="100%" spacing="true" stylename="user-ai-profile-summary edit-sidebar-summary">
                            <label id="profileStatusLabel" width="100%" stylename="user-ai-profile-status"/>
                            <label id="profileCompletionLabel" width="100%" stylename="h4 user-ai-profile-summary-value"/>
                            <label id="profileConfirmedAtLabel" width="100%" stylename="h4 user-ai-profile-summary-value"/>
                        </vbox>

                        <!-- Навигация: Профиль и ИИ -->
                        <vbox id="userAiProfileSectionNavigation" width="100%" spacing="false" stylename="user-ai-profile-navigation label-navigation">
                            <label width="100%" value="msg://aiProfileNavigationTitle" stylename="label-nav-title job-candidate-section-title user-ai-profile-navigation-title" align="MIDDLE_CENTER"/>
                            <label width="100%" value="msg://professionalProfile" stylename="user-ai-profile-nav-item user-ai-profile-nav-item-active label-nav-item label-nav-item-active"/>
                            <label width="100%" value="msg://recruitingProfile" stylename="user-ai-profile-nav-item label-nav-item"/>
                            <label width="100%" value="msg://responsePreferences" stylename="user-ai-profile-nav-item label-nav-item"/>
                            <label width="100%" value="msg://goalsAndInterests" stylename="user-ai-profile-nav-item label-nav-item"/>
                            <label width="100%" value="msg://privacyAndBoundaries" stylename="user-ai-profile-nav-item label-nav-item"/>
                            <label width="100%" value="msg://aiContextPreview" stylename="user-ai-profile-nav-item label-nav-item"/>
                        </vbox>

                        <!-- Навигация: Интерфейс -->
                        <vbox id="interfaceSettingsNavigation" width="100%" spacing="false" stylename="settings-section-navigation label-navigation">
                            <label value="msg://interfaceSettingsNavigationTitle" width="100%" stylename="label-nav-title job-candidate-section-title settings-section-navigation-title" align="MIDDLE_CENTER"/>
                            <label value="msg://interfaceSettingsWindowSection" width="100%" stylename="settings-section-nav-item settings-section-nav-item-active label-nav-item label-nav-item-active"/>
                            <label value="msg://interfaceSettingsAppearanceSection" width="100%" stylename="settings-section-nav-item label-nav-item"/>
                            <label value="msg://interfaceSettingsRegionalSection" width="100%" stylename="settings-section-nav-item label-nav-item"/>
                            <label value="msg://interfaceSettingsStartupSection" width="100%" stylename="settings-section-nav-item label-nav-item"/>
                        </vbox>

                        <!-- Навигация: Почта -->
                        <vbox id="emailSettingsNavigation" width="100%" spacing="false" stylename="settings-section-navigation label-navigation">
                            <label value="msg://emailSettingsNavigationTitle" width="100%" stylename="label-nav-title job-candidate-section-title settings-section-navigation-title" align="MIDDLE_CENTER"/>
                            <label value="msg://emailSettingsSmtpSection" width="100%" stylename="settings-section-nav-item settings-section-nav-item-active label-nav-item label-nav-item-active"/>
                            <label value="msg://emailSettingsPop3Section" width="100%" stylename="settings-section-nav-item label-nav-item"/>
                            <label value="msg://emailSettingsImapSection" width="100%" stylename="settings-section-nav-item label-nav-item"/>
                        </vbox>

                        <!-- Навигация: ИИ Подключения -->
                        <vbox id="aiSettingsNavigation" width="100%" spacing="false" stylename="ai-settings-navigation label-navigation">
                            <label value="msg://aiSettingsNavigationTitle" width="100%" stylename="label-nav-title job-candidate-section-title ai-settings-navigation-title" align="MIDDLE_CENTER"/>
                            <label value="msg://aiSettingsSourceSection" width="100%" stylename="ai-settings-nav-item ai-settings-nav-item-active label-nav-item label-nav-item-active"/>
                            <label value="msg://aiSettingsConnectionsSection" width="100%" stylename="ai-settings-nav-item label-nav-item"/>
                        </vbox>

                        <!-- Навигация: Geo-API -->
                        <vbox id="geoSettingsNavigation" width="100%" spacing="false" stylename="ai-settings-navigation label-navigation">
                            <label value="msg://geoSettingsNavigationTitle" width="100%" stylename="label-nav-title job-candidate-section-title ai-settings-navigation-title" align="MIDDLE_CENTER"/>
                            <label value="msg://geoSettingsDaDataSection" width="100%" stylename="ai-settings-nav-item ai-settings-nav-item-active label-nav-item label-nav-item-active"/>
                        </vbox>

                        <!-- Предупреждение о безопасности -->
                        <vbox id="userAiProfileSensitiveWarningBox" width="100%" spacing="false" stylename="user-ai-profile-sensitive-warning">
                            <label width="100%" value="msg://aiProfileSensitiveDataWarning" stylename="user-ai-profile-help"/>
                        </vbox>

                        <!-- Фиксированный спейсер отступа внизу сайдбара -->
                        <vbox id="userAiProfileSidebarSpacer" width="100%" height="16px" stylename="edit-sidebar-spacer"/>
                    </vbox>
                </scrollBox>
            </vbox>

            <!-- ПРАВАЯ РАБОЧАЯ ОБЛАСТЬ С TABSHEET НА ВСЮ ШИРИНУ -->
            <vbox id="settingsWorkspaceBox" width="100%" height="100%" spacing="false" expand="settingsTabSheet" stylename="edit-workspace settings-workspace">
                <tabSheet id="settingsTabSheet" width="100%" height="100%" stylename="framed ext-settings-tabs">
                    
                    <!-- ВКЛАДКА 1: ПРОФИЛЬ И ИИ -->
                    <tab id="msgMyInfo" caption="msg://msgMyInfo" margin="false" spacing="true">
                        <scrollBox id="userAiProfileContentScrollBox"
                                   width="100%"
                                   height="100%"
                                   orientation="vertical"
                                   scrollBars="vertical"
                                   stylename="user-ai-profile-content edit-workspace edit-workspace-scroll">
                            <vbox id="userAiProfileContent" width="100%" spacing="true" stylename="edit-workspace-content">
                                <hbox id="userAiProfileToolbar" width="100%" spacing="true" expand="userAiProfileTitleBox" stylename="user-ai-profile-toolbar edit-toolbar">
                                    <vbox id="userAiProfileTitleBox" width="100%" spacing="false">
                                        <label value="msg://aiProfileTitle" stylename="h1"/>
                                        <label value="msg://aiProfileDescription" width="100%" stylename="user-ai-profile-help"/>
                                    </vbox>
                                    <hbox id="userAiProfileToolbarActions" spacing="true" align="MIDDLE_RIGHT" stylename="user-ai-profile-toolbar-actions edit-toolbar-actions">
                                        <button id="previewAiContextBtn" caption="msg://previewAiContext" stylename="primary" invoke="previewAiContext"/>
                                        <button id="clearAiProfileBtn" caption="msg://clearAiProfile" stylename="danger" invoke="clearAiProfile"/>
                                    </hbox>
                                </hbox>
                                <vbox id="userAiProfileToolbarSpacer" width="100%" height="8px"/>
                                
                                <groupBox id="professionalProfileGroup" caption="msg://professionalProfile" width="100%" spacing="true" margin="true" collapsable="true" collapsed="false" showAsPanel="true" stylename="user-ai-profile-section edit-accordion-section">
                                    <grid width="100%" spacing="true">
                                        <columns><column flex="1"/><column flex="1"/></columns>
                                        <rows>
                                            <row>
                                                <textField id="currentPositionField" datasource="userAiProfileDs" property="currentPosition" caption="msg://currentPosition" maxLength="255" width="100%"/>
                                                <lookupField id="functionalRoleField" datasource="userAiProfileDs" property="functionalRole" caption="msg://functionalRole" width="100%"/>
                                            </row>
                                            <row>
                                                <lookupField id="seniorityLevelField" datasource="userAiProfileDs" property="seniorityLevel" caption="msg://seniorityLevel" width="100%"/>
                                                <textField id="professionalExperienceYearsField" datasource="userAiProfileDs" property="professionalExperienceYears" caption="msg://professionalExperienceYears" width="100%"/>
                                            </row>
                                            <row>
                                                <textField id="recruitingExperienceYearsField" datasource="userAiProfileDs" property="recruitingExperienceYears" caption="msg://recruitingExperienceYears" width="100%" colspan="2"/>
                                            </row>
                                            <row><textArea id="aboutMeField" datasource="userAiProfileDs" property="aboutMe" caption="msg://aboutMe" maxLength="2000" rows="3" width="100%" colspan="2"/></row>
                                            <row>
                                                <textArea id="currentResponsibilitiesField" datasource="userAiProfileDs" property="currentResponsibilities" caption="msg://currentResponsibilities" maxLength="4000" rows="3" width="100%"/>
                                                <textArea id="educationField" datasource="userAiProfileDs" property="education" caption="msg://education" maxLength="4000" rows="3" width="100%"/>
                                            </row>
                                            <row>
                                                <textArea id="certificationsField" datasource="userAiProfileDs" property="certifications" caption="msg://certifications" maxLength="4000" rows="3" width="100%"/>
                                                <textArea id="domainExpertiseField" datasource="userAiProfileDs" property="domainExpertise" caption="msg://domainExpertise" maxLength="4000" rows="3" width="100%"/>
                                            </row>
                                            <row><textArea id="industriesField" datasource="userAiProfileDs" property="industries" caption="msg://industries" maxLength="4000" rows="2" width="100%" colspan="2"/></row>
                                        </rows>
                                    </grid>
                                </groupBox>

                                <groupBox id="recruitingProfileGroup" caption="msg://recruitingProfile" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="user-ai-profile-section edit-accordion-section">
                                    <grid width="100%" spacing="true">
                                        <columns><column flex="1"/><column flex="1"/></columns>
                                        <rows>
                                            <row>
                                                <textArea id="recruitingSpecializationsField" datasource="userAiProfileDs" property="recruitingSpecializations" caption="msg://recruitingSpecializations" maxLength="4000" rows="3" width="100%"/>
                                                <textArea id="targetRolesField" datasource="userAiProfileDs" property="targetRoles" caption="msg://targetRoles" maxLength="4000" rows="3" width="100%"/>
                                            </row>
                                            <row>
                                                <textField id="candidateLevelsField" datasource="userAiProfileDs" property="candidateLevels" caption="msg://candidateLevels" maxLength="255" width="100%"/>
                                                <textArea id="hiringGeographiesField" datasource="userAiProfileDs" property="hiringGeographies" caption="msg://hiringGeographies" maxLength="2000" rows="2" width="100%"/>
                                            </row>
                                            <row>
                                                <textArea id="decisionPrioritiesField" datasource="userAiProfileDs" property="decisionPriorities" caption="msg://decisionPriorities" maxLength="4000" rows="3" width="100%"/>
                                                <textArea id="clientAndProjectContextField" datasource="userAiProfileDs" property="clientAndProjectContext" caption="msg://clientAndProjectContext" maxLength="4000" rows="3" width="100%"/>
                                            </row>
                                        </rows>
                                    </grid>
                                </groupBox>

                                <groupBox id="responsePreferencesGroup" caption="msg://responsePreferences" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="user-ai-profile-section edit-accordion-section">
                                    <grid width="100%" spacing="true">
                                        <columns><column flex="1"/><column flex="1"/></columns>
                                        <rows>
                                            <row>
                                                <lookupField id="preferredLanguageField" datasource="userAiProfileDs" property="preferredLanguage" caption="msg://preferredLanguage" width="100%"/>
                                                <lookupField id="responseDetailLevelField" datasource="userAiProfileDs" property="responseDetailLevel" caption="msg://responseDetailLevel" width="100%"/>
                                            </row>
                                            <row>
                                                <lookupField id="communicationStyleField" datasource="userAiProfileDs" property="communicationStyle" caption="msg://communicationStyle" width="100%"/>
                                                <lookupField id="terminologyLevelField" datasource="userAiProfileDs" property="terminologyLevel" caption="msg://terminologyLevel" width="100%"/>
                                            </row>
                                            <row><lookupField id="preferredAnswerStructureField" datasource="userAiProfileDs" property="preferredAnswerStructure" caption="msg://preferredAnswerStructure" width="100%" colspan="2"/></row>
                                            <row>
                                                <textArea id="customAiInstructionsField" datasource="userAiProfileDs" property="customAiInstructions" caption="msg://customAiInstructions" description="msg://customAiInstructionsDescription" maxLength="4000" rows="3" width="100%"/>
                                                <textArea id="communicationConstraintsField" datasource="userAiProfileDs" property="communicationConstraints" caption="msg://communicationConstraints" maxLength="2000" rows="3" width="100%"/>
                                            </row>
                                        </rows>
                                    </grid>
                                </groupBox>

                                <groupBox id="goalsGroup" caption="msg://goalsAndInterests" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="user-ai-profile-section edit-accordion-section">
                                    <grid width="100%" spacing="true">
                                        <columns><column flex="1"/><column flex="1"/></columns>
                                        <rows>
                                            <row>
                                                <textArea id="professionalGoalsField" datasource="userAiProfileDs" property="professionalGoals" caption="msg://professionalGoals" maxLength="4000" rows="3" width="100%"/>
                                                <textArea id="professionalInterestsField" datasource="userAiProfileDs" property="professionalInterests" caption="msg://professionalInterests" maxLength="4000" rows="3" width="100%"/>
                                            </row>
                                            <row>
                                                <textArea id="developmentAreasField" datasource="userAiProfileDs" property="developmentAreas" caption="msg://developmentAreas" maxLength="4000" rows="3" width="100%"/>
                                                <textArea id="currentPrioritiesField" datasource="userAiProfileDs" property="currentPriorities" caption="msg://currentPriorities" maxLength="4000" rows="3" width="100%"/>
                                            </row>
                                        </rows>
                                    </grid>
                                </groupBox>

                                <groupBox id="privacyGroup" caption="msg://privacyAndBoundaries" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="user-ai-profile-section user-ai-profile-privacy edit-accordion-section">
                                    <vbox width="100%" spacing="true">
                                        <checkBox id="profileEnabledField" datasource="userAiProfileDs" property="profileEnabled" caption="msg://profileEnabled"/>
                                        <checkBox id="externalProcessingAllowedField" datasource="userAiProfileDs" property="externalProcessingAllowed" caption="msg://externalProcessingAllowed"/>
                                        <label value="msg://externalProcessingConsentText" width="100%" stylename="user-ai-profile-help"/>
                                        <label id="consentAcceptedAtLabel" width="100%" stylename="h4"/>
                                    </vbox>
                                </groupBox>

                                <groupBox id="previewGroup" caption="msg://aiContextPreview" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="user-ai-profile-section edit-accordion-section">
                                    <textArea id="aiContextPreviewArea" width="100%" rows="10" editable="false" stylename="user-ai-profile-preview"/>
                                </groupBox>
                            </vbox>
                        </scrollBox>
                    </tab>

                    <!-- ВКЛАДКА 2: ИНТЕРФЕЙС -->
                    <tab id="msgInterface" caption="msg://msgInterface" margin="false" spacing="true">
                        <scrollBox id="interfaceSettingsContentScrollBox"
                                   width="100%"
                                   height="100%"
                                   orientation="vertical"
                                   scrollBars="vertical"
                                   stylename="settings-section-content edit-workspace edit-workspace-scroll">
                            <vbox id="interfaceSettingsContent" width="100%" spacing="true" stylename="edit-workspace-content">
                                <hbox id="interfaceSettingsToolbar"
                                      width="100%"
                                      spacing="true"
                                      expand="interfaceSettingsTitleBox"
                                      stylename="settings-section-toolbar edit-toolbar">
                                    <vbox id="interfaceSettingsTitleBox" width="100%" spacing="false">
                                        <label value="msg://interfaceSettingsPageTitle" stylename="h1"/>
                                        <label value="msg://interfaceSettingsPageDescription" width="100%" stylename="settings-section-help"/>
                                    </vbox>
                                    <buttonsPanel id="interfaceSettingsToolbarActions"
                                                  align="BOTTOM_RIGHT"
                                                  stylename="settings-section-toolbar-actions edit-toolbar-actions">
                                        <button id="changePasswordBtn" icon="icons/change-pass.png"/>
                                        <button id="resetScreenSettingsBtn" icon="icons/trash.png" stylename="danger"/>
                                    </buttonsPanel>
                                </hbox>
                                <vbox id="interfaceAppearanceCard"
                                      width="100%"
                                      spacing="true"
                                      stylename="settings-section-card interface-settings-card edit-card">
                                    <vbox id="interfaceAppearanceHeader" width="100%" spacing="false">
                                        <label value="msg://interfaceSettingsAppearanceTitle" stylename="h3 settings-section-card-title edit-card-title"/>
                                        <label value="msg://interfaceSettingsAppearanceDescription" width="100%" stylename="settings-section-help"/>
                                    </vbox>
                                    <grid id="grid" spacing="true" width="100%">
                                        <columns><column flex="0"/><column flex="1"/></columns>
                                        <rows>
                                            <row><label id="mainWindowLabel" value="msg://mainWindowMode" align="MIDDLE_LEFT"/><optionsGroup id="modeOptions"/></row>
                                            <row><label id="visualThemeLabel" value="msg://mainWindowTheme" align="MIDDLE_LEFT"/><lookupField id="appThemeField" required="true" width="100%" requiredMessage="msg://mainWindowThemeMsg"/></row>
                                            <row><label id="languageLabel" value="msg://mainWindowLang" align="MIDDLE_LEFT"/><lookupField id="appLangField" width="100%"/></row>
                                            <row>
                                                <label id="timeZoneLabel" value="msg://com.haulmont.cuba.security.entity/User.timeZone" align="MIDDLE_LEFT"/>
                                                <hbox id="timeZoneBox" spacing="true" width="100%" expand="timeZoneLookup">
                                                    <lookupField id="timeZoneLookup" width="100%"/>
                                                    <checkBox id="timeZoneAutoField" align="MIDDLE_LEFT"/>
                                                </hbox>
                                            </row>
                                            <row><label id="defaultScreenLabel" value="msg://defaultScreen" align="MIDDLE_LEFT"/><lookupField id="defaultScreenField" description="msg://defaultScreenDescription" newOptionAllowed="false" nullName="msg://noDefaultScreen" width="100%"/></row>
                                        </rows>
                                    </grid>
                                </vbox>
                            </vbox>
                        </scrollBox>
                    </tab>

                    <!-- ВКЛАДКА 3: ПОЧТА -->
                    <tab id="mailAccessTab" caption="msg://msgEmailSettings" margin="false" spacing="true">
                        <scrollBox id="emailSettingsContentScrollBox"
                                   width="100%"
                                   height="100%"
                                   orientation="vertical"
                                   scrollBars="vertical"
                                   stylename="settings-section-content edit-workspace edit-workspace-scroll">
                            <vbox id="emailSettingsContent" width="100%" spacing="true" stylename="edit-workspace-content">
                                <hbox id="emailSettingsToolbar"
                                      width="100%"
                                      spacing="true"
                                      expand="emailSettingsTitleBox"
                                      stylename="settings-section-toolbar edit-toolbar">
                                    <vbox id="emailSettingsTitleBox" width="100%" spacing="false">
                                        <label value="msg://emailSettingsPageTitle" stylename="h1"/>
                                        <label value="msg://emailSettingsPageDescription" width="100%" stylename="settings-section-help"/>
                                    </vbox>
                                </hbox>
                                <vbox id="emailSettingsToolbarSpacer" width="100%" height="8px"/>
                                <vbox id="emailSettingsAccordion" width="100%" spacing="true">
                                    <groupBox id="smtpSettingsSection"
                                              caption="SMTP"
                                              width="100%"
                                              spacing="true"
                                              margin="true"
                                              collapsable="true"
                                              collapsed="false"
                                              showAsPanel="true"
                                              stylename="user-ai-profile-section edit-accordion-section">
                                        <vbox id="smtpSettingsCard" width="100%" spacing="true">
                                            <label value="msg://emailSettingsSmtpDescription" width="100%" stylename="settings-section-help"/>
                                            <textField id="smtpServer" caption="SMTP server" width="100%"/>
                                            <textField id="smtpPort" datatype="int" caption="SMTP port" width="100%">
                                                <validator class="com.haulmont.cuba.gui.components.validators.IntegerValidator"/>
                                            </textField>
                                            <checkBox id="smtpPasswordRequired" caption="msg://msgSMTPPasswordRequired"/>
                                            <textField id="smtpPassword" caption="SMTP password" width="100%"/>
                                        </vbox>
                                    </groupBox>
                                    <groupBox id="pop3SettingsSection"
                                              caption="POP3"
                                              width="100%"
                                              spacing="true"
                                              margin="true"
                                              collapsable="true"
                                              collapsed="true"
                                              showAsPanel="true"
                                              stylename="user-ai-profile-section edit-accordion-section">
                                        <vbox id="pop3SettingsCard" width="100%" spacing="true">
                                            <label value="msg://emailSettingsPop3Description" width="100%" stylename="settings-section-help"/>
                                            <textField id="pop3Server" caption="POP3 server" width="100%"/>
                                            <textField id="pop3Port" datatype="int" caption="POP3 port" width="100%">
                                                <validator class="com.haulmont.cuba.gui.components.validators.IntegerValidator"/>
                                            </textField>
                                            <checkBox id="pop3PasswordRequired" caption="msg://msgPop3PasswordRequired"/>
                                            <textField id="pop3Password" caption="POP3 password" width="100%"/>
                                        </vbox>
                                    </groupBox>
                                    <groupBox id="imapSettingsSection"
                                              caption="IMAP"
                                              width="100%"
                                              spacing="true"
                                              margin="true"
                                              collapsable="true"
                                              collapsed="true"
                                              showAsPanel="true"
                                              stylename="user-ai-profile-section edit-accordion-section">
                                        <vbox id="imapSettingsCard" width="100%" spacing="true">
                                            <label value="msg://emailSettingsImapDescription" width="100%" stylename="settings-section-help"/>
                                            <textField id="imapServer" caption="IMAP server" width="100%"/>
                                            <textField id="imapPort" datatype="int" caption="IMAP port" width="100%">
                                                <validator class="com.haulmont.cuba.gui.components.validators.IntegerValidator"/>
                                            </textField>
                                            <checkBox id="imapPasswordRequired" caption="msg://msgImapPasswordRequired"/>
                                            <textField id="imapPassword" caption="IMAP password" width="100%"/>
                                        </vbox>
                                    </groupBox>
                                </vbox>
                            </vbox>
                        </scrollBox>
                    </tab>

                    <!-- ВКЛАДКА 4: ИИ НАСТРОЙКИ -->
                    <tab id="aiAccessTab" caption="msg://msgAiSettings" margin="false" spacing="true">
                        <scrollBox id="aiSettingsContentScrollBox"
                                   width="100%"
                                   height="100%"
                                   orientation="vertical"
                                   scrollBars="vertical"
                                   stylename="settings-section-content edit-workspace edit-workspace-scroll">
                            <vbox id="aiSettingsContent"
                                  width="100%"
                                  spacing="true"
                                  stylename="ai-settings-content edit-workspace-content">
                                <hbox id="aiSettingsToolbar"
                                      width="100%"
                                      spacing="true"
                                      expand="aiSettingsTitleBox"
                                      stylename="ai-settings-toolbar edit-toolbar">
                                    <vbox id="aiSettingsTitleBox" width="100%" spacing="false">
                                        <label value="msg://aiSettingsPageTitle" stylename="h1"/>
                                        <label value="msg://aiSettingsPageDescription" width="100%" stylename="ai-settings-help"/>
                                    </vbox>
                                    <hbox id="aiConfigsButtonsPanel" spacing="true" align="MIDDLE_RIGHT" stylename="ai-settings-toolbar-actions edit-toolbar-actions">
                                        <button id="aiConfigsCreateBtn" caption="msg://actions.Create" icon="CREATE_ACTION" invoke="onAiConfigsCreateBtnClick"/>
                                        <button id="aiConfigsEditBtn" caption="msg://actions.Edit" icon="EDIT" enable="false" invoke="onAiConfigsEditBtnClick"/>
                                        <button id="aiConfigsRemoveBtn" caption="msg://actions.Remove" icon="REMOVE" enable="false" invoke="onAiConfigsRemoveBtnClick"/>
                                        <button id="aiConfigsTestBtn" caption="msg://msgAiTestConnection" icon="KEY" enable="false" invoke="onAiConfigsTestBtnClick"/>
                                    </hbox>
                                </hbox>
                                <vbox id="personalAiApiPreferenceBox"
                                      spacing="true"
                                      width="100%"
                                      stylename="ai-settings-card ai-settings-preference-card edit-card">
                                    <label value="msg://aiSettingsPreferenceTitle" stylename="h3 ai-settings-card-title edit-card-title"/>
                                    <checkBox id="preferPersonalAiApiSettingsField"
                                              datasource="userSettingsDs"
                                              property="preferPersonalAiApiSettings"
                                              caption="msg://preferPersonalAiApiSettings"
                                              stylename="ai-settings-preference-checkbox"/>
                                    <label value="msg://preferPersonalAiApiSettingsHint" width="100%" stylename="ai-settings-help"/>
                                    <checkBox id="preferPersonalPromptsField"
                                              datasource="userSettingsDs"
                                              property="preferPersonalPrompts"
                                              caption="msg://preferPersonalPrompts"
                                              stylename="ai-settings-preference-checkbox"/>
                                    <label value="msg://preferPersonalPromptsHint" width="100%" stylename="ai-settings-help"/>
                                </vbox>
                                <vbox id="aiConnectionsCard"
                                      width="100%"
                                      height="360px"
                                      spacing="true"
                                      expand="aiConfigsTable"
                                      stylename="ai-settings-card ai-settings-connections-card edit-card">
                                    <vbox id="aiConnectionsHeader" width="100%" spacing="false">
                                        <label value="msg://aiSettingsConnectionsTitle" stylename="h3 ai-settings-card-title edit-card-title"/>
                                        <label value="msg://aiSettingsConnectionsDescription" width="100%" stylename="ai-settings-help"/>
                                    </vbox>
                                    <table id="aiConfigsTable"
                                           width="100%"
                                           height="100%"
                                           editable="false"
                                           stylename="ai-settings-table">
                                        <columns><column id="providerCode"/><column id="defaultModelName"/><column id="isActive"/></columns>
                                        <rows datasource="userAiConfigsDs"/>
                                    </table>
                                </vbox>
                            </vbox>
                        </scrollBox>
                    </tab>

                    <!-- ВКЛАДКА 5: GEO API -->
                    <tab id="geoApiAccessTab" caption="msg://msgGeoApiSettings" margin="false" spacing="true">
                        <scrollBox id="geoSettingsContentScrollBox"
                                   width="100%"
                                   height="100%"
                                   orientation="vertical"
                                   scrollBars="vertical"
                                   stylename="settings-section-content edit-workspace edit-workspace-scroll">
                            <vbox id="geoSettingsContent"
                                  width="100%"
                                  spacing="true"
                                  stylename="ai-settings-content edit-workspace-content">
                                <hbox id="geoSettingsToolbar"
                                      width="100%"
                                      spacing="true"
                                      expand="geoSettingsTitleBox"
                                      stylename="ai-settings-toolbar edit-toolbar">
                                    <vbox id="geoSettingsTitleBox" width="100%" spacing="false">
                                        <label value="msg://geoSettingsPageTitle" stylename="h1"/>
                                        <label value="msg://geoSettingsPageDescription" width="100%" stylename="ai-settings-help"/>
                                    </vbox>
                                    <buttonsPanel id="geoButtonsPanel" align="BOTTOM_RIGHT" stylename="edit-toolbar-actions">
                                        <button id="testGeoApiBtn"
                                                caption="msg://msgTestGeoConnection"
                                                icon="KEY"
                                                stylename="friendly"
                                                invoke="onTestGeoApiBtnClick"/>
                                    </buttonsPanel>
                                </hbox>
                                <vbox id="geoDaDataCard"
                                      spacing="true"
                                      width="100%"
                                      stylename="ai-settings-card edit-card">
                                    <label value="msg://geoDaDataCardTitle" stylename="h3 ai-settings-card-title edit-card-title"/>
                                    <form id="geoSettingsForm" datasource="userSettingsDs" width="100%">
                                        <column width="100%">
                                            <passwordField id="geoApiKeyField"
                                                           property="geoApiKey"
                                                           caption="msg://msgGeoApiKey"
                                                           width="100%"
                                                           stylename="edit-form-control"/>
                                            <passwordField id="geoApiSecretField"
                                                           property="geoApiSecret"
                                                           caption="msg://msgGeoApiSecret"
                                                           width="100%"
                                                           stylename="edit-form-control"/>
                                            <textField id="geoApiUrlField"
                                                       property="geoApiUrl"
                                                       caption="msg://msgGeoApiUrl"
                                                       width="100%"
                                                       stylename="edit-form-control"
                                                       inputPrompt="https://suggestions.dadata.ru/suggestions/api/4_1/rs"/>
                                        </column>
                                    </form>
                                </vbox>
                                <vbox id="geoOptionsCard"
                                      spacing="true"
                                      width="100%"
                                      stylename="ai-settings-card edit-card">
                                    <label value="msg://geoOptionsCardTitle" stylename="h3 ai-settings-card-title edit-card-title"/>
                                    <checkBox id="geoAutoFetchFlagsField"
                                              datasource="userSettingsDs"
                                              property="geoAutoFetchFlags"
                                              caption="msg://msgGeoAutoFetchFlags"
                                              stylename="ai-settings-preference-checkbox"/>
                                    <label value="msg://msgGeoAutoFetchFlagsHint" width="100%" stylename="ai-settings-help"/>
                                </vbox>
                            </vbox>
                        </scrollBox>
                    </tab>
                </tabSheet>
                
                <!-- НИЖНИЙ ПАНЕЛЬ ДЕЙСТВИЙ (FOOTER) -->
                <hbox id="buttons" width="100%" spacing="true" align="MIDDLE_RIGHT" stylename="edit-footer-actions ext-settings-footer" expand="buttonsSpacer">
                    <vbox id="buttonsSpacer" width="100%"/>
                    <buttonsPanel align="MIDDLE_RIGHT">
                        <button id="okBtn" icon="icons/ok.png" caption="msg://actions.Ok" stylename="primary"/>
                        <button id="cancelBtn" icon="icons/cancel.png" caption="msg://actions.Cancel" stylename="secondary"/>
                    </buttonsPanel>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>
