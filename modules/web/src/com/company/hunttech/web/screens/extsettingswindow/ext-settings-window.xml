<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/window.xsd"
        xmlns:ext="http://schemas.haulmont.com/cuba/window-ext.xsd"
        class="com.company.hunttech.web.screens.extsettingswindow.ExtSettingsWindow"
        caption="msg://msgSettings"
        messagesPack="com.company.hunttech.web.screens.extsettingswindow">
    <dsContext>
        <!-- Legacy datasource-контракты сохраняются, чтобы не менять логику базового SettingsWindow. -->
        <datasource id="userSettingsDs"
                    view="userSettings-view"
                    class="com.company.hunttech.entity.UserSettings"
                    allowCommit="true"/>
        <datasource id="extUserDs"
                    class="com.company.hunttech.entity.ExtUser"
                    view="extUser-view"
                    allowCommit="true"/>
        <!-- Профессиональный ИИ-профиль редактируется в том же dsContext и сохраняется атомарно контроллером. -->
        <datasource id="userAiProfileDs"
                    class="com.company.hunttech.entity.UserAiProfile"
                    view="userAiProfile-view"
                    allowCommit="true"/>
        <!-- Персональные AI-подключения ограничены текущим пользователем через extUserDs. -->
        <collectionDatasource id="userAiConfigsDs"
                              class="com.company.hunttech.entity.UserAiConfiguration"
                              view="userAiConfiguration-view">
            <query><![CDATA[select e from hunttech_UserAiConfiguration e where e.user = :ds$extUserDs]]></query>
        </collectionDatasource>
    </dsContext>
    <!-- Локальный корневой класс ограничивает визуальные правила экраном настроек
         и предотвращает влияние на остальные формы HRM HuntTech. -->
    <layout expand="settingsTabSheet" stylename="ext-settings-window">
        <tabSheet id="settingsTabSheet" width="100%" height="100%" stylename="framed ext-settings-tabs">
            <tab id="msgMyInfo" caption="msg://msgMyInfo" margin="true" spacing="true">
                <!-- Двухпанельная компоновка повторяет утверждённое направление JobCandidateEdit:
                     фиксированный профиль слева и прокручиваемые карточки справа. -->
                <hbox id="userAiProfileMainBox"
                      width="100%"
                      height="100%"
                      spacing="true"
                      expand="userAiProfileContentScrollBox"
                      stylename="user-ai-profile-editor">
                    <vbox id="userAiProfileSidebar"
                          width="270px"
                          height="100%"
                          spacing="true"
                          expand="userAiProfileSidebarSpacer"
                          stylename="user-ai-profile-sidebar">
                        <!-- Существующие component ID аватара являются контрактом контроллера и не переименовываются. -->
                        <vbox id="dropZone"
                              spacing="true"
                              width="200px"
                              height="236px"
                              align="TOP_CENTER"
                              expand="picVBox"
                              stylename="dropzone-container user-ai-profile-avatar">
                            <vbox id="picVBox" align="TOP_CENTER" spacing="true">
                                <image id="userPic" width="100%" height="100%" visible="true" align="TOP_CENTER" stylename="widget-border" scaleMode="FILL"/>
                                <image id="defaultPic" width="100%" visible="false" align="TOP_CENTER" stylename="widget-border" scaleMode="FILL">
                                    <theme path="icons/no-programmer.jpeg"/>
                                </image>
                            </vbox>
                            <upload id="userAvatarUpload"
                                    fileStoragePutMode="IMMEDIATE"
                                    datasource="extUserDs"
                                    property="userAvatar"
                                    align="BOTTOM_CENTER"
                                    width="100%"
                                    showFileName="false"
                                    dropZone="dropZone"
                                    showClearButton="true"/>
                        </vbox>
                        <vbox id="userAiProfileIdentity" width="100%" spacing="false" stylename="user-ai-profile-identity">
                            <label id="userProfileNameLabel" width="100%" stylename="h2 user-ai-profile-name" align="MIDDLE_CENTER"/>
                            <label id="currentPositionSidebarLabel" width="100%" stylename="h4 user-ai-profile-position" align="MIDDLE_CENTER"/>
                        </vbox>
                        <vbox id="userAiProfileSummary" width="100%" spacing="true" stylename="user-ai-profile-summary">
                            <label id="profileStatusLabel" width="100%" stylename="user-ai-profile-status"/>
                            <label id="profileCompletionLabel" width="100%" stylename="h4 user-ai-profile-summary-value"/>
                            <label id="profileConfirmedAtLabel" width="100%" stylename="h4 user-ai-profile-summary-value"/>
                        </vbox>
                        <!-- Вертикальный индекс повторяет порядок аккордеонов справа и помогает ориентироваться в длинной форме. -->
                        <vbox id="userAiProfileSectionNavigation" width="100%" spacing="false" stylename="user-ai-profile-navigation">
                            <label width="100%" value="msg://aiProfileNavigationTitle" stylename="user-ai-profile-navigation-title"/>
                            <label width="100%" value="msg://professionalProfile" stylename="user-ai-profile-nav-item user-ai-profile-nav-item-active"/>
                            <label width="100%" value="msg://recruitingProfile" stylename="user-ai-profile-nav-item"/>
                            <label width="100%" value="msg://responsePreferences" stylename="user-ai-profile-nav-item"/>
                            <label width="100%" value="msg://goalsAndInterests" stylename="user-ai-profile-nav-item"/>
                            <label width="100%" value="msg://privacyAndBoundaries" stylename="user-ai-profile-nav-item"/>
                            <label width="100%" value="msg://aiContextPreview" stylename="user-ai-profile-nav-item"/>
                        </vbox>
                        <label id="userAiProfileSidebarSpacer"/>
                        <vbox id="userAiProfileSensitiveWarningBox" width="100%" spacing="false" stylename="user-ai-profile-sensitive-warning">
                            <label width="100%" value="msg://aiProfileSensitiveDataWarning" stylename="user-ai-profile-help"/>
                        </vbox>
                    </vbox>
                    <scrollBox id="userAiProfileContentScrollBox"
                               width="100%"
                               height="100%"
                               orientation="vertical"
                               scrollBars="vertical"
                               stylename="user-ai-profile-content">
                        <vbox id="userAiProfileContent" width="100%" spacing="true">
                            <!-- Toolbar объединяет заголовок, предпросмотр передаваемых данных и безопасную очистку профиля. -->
                            <hbox id="userAiProfileToolbar" width="100%" spacing="true" expand="userAiProfileTitleBox" stylename="user-ai-profile-toolbar">
                                <vbox id="userAiProfileTitleBox" width="100%" spacing="false">
                                    <label value="msg://aiProfileTitle" stylename="h1"/>
                                    <label value="msg://aiProfileDescription" width="100%" stylename="user-ai-profile-help"/>
                                </vbox>
                                <hbox id="userAiProfileToolbarActions" spacing="true" align="BOTTOM_RIGHT" stylename="user-ai-profile-toolbar-actions">
                                    <button id="previewAiContextBtn" caption="msg://previewAiContext" stylename="primary" invoke="previewAiContext"/>
                                    <button id="clearAiProfileBtn" caption="msg://clearAiProfile" stylename="danger" invoke="clearAiProfile"/>
                                </hbox>
                            </hbox>
                            <!-- Первая секция раскрыта по умолчанию; остальные секции стартуют свёрнутыми. -->
                            <groupBox id="professionalProfileGroup" caption="msg://professionalProfile" width="100%" spacing="true" margin="true" collapsable="true" collapsed="false" showAsPanel="true" stylename="user-ai-profile-section">
                                <grid width="100%" spacing="true">
                                    <columns><column flex="1"/><column flex="1"/></columns>
                                    <rows>
                                        <row>
                                            <textField id="currentPositionField" datasource="userAiProfileDs" property="currentPosition" caption="msg://currentPosition" maxLength="255" width="100%"/>
                                            <lookupField id="functionalRoleField" datasource="userAiProfileDs" property="functionalRole" caption="msg://functionalRole" width="100%"/>
                                        </row>
                                        <row>
                                            <lookupField id="seniorityLevelField" datasource="userAiProfileDs" property="seniorityLevel" caption="msg://seniorityLevel" width="100%"/>
                                            <hbox width="100%" spacing="true">
                                                <textField id="professionalExperienceYearsField" datasource="userAiProfileDs" property="professionalExperienceYears" caption="msg://professionalExperienceYears" width="50%"/>
                                                <textField id="recruitingExperienceYearsField" datasource="userAiProfileDs" property="recruitingExperienceYears" caption="msg://recruitingExperienceYears" width="50%"/>
                                            </hbox>
                                        </row>
                                        <row><textArea id="aboutMeField" datasource="userAiProfileDs" property="aboutMe" caption="msg://aboutMe" maxLength="2000" height="90px" width="100%" colspan="2"/></row>
                                        <row>
                                            <textArea id="currentResponsibilitiesField" datasource="userAiProfileDs" property="currentResponsibilities" caption="msg://currentResponsibilities" maxLength="4000" height="90px" width="100%"/>
                                            <textArea id="educationField" datasource="userAiProfileDs" property="education" caption="msg://education" maxLength="4000" height="90px" width="100%"/>
                                        </row>
                                        <row>
                                            <textArea id="certificationsField" datasource="userAiProfileDs" property="certifications" caption="msg://certifications" maxLength="4000" height="80px" width="100%"/>
                                            <textArea id="domainExpertiseField" datasource="userAiProfileDs" property="domainExpertise" caption="msg://domainExpertise" maxLength="4000" height="80px" width="100%"/>
                                        </row>
                                        <row><textArea id="industriesField" datasource="userAiProfileDs" property="industries" caption="msg://industries" maxLength="4000" height="70px" width="100%" colspan="2"/></row>
                                    </rows>
                                </grid>
                            </groupBox>
                            <groupBox id="recruitingProfileGroup" caption="msg://recruitingProfile" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="user-ai-profile-section">
                                <grid width="100%" spacing="true">
                                    <columns><column flex="1"/><column flex="1"/></columns>
                                    <rows>
                                        <row>
                                            <textArea id="recruitingSpecializationsField" datasource="userAiProfileDs" property="recruitingSpecializations" caption="msg://recruitingSpecializations" maxLength="4000" height="80px" width="100%"/>
                                            <textArea id="targetRolesField" datasource="userAiProfileDs" property="targetRoles" caption="msg://targetRoles" maxLength="4000" height="80px" width="100%"/>
                                        </row>
                                        <row>
                                            <textField id="candidateLevelsField" datasource="userAiProfileDs" property="candidateLevels" caption="msg://candidateLevels" maxLength="255" width="100%"/>
                                            <textArea id="hiringGeographiesField" datasource="userAiProfileDs" property="hiringGeographies" caption="msg://hiringGeographies" maxLength="2000" height="65px" width="100%"/>
                                        </row>
                                        <row>
                                            <textArea id="decisionPrioritiesField" datasource="userAiProfileDs" property="decisionPriorities" caption="msg://decisionPriorities" maxLength="4000" height="90px" width="100%"/>
                                            <textArea id="clientAndProjectContextField" datasource="userAiProfileDs" property="clientAndProjectContext" caption="msg://clientAndProjectContext" maxLength="4000" height="90px" width="100%"/>
                                        </row>
                                    </rows>
                                </grid>
                            </groupBox>
                            <groupBox id="responsePreferencesGroup" caption="msg://responsePreferences" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="user-ai-profile-section">
                                <grid width="100%" spacing="true">
                                    <columns><column flex="1"/><column flex="1"/></columns>
                                    <rows>
                                        <row>
                                            <lookupField id="preferredLanguageField" datasource="userAiProfileDs" property="preferredLanguage" caption="msg://preferredLanguage" width="100%"/>
                                            <lookupField id="responseDetailLevelField" datasource="userAiProfileDs" property="responseDetailLevel" caption="msg://responseDetailLevel" width="100%"/>
                                        </row>
                                        <row>
                                            <lookupField id="communicationStyleField" datasource="userAiProfileDs" property="communicationStyle" caption="msg://communicationStyle" width="100%"/>
                                            <lookupField id="terminologyLevelField" datasource="userAiProfileDs" property="terminologyLevel" caption="msg://terminologyLevel" width="100%"/>
                                        </row>
                                        <row><lookupField id="preferredAnswerStructureField" datasource="userAiProfileDs" property="preferredAnswerStructure" caption="msg://preferredAnswerStructure" width="100%" colspan="2"/></row>
                                        <row>
                                            <textArea id="customAiInstructionsField" datasource="userAiProfileDs" property="customAiInstructions" caption="msg://customAiInstructions" description="msg://customAiInstructionsDescription" maxLength="4000" height="90px" width="100%"/>
                                            <textArea id="communicationConstraintsField" datasource="userAiProfileDs" property="communicationConstraints" caption="msg://communicationConstraints" maxLength="2000" height="90px" width="100%"/>
                                        </row>
                                    </rows>
                                </grid>
                            </groupBox>
                            <groupBox id="goalsGroup" caption="msg://goalsAndInterests" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="user-ai-profile-section">
                                <grid width="100%" spacing="true">
                                    <columns><column flex="1"/><column flex="1"/></columns>
                                    <rows>
                                        <row>
                                            <textArea id="professionalGoalsField" datasource="userAiProfileDs" property="professionalGoals" caption="msg://professionalGoals" maxLength="4000" height="80px" width="100%"/>
                                            <textArea id="professionalInterestsField" datasource="userAiProfileDs" property="professionalInterests" caption="msg://professionalInterests" maxLength="4000" height="80px" width="100%"/>
                                        </row>
                                        <row>
                                            <textArea id="developmentAreasField" datasource="userAiProfileDs" property="developmentAreas" caption="msg://developmentAreas" maxLength="4000" height="80px" width="100%"/>
                                            <textArea id="currentPrioritiesField" datasource="userAiProfileDs" property="currentPriorities" caption="msg://currentPriorities" maxLength="4000" height="80px" width="100%"/>
                                        </row>
                                    </rows>
                                </grid>
                            </groupBox>
                            <groupBox id="privacyGroup" caption="msg://privacyAndBoundaries" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="user-ai-profile-section user-ai-profile-privacy">
                                <checkBox id="profileEnabledField" datasource="userAiProfileDs" property="profileEnabled" caption="msg://profileEnabled"/>
                                <checkBox id="externalProcessingAllowedField" datasource="userAiProfileDs" property="externalProcessingAllowed" caption="msg://externalProcessingAllowed"/>
                                <label value="msg://externalProcessingConsentText" width="100%" stylename="user-ai-profile-help"/>
                                <label id="consentAcceptedAtLabel" width="100%" stylename="h4"/>
                            </groupBox>
                            <groupBox id="previewGroup" caption="msg://aiContextPreview" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="user-ai-profile-section">
                                <textArea id="aiContextPreviewArea" width="100%" height="260px" editable="false" stylename="user-ai-profile-preview"/>
                            </groupBox>
                        </vbox>
                    </scrollBox>
                </hbox>
            </tab>
            <tab id="msgInterface" caption="msg://msgInterface" margin="true" spacing="true">
                <!-- Вкладка сохраняет component ID базового SettingsWindow и меняет только визуальные контейнеры. -->
                <hbox id="interfaceSettingsMainBox"
                      width="100%"
                      height="100%"
                      spacing="true"
                      expand="interfaceSettingsContentScrollBox"
                      stylename="interface-settings-editor">
                    <vbox id="interfaceSettingsSidebar"
                          width="270px"
                          height="100%"
                          spacing="true"
                          expand="interfaceSettingsSidebarSpacer"
                          stylename="settings-section-sidebar">
                        <label value="UI" align="TOP_LEFT" stylename="settings-section-mark"/>
                        <vbox id="interfaceSettingsSidebarIdentity" width="100%" spacing="false">
                            <label value="msg://interfaceSettingsSidebarTitle" width="100%" stylename="h2 settings-section-sidebar-title"/>
                            <label value="msg://interfaceSettingsSidebarDescription" width="100%" stylename="settings-section-help"/>
                        </vbox>
                        <vbox id="interfaceSettingsNavigation" width="100%" spacing="false" stylename="settings-section-navigation">
                            <label value="msg://interfaceSettingsNavigationTitle" width="100%" stylename="settings-section-navigation-title"/>
                            <label value="msg://interfaceSettingsWindowSection" width="100%" stylename="settings-section-nav-item settings-section-nav-item-active"/>
                            <label value="msg://interfaceSettingsAppearanceSection" width="100%" stylename="settings-section-nav-item"/>
                            <label value="msg://interfaceSettingsRegionalSection" width="100%" stylename="settings-section-nav-item"/>
                            <label value="msg://interfaceSettingsStartupSection" width="100%" stylename="settings-section-nav-item"/>
                        </vbox>
                        <label id="interfaceSettingsSidebarSpacer"/>
                        <vbox id="interfaceSettingsHintBox" width="100%" spacing="false" stylename="settings-section-hint">
                            <label value="msg://interfaceSettingsApplyHint" width="100%" stylename="settings-section-help"/>
                        </vbox>
                    </vbox>
                    <scrollBox id="interfaceSettingsContentScrollBox"
                               width="100%"
                               height="100%"
                               orientation="vertical"
                               scrollBars="vertical"
                               stylename="settings-section-content">
                        <vbox id="interfaceSettingsContent" width="100%" spacing="true">
                            <hbox id="interfaceSettingsToolbar"
                                  width="100%"
                                  spacing="true"
                                  expand="interfaceSettingsTitleBox"
                                  stylename="settings-section-toolbar">
                                <vbox id="interfaceSettingsTitleBox" width="100%" spacing="false">
                                    <label value="msg://interfaceSettingsPageTitle" stylename="h1"/>
                                    <label value="msg://interfaceSettingsPageDescription" width="100%" stylename="settings-section-help"/>
                                </vbox>
                                <buttonsPanel id="interfaceSettingsToolbarActions"
                                              align="BOTTOM_RIGHT"
                                              stylename="settings-section-toolbar-actions">
                                    <button id="changePasswordBtn" icon="icons/change-pass.png"/>
                                    <button id="resetScreenSettingsBtn" icon="icons/trash.png" stylename="danger"/>
                                </buttonsPanel>
                            </hbox>
                            <vbox id="interfaceAppearanceCard"
                                  width="100%"
                                  spacing="true"
                                  stylename="settings-section-card interface-settings-card">
                                <vbox id="interfaceAppearanceHeader" width="100%" spacing="false">
                                    <label value="msg://interfaceSettingsAppearanceTitle" stylename="h3 settings-section-card-title"/>
                                    <label value="msg://interfaceSettingsAppearanceDescription" width="100%" stylename="settings-section-help"/>
                                </vbox>
                                <grid id="grid" spacing="true" width="100%">
                                    <columns><column flex="0"/><column flex="1"/></columns>
                                    <rows>
                                        <row><label id="mainWindowLabel" value="msg://mainWindowMode" align="MIDDLE_LEFT"/><optionsGroup id="modeOptions"/></row>
                                        <row><label id="visualThemeLabel" value="msg://mainWindowTheme" align="MIDDLE_LEFT"/><lookupField id="appThemeField" required="true" width="theme://cuba.web.settings-window.appThemeField.width" requiredMessage="msg://mainWindowThemeMsg"/></row>
                                        <row><label id="languageLabel" value="msg://mainWindowLang" align="MIDDLE_LEFT"/><lookupField id="appLangField" width="theme://cuba.web.settings-window.appLocaleField.width"/></row>
                                        <row>
                                            <label id="timeZoneLabel" value="msg://com.haulmont.cuba.security.entity/User.timeZone" align="MIDDLE_LEFT"/>
                                            <hbox id="timeZoneBox" spacing="true" width="100%" expand="timeZoneAutoField">
                                                <lookupField id="timeZoneLookup" width="theme://cuba.web.settings-window.timeZoneField.width"/>
                                                <checkBox id="timeZoneAutoField" align="MIDDLE_LEFT"/>
                                            </hbox>
                                        </row>
                                        <row><label id="defaultScreenLabel" value="msg://defaultScreen" align="MIDDLE_LEFT"/><lookupField id="defaultScreenField" description="msg://defaultScreenDescription" newOptionAllowed="false" nullName="msg://noDefaultScreen" width="theme://cuba.web.settings-window.defaultScreenField.width"/></row>
                                    </rows>
                                </grid>
                            </vbox>
                        </vbox>
                    </scrollBox>
                </hbox>
            </tab>
            <tab id="mailAccessTab" caption="msg://msgEmailSettings" margin="true" spacing="true">
                <!-- Почтовые поля остаются ручными TextField-контрактами контроллера; datasource и сохранение не меняются. -->
                <hbox id="emailSettingsMainBox"
                      width="100%"
                      height="100%"
                      spacing="true"
                      expand="emailSettingsContentScrollBox"
                      stylename="email-settings-editor">
                    <vbox id="emailSettingsSidebar"
                          width="270px"
                          height="100%"
                          spacing="true"
                          expand="emailSettingsSidebarSpacer"
                          stylename="settings-section-sidebar">
                        <label value="@" align="TOP_LEFT" stylename="settings-section-mark"/>
                        <vbox id="emailSettingsSidebarIdentity" width="100%" spacing="false">
                            <label value="msg://emailSettingsSidebarTitle" width="100%" stylename="h2 settings-section-sidebar-title"/>
                            <label value="msg://emailSettingsSidebarDescription" width="100%" stylename="settings-section-help"/>
                        </vbox>
                        <vbox id="emailSettingsNavigation" width="100%" spacing="false" stylename="settings-section-navigation">
                            <label value="msg://emailSettingsNavigationTitle" width="100%" stylename="settings-section-navigation-title"/>
                            <label value="msg://emailSettingsSmtpSection" width="100%" stylename="settings-section-nav-item settings-section-nav-item-active"/>
                            <label value="msg://emailSettingsPop3Section" width="100%" stylename="settings-section-nav-item"/>
                            <label value="msg://emailSettingsImapSection" width="100%" stylename="settings-section-nav-item"/>
                        </vbox>
                        <label id="emailSettingsSidebarSpacer"/>
                        <vbox id="emailSettingsSecurityBox" width="100%" spacing="false" stylename="settings-section-warning">
                            <label value="msg://emailSettingsSecurityHint" width="100%" stylename="settings-section-help"/>
                        </vbox>
                    </vbox>
                    <scrollBox id="emailSettingsContentScrollBox"
                               width="100%"
                               height="100%"
                               orientation="vertical"
                               scrollBars="vertical"
                               stylename="settings-section-content">
                        <vbox id="emailSettingsContent" width="100%" spacing="true">
                            <hbox id="emailSettingsToolbar"
                                  width="100%"
                                  spacing="true"
                                  expand="emailSettingsTitleBox"
                                  stylename="settings-section-toolbar">
                                <vbox id="emailSettingsTitleBox" width="100%" spacing="false">
                                    <label value="msg://emailSettingsPageTitle" stylename="h1"/>
                                    <label value="msg://emailSettingsPageDescription" width="100%" stylename="settings-section-help"/>
                                </vbox>
                            </hbox>
                            <grid id="emailSettingsGrid" width="100%" spacing="true" stylename="email-settings-grid">
                                <columns><column flex="1"/><column flex="1"/><column flex="1"/></columns>
                                <rows>
                                    <row>
                                        <vbox id="smtpSettingsCard" width="100%" spacing="true" stylename="settings-section-card email-settings-card">
                                            <label value="SMTP" stylename="h3 settings-section-card-title"/>
                                            <label value="msg://emailSettingsSmtpDescription" width="100%" stylename="settings-section-help"/>
                                            <textField id="smtpServer" caption="SMTP server" width="100%"/>
                                            <textField id="smtpPort" datatype="int" caption="SMTP port" width="100%">
                                                <validator class="com.haulmont.cuba.gui.components.validators.IntegerValidator"/>
                                            </textField>
                                            <checkBox id="smtpPasswordRequired" caption="msg://msgSMTPPasswordRequired"/>
                                            <textField id="smtpPassword" caption="SMTP password" width="100%"/>
                                        </vbox>
                                        <vbox id="pop3SettingsCard" width="100%" spacing="true" stylename="settings-section-card email-settings-card">
                                            <label value="POP3" stylename="h3 settings-section-card-title"/>
                                            <label value="msg://emailSettingsPop3Description" width="100%" stylename="settings-section-help"/>
                                            <textField id="pop3Server" caption="POP3 server" width="100%"/>
                                            <textField id="pop3Port" datatype="int" caption="POP3 port" width="100%">
                                                <validator class="com.haulmont.cuba.gui.components.validators.IntegerValidator"/>
                                            </textField>
                                            <checkBox id="pop3PasswordRequired" caption="msg://msgPop3PasswordRequired"/>
                                            <textField id="pop3Password" caption="POP3 password" width="100%"/>
                                        </vbox>
                                        <vbox id="imapSettingsCard" width="100%" spacing="true" stylename="settings-section-card email-settings-card">
                                            <label value="IMAP" stylename="h3 settings-section-card-title"/>
                                            <label value="msg://emailSettingsImapDescription" width="100%" stylename="settings-section-help"/>
                                            <textField id="imapServer" caption="IMAP server" width="100%"/>
                                            <textField id="imapPort" datatype="int" caption="IMAP port" width="100%">
                                                <validator class="com.haulmont.cuba.gui.components.validators.IntegerValidator"/>
                                            </textField>
                                            <checkBox id="imapPasswordRequired" caption="msg://msgImapPasswordRequired"/>
                                            <textField id="imapPassword" caption="IMAP password" width="100%"/>
                                        </vbox>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>
                    </scrollBox>
                </hbox>
            </tab>
            <tab id="aiAccessTab" caption="msg://msgAiSettings" margin="true" spacing="true">
                <!-- Вкладка AI использует тот же двухпанельный паттерн, что и остальные Edit-формы:
                     контекст и навигация слева, toolbar и функциональные карточки справа. -->
                <hbox id="aiSettingsMainBox"
                      width="100%"
                      height="100%"
                      spacing="true"
                      expand="aiSettingsContent"
                      stylename="ai-settings-editor">
                    <vbox id="aiSettingsSidebar"
                          width="270px"
                          height="100%"
                          spacing="true"
                          expand="aiSettingsSidebarSpacer"
                          stylename="ai-settings-sidebar">
                        <label value="AI" align="TOP_LEFT" stylename="ai-settings-mark"/>
                        <vbox id="aiSettingsSidebarIdentity" width="100%" spacing="false">
                            <label value="msg://aiSettingsSidebarTitle" width="100%" stylename="h2 ai-settings-sidebar-title"/>
                            <label value="msg://aiSettingsSidebarDescription" width="100%" stylename="ai-settings-help"/>
                        </vbox>
                        <vbox id="aiSettingsNavigation" width="100%" spacing="false" stylename="ai-settings-navigation">
                            <label value="msg://aiSettingsNavigationTitle" width="100%" stylename="ai-settings-navigation-title"/>
                            <label value="msg://aiSettingsSourceSection" width="100%" stylename="ai-settings-nav-item ai-settings-nav-item-active"/>
                            <label value="msg://aiSettingsConnectionsSection" width="100%" stylename="ai-settings-nav-item"/>
                        </vbox>
                        <label id="aiSettingsSidebarSpacer"/>
                        <vbox id="aiSettingsSecurityBox" width="100%" spacing="false" stylename="ai-settings-security">
                            <label value="msg://aiSettingsSecurityHint" width="100%" stylename="ai-settings-help"/>
                        </vbox>
                    </vbox>
                    <vbox id="aiSettingsContent"
                          width="100%"
                          height="100%"
                          spacing="true"
                          expand="aiConnectionsCard"
                          stylename="ai-settings-content">
                        <hbox id="aiSettingsToolbar"
                              width="100%"
                              spacing="true"
                              expand="aiSettingsTitleBox"
                              stylename="ai-settings-toolbar">
                            <vbox id="aiSettingsTitleBox" width="100%" spacing="false">
                                <label value="msg://aiSettingsPageTitle" stylename="h1"/>
                                <label value="msg://aiSettingsPageDescription" width="100%" stylename="ai-settings-help"/>
                            </vbox>
                            <buttonsPanel id="aiConfigsButtonsPanel" align="BOTTOM_RIGHT" stylename="ai-settings-toolbar-actions">
                                <button id="aiConfigsCreateBtn" caption="msg://actions.Create" icon="CREATE_ACTION" invoke="onAiConfigsCreateBtnClick"/>
                                <button id="aiConfigsEditBtn" caption="msg://actions.Edit" icon="EDIT" enable="false" invoke="onAiConfigsEditBtnClick"/>
                                <button id="aiConfigsRemoveBtn" caption="msg://actions.Remove" icon="REMOVE" enable="false" invoke="onAiConfigsRemoveBtnClick"/>
                                <!-- Включается из ExtSettingsWindow только при выбранной строке таблицы. -->
                                <button id="aiConfigsTestBtn" caption="msg://msgAiTestConnection" icon="KEY" enable="false" invoke="onAiConfigsTestBtnClick"/>
                            </buttonsPanel>
                        </hbox>
                        <!-- Предпочтения сохраняются в UserSettings; маршрутизация API и разрешение промптов выполняются отдельными сервисами. -->
                        <vbox id="personalAiApiPreferenceBox"
                              spacing="true"
                              width="100%"
                              stylename="ai-settings-card ai-settings-preference-card">
                            <label value="msg://aiSettingsPreferenceTitle" stylename="h3 ai-settings-card-title"/>
                            <checkBox id="preferPersonalAiApiSettingsField"
                                      datasource="userSettingsDs"
                                      property="preferPersonalAiApiSettings"
                                      caption="msg://preferPersonalAiApiSettings"
                                      stylename="ai-settings-preference-checkbox"/>
                            <label value="msg://preferPersonalAiApiSettingsHint" width="100%" stylename="ai-settings-help"/>
                            <checkBox id="preferPersonalPromptsField"
                                      datasource="userSettingsDs"
                                      property="preferPersonalPrompts"
                                      caption="msg://preferPersonalPrompts"
                                      stylename="ai-settings-preference-checkbox"/>
                            <label value="msg://preferPersonalPromptsHint" width="100%" stylename="ai-settings-help"/>
                        </vbox>
                        <vbox id="aiConnectionsCard"
                              width="100%"
                              height="100%"
                              spacing="true"
                              expand="aiConfigsTable"
                              stylename="ai-settings-card ai-settings-connections-card">
                            <vbox id="aiConnectionsHeader" width="100%" spacing="false">
                                <label value="msg://aiSettingsConnectionsTitle" stylename="h3 ai-settings-card-title"/>
                                <label value="msg://aiSettingsConnectionsDescription" width="100%" stylename="ai-settings-help"/>
                            </vbox>
                            <table id="aiConfigsTable"
                                   width="100%"
                                   height="100%"
                                   editable="false"
                                   stylename="ai-settings-table">
                                <columns><column id="providerCode"/><column id="defaultModelName"/><column id="isActive"/></columns>
                                <rows datasource="userAiConfigsDs"/>
                            </table>
                        </vbox>
                    </vbox>
                </hbox>
            </tab>
        </tabSheet>
        <vbox id="buttons" margin="true;false;false;false" stylename="ext-settings-footer">
            <buttonsPanel><button id="okBtn" icon="icons/ok.png"/><button id="cancelBtn" icon="icons/cancel.png"/></buttonsPanel>
        </vbox>
    </layout>
</window>
