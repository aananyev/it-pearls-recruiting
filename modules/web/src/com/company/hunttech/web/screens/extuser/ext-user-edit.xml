<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Legacy Edit-экран управляет пользователем, его ролями, замещениями, почтовыми и AI-настройками. -->
<window xmlns="http://schemas.haulmont.com/cuba/window.xsd" class="com.company.hunttech.web.screens.extuser.ExtUserEditor" caption="msg://extUserEdit.caption" messagesPack="com.company.hunttech.web.screens.extuser" datasource="userDs" focusComponent="settingsTabSheet">
    <!-- Web companion сохраняет штатную настройку password-полей стандартного UserEditor. -->
    <companions>
        <!-- Штатный companion CUBA инициализирует password controls с платформенными ограничениями. -->
        <web class="com.haulmont.cuba.web.app.ui.security.user.UserEditorCompanion"/>
    </companions>
    <!-- Legacy datasource-контекст сохраняет загрузку пользователя, ролей, замещений и AI-конфигураций. -->
    <dsContext>
        <!-- Корневой datasource пользователя использует расширенный view без изменения контракта. -->
        <datasource id="userDs" class="com.haulmont.cuba.security.entity.User" view="extUser-view">
            <!-- Роли редактируются как group property исходного пользователя. -->
            <groupDatasource id="rolesDs" property="userRoles"/>
            <!-- Замещения редактируются как composition-коллекция исходного пользователя. -->
            <collectionDatasource id="substitutionsDs" property="substitutions"/>
        </datasource>
        <!-- AI-конфигурации выводятся отдельно и фильтруются по текущему userDs. -->
        <collectionDatasource id="userAiConfigsDs" class="com.company.hunttech.entity.UserAiConfiguration" view="userAiConfiguration-view">
            <!-- JPQL сохраняет entity-binding :ds$userDs. -->
            <query>
                <![CDATA[select e from hunttech_UserAiConfiguration e where e.user = :ds$userDs]]>
            </query>
        </collectionDatasource>
    </dsContext>
    <!-- Диалог остаётся крупным и изменяемым по размеру для таблиц ролей и замещений. -->
    <dialogMode height="850" width="theme://cuba.gui.dialogSize.width.xlarge" resizable="true"/>
    <!-- Локальный root namespace ограничивает ExtUserEdit и сохраняет footer отдельно от рабочей области. -->
    <layout expand="mainSplit" spacing="true" stylename="ext-user-editor">
        <!-- Общая двухпанельная композиция фиксирует sidebar и отдаёт оставшуюся ширину workspace. -->
        <hbox id="mainSplit" width="100%" height="100%" expand="userWorkspace" stylename="edit-screen-layout">
            <!-- Постоянная sidebar показывает профиль, контекст и navigation активной вкладки. -->
            <vbox id="profilePanel" width="270px" height="100%" spacing="true" margin="true" expand="profilePanelSpacer" stylename="edit-sidebar">
                <!-- Визуальный блок сохраняет upload/drop-zone и стабильный размер фотографии пользователя. -->
                <vbox id="dropZone" spacing="true" width="100%" align="TOP_CENTER" stylename="dropzone-container edit-sidebar-visual">
                    <!-- Профильное изображение остаётся привязанным к userDs.officialPhoto. -->
                    <fallbackImage id="userPic" width="180px" height="180px" align="MIDDLE_CENTER" scaleMode="SCALE_DOWN" datasource="userDs" property="officialPhoto"/>
                    <!-- Upload сохраняет прежние datasource/property и immediate file-storage contract. -->
                    <upload id="officialPhotoUpload" fileStoragePutMode="IMMEDIATE" datasource="userDs" align="BOTTOM_CENTER" showFileName="false" dropZone="dropZone" showClearButton="true" property="officialPhoto"/>
                </vbox>
                <!-- Identity-блок показывает основное имя пользователя и его login без дублирования полей справа. -->
                <vbox id="profileLabelsVBox" spacing="false" align="TOP_CENTER" width="100%" stylename="edit-sidebar-identity">
                    <!-- Основное человекочитаемое имя пользователя является title sidebar. -->
                    <label id="fioLabel" stylename="h1 edit-sidebar-title" align="MIDDLE_CENTER" width="100%"/>
                    <!-- Login сохраняется как вторичный постоянный контекст пользователя. -->
                    <label id="loginLabel" stylename="large edit-sidebar-subtitle" align="MIDDLE_CENTER" width="100%"/>
                </vbox>
                <!-- Навигация вкладки «Общие настройки» фокусирует существующие секции без изменения контракта. -->
                <vbox id="generalUserNavigation" width="100%" spacing="false" stylename="label-navigation">
                    <!-- Заголовок объясняет назначение вертикального индекса текущей вкладки. -->
                    <label value="msg://msgNavigationTitle" width="100%" stylename="label-nav-title"/>
                    <!-- Первый пункт активен при открытии общей вкладки и переводит focus к контактным полям. -->
                    <button id="generalContactsNav" caption="msg://msgContacts" width="100%" stylename="borderless label-nav-item label-nav-item-active" invoke="focusGeneralContactsSection"/>
                    <!-- Пункт переводит focus к региональным и системным настройкам пользователя. -->
                    <button id="generalRegionalNav" caption="msg://msgRegional" width="100%" stylename="borderless label-nav-item" invoke="focusGeneralRegionalSection"/>
                    <!-- Пункт переводит focus к существующей таблице ролей. -->
                    <button id="generalRolesNav" caption="msg://roles" width="100%" stylename="borderless label-nav-item" invoke="focusRolesSection"/>
                    <!-- Пункт переводит focus к существующей таблице замещений. -->
                    <button id="generalSubstitutionsNav" caption="msg://substUsers" width="100%" stylename="borderless label-nav-item" invoke="focusSubstitutionsSection"/>
                </vbox>
                <!-- Навигация почтовой вкладки повторяет вертикальный порядок accordion-секций. -->
                <vbox id="emailUserNavigation" width="100%" spacing="false" visible="false" stylename="label-navigation">
                    <!-- Заголовок отделяет почтовый navigation-набор от identity пользователя. -->
                    <label value="msg://msgNavigationTitle" width="100%" stylename="label-nav-title"/>
                    <!-- Пункт фокусирует серверные адреса SMTP, POP3 и IMAP. -->
                    <button id="emailServersNav" caption="msg://msgMailServers" width="100%" stylename="borderless label-nav-item label-nav-item-active" invoke="focusMailServersSection"/>
                    <!-- Пункт фокусирует настройки портов почтовых протоколов. -->
                    <button id="emailPortsNav" caption="msg://msgMailPorts" width="100%" stylename="borderless label-nav-item" invoke="focusMailPortsSection"/>
                    <!-- Пункт фокусирует признаки обязательности пароля. -->
                    <button id="emailPasswordRequiredNav" caption="msg://msgMailAuthentication" width="100%" stylename="borderless label-nav-item" invoke="focusMailAuthenticationSection"/>
                    <!-- Пункт фокусирует имена учётных записей почтовых протоколов. -->
                    <button id="emailUsersNav" caption="msg://msgMailAccounts" width="100%" stylename="borderless label-nav-item" invoke="focusMailAccountsSection"/>
                    <!-- Пункт фокусирует password-поля почтовых протоколов. -->
                    <button id="emailPasswordsNav" caption="msg://msgMailPasswords" width="100%" stylename="borderless label-nav-item" invoke="focusMailPasswordsSection"/>
                </vbox>
                <!-- Навигация AI-вкладки содержит единственную существующую рабочую секцию конфигураций. -->
                <vbox id="aiUserNavigation" width="100%" spacing="false" visible="false" stylename="label-navigation">
                    <!-- Заголовок отделяет AI navigation-набор от identity пользователя. -->
                    <label value="msg://msgNavigationTitle" width="100%" stylename="label-nav-title"/>
                    <!-- Пункт фокусирует таблицу персональных AI-подключений. -->
                    <button id="aiConfigurationsNav" caption="msg://msgAiConfigurations" width="100%" stylename="borderless label-nav-item label-nav-item-active" invoke="focusAiConfigurationsSection"/>
                </vbox>
                <!-- Сводка располагается после navigation и показывает существующий статус учётной записи. -->
                <vbox id="profileSummaryBox" width="100%" spacing="false" stylename="edit-sidebar-summary">
                    <!-- Статус отражает active пользователя. -->
                    <label id="statusLabel" align="MIDDLE_CENTER" width="100%"/>
                    <!-- Сохраняется существующая подпись профильного контекста без добавления нового действия. -->
                    <label value="msg://msgProfile" width="100%" stylename="edit-sidebar-hint"/>
                </vbox>
                <!-- Spacer удерживает navigation и summary в первом viewport, не меняя размеры workspace. -->
                <label id="profilePanelSpacer" stylename="edit-sidebar-spacer"/>
            </vbox>
            <!-- Правая рабочая область объединяет toolbar, существующие вкладки и их неизменённые bindings. -->
            <vbox id="userWorkspace" width="100%" height="100%" expand="settingsTabSheet" stylename="edit-workspace">
                <!-- Toolbar содержит описание экрана и существующую штатную смену пароля. -->
                <hbox id="userToolbar" width="100%" spacing="true" align="MIDDLE_LEFT" expand="userToolbarTitleBox" stylename="edit-toolbar">
                    <!-- Заголовочная группа объясняет бизнес-контекст редактирования пользователя. -->
                    <vbox id="userToolbarTitleBox" width="100%" spacing="false">
                        <!-- Основной toolbar-title повторяет caption экрана. -->
                        <label value="msg://extUserEdit.caption" width="100%" stylename="edit-toolbar-title"/>
                        <!-- Описание уточняет, что форма управляет профилем, доступами и интеграциями. -->
                        <label value="msg://msgToolbarDescription" width="100%" stylename="edit-toolbar-description"/>
                    </vbox>
                    <!-- Actions-контейнер сохраняет единственное существующее действие смены пароля. -->
                    <hbox id="userToolbarActions" spacing="true" align="MIDDLE_RIGHT" stylename="edit-toolbar-actions">
                        <!-- Штатный диалог CUBA меняет пароль отдельно от сохранения остальных данных пользователя. -->
                        <button id="changePasswordBtn" caption="msg://msgChangePassword" icon="KEY" stylename="friendly" invoke="changePassword"/>
                    </hbox>
                </hbox>
                <!-- TabSheet сохраняет три существующих бизнес-контекста и получает общий edit-tabs contract. -->
                <tabSheet id="settingsTabSheet" width="100%" height="100%" stylename="framed edit-tabs">
                    <!-- Общая вкладка сохраняет password, контактные, региональные, role и substitution controls. -->
                    <tab id="generalSettingsTab" caption="msg://msgGeneralSettings" margin="true" spacing="true" expand="rolesSubstSplit">
                        <!-- Прокручиваемый верхний блок содержит формы пользователя. -->
                        <scrollBox id="generalScrollBox" width="100%" spacing="true">
                            <!-- Password-card видна только для нового пользователя по штатному lifecycle UserEditor. -->
                            <vbox id="passwordBox" spacing="true" visible="false" width="100%" margin="true,true,true,true" stylename="edit-card">
                                <!-- Legacy FieldGroup обязателен для программно создаваемых passwField/confirmPasswField. -->
                                <fieldGroup id="fieldGroupLeft" datasource="userDs" width="100%" stylename="edit-form-control">
                                    <!-- Password-поля занимают полную ширину карточки. -->
                                    <column width="100%">
                                        <!-- Custom field получает штатный PasswordField из UserEditor.createPasswordFields(). -->
                                        <field id="passw" custom="true" caption="msg://password"/>
                                        <!-- Custom confirmation field проверяется стандартным UserEditor.preCommit(). -->
                                        <field id="confirmPassw" custom="true" caption="msg://confirmPassword"/>
                                    </column>
                                </fieldGroup>
                            </vbox>
                            <!-- Две равные карточки сохраняют существующее разделение контактов и системных параметров. -->
                            <hbox id="contactsRegionalRow" spacing="true" width="100%">
                                <!-- Карточка контактов сохраняет все bindings userDs и email validator. -->
                                <groupBox id="contactsCard" flat="true" spacing="true" width="100%" flex="1" stylename="edit-card">
                                    <!-- Заголовок карточки обозначает контактную идентификацию пользователя. -->
                                    <label value="msg://msgContacts" stylename="h3 edit-card-title"/>
                                    <!-- FieldGroup сохраняет исходные component IDs и получает общий control contract. -->
                                    <fieldGroup id="contactsFieldGroup" datasource="userDs" width="100%" stylename="edit-form-control">
                                        <!-- Контактные поля располагаются вертикально и используют всю ширину карточки. -->
                                        <column width="100%">
                                            <!-- Login обязателен и сохраняется в userDs.login. -->
                                            <field id="login" required="true" requiredMessage="msg://loginMsg"/>
                                            <!-- Имя сохраняется в userDs.firstName. -->
                                            <field id="firstName"/>
                                            <!-- Отчество сохраняется в userDs.middleName. -->
                                            <field id="middleName"/>
                                            <!-- Фамилия сохраняется в userDs.lastName. -->
                                            <field id="lastName"/>
                                            <!-- Отображаемое имя сохраняется в userDs.name. -->
                                            <field id="name"/>
                                            <!-- Email сохраняется в userDs.email и проходит штатную синтаксическую проверку. -->
                                            <field id="email">
                                                <!-- EmailValidator не допускает сохранение некорректного адреса. -->
                                                <validator class="com.haulmont.cuba.gui.components.validators.EmailValidator" message="msg://email.alert"/>
                                            </field>
                                        </column>
                                    </fieldGroup>
                                </groupBox>
                                <!-- Карточка региональных и системных параметров сохраняет custom fields UserEditor. -->
                                <groupBox id="regionalCard" flat="true" spacing="true" width="100%" flex="1" stylename="edit-card">
                                    <!-- Заголовок карточки обозначает региональные и системные параметры. -->
                                    <label value="msg://msgRegional" stylename="h3 edit-card-title"/>
                                    <!-- FieldGroup обязателен для custom language, timeZone и group controls UserEditor. -->
                                    <fieldGroup id="fieldGroupRight" datasource="userDs" width="100%" stylename="edit-form-control">
                                        <!-- Системные поля располагаются вертикально и сохраняют исходный порядок. -->
                                        <column width="100%">
                                            <!-- Custom language control создаётся стандартным UserEditor. -->
                                            <field id="language" custom="true"/>
                                            <!-- Custom time-zone control сохраняет auto/manual contract UserEditor. -->
                                            <field id="timeZone" custom="true"/>
                                            <!-- Custom group picker учитывает штатные security permissions. -->
                                            <field id="group" custom="true"/>
                                            <!-- Должность сохраняется в пользовательском расширении entity. -->
                                            <field id="position"/>
                                            <!-- IP-mask сохраняет существующее ограничение входа пользователя. -->
                                            <field id="ipMask"/>
                                            <!-- Active управляет доступностью учётной записи через штатный binding. -->
                                            <field id="active"/>
                                            <!-- Statistics сохраняет существующий пользовательский флаг. -->
                                            <field id="statistics"/>
                                            <!-- Dashboards сохраняет существующий пользовательский флаг. -->
                                            <field id="dashboards"/>
                                        </column>
                                    </fieldGroup>
                                </groupBox>
                            </hbox>
                        </scrollBox>
                        <!-- Нижний split сохраняет параллельную работу с ролями и замещениями пользователя. -->
                        <split id="rolesSubstSplit" orientation="horizontal" pos="50" width="100%" height="100%" expand="substPanel" margin="true,false,false,false">
                            <!-- Карточка ролей сохраняет стандартные add/edit/remove actions UserEditor. -->
                            <vbox id="rolesPanel" expand="rolesTable" spacing="true" margin="false,true,false,false" height="100%" width="100%" stylename="edit-card">
                                <!-- Заголовок карточки обозначает набор назначенных ролей. -->
                                <label value="msg://roles" stylename="h3 edit-card-title"/>
                                <!-- Панель действий использует существующие action IDs таблицы ролей. -->
                                <buttonsPanel>
                                    <!-- Add-кнопка получает action программно из UserEditor.init(). -->
                                    <button id="rolesTableAddBtn"/>
                                    <!-- Edit-кнопка вызывает существующий rolesTable.edit. -->
                                    <button id="rolesTableEditBtn" action="rolesTable.edit"/>
                                    <!-- Remove-кнопка вызывает существующий rolesTable.remove. -->
                                    <button id="rolesTableRemoveBtn" action="rolesTable.remove"/>
                                </buttonsPanel>
                                <!-- GroupTable отображает роли пользователя и сохраняет fixed grouping. -->
                                <groupTable id="rolesTable" editable="false" multiselect="true" width="100%" height="100%" fixedGrouping="true">
                                    <!-- Набор actions остаётся совместимым со стандартным UserEditor. -->
                                    <actions>
                                        <!-- Edit action редактирует выбранную роль. -->
                                        <action id="edit"/>
                                        <!-- Remove action удаляет выбранные назначения ролей. -->
                                        <action id="remove"/>
                                    </actions>
                                    <!-- Колонки отображают техническое, локализованное имя и security scope роли. -->
                                    <columns>
                                        <!-- Техническое имя роли берётся из role.name. -->
                                        <column id="role.name" caption="msg://roleName"/>
                                        <!-- Локализованное имя роли берётся из role.locName. -->
                                        <column id="role.locName" caption="msg://localizedRoleName"/>
                                        <!-- Security scope отображается через role.locSecurityScope. -->
                                        <column id="role.locSecurityScope"/>
                                    </columns>
                                    <!-- Строки таблицы поступают из rolesDs текущего пользователя. -->
                                    <rows datasource="rolesDs"/>
                                </groupTable>
                            </vbox>
                            <!-- Карточка замещений сохраняет стандартные add/edit/remove actions UserEditor. -->
                            <vbox id="substPanel" expand="substTable" spacing="true" margin="false,false,false,true" height="100%" width="100%" stylename="edit-card">
                                <!-- Заголовок карточки обозначает временные замещения пользователя. -->
                                <label value="msg://substUsers" stylename="h3 edit-card-title"/>
                                <!-- Панель действий использует существующие action IDs таблицы замещений. -->
                                <buttonsPanel>
                                    <!-- Add-кнопка создаёт замещение через substTable.add. -->
                                    <button id="substTableAddBtn" action="substTable.add"/>
                                    <!-- Edit-кнопка редактирует выбранное замещение. -->
                                    <button id="substTableEditBtn" action="substTable.edit"/>
                                    <!-- Remove-кнопка удаляет выбранное замещение. -->
                                    <button id="substTableRemoveBtn" action="substTable.remove"/>
                                </buttonsPanel>
                                <!-- Таблица отображает замещаемого пользователя и период действия замещения. -->
                                <table id="substTable" editable="false" multiselect="true" width="100%" height="100%">
                                    <!-- Набор actions сохраняет штатную CRUD-цепочку замещений. -->
                                    <actions>
                                        <!-- Add action создаёт новую строку substitutionsDs. -->
                                        <action id="add"/>
                                        <!-- Edit action редактирует выбранную строку substitutionsDs. -->
                                        <action id="edit"/>
                                        <!-- Remove action удаляет выбранную строку substitutionsDs. -->
                                        <action id="remove"/>
                                    </actions>
                                    <!-- Колонки показывают пользователя и даты начала/окончания замещения. -->
                                    <columns>
                                        <!-- Login замещаемого пользователя берётся из substitutedUser.login. -->
                                        <column id="substitutedUser.login" caption="msg://login"/>
                                        <!-- Имя замещаемого пользователя берётся из substitutedUser.name. -->
                                        <column id="substitutedUser.name" caption="msg://name"/>
                                        <!-- Дата начала форматируется как DATE без изменения контракта. -->
                                        <column id="startDate" caption="msg://startDate">
                                            <!-- DateFormatter отображает только календарную дату начала. -->
                                            <formatter class="com.haulmont.cuba.gui.components.formatters.DateFormatter" type="DATE"/>
                                        </column>
                                        <!-- Дата окончания форматируется как DATE без изменения контракта. -->
                                        <column id="endDate" caption="msg://endDate">
                                            <!-- DateFormatter отображает только календарную дату окончания. -->
                                            <formatter class="com.haulmont.cuba.gui.components.formatters.DateFormatter" type="DATE"/>
                                        </column>
                                    </columns>
                                    <!-- Строки таблицы поступают из substitutionsDs текущего пользователя. -->
                                    <rows datasource="substitutionsDs"/>
                                </table>
                            </vbox>
                        </split>
                    </tab>
                    <!-- Почтовая вкладка преобразует прежнюю широкую grid в вертикальные accordion-секции без изменения bindings. -->
                    <tab id="emailSettingsTab" caption="msg://msgEmailSettings" margin="true" spacing="true" expand="emailScrollBox">
                        <!-- Вертикальная прокрутка удерживает пять полноширинных почтовых секций внутри workspace. -->
                        <scrollBox id="emailScrollBox" width="100%" height="100%" spacing="true">
                            <!-- Legacy ID propertiesEmailGrid сохранён как вертикальный визуальный контейнер пяти accordion-секций. -->
                            <vbox id="propertiesEmailGrid" width="100%" spacing="true">
                                <!-- Серверные адреса раскрыты по умолчанию как основной почтовый раздел. -->
                                <groupBox id="propertiesEmailBox" caption="msg://msgMailServers" width="100%" spacing="true" margin="true" collapsable="true" collapsed="false" showAsPanel="true" stylename="edit-accordion-section">
                                    <!-- FieldGroup сохраняет smtpServer/pop3Server/imapServer и исходные IDs. -->
                                    <fieldGroup id="emailFieldGroupLeft" datasource="userDs" width="100%" stylename="edit-form-control">
                                        <!-- Серверные адреса располагаются вертикально на полной ширине. -->
                                        <column width="100%">
                                            <!-- SMTP server сохраняется в userDs.smtpServer. -->
                                            <field id="smtpServer" caption="SMTP server"/>
                                            <!-- POP3 server сохраняется в userDs.pop3Server. -->
                                            <field id="pop3Server" caption="POP3 server"/>
                                            <!-- IMAP server сохраняется в userDs.imapServer. -->
                                            <field id="imapServer" caption="IMAP server"/>
                                        </column>
                                    </fieldGroup>
                                </groupBox>
                                <!-- Порты вынесены в отдельную сворачиваемую секцию с прежними validators. -->
                                <groupBox id="emailPortsBox" caption="msg://msgMailPorts" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="edit-accordion-section">
                                    <!-- FieldGroup сохраняет smtpPort/pop3Port/imapPort и исходный datasource. -->
                                    <fieldGroup id="emailFieldGroupRight" datasource="userDs" width="100%" stylename="edit-form-control">
                                        <!-- Портовые значения располагаются вертикально и проходят IntegerValidator. -->
                                        <column width="100%">
                                            <!-- SMTP port должен быть целым числом. -->
                                            <field id="smtpPort" caption="SMTP port">
                                                <!-- IntegerValidator предотвращает сохранение нечислового SMTP-порта. -->
                                                <validator class="com.haulmont.cuba.gui.components.validators.IntegerValidator"/>
                                            </field>
                                            <!-- POP3 port должен быть целым числом. -->
                                            <field id="pop3Port" caption="POP3 port">
                                                <!-- IntegerValidator предотвращает сохранение нечислового POP3-порта. -->
                                                <validator class="com.haulmont.cuba.gui.components.validators.IntegerValidator"/>
                                            </field>
                                            <!-- IMAP port должен быть целым числом. -->
                                            <field id="imapPort" caption="IMAP port">
                                                <!-- IntegerValidator предотвращает сохранение нечислового IMAP-порта. -->
                                                <validator class="com.haulmont.cuba.gui.components.validators.IntegerValidator"/>
                                            </field>
                                        </column>
                                    </fieldGroup>
                                </groupBox>
                                <!-- Признаки обязательности пароля сохраняются отдельным accordion без изменения контракта. -->
                                <groupBox id="emailAuthenticationBox" caption="msg://msgMailAuthentication" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="edit-accordion-section">
                                    <!-- FieldGroup сохраняет три boolean bindings обязательности пароля. -->
                                    <fieldGroup id="emailFieldPasswordRequired" datasource="userDs" width="100%">
                                        <!-- Boolean-поля располагаются вертикально и сохраняют исходный порядок. -->
                                        <column width="100%">
                                            <!-- SMTP password required управляет существующим required-state smtpPassword. -->
                                            <field id="smtpPasswordRequired"/>
                                            <!-- POP3 password required сохраняет существующий пользовательский флаг. -->
                                            <field id="pop3PasswordRequired"/>
                                            <!-- IMAP password required сохраняет существующий пользовательский флаг. -->
                                            <field id="imapPasswordRequired"/>
                                        </column>
                                    </fieldGroup>
                                </groupBox>
                                <!-- Учётные имена протоколов сгруппированы без изменения контракта. -->
                                <groupBox id="emailAccountsBox" caption="msg://msgMailAccounts" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="edit-accordion-section">
                                    <!-- FieldGroup сохраняет smtpUser/pop3User/imapUser и исходный datasource. -->
                                    <fieldGroup id="emailFieldGroupUser" datasource="userDs" width="100%" stylename="edit-form-control">
                                        <!-- Имена учётных записей располагаются вертикально на полной ширине. -->
                                        <column width="100%">
                                            <!-- SMTP user сохраняется в userDs.smtpUser. -->
                                            <field id="smtpUser" caption="SMTP user"/>
                                            <!-- POP3 user сохраняется в userDs.pop3User. -->
                                            <field id="pop3User" caption="POP3 user"/>
                                            <!-- IMAP user сохраняется в userDs.imapUser. -->
                                            <field id="imapUser" caption="IMAP user"/>
                                        </column>
                                    </fieldGroup>
                                </groupBox>
                                <!-- Пароли протоколов сгруппированы в отдельную закрытую по умолчанию секцию. -->
                                <groupBox id="emailPasswordsBox" caption="msg://msgMailPasswords" width="100%" spacing="true" margin="true" collapsable="true" collapsed="true" showAsPanel="true" stylename="edit-accordion-section">
                                    <!-- FieldGroup сохраняет smtpPassword/pop3Password/imapPassword и required-state. -->
                                    <fieldGroup id="emailFieldGroupPasswords" datasource="userDs" width="100%" stylename="edit-form-control">
                                        <!-- Password-поля располагаются вертикально на полной ширине. -->
                                        <column width="100%">
                                            <!-- SMTP password сохраняется в userDs.smtpPassword. -->
                                            <field id="smtpPassword" caption="SMTP password"/>
                                            <!-- POP3 password сохраняется в userDs.pop3Password. -->
                                            <field id="pop3Password" caption="POP3 password"/>
                                            <!-- IMAP password сохраняется в userDs.imapPassword. -->
                                            <field id="imapPassword" caption="IMAP password"/>
                                        </column>
                                    </fieldGroup>
                                </groupBox>
                            </vbox>
                        </scrollBox>
                    </tab>
                    <!-- AI-вкладка сохраняет существующую таблицу и CRUD-кнопки внутри общей карточки. -->
                    <tab id="aiSettingsTab" caption="msg://msgAiSettings" margin="true" spacing="true" expand="aiConfigsCard">
                        <!-- Карточка объединяет пояснение, действия и таблицу персональных AI-конфигураций. -->
                        <vbox id="aiConfigsCard" width="100%" height="100%" spacing="true" expand="aiConfigsTable" stylename="edit-card">
                            <!-- Пояснение предупреждает, что API-ключ не выводится в таблице. -->
                            <label value="msg://msgAiSettingsHint" stylename="light edit-help"/>
                            <!-- Панель сохраняет три существующие CRUD-кнопки AI-конфигураций. -->
                            <buttonsPanel id="aiConfigsButtonsPanel">
                                <!-- Create-кнопка сохраняет существующий component ID и caption. -->
                                <button id="aiConfigsCreateBtn" caption="msg://actions.Create" icon="CREATE_ACTION"/>
                                <!-- Edit-кнопка сохраняет существующий component ID и caption. -->
                                <button id="aiConfigsEditBtn" caption="msg://actions.Edit" icon="EDIT"/>
                                <!-- Remove-кнопка сохраняет существующий component ID и caption. -->
                                <button id="aiConfigsRemoveBtn" caption="msg://actions.Remove" icon="REMOVE"/>
                            </buttonsPanel>
                            <!-- Таблица показывает provider, model и active-state без API-ключа. -->
                            <table id="aiConfigsTable" width="100%" height="100%" editable="false">
                                <!-- Колонки сохраняют исходный набор безопасно отображаемых свойств. -->
                                <columns>
                                    <!-- Provider code идентифицирует AI-провайдера. -->
                                    <column id="providerCode"/>
                                    <!-- Default model name показывает выбранную модель провайдера. -->
                                    <column id="defaultModelName"/>
                                    <!-- Active-state показывает доступность конфигурации. -->
                                    <column id="isActive"/>
                                </columns>
                                <!-- Строки поступают из userAiConfigsDs текущего пользователя. -->
                                <rows datasource="userAiConfigsDs"/>
                            </table>
                        </vbox>
                    </tab>
                </tabSheet>
            </vbox>
        </hbox>
        <!-- Footer визуально отделяет штатные save/cancel actions от прокручиваемого workspace. -->
        <hbox id="bottomActionsBox" width="100%" spacing="true" align="BOTTOM_RIGHT" stylename="edit-footer-actions">
            <!-- Spacer сохраняет штатные действия выровненными справа. -->
            <label value="" expand="true"/>
            <!-- Стандартный fragment выполняет прежние commit/cancel actions UserEditor. -->
            <fragment id="windowActions" screen="editWindowActions"/>
        </hbox>
    </layout>
</window>
