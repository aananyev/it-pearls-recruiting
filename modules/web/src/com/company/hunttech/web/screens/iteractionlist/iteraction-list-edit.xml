<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Корневой экран объявляет editor взаимодействия и подключает пакет локализованных сообщений. -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://editorCaption"
        messagesPack="com.company.hunttech.web.screens.iteractionlist"
        icon="REORDER">
    <!-- Раздел данных связывает визуальные компоненты с редактируемой сущностью и справочниками. -->
    <data>
        <!-- Контейнер редактируемого взаимодействия хранит текущий экземпляр IteractionList и полный edit-view. -->
        <instance id="iteractionListDc"
                  class="com.company.hunttech.entity.IteractionList"
                  view="iteractionList-edit-view">
            <!-- Loader загружает или создаёт экземпляр, который редактирует экран. -->
            <loader id="iteractionListDl"/>
        </instance>
        <!-- Коллекция типов взаимодействий поставляет варианты для обязательного поля «Тип взаимодействия». -->
        <collection id="iteractionTypesDc"
                    class="com.company.hunttech.entity.Iteraction"
                    view="iteraction-list-type-view">
            <!-- Кэшируемый loader загружает допустимые типы после установки controller-параметра number. -->
            <loader id="iteractionTypesLc" cacheable="true">
                <!-- JPQL выбирает только элементы, включённые в дерево взаимодействий, и сортирует их по названию. -->
                <query>
                    <![CDATA[select e from hunttech_Iteraction e
                    where e.iteractionTree is not null
                    order by e.iterationName
                        ]]>
                    <!-- Условие добавляет фильтр по номеру группы дерева, выбранной business-controller. -->
                    <condition>
                        <!-- JPQL-условие подключает именованный параметр number без изменения базового запроса. -->
                        <c:jpql>
                            <!-- Фрагмент WHERE ограничивает типы одной веткой дерева взаимодействий. -->
                            <c:where>
                                e.iteractionTree.number like :number
                            </c:where>
                        </c:jpql>
                    </condition>
                </query>
            </loader>
        </collection>
        <!-- Коллекция вакансий поставляет варианты для поля «Вакансия» с учётом подразделения и подписок. -->
        <collection id="openPositionDc"
                    class="com.company.hunttech.entity.OpenPosition"
                    view="openPosition-iteraction-list-picker-view">
            <!-- Кэшируемый loader загружает вакансии и принимает параметры departament и subscriber от controller. -->
            <loader id="openPositionsDl" cacheable="true">
                <!-- JPQL возвращает вакансии в порядке состояния открытия и наименования. -->
                <query>
                    <![CDATA[select e from hunttech_OpenPosition e
                                order by e.openClose, e.vacansyName]]>
                    <!-- Составное условие объединяет фильтр подразделения и режим «только мои подписки». -->
                    <condition>
                        <!-- Логический AND требует одновременного выполнения включённых controller-ом фильтров. -->
                        <and>
                            <!-- Первый JPQL-фрагмент ограничивает вакансии текущим подразделением. -->
                            <c:jpql>
                                <!-- WHERE использует параметр departament, который устанавливает controller. -->
                                <c:where>
                                    e.companyDepartament = :departament
                                </c:where>
                            </c:jpql>
                            <!-- Второй JPQL-фрагмент ограничивает вакансии активными заданиями текущего рекрутёра. -->
                            <c:jpql>
                                <!-- WHERE проверяет подписчика, незакрытый статус задачи и действующий период подписки. -->
                                <c:where>
                                    e in (select k.openPosition from hunttech_RecrutiesTasks k
                                    where k.reacrutier = :subscriber
                                    and k.closed = false
                                    and current_date between k.startDate and k.endDate)
                                </c:where>
                            </c:jpql>
                        </and>
                    </condition>
                </query>
            </loader>
        </collection>
        <!-- Коллекция активных пользователей поставляет варианты ответственного рекрутёра. -->
        <collection id="usersDc"
                    class="com.haulmont.cuba.security.entity.User"
                    view="_minimal">
            <!-- Не кэшируемый loader исключает неактивных пользователей из выбора рекрутёра (без query cache: удаление пользователей при горячем кэше давало null-элемент и IllegalArgumentException «entity is null»). -->
            <loader id="usersDl">
                <!-- JPQL сортирует активных пользователей по отображаемому имени. -->
                <query>
                    <![CDATA[select e from sec$User e where e.active = true order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>

    <!-- Диалоговый режим разворачивает editor на всю доступную область браузера. -->
    <dialogMode height="100%" modal="true" width="100%"/>

    <!-- Корневой layout задаёт локальный CSS namespace и передаёт высоту двухпанельной компоновке. -->
    <layout stylename="iteraction-list-editor"
            expand="iteractionListMainLayout"
            spacing="false"
            width="100%"
            height="100%">
        <!-- Главный HBox делит экран на постоянную sidebar и расширяемую рабочую область. -->
        <hbox id="iteractionListMainLayout"
              stylename="iteraction-list-main-layout edit-screen-layout"
              width="100%"
              height="100%"
              spacing="false"
              expand="iteractionListWorkspace">

            <!-- Sidebar удерживает контекст кандидата, вакансии, навигацию и служебные сведения при прокрутке формы. -->
            <vbox id="iteractionListSidebar"
                  stylename="iteraction-list-sidebar edit-sidebar"
                  width="312px"
                  height="100%"
                  spacing="true"
                  expand="iteractionListSidebarSpacer">
                <!-- Профильный блок объединяет изображения, имя кандидата, служебные данные, статус и приоритет вакансии. -->
                <vbox id="iteractionProfileSummaryBox"
                      width="100%"
                      height="AUTO"
                      spacing="true"
                      stylename="iteraction-list-profile-header edit-sidebar-identity">
                    <!-- Горизонтальный контейнер показывает фотографию кандидата и логотип проекта одинакового размера. -->
                    <hbox id="iteractionIdentityImages"
                          width="100%"
                          height="AUTO"
                          spacing="true"
                          align="MIDDLE_CENTER"
                          stylename="iteraction-list-identity-images edit-sidebar-visual">
                        <!-- OvaFallbackImage кандидата читает фотографию из entity и показывает fallback при отсутствии файла. -->
                        <ovaFallbackImage id="candidateImage"
                                          dataContainer="iteractionListDc"
                                          property="candidate.fileImageFace"
                                          width="96px"
                                          height="96px"
                                          ovalWidth="96px"
                                          ovalHeight="96px"
                                          fallbackThemePath="icons/no-programmer.jpeg"
                                          visible="true"
                                          align="MIDDLE_CENTER"
                                          stylename="iteraction-list-context-image iteraction-list-candidate-image"
                                          scaleMode="SCALE_DOWN"/>
                        <!-- OvaFallbackImage проекта показывает логотип выбранной вакансии или нейтральный company fallback. -->
                        <ovaFallbackImage id="projectLogoImage"
                                          width="96px"
                                          height="96px"
                                          ovalWidth="96px"
                                          ovalHeight="96px"
                                          fallbackThemePath="icons/no-company.png"
                                          visible="true"
                                          align="MIDDLE_CENTER"
                                          stylename="iteraction-list-context-image iteraction-list-project-image"
                                          scaleMode="SCALE_DOWN"/>
                    </hbox>
                    <!-- Label имени идентифицирует кандидата, для которого создаётся взаимодействие. -->
                    <label id="iteractionCandidateNameLabel"
                           dataContainer="iteractionListDc"
                           property="candidate.fullName"
                           stylename="iteraction-list-profile-title edit-sidebar-title"
                           width="100%"
                           height="AUTO"
                           align="MIDDLE_CENTER"/>
                    <!-- Label вакансии фиксирует контекст взаимодействия до перехода к разделам ввода. -->
                    <label id="iteractionVacancyNameLabel"
                           dataContainer="iteractionListDc"
                           property="vacancy.vacansyName"
                           stylename="iteraction-list-profile-subtitle edit-sidebar-subtitle"
                           width="100%"
                           height="AUTO"
                           align="MIDDLE_CENTER"/>

                    <!-- Служебная карточка следует сразу за профилем кандидата и не смешивается с навигацией формы. -->
                    <vbox id="iteractionServiceCard"
                          width="100%"
                          height="AUTO"
                          spacing="false"
                          stylename="iteraction-list-sidebar-card iteraction-list-service-card edit-sidebar-summary">
                        <!-- Внутренний контейнер ограничивает оба служебных поля шириной карточки. -->
                        <vbox id="iteractionServiceFields"
                              width="100%"
                              height="AUTO"
                              spacing="true"
                              stylename="iteraction-list-service-fields">
                            <!-- Read-only поле показывает последовательный номер взаимодействия, назначенный business-controller. -->
                            <textField id="numberIteractionField"
                                       stylename="iteraction-list-service-field"
                                       dataContainer="iteractionListDc"
                                       property="numberIteraction"
                                       editable="false"
                                       caption="msg://msgNumber"
                                       width="100%"
                                       align="MIDDLE_LEFT"/>
                            <!-- Read-only поле показывает дату взаимодействия (только календарная дата без времени и минут). -->
                            <dateField id="dateIteractionField"
                                       stylename="iteraction-list-service-field"
                                       dataContainer="iteractionListDc"
                                       property="dateIteraction"
                                       editable="false"
                                       caption="msg://msgDate"
                                       resolution="DAY"
                                       dateFormat="dd.MM.yyyy"
                                       width="100%"
                                       align="MIDDLE_LEFT"/>
                        </vbox>
                    </vbox>

                    <!-- HBox располагает статус вакансии и её приоритет одной горизонтальной парой 50/50. -->
                    <hbox id="vacancyStateSummary"
                          width="100%"
                          height="AUTO"
                          spacing="true"
                          align="TOP_LEFT"
                          stylename="iteraction-list-vacancy-state-summary edit-sidebar-summary">
                        <!-- Левая ячейка содержит состояние открытия вакансии и предупреждение об альтернативных вакансиях. -->
                        <vbox id="vacancyStatusSummary"
                              width="50%"
                              height="AUTO"
                              spacing="false"
                              stylename="iteraction-list-vacancy-state-cell iteraction-list-sidebar-info-row">
                            <!-- Caption объясняет, что следующее значение относится к статусу вакансии. -->
                            <label value="msg://msgStatusOfVacansy"
                                   width="100%"
                                   stylename="iteraction-list-sidebar-caption"/>
                            <!-- Строка значения объединяет текст статуса и условную кнопку предупреждения. -->
                            <hbox id="vacancyStatusValueBox"
                                  width="100%"
                                  height="AUTO"
                                  spacing="true"
                                  align="MIDDLE_LEFT"
                                  expand="statusOfVacansyLabel"
                                  stylename="iteraction-list-sidebar-value-row">
                                <!-- Label получает вычисленный controller-ом текст «Открыта» или «Закрыта». -->
                                <label id="statusOfVacansyLabel"
                                       width="100%"
                                       height="AUTO"
                                       align="MIDDLE_LEFT"
                                       stylename="iteraction-list-sidebar-value iteraction-list-status-value"/>
                                <!-- LinkButton сигнализирует о найденных альтернативных вакансиях и остаётся скрытым без предупреждения. -->
                                <linkButton id="alternativeVacancyLinkButton"
                                            visible="false"
                                            descriptionAsHtml="true"
                                            description="msg://msgAlarmAlternativeVacancy"
                                            stylename="huge iteraction-list-sidebar-warning edit-sidebar-warning"
                                            icon="WARNING"/>
                            </hbox>
                        </vbox>
                        <!-- Правая ячейка показывает текущий приоритет вакансии и его визуальный индикатор. -->
                        <vbox id="vacancyPrioritySummary"
                              width="50%"
                              height="AUTO"
                              spacing="false"
                              stylename="iteraction-list-vacancy-state-cell iteraction-list-sidebar-info-row">
                            <!-- Caption объясняет, что следующая строка содержит приоритет вакансии. -->
                            <label value="msg://msgPriority"
                                   width="100%"
                                   stylename="iteraction-list-sidebar-caption"/>
                            <!-- Строка значения объединяет светофор приоритета и его текстовое название. -->
                            <hbox id="vacancyPriorityValueBox"
                                  width="100%"
                                  height="AUTO"
                                  spacing="true"
                                  align="MIDDLE_LEFT"
                                  expand="currentPriorityLabel"
                                  stylename="iteraction-list-sidebar-value-row">
                                <!-- Image отображает назначенный controller-ом графический индикатор приоритета. -->
                                <image id="trafficLighterImage"
                                       width="AUTO"
                                       height="AUTO"
                                       align="MIDDLE_LEFT"
                                       stylename="iteraction-list-priority-image"/>
                                <!-- Label выводит человекочитаемое значение приоритета вакансии. -->
                                <label id="currentPriorityLabel"
                                       width="100%"
                                       height="AUTO"
                                       align="MIDDLE_LEFT"
                                       stylename="iteraction-list-sidebar-value"/>
                            </hbox>
                        </vbox>
                    </hbox>
                </vbox>


                <!-- Карточка вакансии раскрывает бизнес-контекст выбранной позиции без перехода в отдельный экран. -->
                <vbox id="iteractionVacancyCard"
                      width="100%"
                      height="AUTO"
                      spacing="true"
                      stylename="iteraction-list-sidebar-card iteraction-list-vacancy-card edit-sidebar-summary">
                    <!-- Заголовок «Вакансия» визуально отделяет vacancy context от служебных данных
                         взаимодействия; стиль — полоса-заголовок с двумя inset-линиями (контракт §4.1). -->
                    <label value="mainMsg://msgVacancy"
                           width="100%"
                           height="AUTO"
                           stylename="iteraction-list-sidebar-card-title"/>
                    <!-- Строка наименования повторяет выбранную вакансию внутри подробной vacancy-card. -->
                    <vbox id="sidebarVacancyNameRow"
                          width="100%"
                          height="AUTO"
                          spacing="false"
                          stylename="iteraction-list-sidebar-info-row iteraction-list-vacancy-name-row">
                        <!-- Caption поясняет значение связанного ниже названия вакансии. -->
                        <label value="msg://msgVacancyName"
                               width="100%"
                               height="AUTO"
                               stylename="iteraction-list-sidebar-caption"/>
                        <!-- Label читает vacancy.vacansyName из текущего взаимодействия без дополнительного loader. -->
                        <label id="sidebarVacancyNameLabel"
                               dataContainer="iteractionListDc"
                               property="vacancy.vacansyName"
                               width="100%"
                               height="AUTO"
                               stylename="iteraction-list-sidebar-value iteraction-list-vacancy-name-value"/>
                    </vbox>
                    <!-- Скрытый label отображает controller-сообщение о сроке закрытия вакансии, когда оно актуально. -->
                    <label id="closingDateVacancyLabel"
                           stylename="h4 iteraction-list-closing-date"
                           width="100%"
                           visible="false"
                           height="AUTO"
                           align="MIDDLE_LEFT"/>
                    <!-- Контейнер компании и подразделения группирует caption и вычисленное HTML-значение. -->
                    <vbox id="vacancyCompanyDepartmentBox"
                          width="100%"
                          height="AUTO"
                          spacing="false"
                          stylename="iteraction-list-sidebar-info-row">
                        <!-- Caption обозначает организационный контекст вакансии. -->
                        <label value="msg://msgCompanyDepartament"
                               width="100%"
                               height="AUTO"
                               stylename="iteraction-list-sidebar-caption"/>
                        <!-- Label принимает сформированное controller-ом HTML-наименование компании и подразделения. -->
                        <label id="companyLabel"
                               width="100%"
                               height="AUTO"
                               htmlEnabled="true"
                               stylename="iteraction-list-sidebar-value"/>
                    </vbox>
                    <!-- Контейнер проекта группирует caption и название проекта выбранной вакансии. -->
                    <vbox id="vacancyProjectBox"
                          width="100%"
                          height="AUTO"
                          spacing="false"
                          stylename="iteraction-list-sidebar-info-row">
                        <!-- Caption поясняет, что следующее значение относится к проекту вакансии. -->
                        <label value="msg://msgProject"
                               width="100%"
                               height="AUTO"
                               stylename="iteraction-list-sidebar-caption"/>
                        <!-- Label получает controller-ом название проекта или остаётся пустым при отсутствии связи. -->
                        <label id="projectLabel"
                               width="100%"
                               height="AUTO"
                               stylename="iteraction-list-sidebar-value"/>
                    </vbox>
                    <!-- Условный блок ставки показывается только для вакансий с применимой outstaffing-cost. -->
                    <hbox id="outstaffingCostHBox"
                          width="100%"
                          height="AUTO"
                          visible="false"
                          spacing="false"
                          align="MIDDLE_LEFT"
                          stylename="iteraction-list-sidebar-cost">
                        <!-- Вертикальный контейнер объединяет caption ставки и строку суммы с единицей измерения. -->
                        <vbox id="outstaffingCostContentBox" width="100%" height="AUTO" spacing="false">
                            <!-- Caption обозначает предельную ставку вакансии. -->
                            <label value="msg://msgOutstaffCost"
                                   width="100%"
                                   height="AUTO"
                                   align="MIDDLE_LEFT"
                                   stylename="iteraction-list-sidebar-caption"/>
                            <!-- Строка ставки размещает числовое значение и подпись «рублей в час». -->
                            <hbox id="outstaffingCostValueBox"
                                  width="100%"
                                  height="AUTO"
                                  spacing="true"
                                  align="MIDDLE_LEFT"
                                  stylename="iteraction-list-sidebar-cost-line">
                                <!-- Label читает outstaffingCost непосредственно из выбранной вакансии. -->
                                <label dataContainer="iteractionListDc"
                                       property="vacancy.outstaffingCost"
                                       width="AUTO"
                                       height="AUTO"
                                       align="MIDDLE_LEFT"
                                       stylename="iteraction-list-sidebar-cost-value"/>
                                <!-- Label поясняет единицу измерения числовой ставки. -->
                                <label value="msg://msgRubPerHour"
                                       width="AUTO"
                                       height="AUTO"
                                       align="MIDDLE_LEFT"
                                       stylename="iteraction-list-sidebar-cost-unit"/>
                            </hbox>
                        </vbox>
                    </hbox>
                    <!-- Контейнер контекста рейтинга резервирует место для условной оценки вакансии и пиктограммы. -->
                    <hbox id="vacancyRatingContextBox"
                          width="100%"
                          height="AUTO"
                          spacing="true"
                          align="MIDDLE_LEFT"
                          stylename="iteraction-list-rating-context">
                        <!-- Скрытый label выводит текстовую оценку, когда controller считает её применимой. -->
                        <label id="ratingLabel"
                               visible="false"
                               width="AUTO"
                               height="AUTO"
                               align="MIDDLE_LEFT"
                               stylename="h1"/>
                        <!-- Скрытое изображение визуализирует рейтинг, когда controller назначает ресурс и включает видимость. -->
                        <image id="ratingImage"
                               visible="false"
                               width="50px"
                               height="50px"
                               align="MIDDLE_LEFT"
                               scaleMode="FILL"/>
                    </hbox>
                </vbox>

                <!-- Spacer забирает оставшуюся высоту sidebar и удерживает информационные карточки сверху. -->
                <vbox id="iteractionListSidebarSpacer"
                      width="100%"
                      height="100%"
                      stylename="iteraction-list-sidebar-spacer edit-sidebar-spacer"/>
            </vbox>

            <!-- Рабочая область содержит toolbar, быстрые действия, прокручиваемые поля и постоянный footer. -->
            <vbox id="iteractionListWorkspace"
                  stylename="iteraction-list-workspace edit-workspace"
                  width="100%"
                  height="100%"
                  spacing="false"
                  expand="iteractionListContentScrollBox">
                <!-- Toolbar показывает назначение editor и контекст текущего списка взаимодействий. -->
                <hbox id="iteractionListToolbarBox"
                      stylename="iteraction-list-toolbar edit-toolbar"
                      width="100%"
                      height="AUTO"
                      spacing="true"
                      expand="iteractionListToolbarTitleBox"
                      align="MIDDLE_LEFT">
                    <!-- Контейнер заголовков вертикально объединяет основное название и поясняющую строку. -->
                    <vbox id="iteractionListToolbarTitleBox"
                          width="100%"
                          height="AUTO"
                          spacing="false"
                          stylename="iteraction-list-toolbar-title-box">
                        <!-- Основной заголовок сообщает, что пользователь редактирует список взаимодействий. -->
                        <label value="msg://editorCaption"
                               width="100%"
                               height="AUTO"
                               stylename="iteraction-list-toolbar-title edit-toolbar-title"/>
                        <!-- Контекстная строка уточняет тип редактируемых данных. -->
                        <label value="msg://msgIteractionList"
                               width="100%"
                               height="AUTO"
                               stylename="iteraction-list-toolbar-context edit-toolbar-description"/>
                    </vbox>
                </hbox>

                <!-- Карточка быстрых действий позволяет одним кликом выбрать один из пяти частых типов взаимодействия. -->
                <vbox id="mostPopularQuickActions"
                      width="100%"
                      height="AUTO"
                      spacing="true"
                      stylename="iteraction-list-quick-actions edit-card">
                    <!-- Заголовок объясняет назначение динамически созданных кнопок. -->
                    <label value="msg://mshMostPopular"
                           width="100%"
                           height="AUTO"
                           stylename="iteraction-list-quick-actions-title edit-card-title"/>
                    <!-- Host-контейнер изолирует runtime-ряд кнопок от внешней карточки. -->
                    <hbox id="mostPopularIteractionHBox"
                          width="100%"
                          height="AUTO"
                          spacing="false"
                          stylename="iteraction-list-popular-host">
                        <!-- Runtime-контейнер получает пять реальных или disabled-кнопок из business-controller. -->
                        <hbox id="mostPopularHbox"
                              width="100%"
                              height="AUTO"
                              spacing="true"
                              align="MIDDLE_CENTER"
                              stylename="iteraction-list-popular-buttons"/>
                    </hbox>
                </vbox>

                <!-- Вертикальный ScrollBox прокручивает только блоки ввода, сохраняя toolbar, быстрые действия и footer. -->
                <scrollBox id="iteractionListContentScrollBox"
                           orientation="vertical"
                           width="100%"
                           height="100%"
                           stylename="iteraction-list-scroll edit-workspace-scroll">
                    <!-- Контейнер контента располагает четыре смысловых блока формы вертикально друг под другом. -->
                    <vbox id="iteractionListSectionsBox"
                          width="100%"
                          height="AUTO"
                          spacing="true"
                          margin="true"
                          stylename="iteraction-list-content iteraction-list-flat-content edit-workspace-content">

                        <!-- Единый блок всей информации взаимодействия объединяет участников, тип, результат и комментарий. -->
                        <vbox id="iteractionMainInfoCard"
                              width="100%"
                              height="AUTO"
                              spacing="false"
                              stylename="iteraction-list-flat-section iteraction-list-form-section iteraction-list-unified-card edit-card">
                            <!-- Body содержит все поля ввода формы в едином блоке. -->
                            <vbox id="iteractionMainInfoBody"
                                  width="100%"
                                  height="AUTO"
                                  spacing="true"
                                  margin="true"
                                  stylename="iteraction-list-flat-section-body iteraction-list-unified-body iteraction-list-section-content">
                                <!-- Участники: Кандидат и Вакансия -->
                                <grid id="gridIterationData"
                                      width="100%"
                                      height="AUTO"
                                      spacing="true"
                                      stylename="iteraction-list-form-grid iteraction-list-participants-grid">
                                    <columns>
                                        <column width="50%"/>
                                        <column width="50%"/>
                                    </columns>
                                    <rows>
                                        <row id="row">
                                            <suggestionPickerField id="candidateField"
                                                                   inputPrompt="mainMsg://msgStartInput"
                                                                   minSearchStringLength="3"
                                                                   caption="msg://msgCandidate"
                                                                   stylename="edit-form-control iteraction-list-primary-picker"
                                                                   width="100%"
                                                                   height="AUTO"
                                                                   required="true"
                                                                   dataContainer="iteractionListDc"
                                                                   property="candidate">
                                                <actions>
                                                    <action id="lookup" type="picker_lookup"/>
                                                    <action id="open" type="picker_open" icon="EDIT_ACTION"/>
                                                </actions>
                                                <query entityClass="com.company.hunttech.entity.JobCandidate"
                                                       view="jobCandidate-iteraction-list-suggestion-view"
                                                       escapeValueForLike="true"
                                                       searchStringFormat="%$searchString%">
                                                    select e
                                                    from hunttech_JobCandidate e
                                                    where lower(e.fullName) like lower(:searchString) escape '\'
                                                    and e.middleName not like '(не использовать)'
                                                    and not e.blockCandidate = true
                                                    order by e.secondName, e.firstName
                                                </query>
                                            </suggestionPickerField>
                                            <!-- LookupPickerField выбирает вакансию из отфильтрованного openPositionDc. -->
                                            <lookupPickerField id="vacancyFiels"
                                                               caption="mainMsg://msgVacancy"
                                                               dataContainer="iteractionListDc"
                                                               optionsContainer="openPositionDc"
                                                               property="vacancy"
                                                               height="AUTO"
                                                               width="100%"
                                                               stylename="edit-form-control iteraction-list-primary-picker">
                                                <actions>
                                                    <action id="lookup" type="picker_lookup"/>
                                                    <action id="open" type="picker_open" icon="EDIT_ACTION"/>
                                                </actions>
                                            </lookupPickerField>
                                        </row>
                                    </rows>
                                </grid>
                                <checkBox id="onlyMySubscribeCheckBox"
                                          width="100%"
                                          height="AUTO"
                                          align="MIDDLE_LEFT"
                                          description="msg://msgOnlyMySebscribeDec"
                                          caption="msg://msgOnlyMySubscribe"
                                          stylename="iteraction-list-subscription-filter"/>

                                <!-- Тип взаимодействия и динамические поля действия -->
                                <lookupPickerField id="iteractionTypeField"
                                                   optionsContainer="iteractionTypesDc"
                                                   caption="msg://msgIteractionType"
                                                   width="100%"
                                                   height="AUTO"
                                                   stylename="edit-form-control"
                                                   required="true"
                                                   dataContainer="iteractionListDc"
                                                   property="iteractionType">
                                    <actions>
                                        <action id="lookup" type="picker_lookup"/>
                                    </actions>
                                </lookupPickerField>
                                <buttonsPanel id="buttonsPanelCallAction"
                                              width="100%"
                                              height="AUTO"
                                              align="BOTTOM_LEFT"
                                              stylename="iteraction-list-dynamic-panel">
                                    <vbox id="dynamicActionFieldsBox" width="100%" height="AUTO" spacing="true">
                                        <button id="buttonCallAction"
                                                invoke="callActionEntity"
                                                width="100%"
                                                align="BOTTOM_LEFT"/>
                                        <textField id="addString"
                                                   dataContainer="iteractionListDc"
                                                   property="addString"
                                                   width="100%"/>
                                        <dateField id="addDate"
                                                   dataContainer="iteractionListDc"
                                                   property="addDate"
                                                   width="100%"/>
                                        <textField id="addInteger"
                                                   dataContainer="iteractionListDc"
                                                   property="addInteger"
                                                   width="100%"/>
                                    </vbox>
                                </buttonsPanel>

                                <!-- Оценка, рекрутер и способ связи -->
                                <grid id="resultAccordionGrid"
                                      width="100%"
                                      height="AUTO"
                                      spacing="true"
                                      stylename="iteraction-list-form-grid iteraction-list-result-grid">
                                    <columns>
                                        <column width="50%"/>
                                        <column width="50%"/>
                                    </columns>
                                    <rows>
                                        <row id="rating">
                                            <lookupField id="ratingField"
                                                         required="true"
                                                         align="MIDDLE_LEFT"
                                                         caption="msg://msgRating"
                                                         dataContainer="iteractionListDc"
                                                         property="rating"
                                                         description="msg://msgRatingDecription"
                                                         stylename="edit-form-control"
                                                         width="100%"/>
                                            <lookupPickerField id="recrutierField"
                                                               caption="msg://msgRecrutier"
                                                               width="100%"
                                                               dataContainer="iteractionListDc"
                                                               property="recrutier"
                                                               stylename="edit-form-control"
                                                               optionsContainer="usersDc">
                                                <actions>
                                                    <action id="lookup" type="picker_lookup"/>
                                                </actions>
                                            </lookupPickerField>
                                        </row>
                                        <row>
                                            <textField id="communicationMethodField"
                                                       width="100%"
                                                       caption="msg://msgCommunicationMethod"
                                                       dataContainer="iteractionListDc"
                                                       property="communicationMethod"
                                                       stylename="edit-form-control"
                                                       colspan="2"/>
                                        </row>
                                    </rows>
                                </grid>

                                <!-- TextArea сохраняет обязательное бизнес-описание контакта в свойство comment. -->
                                <textArea id="commentField"
                                          dataContainer="iteractionListDc"
                                          property="comment"
                                          caption="msg://msgComment"
                                          stylename="edit-form-control"
                                          width="100%"
                                          height="170px"
                                          rows="7"/>
                            </vbox>
                        </vbox>
                    </vbox>
                </scrollBox>

                <!-- Footer удерживает подписку, сохранение и отмену вне прокручиваемого содержимого. -->
                <hbox id="editActions"
                      stylename="iteraction-list-footer edit-footer-actions"
                      width="100%"
                      height="AUTO"
                      spacing="true"
                      expand="editActionsSpacer"
                      align="MIDDLE_RIGHT">
                    <!-- Spacer выталкивает группу действий к правому краю footer. -->
                    <vbox id="editActionsSpacer" width="100%" height="1px"/>
                    <!-- Группа действий объединяет пользовательские и стандартные editor-команды. -->
                    <hbox id="editActionsGroup"
                          width="AUTO"
                          height="AUTO"
                          spacing="true"
                          align="MIDDLE_RIGHT"
                          stylename="iteraction-list-footer-actions">
                        <!-- Button открывает или создаёт подписку пользователя на кандидата. -->
                        <button id="subscribeButton"
                                invoke="onButtonSubscribeClick"
                                caption="mainMsg://msgSubscribe"
                                icon="BELL"
                                stylename="iteraction-list-subscribe-action"/>
                        <!-- Стандартная action сохраняет IteractionList и закрывает editor. -->
                        <button action="windowCommitAndClose"
                                stylename="iteraction-list-primary-action"/>
                        <!-- Стандартная action закрывает editor без подтверждённого сохранения изменений. -->
                        <button action="windowClose"
                                stylename="iteraction-list-secondary-action"/>
                    </hbox>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>
