<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://editorCaption"
        messagesPack="com.company.hunttech.web.screens.iteractionlist"
        icon="REORDER">
    <data>
        <!-- Корневой контейнер хранит единственный редактируемый IteractionList.
             View остаётся прежним контрактом бизнес-контроллера и XML binding. -->
        <instance id="iteractionListDc"
                  class="com.company.hunttech.entity.IteractionList"
                  view="iteractionList-edit-view">
            <loader id="iteractionListDl"/>
        </instance>
        <!-- Справочник типов загружается прежним loader; presentation-навигация
             не меняет параметры и не запускает его самостоятельно. -->
        <collection id="iteractionTypesDc"
                    class="com.company.hunttech.entity.Iteraction"
                    view="iteraction-list-type-view">
            <loader id="iteractionTypesLc"
                    cacheable="true">
                <query>
                    <![CDATA[select e from hunttech_Iteraction e
                    where e.iteractionTree is not null
                    order by e.iterationName
                        ]]>
                    <condition>
                        <c:jpql>
                            <c:where>
                                e.iteractionTree.number like :number
                            </c:where>
                        </c:jpql>
                    </condition>
                </query>
            </loader>
        </collection>
        <!-- Вакансии используют прежний подписочный фильтр и узкий picker-view. -->
        <collection id="openPositionDc"
                    class="com.company.hunttech.entity.OpenPosition"
                    view="openPosition-iteraction-list-picker-view">
            <loader id="openPositionsDl"
                    cacheable="true">
                <query>
                    <![CDATA[select e from hunttech_OpenPosition e
                                order by e.openClose, e.vacansyName]]>
                    <condition>
                        <and>
                            <c:jpql>
                                <c:where>
                                    e.companyDepartament = :departament
                                </c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>
                                    e in (select k.openPosition from hunttech_RecrutiesTasks k
                                    where k.reacrutier = :subscriber
                                    and k.closed = false
                                    and current_date between k.startDate and k.endDate)
                                </c:where>
                            </c:jpql>
                        </and>
                    </condition>
                </query>
            </loader>
        </collection>
        <collection id="usersDc"
                    class="com.haulmont.cuba.security.entity.User"
                    view="_minimal">
            <loader id="usersDl"
                    cacheable="true">
                <query>
                    <![CDATA[select e from sec$User e where e.active = true order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>

    <dialogMode height="100%"
                modal="true"
                width="100%"/>

    <layout stylename="iteraction-list-editor"
            expand="iteractionListMainLayout"
            spacing="false"
            width="100%"
            height="100%">
        <hbox id="iteractionListMainLayout"
              stylename="iteraction-list-main-layout edit-screen-layout"
              width="100%"
              height="100%"
              spacing="false"
              expand="iteractionListWorkspace">

            <!-- Постоянная sidebar хранит идентичность и контекст взаимодействия.
                 Component ID и bindings сохранены для существующего контроллера. -->
            <vbox stylename="iteraction-list-sidebar edit-sidebar"
                  width="270px"
                  height="100%"
                  spacing="true"
                  expand="iteractionListSidebarSpacer">
                <vbox width="100%"
                      spacing="true"
                      stylename="iteraction-list-profile-header edit-sidebar-identity">
                    <hbox width="100%"
                          spacing="true"
                          align="MIDDLE_CENTER"
                          stylename="iteraction-list-identity-images edit-sidebar-visual">
                        <ovaFallbackImage id="candidateImage"
                                          dataContainer="iteractionListDc"
                                          property="candidate.fileImageFace"
                                          width="112px"
                                          height="112px"
                                          ovalWidth="112px"
                                          ovalHeight="112px"
                                          fallbackThemePath="icons/no-programmer.jpeg"
                                          visible="true"
                                          align="MIDDLE_CENTER"
                                          stylename="iteraction-list-candidate-image"
                                          scaleMode="SCALE_DOWN"/>
                        <ovaFallbackImage id="projectLogoImage"
                                          width="80px"
                                          height="80px"
                                          ovalWidth="80px"
                                          ovalHeight="80px"
                                          fallbackThemePath="icons/no-company.png"
                                          visible="true"
                                          align="MIDDLE_CENTER"
                                          stylename="iteraction-list-project-image"
                                          scaleMode="SCALE_DOWN"/>
                    </hbox>
                    <label id="iteractionCandidateNameLabel"
                           dataContainer="iteractionListDc"
                           property="candidate.fullName"
                           stylename="iteraction-list-profile-title edit-sidebar-title"
                           width="100%"
                           height="AUTO"
                           align="MIDDLE_CENTER"/>
                    <label id="iteractionVacancyNameLabel"
                           dataContainer="iteractionListDc"
                           property="vacancy.vacansyName"
                           stylename="iteraction-list-profile-subtitle edit-sidebar-subtitle"
                           width="100%"
                           height="AUTO"
                           align="MIDDLE_CENTER"/>
                </vbox>

                <!-- Fallback-label заменяются presentation-контроллером на четыре
                     keyboard-доступные кнопки реальных рабочих аккордеонов. -->
                <vbox id="iteractionListNavigation"
                      width="100%"
                      spacing="false"
                      stylename="label-navigation">
                    <label width="100%"
                           value="msg://msgAccordionNavigation"
                           stylename="label-nav-title"/>
                    <label width="100%"
                           value="msg://msgAccordionParticipants"
                           stylename="label-nav-item label-nav-item-active"/>
                    <label width="100%"
                           value="msg://msgAccordionInteraction"
                           stylename="label-nav-item"/>
                    <label width="100%"
                           value="msg://msgAccordionResult"
                           stylename="label-nav-item"/>
                    <label width="100%"
                           value="msg://msgAccordionComment"
                           stylename="label-nav-item"/>
                </vbox>

                <vbox width="100%"
                      spacing="true"
                      stylename="iteraction-list-sidebar-card iteraction-list-service-card edit-sidebar-summary">
                    <vbox width="100%"
                          spacing="true"
                          stylename="iteraction-list-service-fields">
                        <textField id="numberIteractionField"
                                   stylename="iteraction-list-service-field"
                                   dataContainer="iteractionListDc"
                                   property="numberIteraction"
                                   editable="false"
                                   caption="msg://msgNumber"
                                   width="100%"
                                   align="MIDDLE_LEFT"/>
                        <dateField id="dateIteractionField"
                                   stylename="iteraction-list-service-field"
                                   dataContainer="iteractionListDc"
                                   property="dateIteraction"
                                   editable="false"
                                   caption="msg://msgDate"
                                   width="100%"
                                   align="MIDDLE_LEFT"/>
                    </vbox>
                </vbox>

                <vbox width="100%"
                      spacing="true"
                      stylename="iteraction-list-sidebar-card iteraction-list-vacancy-card edit-sidebar-summary">
                    <label value="mainMsg://msgVacancy"
                           width="100%"
                           stylename="iteraction-list-sidebar-card-title"/>
                    <label id="closingDateVacancyLabel"
                           stylename="h4 iteraction-list-closing-date"
                           width="100%"
                           visible="false"
                           height="AUTO"
                           align="MIDDLE_LEFT"/>
                    <vbox width="100%"
                          spacing="false"
                          stylename="iteraction-list-sidebar-info-row">
                        <label value="msg://msgCompanyDepartament"
                               stylename="iteraction-list-sidebar-caption"
                               width="100%"/>
                        <label id="companyLabel"
                               stylename="iteraction-list-sidebar-value"
                               width="100%"
                               height="AUTO"
                               htmlEnabled="true"/>
                    </vbox>
                    <vbox width="100%"
                          spacing="false"
                          stylename="iteraction-list-sidebar-info-row">
                        <label value="msg://msgProject"
                               stylename="iteraction-list-sidebar-caption"
                               width="100%"/>
                        <label id="projectLabel"
                               stylename="iteraction-list-sidebar-value"
                               width="100%"
                               height="AUTO"/>
                    </vbox>
                    <vbox width="100%"
                          spacing="false"
                          stylename="iteraction-list-sidebar-info-row">
                        <label value="msg://msgStatusOfVacansy"
                               stylename="iteraction-list-sidebar-caption"
                               width="100%"/>
                        <hbox spacing="true"
                              width="100%"
                              align="MIDDLE_LEFT"
                              expand="statusOfVacansyLabel"
                              stylename="iteraction-list-sidebar-value-row">
                            <label id="statusOfVacansyLabel"
                                   width="100%"
                                   height="AUTO"
                                   stylename="iteraction-list-sidebar-value iteraction-list-status-value"
                                   align="MIDDLE_LEFT"/>
                            <linkButton id="alternativeVacancyLinkButton"
                                        visible="false"
                                        descriptionAsHtml="true"
                                        description="msg://msgAlarmAlternativeVacancy"
                                        stylename="huge iteraction-list-sidebar-warning edit-sidebar-warning"
                                        icon="WARNING"/>
                        </hbox>
                    </vbox>
                    <vbox width="100%"
                          spacing="false"
                          stylename="iteraction-list-sidebar-info-row">
                        <label value="msg://msgPriority"
                               stylename="iteraction-list-sidebar-caption"
                               width="100%"/>
                        <hbox spacing="true"
                              width="100%"
                              align="MIDDLE_LEFT"
                              expand="currentPriorityLabel"
                              stylename="iteraction-list-sidebar-value-row">
                            <image id="trafficLighterImage"
                                   width="AUTO"
                                   align="MIDDLE_LEFT"
                                   height="AUTO"
                                   stylename="iteraction-list-priority-image"/>
                            <label id="currentPriorityLabel"
                                   align="MIDDLE_LEFT"
                                   width="100%"
                                   height="AUTO"
                                   stylename="iteraction-list-sidebar-value"/>
                        </hbox>
                    </vbox>
                    <hbox id="outstaffingCostHBox"
                          spacing="false"
                          width="100%"
                          visible="false"
                          align="MIDDLE_LEFT"
                          stylename="iteraction-list-sidebar-cost">
                        <vbox width="100%"
                              spacing="false">
                            <label value="msg://msgOutstaffCost"
                                   stylename="iteraction-list-sidebar-caption"
                                   width="100%"
                                   align="MIDDLE_LEFT"/>
                            <hbox width="100%"
                                  spacing="true"
                                  align="MIDDLE_LEFT"
                                  stylename="iteraction-list-sidebar-cost-line">
                                <label dataContainer="iteractionListDc"
                                       align="MIDDLE_LEFT"
                                       property="vacancy.outstaffingCost"
                                       width="AUTO"
                                       stylename="iteraction-list-sidebar-cost-value"/>
                                <label value="msg://msgRubPerHour"
                                       stylename="iteraction-list-sidebar-cost-unit"
                                       width="AUTO"
                                       align="MIDDLE_LEFT"/>
                            </hbox>
                        </vbox>
                    </hbox>
                    <hbox id="labelHBox"
                          stylename="iteraction-list-rating-context"
                          width="100%"
                          spacing="true"
                          align="MIDDLE_LEFT">
                        <label id="ratingLabel"
                               stylename="h1"
                               width="AUTO"
                               visible="false"
                               height="AUTO"
                               align="MIDDLE_LEFT"/>
                        <image id="ratingImage"
                               scaleMode="FILL"
                               visible="false"
                               width="50px"
                               height="50px"
                               align="MIDDLE_LEFT"/>
                    </hbox>
                </vbox>

                <vbox id="iteractionListSidebarSpacer"
                      width="100%"
                      height="100%"
                      stylename="iteraction-list-sidebar-spacer edit-sidebar-spacer"/>
            </vbox>

            <!-- Правая область имеет фиксированные toolbar, quick actions и footer;
                 прокручивается только естественная аккордеонная область. -->
            <vbox id="iteractionListWorkspace"
                  stylename="iteraction-list-workspace edit-workspace"
                  width="100%"
                  height="100%"
                  spacing="false"
                  expand="iteractionListContentScrollBox">
                <hbox stylename="iteraction-list-toolbar edit-toolbar"
                      width="100%"
                      spacing="true"
                      expand="iteractionListToolbarTitleBox"
                      align="MIDDLE_LEFT">
                    <vbox id="iteractionListToolbarTitleBox"
                          width="100%"
                          spacing="false"
                          stylename="iteraction-list-toolbar-title-box">
                        <label value="msg://editorCaption"
                               stylename="iteraction-list-toolbar-title edit-toolbar-title"
                               width="100%"/>
                        <label value="msg://msgIteractionList"
                               stylename="iteraction-list-toolbar-context edit-toolbar-description"
                               width="100%"/>
                    </vbox>
                </hbox>

                <!-- Блок всегда находится вне GroupBox. Базовый контроллер создаёт
                     кнопки из точных Iteraction; extension добавляет disabled-заглушки. -->
                <vbox id="mostPopularQuickActions"
                      width="100%"
                      height="AUTO"
                      spacing="true"
                      stylename="iteraction-list-quick-actions edit-card">
                    <label value="msg://mshMostPopular"
                           width="100%"
                           stylename="iteraction-list-quick-actions-title edit-card-title"/>
                    <hbox id="mostPopularIteractionHBox"
                          width="100%"
                          height="AUTO"
                          spacing="false"
                          stylename="iteraction-list-popular-host">
                        <hbox id="mostPopularHbox"
                              width="100%"
                              height="AUTO"
                              spacing="true"
                              align="MIDDLE_CENTER"
                              stylename="iteraction-list-popular-buttons"/>
                    </hbox>
                </vbox>

                <scrollBox id="iteractionListContentScrollBox"
                           orientation="vertical"
                           width="100%"
                           height="100%"
                           stylename="iteraction-list-scroll edit-workspace-scroll">
                    <vbox width="100%"
                          height="AUTO"
                          spacing="true"
                          stylename="iteraction-list-content edit-workspace-content">
                        <groupBox id="participantsAccordion"
                                  caption="Кандидат и вакансия"
                                  width="100%"
                                  height="AUTO"
                                  spacing="true"
                                  margin="true"
                                  collapsable="true"
                                  collapsed="false"
                                  visible="true"
                                  showAsPanel="true"
                                  stylename="iteraction-list-accordion-section iteraction-list-form-section iteraction-list-participants-section edit-accordion-section">
                            <!-- Кандидат и вакансия сохраняют прежние bindings и picker actions.
                                 Подписочный фильтр остаётся отдельной строкой. -->
                            <grid id="gridIterationData"
                                  spacing="true"
                                  width="100%"
                                  height="AUTO"
                                  stylename="iteraction-list-form-grid">
                                <columns>
                                    <column flex="1"/>
                                    <column flex="1"/>
                                </columns>
                                <rows>
                                    <row id="row">
                                        <suggestionPickerField id="candidateField"
                                                               inputPrompt="mainMsg://msgStartInput"
                                                               minSearchStringLength="3"
                                                               caption="msg://msgCandidate"
                                                               stylename="iteraction-list-primary-picker"
                                                               width="100%"
                                                               height="AUTO"
                                                               required="true"
                                                               dataContainer="iteractionListDc"
                                                               property="candidate">
                                            <actions>
                                                <action id="lookup" type="picker_lookup"/>
                                                <action id="open" type="picker_open" icon="EDIT_ACTION"/>
                                            </actions>
                                            <query entityClass="com.company.hunttech.entity.JobCandidate"
                                                   view="jobCandidate-iteraction-list-suggestion-view"
                                                   escapeValueForLike="true"
                                                   searchStringFormat="%$searchString%">
                                                select e
                                                from hunttech_JobCandidate e
                                                where lower(e.fullName) like lower(:searchString) escape '\'
                                                and e.middleName not like '(не использовать)'
                                                and not e.blockCandidate = true
                                                order by e.secondName, e.firstName
                                            </query>
                                        </suggestionPickerField>
                                        <lookupPickerField id="vacancyFiels"
                                                           caption="mainMsg://msgVacancy"
                                                           dataContainer="iteractionListDc"
                                                           optionsContainer="openPositionDc"
                                                           property="vacancy"
                                                           height="AUTO"
                                                           stylename="iteraction-list-primary-picker"
                                                           width="100%">
                                            <actions>
                                                <action id="lookup" type="picker_lookup"/>
                                                <action id="open" type="picker_open" icon="EDIT_ACTION"/>
                                            </actions>
                                        </lookupPickerField>
                                    </row>
                                </rows>
                            </grid>
                            <checkBox id="onlyMySubscribeCheckBox"
                                      align="MIDDLE_LEFT"
                                      width="100%"
                                      height="AUTO"
                                      description="msg://msgOnlyMySebscribeDec"
                                      caption="msg://msgOnlyMySubscribe"
                                      stylename="iteraction-list-subscription-filter"/>
                        </groupBox>

                        <groupBox id="interactionAccordion"
                                  caption="msg://msgAccordionInteraction"
                                  width="100%"
                                  height="AUTO"
                                  spacing="true"
                                  margin="true"
                                  collapsable="true"
                                  collapsed="true"
                                  showAsPanel="true"
                                  stylename="iteraction-list-accordion-section iteraction-list-form-section edit-accordion-section">
                            <!-- Runtime visible, required, caption и значения динамических полей
                                 остаются бизнес-контрактом IteractionListEdit. -->
                            <vbox width="100%"
                                  height="AUTO"
                                  spacing="true"
                                  stylename="iteraction-list-dynamic-fields">
                                <lookupPickerField id="iteractionTypeField"
                                                   optionsContainer="iteractionTypesDc"
                                                   caption="msg://msgIteractionType"
                                                   width="100%"
                                                   height="AUTO"
                                                   required="true"
                                                   dataContainer="iteractionListDc"
                                                   property="iteractionType">
                                    <actions>
                                        <action id="lookup" type="picker_lookup"/>
                                    </actions>
                                </lookupPickerField>
                                <buttonsPanel id="buttonsPanelCallAction"
                                              width="100%"
                                              align="BOTTOM_LEFT"
                                              stylename="iteraction-list-dynamic-panel">
                                    <vbox width="100%"
                                          spacing="true">
                                        <button id="buttonCallAction"
                                                invoke="callActionEntity"
                                                align="BOTTOM_LEFT"
                                                width="100%"/>
                                        <textField id="addString"
                                                   dataContainer="iteractionListDc"
                                                   property="addString"
                                                   width="100%"/>
                                        <dateField id="addDate"
                                                   dataContainer="iteractionListDc"
                                                   property="addDate"
                                                   width="100%"/>
                                        <textField id="addInteger"
                                                   dataContainer="iteractionListDc"
                                                   property="addInteger"
                                                   width="100%"/>
                                    </vbox>
                                </buttonsPanel>
                            </vbox>
                        </groupBox>

                        <groupBox id="resultAccordion"
                                  caption="msg://msgAccordionResult"
                                  width="100%"
                                  height="AUTO"
                                  spacing="true"
                                  margin="true"
                                  collapsable="true"
                                  collapsed="true"
                                  showAsPanel="true"
                                  stylename="iteraction-list-accordion-section iteraction-list-form-section edit-accordion-section">
                            <grid id="resultAccordionGrid"
                                  spacing="true"
                                  width="100%"
                                  height="AUTO"
                                  stylename="iteraction-list-form-grid">
                                <columns>
                                    <column flex="1"/>
                                    <column flex="1"/>
                                </columns>
                                <rows>
                                    <row id="rating">
                                        <lookupField id="ratingField"
                                                     required="true"
                                                     align="MIDDLE_LEFT"
                                                     caption="msg://msgRating"
                                                     dataContainer="iteractionListDc"
                                                     property="rating"
                                                     description="msg://msgRatingDecription"
                                                     width="100%"/>
                                        <lookupPickerField id="recrutierField"
                                                           caption="msg://msgRecrutier"
                                                           width="100%"
                                                           dataContainer="iteractionListDc"
                                                           property="recrutier"
                                                           optionsContainer="usersDc">
                                            <actions>
                                                <action id="lookup" type="picker_lookup"/>
                                            </actions>
                                        </lookupPickerField>
                                    </row>
                                    <row>
                                        <textField id="communicationMethodField"
                                                   width="100%"
                                                   caption="msg://msgCommunicationMethod"
                                                   dataContainer="iteractionListDc"
                                                   property="communicationMethod"
                                                   colspan="2"/>
                                    </row>
                                </rows>
                            </grid>
                        </groupBox>

                        <groupBox id="commentAccordion"
                                  caption="msg://msgAccordionComment"
                                  width="100%"
                                  height="AUTO"
                                  spacing="true"
                                  margin="true"
                                  collapsable="true"
                                  collapsed="true"
                                  showAsPanel="true"
                                  stylename="iteraction-list-accordion-section iteraction-list-comment-section edit-accordion-section">
                            <textArea id="commentField"
                                      property="comment"
                                      rows="7"
                                      width="100%"
                                      dataContainer="iteractionListDc"
                                      caption="msg://msgComment"
                                      height="170px"/>
                        </groupBox>

                        <!-- Невидимый compatibility-компонент требуется для legacy-инъекции
                             базового контроллера. Он не является рабочим разделом и не входит
                             в label-navigation или пользовательский аккордеонный сценарий. -->
                        <groupBox id="popularAccordion"
                                  visible="false"
                                  width="100%"
                                  height="AUTO"
                                  collapsable="true"
                                  collapsed="true"
                                  stylename="iteraction-list-popular-section"/>
                    </vbox>
                </scrollBox>

                <hbox id="editActions"
                      stylename="iteraction-list-footer edit-footer-actions"
                      width="100%"
                      spacing="true"
                      expand="editActionsSpacer"
                      align="MIDDLE_RIGHT">
                    <vbox id="editActionsSpacer"
                          width="100%"
                          height="1px"/>
                    <hbox id="editActionsGroup"
                          width="AUTO"
                          spacing="true"
                          align="MIDDLE_RIGHT"
                          stylename="iteraction-list-footer-actions">
                        <button id="subscribeButton"
                                invoke="onButtonSubscribeClick"
                                caption="mainMsg://msgSubscribe"
                                icon="BELL"
                                stylename="iteraction-list-subscribe-action"/>
                        <button action="windowCommitAndClose"
                                stylename="iteraction-list-primary-action"/>
                        <button action="windowClose"
                                stylename="iteraction-list-secondary-action"/>
                    </hbox>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>
