<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://iteractionListReestrCaption"
        focusComponent="iteractionListsTable"
        messagesPack="com.company.hunttech.web.screens.iteractionlist"
        icon="EXCHANGE">
    <data readOnly="true">
        <collection id="iteractionListsDc"
                    class="com.company.hunttech.entity.IteractionList">
            <view extends="iteractionList-browse-view">
                <property name="candidate" view="_minimal">
                    <property name="fullName"/>
                    <property name="personPosition" view="_minimal">
                        <property name="positionRuName"/>
                    </property>
                    <property name="cityOfResidence" view="_minimal">
                        <property name="cityRuName"/>
                    </property>
                    <property name="fileImageFace" view="_minimal"/>
                </property>
                <property name="vacancy" view="_minimal">
                    <property name="vacansyName"/>
                    <property name="openClose"/>
                    <property name="projectName" view="_minimal">
                        <property name="projectName"/>
                    </property>
                </property>
                <property name="iteractionType" view="_minimal">
                    <property name="number"/>
                    <property name="iterationName"/>
                    <property name="pic"/>
                    <property name="outstaffingSign"/>
                </property>
                <property name="recrutier" view="extUser-picker-view"/>
                <property name="comment"/>
                <property name="communicationMethod"/>
            </view>
            <loader id="iteractionListsDl">
                <query><![CDATA[select e from hunttech_IteractionList e order by e.dateIteraction desc, e.numberIteraction desc]]>
                    <condition>
                        <and>
                            <c:jpql>
                                <c:where>e.createdBy like :userName</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.vacancy.internalProject = :internalProject</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.iteractionType.id in :outstaffingTypeIds</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.dateIteraction &gt;= :dateFrom</c:where>
                            </c:jpql>
                        </and>
                    </condition>
                </query>
            </loader>
        </collection>
    </data>

    <dialogMode height="700" width="1100"/>

    <layout expand="splitMainLayout" spacing="false" margin="false" stylename="job-candidate-editor edit-screen-layout">
        <split id="splitMainLayout" orientation="horizontal" pos="312px" min="260px" max="500px" width="100%" height="100%">
            <!-- ЛЕВЫЙ САЙДБАР (312px) -->
            <vbox id="detailPane" width="100%" height="100%" spacing="true" margin="false" stylename="edit-sidebar job-candidate-sidebar">
                <scrollBox id="sidebarScrollBox" width="100%" height="100%" spacing="true" scrollBars="vertical">
                    <vbox width="100%" spacing="true">
                        <!-- Шапка кандидата / взаимодействия -->
                        <vbox id="profileHeader" width="100%" spacing="true" align="TOP_CENTER" stylename="job-candidate-profile-header edit-sidebar-visual">
                            <ovaFallbackImage id="logoPic" width="120px" height="120px" ovalWidth="120px" ovalHeight="120px"
                                              align="TOP_CENTER" stylename="job-candidate-avatar" fallbackThemePath="icons/no-company.png" scaleMode="SCALE_DOWN"/>
                            <vbox width="100%" spacing="false" align="MIDDLE_CENTER" stylename="edit-sidebar-identity">
                                <label id="detailTitle" value="Выберите запись" width="100%" stylename="edit-sidebar-title h2 candidate-sidebar-fullname" align="MIDDLE_CENTER"/>
                                <label id="detailSubtitle" value="-" width="100%" stylename="edit-sidebar-subtitle h4 candidate-sidebar-position" align="MIDDLE_CENTER"/>
                                <label id="detailLocation" value="-" width="100%" stylename="edit-help candidate-sidebar-city" align="MIDDLE_CENTER"/>
                            </vbox>
                        </vbox>

                        <!-- Кнопки действий сайдбара -->
                        <vbox id="sidebarActionsCard" width="100%" spacing="true" stylename="edit-sidebar-summary">
                            <button id="openEditCardBtn" caption="Открыть взаимодействие" icon="EDIT_ACTION" stylename="primary" enabled="false" width="100%"/>
                            <button id="openCandidateCardBtn" caption="Открыть кандидата" icon="USER" enabled="false" width="100%"/>
                        </vbox>

                        <!-- Секция: Детали взаимодействия -->
                        <vbox id="termsCard" width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="ДЕТАЛИ ВЗАИМОДЕЙСТВИЯ" width="100%" stylename="label-nav-title job-candidate-section-title"/>
                            <grid id="termsGrid" spacing="true" width="100%" stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row><label value="Номер:" stylename="bold"/><label id="detailNumber" value="-"/></row>
                                    <row><label value="Дата:" stylename="bold"/><label id="detailDate" value="-"/></row>
                                    <row><label value="Рейтинг:" stylename="bold"/><label id="detailRating" htmlEnabled="true" value="-"/></row>
                                    <row><label value="Вакансия:" stylename="bold"/><label id="detailVacancy" value="-"/></row>
                                    <row><label value="Статус вакансии:" stylename="bold"/><label id="detailVacancyStatus" htmlEnabled="true" value="-"/></row>
                                    <row><label value="Рекрутер:" stylename="bold"/><label id="detailRecruiter" value="-"/></row>
                                    <row><label value="Способ связи:" stylename="bold"/><label id="detailCommMethod" value="-"/></row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Секция: Комментарий / содержание -->
                        <vbox id="commentCard" width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="КОММЕНТАРИЙ" width="100%" stylename="label-nav-title job-candidate-section-title"/>
                            <label id="detailComment" htmlEnabled="true" width="100%" stylename="edit-help"/>
                        </vbox>
                    </vbox>
                </scrollBox>
            </vbox>

            <!-- ПРАВАЯ РАБОЧАЯ ОБЛАСТЬ -->
            <vbox id="workspaceBox" width="100%" height="100%" spacing="true" stylename="edit-workspace candidate-reestr-workspace" expand="tableCard" margin="true,true,true,false">
                
                <!-- Командный тулбар -->
                <hbox id="tableFilterBar" width="100%" spacing="true" align="MIDDLE_LEFT" stylename="candidate-filter-bar edit-card" expand="toolbarSpacer">
                    <hbox id="leftActionButtons" spacing="true" align="MIDDLE_LEFT" stylename="filter-buttons-panel">
                        <button id="createBtn" caption="Создать взаимодействие" icon="CREATE_ACTION" stylename="primary candidate-btn candidate-create-btn" action="iteractionListsTable.create"/>
                        <button id="editBtn" caption="Редактировать" icon="EDIT_ACTION" stylename="secondary candidate-btn" action="iteractionListsTable.edit"/>
                        <button id="removeBtn" caption="Удалить" icon="REMOVE_ACTION" stylename="secondary candidate-btn" action="iteractionListsTable.remove"/>
                    </hbox>
                    <hbox id="toolbarSpacer" width="100%"/>
                    <hbox id="rightActionButtons" spacing="true" align="MIDDLE_RIGHT" stylename="filter-buttons-panel">
                        <label value="С даты:" align="MIDDLE_LEFT" stylename="edit-help" css="margin-right: 4px;"/>
                        <dateField id="dateFromField" width="115px"/>
                        <popupButton id="filterPopupButton" caption="Все взаимодействия" icon="FILTER" stylename="secondary candidate-btn">
                            <actions>
                                <action id="filterAll" caption="Все взаимодействия"/>
                                <action id="filterMyOnly" caption="Только мои взаимодействия"/>
                                <action id="filterOutstaffingOnly" caption="Только аутстаффинг"/>
                            </actions>
                        </popupButton>
                        <popupButton id="actionsPopupButton" caption="Действия" icon="BARS" stylename="primary candidate-btn">
                            <actions>
                                <action id="refreshAction" caption="Обновить данные" icon="REFRESH"/>
                                <action id="excelExportAction" caption="Выгрузить в Excel" icon="FILE_EXCEL_O"/>
                                <action id="copyCandidateSummaryAction" caption="Скопировать саммари" icon="COPY"/>
                            </actions>
                        </popupButton>
                    </hbox>
                </hbox>

                <!-- Generic Filter -->
                <filter id="filter"
                        applyTo="iteractionListsTable"
                        dataLoader="iteractionListsDl"
                        defaultMode="generic"
                        width="100%"
                        collapsable="true"
                        collapsed="true"
                        stylename="candidate-generic-filter">
                    <properties include=".*"
                                excludeProperties="addDate,addInteger,addString,addType,comment,communicationMethod,ID,iteractionChain,numberIteraction,recrutierName,id,version,createTs,createdBy,updateTs,updatedBy,deleteTs,deletedBy"/>
                </filter>

                <!-- Карточка таблицы с rowsCount -->
                <vbox id="tableCard" width="100%" height="100%" spacing="false" stylename="edit-card candidate-table-card" expand="iteractionListsTable">
                    <dataGrid id="iteractionListsTable"
                              width="100%"
                              height="100%"
                              dataContainer="iteractionListsDc"
                              stylename="borderless grid candidate-browse-grid">
                        <actions>
                            <action id="create" type="create"/>
                            <action id="edit" type="edit"/>
                            <action id="remove" type="remove"/>
                            <action id="excel" type="excelExport"/>
                            <action id="refresh" type="refresh"/>
                        </actions>
                        <columns>
                            <column id="numberIteraction"
                                    property="numberIteraction"
                                    caption="№"
                                    width="70px"/>
                            <column id="ratingStars"
                                    caption="Рейтинг"
                                    width="105px">
                                <componentRenderer/>
                            </column>
                            <column id="candidateFullName"
                                    property="candidate.fullName"
                                    caption="Кандидат"
                                    expandRatio="2"/>
                            <column id="iteractionType"
                                    property="iteractionType"
                                    caption="Тип взаимодействия"
                                    expandRatio="2"/>
                            <column id="vacancyProject"
                                    property="vacancy.projectName.projectName"
                                    caption="Проект"
                                    width="160px"/>
                            <column id="vacancyName"
                                    property="vacancy.vacansyName"
                                    caption="Вакансия"
                                    expandRatio="2"/>
                            <column id="vacancyStatus"
                                    caption="Статус вакансии"
                                    width="120px">
                                <componentRenderer/>
                            </column>
                            <column id="recrutier"
                                    property="recrutier"
                                    caption="Рекрутер"
                                    width="140px"/>
                            <column id="dateIteraction"
                                    property="dateIteraction"
                                    caption="Дата"
                                    width="110px"/>
                        </columns>
                        <rowsCount/>
                    </dataGrid>
                </vbox>
            </vbox>
        </split>
    </layout>
</window>
