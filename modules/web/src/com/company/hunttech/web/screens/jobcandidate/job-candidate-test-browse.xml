<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Тестовый экран брауза кандидатов по контракту Split-View (Master-Detail) в теме CUBA Halo.
     Не затрагивает основной экран hunttech_JobCandidate.browse. -->
<!-- Корневой элемент: тестовый экран просмотра кандидатов Split-View -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="Тест: Кандидаты (Split-View Halo)"
        messagesPack="com.company.hunttech.web.screens.jobcandidate"
        icon="USER">
    <!-- Секция данных экрана: декларативные контейнеры и лоадеры -->
    <data readOnly="true">
        <!-- Коллекция кандидатов загружает список сущностей JobCandidate с view по умолчанию -->
        <collection id="jobCandidatesDc"
                    class="com.company.hunttech.entity.JobCandidate"
                    view="jobCandidate-view">
            <!-- Загрузчик коллекции кандидатов ограничивает выборку 200 записями -->
            <loader id="jobCandidatesDl" maxResults="200">
                <!-- JPQL-запрос выбирает кандидатов, сортируя по дате создания по убыванию -->
                <query><![CDATA[select e from hunttech_JobCandidate e order by e.createTs desc]]></query>
            </loader>
        </collection>
    </data>

    <!-- Настройка размеров экрана при открытии в режиме диалога или lookup-окна -->
    <dialogMode height="700" width="1100"/>

    <!-- Корневой контейнер разметки экрана с вертикальным размещением тулбара и рабочей области -->
    <layout expand="splitMainLayout" spacing="false" width="100%" height="100%" stylename="job-candidate-editor edit-screen-layout">
        <!-- Верхний тулбар управления в фирменном дизайне Edit-форм (edit-toolbar) -->
        <hbox id="topToolbar" width="100%" spacing="true" align="MIDDLE_CENTER" stylename="edit-toolbar" expand="toolbarTitleBox">
            <!-- Левый заголовочный блок с названием концепта и описанием -->
            <vbox id="toolbarTitleBox" width="100%" spacing="false" align="MIDDLE_LEFT">
                <label value="Кандидаты (Split-View Halo)" stylename="edit-toolbar-title"/>
                <label value="Реестр кандидатов в теме Halo с профильной карточкой деталей" stylename="edit-toolbar-description"/>
            </vbox>

            <!-- Правая панель кнопок действий и поиска (edit-toolbar-actions) -->
            <hbox id="toolbarActions" spacing="true" align="MIDDLE_RIGHT" stylename="edit-toolbar-actions">
                <textField id="searchField" inputPrompt="Поиск по ФИО..." width="240px" stylename="edit-form-control"/>
                <button id="searchButton" caption="Поиск" icon="SEARCH" stylename="primary"/>
                <button id="createCandidateBtn" caption="Создать кандидата" icon="CREATE_ACTION" stylename="primary"/>
                <button id="refreshBtn" caption="Обновить" icon="REFRESH" stylename="secondary"/>
            </hbox>
        </hbox>

        <!-- Двухпанельная разметка Split-View: Левый профильный сайдбар Edit-формы (312px) + Таблица справа -->
        <hbox id="splitMainLayout" width="100%" height="100%" spacing="false" expand="candidatesTableBox" stylename="job-candidate-main-layout edit-screen-layout">
            
            <!-- ЛЕВАЯ ПАНЕЛЬ (САЙДБАР): Выдержана в фирменном стиле Edit-форм (job-candidate-sidebar edit-sidebar) -->
            <vbox id="candidateDetailPane" width="312px" height="100%" spacing="true" stylename="job-candidate-sidebar edit-sidebar">
                <!-- Скроллер для детального просмотра данных -->
                <scrollBox id="detailScroll" width="100%" height="100%" orientation="vertical">
                    <vbox width="100%" spacing="true">
                        <!-- Шапка профиля с фото, центрированным ФИО и городом -->
                        <vbox id="candidateProfileHeader" width="100%" spacing="true" align="TOP_CENTER" stylename="job-candidate-profile-header edit-sidebar-visual">
                            <ovaFallbackImage id="detailPic"
                                              width="120px" height="120px"
                                              ovalWidth="120px" ovalHeight="120px"
                                              align="TOP_CENTER"
                                              stylename="job-candidate-avatar"
                                              fallbackThemePath="icons/no-programmer.jpeg"
                                              scaleMode="SCALE_DOWN"/>
                            <vbox width="100%" spacing="false" align="MIDDLE_CENTER" stylename="edit-sidebar-identity">
                                <label id="detailFullName" value="Выберите кандидата" stylename="edit-sidebar-title h2" align="MIDDLE_CENTER"/>
                                <label id="detailPosition" value="" stylename="edit-sidebar-subtitle h4" align="MIDDLE_CENTER"/>
                                <label id="detailCity" value="" stylename="edit-help" align="MIDDLE_CENTER"/>
                            </vbox>
                        </vbox>

                        <!-- Кнопки действий -->
                        <vbox width="100%" spacing="true" stylename="edit-sidebar-summary">
                            <button id="editCandidateBtn" caption="Открыть карточку" icon="EDIT_ACTION" stylename="primary" enabled="false" width="100%"/>
                            <button id="createInteractionBtn" caption="Взаимодействие" icon="PLUS" enabled="false" width="100%"/>
                        </vbox>

                        <!-- Таблица ключевых контактов и реквизитов (стиль Edit-форм с линиями над и под заголовком) -->
                        <vbox width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="КОНТАКТЫ И РЕКВИЗИТЫ" width="100%" stylename="label-nav-title job-candidate-section-title"/>
                            <grid id="detailsGrid" spacing="true" width="100%" stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row>
                                        <label value="Телефон:" stylename="bold"/>
                                        <label id="detailPhone" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Email:" stylename="bold"/>
                                        <label id="detailEmail" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Telegram:" stylename="bold"/>
                                        <label id="detailTelegram" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Компания:" stylename="bold"/>
                                        <label id="detailCompany" value="-"/>
                                    </row>
                                    <row>
                                        <label id="detailSalaryCaption" value="Ожидания:" stylename="bold" visible="false"/>
                                        <label id="detailSalary" value="-" visible="false"/>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Лента активности/взаимодействий (стиль Edit-форм с линиями над и под заголовком) -->
                        <vbox width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="ПОСЛЕДНЯЯ АКТИВНОСТЬ" width="100%" stylename="label-nav-title job-candidate-section-title"/>
                            <label id="detailInteractionsInfo" value="Выберите кандидата в таблице для просмотра истории." width="100%" stylename="edit-help"/>
                        </vbox>

                        <!-- Блок основных навыков кандидата (стиль Edit-форм с цветными бейджами) -->
                        <vbox id="detailSkillsVBox" width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="ОСНОВНЫЕ НАВЫКИ" width="100%" stylename="label-nav-title job-candidate-section-title"/>
                            <label id="detailSkillsLabels" width="100%" htmlEnabled="true" stylename="candidate-skills-chips"/>
                        </vbox>
                    </vbox>
                </scrollBox>
            </vbox>
        </hbox>
    </layout>
</window>
