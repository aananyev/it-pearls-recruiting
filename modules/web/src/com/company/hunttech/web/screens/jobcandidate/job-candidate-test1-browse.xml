<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Эскиз 1: Split-View (Master-Detail) Browse в теме CUBA Halo -->
<!-- Корневой элемент: тестовый экран просмотра кандидатов Split-View -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="Тест 1: Split-View (Master-Detail)"
        messagesPack="com.company.hunttech.web.screens.jobcandidate"
        icon="TH_LIST">
    <!-- Секция данных экрана: декларативные контейнеры и лоадеры -->
    <data readOnly="true">
        <!-- Коллекция кандидатов загружает список сущностей JobCandidate с view по умолчанию -->
        <collection id="jobCandidatesDc"
                    class="com.company.hunttech.entity.JobCandidate"
                    view="jobCandidate-view">
            <!-- Загрузчик коллекции кандидатов ограничивает выборку 200 записями -->
            <loader id="jobCandidatesDl" maxResults="200">
                <!-- JPQL-запрос выбирает кандидатов, сортируя по дате создания по убыванию -->
                <query><![CDATA[select e from hunttech_JobCandidate e order by e.createTs desc]]></query>
            </loader>
        </collection>
    </data>

    <!-- Настройка размеров экрана при открытии в режиме диалога или lookup-окна -->
    <dialogMode height="700" width="1100"/>

    <!-- Корневой контейнер разметки экрана с базовыми стилями темы Edit-форм и правильными отступами -->
    <layout expand="splitMainLayout" spacing="true" width="100%" height="100%" stylename="job-candidate-editor edit-screen-layout">
        <!-- Верхний тулбар управления в фирменном дизайне Edit-форм (edit-toolbar) -->
        <hbox id="topToolbar" width="100%" spacing="true" align="MIDDLE_CENTER" stylename="edit-toolbar" expand="toolbarTitleBox">
            <!-- Левый заголовочный блок с названием концепта и описанием -->
            <vbox id="toolbarTitleBox" width="100%" spacing="false" align="MIDDLE_LEFT">
                <label value="Тест 1: Split-View (Master-Detail)" stylename="edit-toolbar-title"/>
                <label value="Реестр кандидатов с профильным сайдбаром и индикацией рекрутеров" stylename="edit-toolbar-description"/>
            </vbox>

            <!-- Правая панель кнопок действий и поиска (edit-toolbar-actions) -->
            <hbox id="toolbarActions" spacing="true" align="MIDDLE_RIGHT" stylename="edit-toolbar-actions">
                <!-- Текстовое поле ввода для быстрого поиска кандидатов по ФИО -->
                <textField id="searchField" inputPrompt="Поиск по ФИО..." width="240px" stylename="edit-form-control"/>
                <!-- Кнопка запуска поиска по введенному ФИО -->
                <button id="searchButton" caption="Поиск" icon="SEARCH" stylename="primary"/>
                <!-- Кнопка создания новой карточки кандидата -->
                <button id="createCandidateBtn" caption="Создать кандидата" icon="CREATE_ACTION" stylename="primary"/>
                <!-- Кнопка обновления текущего списка кандидатов из БД -->
                <button id="refreshBtn" caption="Обновить" icon="REFRESH" stylename="secondary"/>
            </hbox>
        </hbox>

        <!-- Двухпанельная разметка Split-View: Левый профильный сайдбар Edit-формы (312px) + Просторная рабочая область справа -->
        <hbox id="splitMainLayout" width="100%" height="100%" spacing="true" expand="candidatesTableBox" stylename="job-candidate-main-layout edit-screen-layout">
            
            <!-- ЛЕВАЯ ПАНЕЛЬ (САЙДБАР): Выдержана в фирменном стиле Edit-форм (job-candidate-sidebar edit-sidebar) -->
            <vbox id="candidateDetailPane" width="312px" height="100%" spacing="true" stylename="job-candidate-sidebar edit-sidebar">
                <!-- Скроллер для детального просмотра всех карточек данных -->
                <scrollBox id="detailScroll" width="100%" height="100%" orientation="vertical">
                    <!-- Вертикальная стопка блоков карточки детализации с комфортными отступами -->
                    <vbox width="100%" spacing="true">
                        <!-- Шапка профиля: гармоничный аватар 120x120px, ФИО и должность -->
                        <vbox id="candidateProfileHeader" width="100%" spacing="true" align="TOP_CENTER" stylename="job-candidate-profile-header edit-sidebar-visual">
                            <!-- Кастомное круглое фото с фолбеком на случай отсутствия изображения -->
                            <ovaFallbackImage id="detailPic"
                                              width="120px" height="120px"
                                              ovalWidth="120px" ovalHeight="120px"
                                              align="TOP_CENTER"
                                              stylename="job-candidate-avatar"
                                              fallbackThemePath="icons/no-programmer.jpeg"
                                              scaleMode="SCALE_DOWN"/>
                            <!-- Текстовый блок заголовка профиля с автопереносом строк и центрированием -->
                            <vbox width="100%" spacing="false" align="MIDDLE_CENTER" stylename="edit-sidebar-identity">
                                <!-- Подпись с ФИО выбранного кандидата (+30% шрифт, центрировано) -->
                                <label id="detailFullName" value="Выберите кандидата" stylename="edit-sidebar-title h2" align="MIDDLE_CENTER"/>
                                <!-- Подпись с текущей должностью кандидата -->
                                <label id="detailPosition" value="" stylename="edit-sidebar-subtitle h4" align="MIDDLE_CENTER"/>
                                <!-- Подпись с городом проживания кандидата (+30% шрифт, центрировано) -->
                                <label id="detailCity" value="" stylename="edit-help" align="MIDDLE_CENTER"/>
                            </vbox>
                        </vbox>

                        <!-- Панель быстрых действий над выбранным кандидатом -->
                        <vbox width="100%" spacing="true" stylename="edit-sidebar-summary">
                            <!-- Кнопка перехода к полному редактированию карточки -->
                            <button id="editCandidateBtn" caption="Открыть карточку" icon="EDIT_ACTION" stylename="primary" enabled="false" width="100%"/>
                            <!-- Кнопка быстрой регистрации нового взаимодействия -->
                            <button id="createInteractionBtn" caption="Взаимодействие" icon="PLUS" enabled="false" width="100%"/>
                        </vbox>

                        <!-- Блок ключевой контактной информации кандидата (label-navigation) -->
                        <vbox width="100%" spacing="true" stylename="label-navigation">
                            <label value="КОНТАКТЫ И РЕКВИЗИТЫ" stylename="label-nav-title"/>
                            <!-- Сетка контактов для упорядоченного вывода пар "ключ-значение" -->
                            <grid id="detailsGrid" spacing="true" width="100%" stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row>
                                        <label value="Телефон:" stylename="bold"/>
                                        <label id="detailPhone" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Email:" stylename="bold"/>
                                        <label id="detailEmail" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Telegram:" stylename="bold"/>
                                        <label id="detailTelegram" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Компания:" stylename="bold"/>
                                        <label id="detailCompany" value="-"/>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Блок истории взаимодействий кандидата (label-navigation) -->
                        <vbox width="100%" spacing="true" stylename="label-navigation">
                            <label value="ПОСЛЕДНЯЯ АКТИВНОСТЬ" stylename="label-nav-title"/>
                            <!-- Текстовое описание последних действий рекрутера -->
                            <label id="detailInteractionsInfo" value="Выберите кандидата в таблице справа для просмотра истории." width="100%" stylename="edit-help"/>
                        </vbox>
                    </vbox>
                </scrollBox>
            </vbox>

            <!-- ПРАВАЯ ПАНЕЛЬ: Рабочая область реестра (edit-workspace) -->
            <vbox id="candidatesTableBox" width="100%" height="100%" spacing="true" stylename="edit-workspace" expand="candidatesTableCard">
                
                <!-- Верхняя полоса быстрых фильтров, счетчиков и выпадающего меню действий -->
                <hbox id="tableFilterBar" width="100%" spacing="true" align="MIDDLE_LEFT" stylename="edit-card" expand="statusFilterButtons">
                    <!-- Заголовок реестра -->
                    <label id="tableTitleLabel" value="👤 Реестр кандидатов" stylename="h3" align="MIDDLE_LEFT"/>
                    
                    <!-- Кнопки быстрых фильтров по статусам рекрутеров -->
                    <hbox id="statusFilterButtons" spacing="true" align="MIDDLE_LEFT">
                        <button id="filterAllBtn" caption="Все кандидаты" stylename="primary" icon="USERS"/>
                        <button id="filterFreeBtn" caption="🟢 Свободные" stylename="secondary"/>
                        <button id="filterMyBtn" caption="🟡 В моей работе" stylename="secondary"/>
                        <button id="filterOtherBtn" caption="🔴 У других" stylename="secondary"/>
                    </hbox>

                    <!-- Выпадающая кнопка действий над кандидатом как в оригинальной форме -->
                    <popupButton id="actionsWithCandidateButton"
                                 caption="Действия"
                                 icon="BARS"
                                 showActionIcons="true"
                                 enabled="false"
                                 stylename="primary"
                                 align="MIDDLE_RIGHT">
                        <actions>
                            <action id="editCandidateAction" caption="Редактировать карточку" icon="EDIT_ACTION"/>
                            <action id="createInteractionAction" caption="Добавить взаимодействие" icon="PLUS"/>
                            <action id="sendEmailAction" caption="Отправить Email" icon="ENVELOPE"/>
                            <action id="addPersonalReserveAction" caption="В кадровый резерв" icon="SUPERSCRIPT"/>
                        </actions>
                    </popupButton>
                </hbox>

                <!-- Карточка-обёртка для таблицы кандидатов -->
                <vbox id="candidatesTableCard" width="100%" height="100%" spacing="false" stylename="edit-card" expand="candidatesTable">
                    <!-- Таблица кандидатов отображает расширенные колонки реестра -->
                    <groupTable id="candidatesTable"
                                 width="100%"
                                 height="100%"
                                 dataContainer="jobCandidatesDc"
                                 stylename="borderless grid">
                        <actions>
                            <action id="edit" type="edit"/>
                            <action id="refresh" type="refresh"/>
                        </actions>
                        <!-- Колонки таблицы с продуманными пропорциями ширины -->
                        <columns>
                            <!-- Генерируемая колонка для отображения миниатюры фото кандидата -->
                            <column id="avatar" caption="Фото" width="50px"/>
                            <!-- Колонка отображения ФИО кандидата с контактом -->
                            <column id="candidateInfo" caption="Кандидат"/>
                            <!-- Колонка отображения желаемой должности в виде плашки -->
                            <column id="personPositionFormatted" caption="Должность"/>
                            <!-- Колонка отображения города проживания -->
                            <column id="cityFormatted" caption="Город" width="130px"/>
                            <!-- Колонка текущей компании -->
                            <column id="companyFormatted" caption="Компания"/>
                            <!-- Компактная генерируемая колонка даты последнего взаимодействия со светофорным статусом -->
                            <column id="lastInteractionStatus" caption="Посл. взаимодействие" width="135px"/>
                        </columns>
                        <!-- Компонент отображения общего количества строк в таблице -->
                        <rowsCount/>
                    </groupTable>
                </vbox>
            </vbox>
        </hbox>
    </layout>
</window>

