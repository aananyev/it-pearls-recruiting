<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Эскиз 3: Kanban Pipeline & Дашборд метрик в теме CUBA Halo -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="Тест 3: Kanban Pipeline &amp; Метрики"
        messagesPack="com.company.hunttech.web.screens.jobcandidate"
        icon="COLUMNS">
    <data readOnly="true">
        <collection id="jobCandidatesDc"
                    class="com.company.hunttech.entity.JobCandidate"
                    view="jobCandidate-view">
            <loader id="jobCandidatesDl" maxResults="200">
                <query><![CDATA[select e from hunttech_JobCandidate e order by e.createTs desc]]></query>
            </loader>
        </collection>
    </data>

    <dialogMode height="700" width="1100"/>

    <layout expand="kanbanBoard" spacing="true" width="100%" height="100%">
        <!-- Верхняя панель карточек KPI метрик -->
        <hbox id="kpiBar" width="100%" spacing="true">
            <vbox stylename="edit-card" width="100%" spacing="false">
                <label value="Всего кандидатов" stylename="small"/>
                <label id="totalCountLabel" value="0" stylename="h1"/>
            </vbox>
            <vbox stylename="edit-card" width="100%" spacing="false">
                <label value="Первичный контакт" stylename="small"/>
                <label id="newCountLabel" value="0" stylename="h1"/>
            </vbox>
            <vbox stylename="edit-card" width="100%" spacing="false">
                <label value="На этапе интервью" stylename="small"/>
                <label id="interviewCountLabel" value="0" stylename="h1"/>
            </vbox>
            <vbox stylename="edit-card" width="100%" spacing="false">
                <label value="Приняты / Оффер" stylename="small"/>
                <label id="hiredCountLabel" value="0" stylename="h1"/>
            </vbox>
        </hbox>

        <!-- Основная доска воронки Kanban (4 колонки) -->
        <hbox id="kanbanBoard" width="100%" height="100%" spacing="true">
            <!-- Колонка 1: Новый контакт -->
            <vbox id="colNew" width="100%" height="100%" spacing="true" stylename="edit-sidebar">
                <hbox width="100%" spacing="true">
                    <label value="1. Новый контакт" stylename="h3"/>
                </hbox>
                <scrollBox id="scrollColNew" width="100%" height="100%" orientation="vertical">
                    <vbox id="containerColNew" width="100%" spacing="true"/>
                </scrollBox>
            </vbox>

            <!-- Колонка 2: Интервью -->
            <vbox id="colInterview" width="100%" height="100%" spacing="true" stylename="edit-sidebar">
                <hbox width="100%" spacing="true">
                    <label value="2. Интервью" stylename="h3"/>
                </hbox>
                <scrollBox id="scrollColInterview" width="100%" height="100%" orientation="vertical">
                    <vbox id="containerColInterview" width="100%" spacing="true"/>
                </scrollBox>
            </vbox>

            <!-- Колонка 3: На рассмотрении -->
            <vbox id="colReview" width="100%" height="100%" spacing="true" stylename="edit-sidebar">
                <hbox width="100%" spacing="true">
                    <label value="3. У заказчика" stylename="h3"/>
                </hbox>
                <scrollBox id="scrollColReview" width="100%" height="100%" orientation="vertical">
                    <vbox id="containerColReview" width="100%" spacing="true"/>
                </scrollBox>
            </vbox>

            <!-- Колонка 4: Оффер / Нанят -->
            <vbox id="colOffer" width="100%" height="100%" spacing="true" stylename="edit-sidebar">
                <hbox width="100%" spacing="true">
                    <label value="4. Оффер / Нанят" stylename="h3"/>
                </hbox>
                <scrollBox id="scrollColOffer" width="100%" height="100%" orientation="vertical">
                    <vbox id="containerColOffer" width="100%" spacing="true"/>
                </scrollBox>
            </vbox>
        </hbox>
    </layout>
</window>
