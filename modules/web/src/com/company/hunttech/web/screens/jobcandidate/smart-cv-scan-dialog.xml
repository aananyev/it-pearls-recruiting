<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://smartCvScanDialog.caption"
        messagesPack="com.company.hunttech.web.screens.jobcandidate">
    <dialogMode width="860px" height="680px" modal="true" closeable="true" resizable="true"/>
    <layout spacing="true" expand="mainContentBox" width="100%" height="100%" stylename="edit-screen-layout">
        <!-- Шапка окна с заголовком и описанием -->
        <hbox id="headerBox" width="100%" spacing="true" align="MIDDLE_LEFT" stylename="edit-toolbar">
            <vbox spacing="false" width="100%">
                <label id="headerTitle" value="msg://smartCvScanDialog.title" stylename="edit-toolbar-title h2"/>
                <label id="headerDescription" value="msg://smartCvScanDialog.description"
                       stylename="edit-toolbar-description edit-help"/>
            </vbox>
        </hbox>

        <!-- Основная область с прокруткой -->
        <scrollBox id="mainContentBox" width="100%" height="100%" spacing="true" orientation="vertical">
            <vbox width="100%" spacing="true">

                <!-- Карточка информации о выбранном резюме -->
                <vbox id="cvInfoCard" width="100%" spacing="true" stylename="edit-card">
                    <label value="msg://smartCvScanDialog.cvInfoTitle" stylename="label-nav-title job-candidate-section-title"/>
                    <grid id="cvInfoGrid" spacing="true" width="100%">
                        <columns count="4"/>
                        <rows>
                            <row>
                                <label value="msg://smartCvScanDialog.candidateNameLabel" stylename="bold"/>
                                <label id="cvCandidateNameLabel" value="—"/>
                                <label value="msg://smartCvScanDialog.datePostLabel" stylename="bold"/>
                                <label id="cvDatePostLabel" value="—"/>
                            </row>
                            <row>
                                <label value="msg://smartCvScanDialog.fileNameLabel" stylename="bold"/>
                                <label id="cvFileNameLabel" value="—"/>
                                <label value="msg://smartCvScanDialog.toVacancyLabel" stylename="bold"/>
                                <label id="cvToVacancyLabel" value="—"/>
                            </row>
                        </rows>
                    </grid>

                    <!-- Индикатор прогресса и статус анализа -->
                    <vbox id="progressBox" width="100%" spacing="true" margin="true,false,false,false">
                        <progressBar id="progressBar" indeterminate="true" visible="true" width="100%"/>
                        <label id="statusLabel" value="msg://smartCvScanDialog.statusPreparing" stylename="bold"
                               css="color: #2563eb; font-size: 13px;"/>
                    </vbox>
                </vbox>

                <!-- Сообщение об ошибке анализа -->
                <vbox id="errorBox" width="100%" spacing="true" visible="false" stylename="edit-card"
                      css="border-left: 4px solid #ef4444 !important; background: #fef2f2 !important;">
                    <hbox spacing="true" align="MIDDLE_LEFT">
                        <label value="msg://smartCvScanDialog.errorTitle" stylename="bold"
                               css="color: #b91c1c !important; font-size: 13px !important;"/>
                    </hbox>
                    <label id="errorDetailsLabel" htmlEnabled="true" width="100%"/>
                </vbox>

                <!-- Информационное сообщение: новые данные не обнаружены -->
                <vbox id="noUpdatesBox" width="100%" spacing="true" visible="false" stylename="edit-card"
                      css="border-left: 4px solid #3b82f6 !important; background: #eff6ff !important;">
                    <label id="noUpdatesLabel" htmlEnabled="true" width="100%"
                           value="msg://smartCvScanDialog.noUpdatesFound"/>
                </vbox>

                <!-- Карточка результатов сравнения -->
                <vbox id="comparisonCard" width="100%" spacing="true" visible="false" stylename="edit-card">
                    <hbox width="100%" spacing="true" align="MIDDLE_LEFT">
                        <label value="msg://smartCvScanDialog.comparisonTitle"
                               stylename="label-nav-title job-candidate-section-title"
                               align="MIDDLE_LEFT"/>
                        <hbox spacing="true" align="MIDDLE_RIGHT" width="100%">
                            <button id="selectAllBtn" caption="msg://smartCvScanDialog.selectAll"
                                    icon="font-icon:CHECK_SQUARE_O" stylename="secondary"/>
                            <button id="deselectAllBtn" caption="msg://smartCvScanDialog.deselectAll"
                                    icon="font-icon:SQUARE_O" stylename="secondary"/>
                        </hbox>
                    </hbox>
                    <label value="msg://smartCvScanDialog.comparisonPrompt" stylename="edit-help"/>

                    <!-- Контейнер для строк сравнения -->
                    <vbox id="comparisonRowsBox" width="100%" spacing="true"
                          css="border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px; background: #ffffff;"/>
                </vbox>

            </vbox>
        </scrollBox>

        <!-- Подвал с действиями -->
        <hbox id="footerToolbar" width="100%" spacing="true" align="MIDDLE_RIGHT" stylename="edit-toolbar">
            <button id="applyBtn" caption="msg://smartCvScanDialog.applyBtn"
                    icon="font-icon:CHECK" stylename="primary" enable="false"/>
            <button id="cancelBtn" caption="msg://smartCvScanDialog.cancelBtn"
                    icon="font-icon:BAN" stylename="secondary"/>
        </hbox>
    </layout>
</window>
