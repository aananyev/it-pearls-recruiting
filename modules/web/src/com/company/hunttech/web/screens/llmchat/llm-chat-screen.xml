<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://screenCaption"
        messagesPack="com.company.hunttech.web.screens.llmchat">
    <!-- Floating non-modal panel (840px); output is incrementally received through the middleware snapshot. -->
    <dialogMode width="840px" height="560px" modal="false" resizable="true" closeable="true"/>
    <facets>
        <!-- Recovery polling and dynamic AI status badge progression timer (750ms). -->
        <timer id="streamPollTimer" delay="750" autostart="false" repeating="true"/>
    </facets>
    <layout stylename="llm-chat-screen" expand="chatTabSheet" spacing="true" width="100%" height="100%">
        <tabSheet id="chatTabSheet" width="100%" height="100%" stylename="framed llm-chat-tabsheet">
            <!-- ВКЛАДКА 1: ЛОКАЛЬНЫЙ ЧАТ. Fail-closed: Antigravity включает её только по CUBA permission hunttech.ai.useLocalChat. -->
            <tab id="localChatTab" caption="msg://tabLocalChat" margin="true" spacing="true" visible="false">
                <vbox width="100%" height="100%" spacing="false" expand="historyScrollBox" stylename="local-chat-tab-pane">
                    <vbox width="100%" spacing="false" stylename="llm-chat-header">
                        <label value="msg://screenTitle" stylename="h2"/>
                        <label value="msg://screenDescription" width="100%" stylename="user-ai-profile-help"/>
                    </vbox>
                    <scrollBox id="historyScrollBox" width="100%" height="100%" orientation="vertical" scrollBars="vertical" stylename="llm-chat-history-scroll">
                        <label id="historyLabel" width="100%" htmlEnabled="true" stylename="llm-chat-history-content"/>
                    </scrollBox>
                    <hbox id="inputBar" width="100%" spacing="true" expand="inputArea" stylename="llm-chat-input-bar local-chat-input-bar">
                        <textArea id="inputArea" width="100%" rows="2" stylename="llm-chat-input-area local-chat-input-area"/>
                        <button id="sendBtn" stylename="llm-chat-send-btn local-chat-send-btn primary" captionAsHtml="true" align="MIDDLE_RIGHT"/>
                    </hbox>
                </vbox>
            </tab>

            <!-- ВКЛАДКА 2: HERMES (текущий read-only/общий контур). -->
            <tab id="hermesChatTab" caption="msg://tabHermes" margin="true" spacing="true">
                <vbox width="100%" height="100%" spacing="false" expand="hermesHistoryScrollBox" stylename="hermes-chat-tab-pane">
                    <vbox width="100%" spacing="false" stylename="llm-chat-header">
                        <label value="msg://hermesScreenTitle" stylename="h2"/>
                        <label value="msg://hermesScreenDescription" width="100%" stylename="user-ai-profile-help"/>
                    </vbox>
                    <scrollBox id="hermesHistoryScrollBox" width="100%" height="100%" orientation="vertical" scrollBars="vertical" stylename="llm-chat-history-scroll">
                        <label id="hermesHistoryLabel" width="100%" htmlEnabled="true" stylename="llm-chat-history-content"/>
                    </scrollBox>
                    <hbox id="hermesInputBar" width="100%" spacing="true" expand="hermesInputArea" stylename="llm-chat-input-bar hermes-chat-input-bar">
                        <textArea id="hermesInputArea" width="100%" rows="2" stylename="llm-chat-input-area hermes-chat-input-area"/>
                        <button id="hermesSendBtn" stylename="llm-chat-send-btn hermes-chat-send-btn primary" captionAsHtml="true" align="MIDDLE_RIGHT"/>
                    </hbox>
                </vbox>
            </tab>

            <!-- ВКЛАДКА 3: HERMES (профиль hrm-operator, управление HRM). Fail-closed до проверки прав. -->
            <tab id="hermesManagerChatTab" caption="msg://tabHermesManager" margin="true" spacing="true" visible="false">
                <vbox width="100%" height="100%" spacing="false" expand="hermesManagerHistoryScrollBox" stylename="hermes-manager-chat-tab-pane">
                    <vbox width="100%" spacing="false" stylename="llm-chat-header">
                        <label value="msg://hermesManagerScreenTitle" stylename="h2"/>
                        <label value="msg://hermesManagerScreenDescription" width="100%" stylename="user-ai-profile-help"/>
                    </vbox>
                    <scrollBox id="hermesManagerHistoryScrollBox" width="100%" height="100%" orientation="vertical" scrollBars="vertical" stylename="llm-chat-history-scroll">
                        <label id="hermesManagerHistoryLabel" width="100%" htmlEnabled="true" stylename="llm-chat-history-content"
                               value="msg://hermesManagerPlaceholder"/>
                    </scrollBox>
                    <hbox id="hermesManagerInputBar" width="100%" spacing="true" expand="hermesManagerInputArea" stylename="llm-chat-input-bar hermes-manager-chat-input-bar">
                        <textArea id="hermesManagerInputArea" width="100%" rows="2" stylename="llm-chat-input-area hermes-manager-chat-input-area"/>
                        <button id="hermesManagerSendBtn" stylename="llm-chat-send-btn hermes-manager-chat-send-btn primary" captionAsHtml="true" align="MIDDLE_RIGHT"/>
                    </hbox>
                </vbox>
            </tab>
        </tabSheet>
    </layout>
</window>
