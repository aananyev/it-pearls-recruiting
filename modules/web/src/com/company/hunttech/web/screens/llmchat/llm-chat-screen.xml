<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://screenCaption"
        focusComponent="inputArea"
        messagesPack="com.company.hunttech.web.screens.llmchat">
    <!-- MVP shell: compact dialog behaves as a floating panel; provider call is asynchronous from UI. -->
    <dialogMode width="420" height="640" modal="false" resizable="true" closeable="true"/>
    <layout stylename="llm-chat-screen" expand="historyArea" spacing="true" width="100%" height="100%">
        <vbox width="100%" spacing="false">
            <label value="msg://screenTitle" stylename="h2"/>
            <label value="msg://screenDescription" width="100%" stylename="user-ai-profile-help"/>
        </vbox>
        <textArea id="historyArea" width="100%" height="100%" editable="false"/>
        <hbox width="100%" spacing="true" expand="inputArea">
            <textArea id="inputArea" width="100%" rows="3"/>
            <button id="sendBtn" caption="msg://send" stylename="primary"/>
            <button id="cancelBtn" caption="msg://cancel" enabled="false"/>
        </hbox>
    </layout>
</window>
