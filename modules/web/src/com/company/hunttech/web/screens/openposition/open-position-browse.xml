<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://browseCaption"
        focusComponent="openPositionsTable"
        messagesPack="com.company.hunttech.web.screens.openposition" icon="COMPASS">
    <data readOnly="true">
        <!-- Коллекция позиций (openPosition-browse-view) с BATCH-загрузкой projectName, positionType, owner, комментариев, файлов и городов — все вложенные пути, читаемые Java-генераторами таблицы (view integrity). -->
        <collection id="openPositionsDc"
                    class="com.company.hunttech.entity.OpenPosition">
            <view extends="openPosition-browse-view">
                <property name="projectName" fetch="BATCH">
                    <property name="projectLogo" view="_minimal"/>
                    <property name="projectDepartment" view="companyDepartament-picker-view">
                        <property name="companyName" view="company-picker-view"/>
                    </property>
                    <property name="projectOwner" view="person-owner-view"/>
                </property>
                <property name="positionType" fetch="BATCH" view="position-picker-view"/>
                <property name="owner" fetch="BATCH" view="extUser-picker-view"/>
                <property name="openPositionComments" fetch="BATCH" view="_minimal"/>
                <property name="someFiles" fetch="BATCH" view="_minimal"/>
                <property name="cities" fetch="BATCH" view="city-picker-view"/>
            </view>
            <!-- Загрузчик позиций с лимитом 40 строк; параметры условий задаются фильтром и программно в контроллере (подписки, приоритет, статусы). -->
            <loader id="openPositionsDl" maxResults="40">
            <!-- Загрузчик позиций с лимитом 40 строк; параметры условий задаются фильтром и программно в контроллере (подписки, приоритет, статусы). -->
                <query>
                    <![CDATA[select e from hunttech_OpenPosition e
                                      order by e.vacansyName]]>
                    <condition>
                        <and>
                            <c:jpql>
                                <c:where>e.priority = :priority</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>@between(e.lastOpenDate, now - :newOpenPosition, now + 1, day)</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>
                                    not e in (select k.openPosition from hunttech_RecrutiesTasks k
                                    where k.closed = :freesubscriber
                                    and current_date between k.startDate and k.endDate))
                                </c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>
                                    e in (select k.openPosition from hunttech_RecrutiesTasks k
                                    where k.reacrutier = :subscriber
                                    and k.closed = false
                                    and current_date between k.startDate and k.endDate))
                                </c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>
                                    not (e in (select x.openPosition from hunttech_RecrutiesTasks x
                                    where x.reacrutier = :notsubscriber
                                    and x.closed = false
                                    and current_date between x.startDate and x.endDate)))
                                </c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.openClose = :openClosePos</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.signDraft = :signDraft</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.priority > :paused</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>
                                    e in
                                    (select f.openPosition
                                    from hunttech_RecrutiesTasks f
                                    where f.reacrutier = :recrutier and :nowDate between f.startDate and f.endDate
                                    and f.closed = false)
                                </c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.internalProject = :internalProject</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.priority >= :rating</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.remoteWork = :remoteWork</c:where>
                            </c:jpql>
                            <c:jpql>
                                <c:where>e.positionType = :positionType</c:where>
                            </c:jpql>
                        </and>
                    </condition>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="800"
                width="1000"/>
    <layout expand="splitMainLayout" spacing="false" width="100%" height="100%" stylename="job-candidate-editor edit-screen-layout">

        <!-- Двухпанельная разметка Split-View: Левый профильный сайдбар (312px) от самого верха до низа + Просторная рабочая область справа -->
        <hbox id="splitMainLayout" width="100%" height="100%" spacing="true" expand="positionsWorkspaceBox" stylename="job-candidate-main-layout edit-screen-layout">

            <!-- ЛЕВАЯ ПАНЕЛЬ (САЙДБАР): Выдержана в фирменном стиле Edit-форм (job-candidate-sidebar edit-sidebar) -->
            <vbox id="openPositionDetailPane" width="312px" height="100%" spacing="true" stylename="job-candidate-sidebar edit-sidebar">
                <scrollBox id="detailScroll" width="100%" height="100%" orientation="vertical">
                    <vbox width="100%" spacing="true">

                        <!-- Шапка профиля: логотип проекта / компании 120x120px, название вакансии и проект -->
                        <vbox id="openPositionProfileHeader" width="100%" spacing="true" align="TOP_CENTER" stylename="job-candidate-profile-header edit-sidebar-visual">
                            <ovaFallbackImage id="projectLogoPic"
                                              width="120px" height="120px"
                                              ovalWidth="120px" ovalHeight="120px"
                                              align="TOP_CENTER"
                                              stylename="job-candidate-avatar"/>
                            <label id="detailVacancyName"
                                   value="Выберите вакансию"
                                   stylename="edit-sidebar-title h2 candidate-sidebar-fullname"
                                   align="TOP_CENTER"
                                   width="100%"/>
                            <label id="detailProjectName"
                                   value="-"
                                   stylename="edit-sidebar-subtitle h4 candidate-sidebar-position"
                                   align="TOP_CENTER"
                                   width="100%"/>
                            <label id="detailCompanyName"
                                   value="-"
                                   stylename="edit-help candidate-sidebar-city"
                                   align="TOP_CENTER"
                                   width="100%"/>
                            <label id="detailLocationAndFormat"
                                   value="-"
                                   stylename="edit-help"
                                   align="TOP_CENTER"
                                   width="100%"/>
                        </vbox>

                        <!-- Панель быстрых действий по вакансии -->
                        <vbox id="sidebarActionsCard" width="100%" spacing="true" stylename="edit-sidebar-card">
                            <button id="openEditCardBtn"
                                    caption="Открыть вакансию"
                                    icon="EDIT_ACTION"
                                    stylename="primary candidate-btn candidate-create-btn"
                                    width="100%"/>
                            <button id="suggestCandidatesBtn"
                                    caption="Подобрать кандидатов"
                                    icon="font-icon:MAGIC"
                                    stylename="secondary candidate-btn"
                                    width="100%"/>
                            <button id="subscribeBtn"
                                    caption="Подписаться"
                                    icon="font-icon:BELL"
                                    stylename="secondary candidate-btn"
                                    width="100%"/>
                        </vbox>

                        <!-- Секция 1: Условия и реквизиты -->
                        <vbox id="termsCard" width="100%" spacing="true" stylename="edit-sidebar-card">
                            <label value="1. УСЛОВИЯ И РЕКВИЗИТЫ" stylename="label-nav-title job-candidate-section-title"/>
                            <grid id="termsGrid" spacing="true" width="100%" stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row>
                                        <label value="Зарплата:" stylename="bold"/>
                                        <label id="detailSalary" value="-" stylename="bold" css="color: #1e3a8a;"/>
                                    </row>
                                    <row>
                                        <label value="Опыт / Грейд:" stylename="bold"/>
                                        <label id="detailExperience" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Формат работы:" stylename="bold"/>
                                        <label id="detailRemoteWork" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Статус:" stylename="bold"/>
                                        <label id="detailOpenClose" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Позиций:" stylename="bold"/>
                                        <label id="detailNumberPosition" value="-"/>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Секция 2: Проект и кураторы -->
                        <vbox id="projectDetailsCard" width="100%" spacing="true" stylename="edit-sidebar-card">
                            <label value="2. ПРОЕКТ И КУРАТОРЫ" stylename="label-nav-title job-candidate-section-title"/>
                            <grid id="projectGrid" spacing="true" width="100%" stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row>
                                        <label value="Куратор проекта:" stylename="bold"/>
                                        <label id="detailProjectOwner" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Владелец:" stylename="bold"/>
                                        <label id="detailOwner" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Создатель:" stylename="bold"/>
                                        <label id="detailCreatedBy" value="-"/>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Секция 3: Индикаторы готовности и рейтинг -->
                        <vbox id="readinessCard" width="100%" spacing="true" stylename="edit-sidebar-card">
                            <label value="3. ГОТОВНОСТЬ И РЕЙТИНГ" stylename="label-nav-title job-candidate-section-title"/>
                            <label id="detailIndicators" htmlEnabled="true" width="100%"/>
                            <label id="detailRating" htmlEnabled="true" width="100%"/>
                        </vbox>

                        <!-- Секция 4: Требуемые навыки -->
                        <vbox id="skillsCard" width="100%" spacing="true" stylename="edit-sidebar-card">
                            <label value="4. ТРЕБУЕМЫЕ НАВЫКИ" stylename="label-nav-title job-candidate-section-title"/>
                            <label id="detailSkills" htmlEnabled="true" width="100%"/>
                        </vbox>

                    </vbox>
                </scrollBox>
            </vbox>

            <!-- ПРАВАЯ ПАНЕЛЬ: Рабочая область реестра (edit-workspace candidate-reestr-workspace) -->
            <vbox id="positionsWorkspaceBox" width="100%" height="100%" spacing="true" stylename="edit-workspace candidate-reestr-workspace" expand="openPositionsTable" margin="true,true,true,false">
        <!-- Панель срочных вакансий: горизонтальная лента кнопок позиций с критическим приоритетом (QUERY_URGENTLY_POSITIONS). -->
        <groupBox id="urgentlyPositons"
                  collapsable="true"
                  spacing="true"
                  caption="msg://msgUrgentlyPositios"
                  description="msg://msgUrgentlyPositios">
            <!-- Контейнер кнопки сброса и ленты срочных позиций. -->
            <hbox id="urgentlyPositionsHBox"
                  spacing="true"
                  height="100%">
                <!-- Сброс срочной фильтрации — возврат к полному списку вакансий. -->
                <button id="clearUrgentPos"
                        caption="msg://msgClear"
                        align="MIDDLE_LEFT"
                        height="AUTO"
                        description="msg://msgClearDescription"
                        invoke="clearUrgentFilter"/>
                <!-- Горизонтальная прокрутка ленты срочных позиций. -->
                <scrollBox id="urgentlyBox"
                           height="100%"
                           orientation="horizontal"
                           contentMaxHeight="100%"
                           contentMaxWidth="100%">
                    <!-- Лента кнопок срочных позиций; наполняется в setUrgentlyPositios по приоритету. -->
                    <hbox id="urgentlyHBox"
                          height="100%"/>
                </scrollBox>
            </hbox>
        </groupBox>
        <!-- Фильтр таблицы вакансий (скрыт по умолчанию, collapsable): применяется к openPositionsTable через openPositionsDl; из набора свойств исключены LOB и служебные поля. -->
        <filter id="vacancyFilter"
                collapsable="true"
                collapsed="true"
                applyTo="openPositionsTable"
                dataLoader="openPositionsDl">
            <properties include=".*"
                        exclude="id|birdhDate|email|id|whatsupName|parentOpenPosition|needLetter|exercise|needExercise|needLetter|templateLetter|workExperience|useTaxNDFL|salaryMin|salaryMax|percentComissionOfCompany|percentSalaryOfResearcher|percentSalaryOfRecrutier|typeSalaryOfRecrutier|typeSalaryOfResearcher|paymentsType|typeCompanyComission|shortDescription|commandExperience"
                        excludeProperties="comment,numberPosition,version,createTs,createdBy,updateTs,updatedBy,deleteTs,deletedBy"/>
            <custom name="projectFilter"
                    paramClass="com.company.hunttech.entity.Project"
                    caption="mainMsg://msgProject">
                {E}.id = (?)
            </custom>
            <custom name="positionFilter"
                    paramClass="com.company.hunttech.entity.Position"
                    caption="mainMsg://msgPosition">
                {E}.id = (?)
            </custom>
            <custom name="projectOwnerFilter"
                    paramClass="com.company.hunttech.entity.Person"
                    caption="mainMsg://msgPerson">
                {E}.id = (?)
            </custom>
            <custom name="newOpenPositionFilter"
                    caption="mainMsg://msgNewOpenPosition">
                @between({E}.lastOpenDate, now-3, now, day)
            </custom>
        </filter>
        <!-- Переключатель варианта подписки (все подписчики / собственные) — управляется программно из контроллера. -->
        <radioButtonGroup id="subscribeRadioButtonGroup"
                          width="AUTO"
                          align="MIDDLE_LEFT"
                          orientation="horizontal"/>
        <!-- Иерархическая таблица позиций (дерево по parentOpenPosition), строки 60px, single-selection, без редактирования; большинство колонок — кастомные генераторы и popup-действия строки. -->
        <treeDataGrid id="openPositionsTable"
                      contextHelpTextHtmlEnabled="true"
                      descriptionAsHtml="true"
                      captionAsHtml="true"
                      width="100%"
                      editorEnabled="false"
                      headerVisible="true"
                      contextMenuEnabled="false"
                      bodyRowHeight="60px"
                      textSelectionEnabled="false"
                      hierarchyProperty="parentOpenPosition"
                      selectionMode="SINGLE"
                      reorderingAllowed="true"
                      dataContainer="openPositionsDc">
            <actions>
                <!-- Создание новой позиции (стандартное действие CUBA). -->
                <action id="create" type="create"/>
                <!-- Создание новой позиции (стандартное действие CUBA). -->
                <action id="edit" type="edit"/>
                <!-- Редактирование выбранной позиции (стандартное действие CUBA). -->
                <action id="remove" type="remove"/>
                <!-- Удаление выбранной позиции (стандартное действие CUBA). -->
                <action id="excel" type="excel" visible="false"/>
                <!-- Выгрузка списка в Excel — скрыта, активируется по ролям. -->
                <action id="list" type="listPrintForm"/>
                <!-- Печатная форма списка: формирует «Памятку для кандидата» (getMemoForCandidate). -->
            </actions>
            <columns
                    exclude="remoteWork,commandCandidate,salaryMax,cityPosition,numberPosition,workExperience,commandExperience,comment,shortDescription,templateLetter,needLetter,exercise,needExercise,skillsList,candidates,paymentsType,typeCompanyComission,typeSalaryOfResearcher,typeSalaryOfRecrutier,useTaxNDFL,internalProject,percentComissionOfCompany,percentSalaryOfResearcher,percentSalaryOfRecrutier,parentOpenPosition">
                <!-- Признак наличия дочерних позиций — иконка папки (folder generator). -->
                <column id="folder"
                        maximumWidth="100px"
                        resizable="true"
                        collapsible="false"
                        collapsed="false"
                        width="100px"
                        caption="msg://msgFolder">
                    <componentRenderer/>
                </column>
                <!-- Иконка приоритета «светофор»: красный/жёлтый/зелёный по приоритету позиции. -->
                <column id="icon"
                        resizable="true"
                        collapsible="true"
                        collapsed="true"
                        width="70px"
                        minimumWidth="35px"
                        caption="msg://msgPriority"/>
                <!-- Средний рейтинг позиции, рассчитанный из комментариев (avgRating). -->
                <column id="rating"
                        minimumWidth="85px"
                        maximumWidth="85px"
                        caption="msg://msgRating">
                    <componentRenderer/>
                </column>
                <!-- Логотип компании проекта с HTML-подсказкой (lazy-описание компании). -->
                <column id="companyLogoColumn"
                        resizable="true"
                        collapsible="true"
                        collapsed="true"
                        caption="msg://msgCompany"
                        width="70px"
                        minimumWidth="70px">
                    <componentRenderer/>
                </column>
                <!-- Логотип проекта с HTML-подсказкой. -->
                <column id="projectLogoColumn"
                        resizable="true"
                        collapsible="true"
                        collapsed="false"
                        caption="msg://msgProject"
                        width="70px"
                        minimumWidth="70px">
                    <componentRenderer/>
                </column>
                <!-- Иконка последнего открытия/закрытия позиции (lastOpenDate). -->
                <column id="lastOpenCloseColumn"
                        collapsible="true"
                        collapsed="true"
                        sortable="true"
                        caption="msg://msgLastOpenCloseColumn"
                        resizable="true"
                        maximumWidth="70px"
                        minimumWidth="55px">
                    <componentRenderer/>
                </column>
                <!-- Внутренний ID вакансии (vacansyID). -->
                <column id="vacansyID"
                        collapsible="true"
                        property="vacansyID"
                        width="80px"
                        maximumWidth="80px"
                        caption="msg://msgID">
                    <componentRenderer/>
                </column>
                <!-- Название вакансии: HTML-рендер с именем, проектом и владельцем в подсказке. -->
                <column id="vacansyName"
                        collapsible="false"
                        property="vacansyName"
                        resizable="true"
                        caption="msg://msgVacancy">
                    <componentRenderer/>
                </column>
                <!-- Тип позиции (название должности RU/EN с lazy-догрузкой). -->
                <column id="positionType"
                        collapsible="true"
                        collapsed="true"
                        resizable="true"
                        property="positionType"
                        maximumWidth="300px"
                        caption="msg://msgPositionType">
                    <componentRenderer/>
                </column>
                <!-- Проект позиции. -->
                <column id="projectName"
                        collapsible="true"
                        collapsed="true"
                        resizable="true"
                        property="projectName"
                        maximumWidth="250px"
                        caption="msg://msgProjectName">
                    <componentRenderer/>
                </column>
                <!-- Список городов позиции из коллекции cities. -->
                <column id="cityPositionList"
                        collapsed="true"
                        collapsible="true"
                        caption="msg://msgCity"
                        minimumWidth="60px"
                        width="120px">
                    <componentRenderer/>
                </column>
                <!-- Требуемый опыт работы (иконки и текст из mapWorkExperience). -->
                <column id="workExperience"
                        width="65px"
                        caption="msg://msgWorkExperience">
                    <componentRenderer/>
                </column>
                <!-- Вилка зарплаты «мин/макс» с подсказкой и стилем по значению. -->
                <column id="salaryMinMax"
                        resizable="true"
                        width="120px"
                        caption="msg://msgSalaryMinMax">
                    <componentRenderer/>
                </column>
                <!-- Количество позиций (штатных единиц). -->
                <column id="numberPosition"
                        width="65px"
                        maximumWidth="85px"
                        minimumWidth="65px"
                        caption="msg://msgNumberOpenPosition">
                    <componentRenderer/>
                </column>
                <!-- Наличие описания вакансии (иконка по comment). -->
                <column id="description"
                        sortable="false"
                        resizable="true"
                        maximumWidth="65px"
                        minimumWidth="45px"
                        collapsible="true"
                        collapsed="true"
                        caption="msg://msgCVDescription">
                    <componentRenderer/>
                </column>
                <!-- Наличие тестового задания (иконка по exercise). -->
                <column id="testExserice"
                        collapsed="true"
                        sortable="false"
                        caption="msg://msgNeedExercise"
                        resizable="true"
                        collapsible="true"
                        maximumWidth="65px"
                        minimumWidth="45px">
                    <componentRenderer/>
                </column>
                <!-- Формат удалённой работы (иконка +/- и подсказка). -->
                <column id="remoteWork"
                        property="remoteWork"
                        sortable="false"
                        resizable="true"
                        collapsible="true"
                        collapsed="true"
                        maximumWidth="65px"
                        minimumWidth="45px"
                        caption="msg://msgRemoteWork">
                    <componentRenderer/>
                </column>
                <!-- Наличие шаблона сопроводительного письма (иконка). -->
                <column id="queryQuestion"
                        collapsed="true"
                        sortable="false"
                        caption="msg://msgQuestionQuery"
                        resizable="true"
                        collapsible="true"
                        maximumWidth="65px"
                        minimumWidth="45px">
                    <componentRenderer/>
                </column>
                <!-- Наличие памятки для кандидата (иконка). -->
                <column id="memoForCandidateColumn"
                        collapsed="true"
                        collapsible="true"
                        sortable="false"
                        caption="msg://msgMemoForCandidate"
                        resizable="true"
                        maximumWidth="65px"
                        minimumWidth="45px">
                    <componentRenderer/>
                </column>
                <!-- Дата последней отправки резюме кандидату/по позиции. -->
                <column id="lastCVSend"
                        resizable="true"
                        collapsed="false"
                        collapsible="true"
                        maximumWidth="65px"
                        minimumWidth="45px"
                        caption="msg://mshLastCVSend">
                    <componentRenderer/>
                </column>
                <!-- Статистика взаимодействий по позиции: счётчики по типам с учётом родительских и дочерних позиций. -->
                <column id="idStatistics"
                        collapsible="true"
                        collapsed="true"
                        resizable="true"
                        width="70px"
                        minimumWidth="35px"
                        caption="msg://msgStat">
                    <componentRenderer/>
                </column>
                <!-- Владелец позиции (рекрутёр, ExtUser). -->
                <column id="owner"
                        collapsed="true"
                        collapsible="true"
                        resizable="true"
                        width="120px">
                    <componentRenderer/>
                </column>
                <!-- Количество отправленных кандидатов по позиции. -->
                <column id="candidateSendedColumn"
                        collapsed="true"
                        collapsible="true"
                        caption="msg://msgSendedCandidates"
                        width="120px"
                        resizable="true">
                    <componentRenderer/>
                </column>
                <!-- Колонка popup-действий строки: открыть/закрыть, комментарий, отчёты, подписка, подбор кандидатов. -->
                <column id="openPositionActionButtonColumn"
                        collapsed="false"
                        collapsible="true"
                        caption=""
                        width="100px"
                        resizable="true">
                    <componentRenderer/>
                </column>
            </columns>
            <rowsCount autoLoad="true"/>
            <!-- Панель действий таблицы: CRUD, открыть/закрыть, подписка, отчёты, рейтинг-комментарий. -->
            <buttonsPanel id="openPositionButtonsPanel"
                          alwaysVisible="true">
                <!-- Кнопка «Создать» (действие openPositionsTable.create). -->
                <button id="createBtn"
                        action="openPositionsTable.create"/>
                <!-- Кнопка «Редактировать» (действие openPositionsTable.edit). -->
                <button id="editBtn"
                        action="openPositionsTable.edit"/>
                <!-- Кнопка «Удалить» (действие openPositionsTable.remove). -->
                <button id="removeBtn"
                        action="openPositionsTable.remove"/>
                <!-- Pop-up открытия/закрытия позиции; действия закомментированы и подключаются в контроллере (initOpenCloseButton) с проверкой дочерних позиций. -->
                <popupButton id="openCloseButton"
                             showActionIcons="true"
                             caption="msg://msgOpenClose"
                             enable="false"
                             icon="DIALOG_CLOSE"/>
<!--                    <actions>
                        <action id="closeOpenPositionAction"
                                caption="msg://msgCloseOpenPosition"
                                icon="CLOSE"
                                invoke="openCloseButtonInvoke"/>
                        <action id="closeOpenPositionWithCommentAction"
                                caption="msg://msgCloseOpenPositionWithComment"
                                icon="COMMENTING"
                                invoke="openCloseButtonWithCommentInvoke"/>
                    </actions>
                </popupButton> -->
                <!-- Подписка текущего рекрутёра на выбранную позицию (subscribePosition). -->
                <button id="buttonSubscribe"
                        caption="msg://mshSubscibe"
                        invoke="subscribePosition"
                        enable="false"
                        icon="BELL"/>
                <!-- Групповая подписка всех подписчиков (скрыта). -->
                <button id="groupSubscribe"
                        caption="msg://msgGroupSubscribe"
                        visible="false"
                        enable="false"
                        invoke="groupSubscribe"
                        icon="BELL_O"/>
                <!-- Выгрузка в Excel (скрыта). -->
                <button id="buttonExcel"
                        action="openPositionsTable.excel"
                        icon="EXCEL_ACTION"
                        enable="false"
                        visible="false"/>
                <!-- Подбор кандидатов по позиции (скрыт). -->
                <button id="suggestCandidateButton"
                        caption="msg://msgSuggestCandidates"
                        icon="EYE"
                        enable="false"
                        visible="false"
                        invoke="suggestCandidateButton"/>
                <!-- Pop-up отчётов: печатная форма «Памятка для кандидата» (скрыт). -->
                <popupButton id="reportsPopupButton"
                             icon="FILE_TEXT"
                             visible="false"
                             enable="false"
                             caption="msg://msgReports">
                    <actions>
                        <!-- Формирование памятки для кандидата (getMemoForCandidate). -->
                        <action id="listPrintFormAction"
                                enable="true"
                                invoke="getMemoForCandidate"
                                type="listPrintForm"
                                caption="msg://msgGetMemoForCandidate"/>
                    </actions>
                </popupButton>
                <!-- Pop-up комментария-рейтинга: выставить рейтинг позиции или просмотреть существующие комментарии. -->
                <popupButton id="setRatingButton"
                             caption="msg://msgOpenPositionComment"
                             showActionIcons="true"
                             visible="true"
                             icon="font-icon:COMMENT"
                             enable="false">
                    <actions>
                        <!-- Выставление рейтинга позиции с комментарием (setRatingComment). -->
                        <action id="setRatingComment"
                                caption="msg://msgOpenPositionComment"
                                icon="STAR_O"
                                invoke="setRatingComment"
                                description="msg://msgSetRating"/>
                        <!-- Просмотр комментариев и рейтинга позиции (openPositionCommentViewInvoke). -->
                        <action id="viewRatingComment"
                                icon="VIEW_ACTION"
                                invoke="openPositionCommentViewInvoke"
                                caption="msg://msgViewOpenPositionComment"/>
                    </actions>
                </popupButton>
            </buttonsPanel>
        </treeDataGrid>
        <!-- Ряд фильтр-переключателей под таблицей: чекбоксы статусов слева, фильтры приоритета и формата работы справа. -->
        <hbox id="vacancyFilterCheckBoxesHBox"
              spacing="true"
              align="MIDDLE_LEFT"
              width="100%">
            <!-- Группа чекбоксов статуса: только открытые, черновики, не на паузе, только мои подписки. -->
            <hbox id="checkBoxsHBox"
                  align="MIDDLE_LEFT"
                  spacing="true"
                  width="AUTO">
                <!-- Показывать только открытые позиции (openClose = false). -->
                <checkBox id="checkBoxOnlyOpenedPosition"
                          align="MIDDLE_LEFT"
                          description="msg://msgOnlyOpenedVacansy"
                          caption="msg://msgOnlyOpenedVacansy"/>
                <!-- Включать черновики (signDraft) в список. -->
                <checkBox id="signDraftCheckBox"
                          align="MIDDLE_LEFT"
                          description="msg://msgSignDraft"
                          caption="msg://msgSignDraft"/>
                <!-- Скрыть приостановленные позиции (priority > paused). -->
                <checkBox id="checkBoxOnlyNotPaused"
                          align="MIDDLE_LEFT"
                          description="msg://msgOnlyNotPaused"
                          caption="msg://msgOnlyNotPaused"/>
                <!-- Показывать только позиции, на которые подписан текущий рекрутёр (скрыт по умолчанию). -->
                <checkBox id="checkBoxOnlyMySubscribe"
                          align="MIDDLE_LEFT"
                          visible="false"
                          description="msg://msgOnlyMySubscribe"
                          caption="msg://msgOnlyMySubscribe"/>
            </hbox>
            <!-- Правая группа фильтров: минимальный приоритет и формат удалённой работы. -->
            <hbox id="notLowerRatingForm"
                  align="MIDDLE_RIGHT"
                  spacing="true"
                  width="AUTO">
                <!-- Фильтр «не ниже рейтинга»: позиции с приоритетом не ниже выбранного. -->
                <lookupField id="notLowerRatingLookupField"
                             align="MIDDLE_RIGHT"
                             nullOptionVisible="false"
                             caption="msg://msgPriorityPosition"
                             description="msg://msgStatusNotLower"/>
                <!-- Фильтр по формату удалённой работы (remoteWork). -->
                <lookupField id="remoteWorkLookupField"
                             caption="msg://msgRemoteWork"
                             nullOptionVisible="false"
                             align="MIDDLE_RIGHT"
                             description="msg://msgRemoteWork"/>
            </hbox>
        </hbox>
        <!-- Действия lookup-режима (выбор/отмена); видны только при открытии окна в режиме подбора. -->
        <hbox id="lookupActions"
              spacing="true"
              visible="false"
              align="TOP_RIGHT">
            <button id="lookupSelectButton" action="lookupSelectAction"/>
            <button id="lookupCancelButton" action="lookupCancelAction"/>
        </hbox>
            </vbox>
        </hbox>
    </layout>
</window>
