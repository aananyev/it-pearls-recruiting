<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="Умная AI-загрузка и открытие вакансии"
        messagesPack="com.company.hunttech.web.screens.openposition">
    <dialogMode width="860px" height="680px" modal="true" closeable="true" resizable="true"/>
    <layout spacing="true" expand="mainContentBox" width="100%" height="100%" stylename="edit-screen-layout">
        <!-- Шапка окна с заголовком и описанием -->
        <hbox id="headerBox" width="100%" spacing="true" align="MIDDLE_LEFT" stylename="edit-toolbar">
            <vbox spacing="false" width="100%">
                <label value="Умная AI-загрузка и открытие вакансии" stylename="edit-toolbar-title h2"/>
                <label value="Автоматическое распознавание требований, условий, зарплатной вилки и ключевых навыков из текста или файла"
                       stylename="edit-toolbar-description edit-help"/>
            </vbox>
        </hbox>

        <!-- Основная область с прокруткой -->
        <scrollBox id="mainContentBox" width="100%" height="100%" spacing="true" orientation="vertical">
            <vbox width="100%" spacing="true">

                <!-- Зона загрузки файла или текста -->
                <vbox id="uploadCard" width="100%" spacing="true" stylename="edit-card">
                    <label value="1. ВЫБЕРИТЕ ФАЙЛ ОПИСАНИЯ ВАКАНСИИ ИЛИ ВСТАВЬТЕ ТЕКСТ" stylename="label-nav-title job-candidate-section-title"/>
                    
                    <tabSheet id="inputTabSheet" width="100%">
                        <!-- Вкладка загрузки файла -->
                        <tab id="fileTab" caption="Загрузка файла" icon="CLOUD_UPLOAD">
                            <vbox spacing="true" width="100%" margin="true,false,false,false">
                                <label value="Перетащите файл описания вакансии в эту область или нажмите кнопку загрузки:" stylename="edit-help"/>
                                <upload id="uploadField"
                                        uploadButtonCaption="Загрузить файл вакансии..."
                                        uploadButtonIcon="font-icon:CLOUD_UPLOAD"
                                        permittedExtensions=".pdf,.docx,.doc,.rtf,.txt"
                                        dropZone="uploadCard"
                                        dropZonePrompt="Перетащите файл описания вакансии сюда (PDF, Word, TXT)"
                                        stylename="primary"
                                        showFileName="true"/>
                            </vbox>
                        </tab>
                        
                        <!-- Вкладка ввода / вставки текста -->
                        <tab id="textTab" caption="Вставка текста" icon="FILE_TEXT_O">
                            <vbox spacing="true" width="100%" margin="true,false,false,false">
                                <label value="Вставьте текст заявки / описания вакансии из мессенджера или письма:" stylename="edit-help"/>
                                <richTextArea id="vacancyRichTextArea"
                                              width="100%"
                                              height="180px"/>
                                <hbox spacing="true" align="MIDDLE_LEFT">
                                    <button id="analyzeTextBtn"
                                            caption="Распознать введенный текст"
                                            icon="font-icon:MAGIC"
                                            stylename="primary candidate-btn candidate-smartload-btn"/>
                                    <button id="clearTextBtn"
                                            caption="Очистить"
                                            icon="ERASER"
                                            stylename="secondary candidate-btn"/>
                                </hbox>
                            </vbox>
                        </tab>
                    </tabSheet>

                    <!-- Индикатор прогресса и статус выполнения -->
                    <hbox width="100%" spacing="true" align="MIDDLE_LEFT" margin="true,false,false,false">
                        <progressBar id="progressBar" indeterminate="true" visible="false" align="MIDDLE_LEFT" width="200px"/>
                        <label id="statusLabel" value="Готов к загрузке файла или текста" align="MIDDLE_LEFT" stylename="edit-help"/>
                    </hbox>
                </vbox>

                <!-- Блок предупреждения о найденной похожей открытой вакансии -->
                <vbox id="duplicateBox" width="100%" spacing="true" visible="false" stylename="edit-card"
                      css="border-left: 4px solid #f59e0b !important; background: #fffbeb !important;">
                    <hbox spacing="true" align="MIDDLE_LEFT">
                        <label value="⚠️ НАЙДЕНА ПОХОЖАЯ ОТКРЫТАЯ ВАКАНСИЯ В БАЗЕ" stylename="bold"
                               css="color: #b45309 !important; font-size: 13px !important;"/>
                    </hbox>
                    <label id="duplicateInfoLabel" htmlEnabled="true" width="100%"/>
                </vbox>

                <!-- Блок распознанных данных вакансии -->
                <vbox id="previewCard" width="100%" spacing="true" visible="false" stylename="edit-card">
                    <label value="2. РАСПОЗНАННЫЕ ДАННЫЕ ВАКАНСИИ" stylename="label-nav-title job-candidate-section-title"/>
                    
                    <hbox width="100%" spacing="true" expand="detailsGrid">
                        <grid id="detailsGrid" spacing="true" width="100%" stylename="edit-sidebar-summary">
                            <columns count="2"/>
                            <rows>
                                <row>
                                    <label value="Название вакансии:" stylename="bold"/>
                                    <label id="previewVacancyName" value="-" stylename="bold" css="color: #1e3a8a;"/>
                                </row>
                                <row>
                                    <label value="Проект / Компания:" stylename="bold"/>
                                    <label id="previewProject" value="-"/>
                                </row>
                                <row>
                                    <label value="Специализация:" stylename="bold"/>
                                    <label id="previewPositionType" value="-"/>
                                </row>
                                <row>
                                    <label value="Грейд:" stylename="bold"/>
                                    <label id="previewGrade" value="-"/>
                                </row>
                                <row>
                                    <label value="Город / Локация:" stylename="bold"/>
                                    <label id="previewCity" value="-"/>
                                </row>
                                <row>
                                    <label value="Формат работы:" stylename="bold"/>
                                    <label id="previewRemote" value="-"/>
                                </row>
                                <row>
                                    <label value="Зарплатная вилка:" stylename="bold"/>
                                    <label id="previewSalary" value="-"/>
                                </row>
                                <row>
                                    <label value="Требуемый опыт:" stylename="bold"/>
                                    <label id="previewExperience" value="-"/>
                                </row>
                            </rows>
                        </grid>
                    </hbox>

                    <!-- Блок ключевых навыков -->
                    <vbox width="100%" spacing="false">
                        <label value="Ключевые навыки:" stylename="bold" css="font-size: 11px; margin-bottom: 4px;"/>
                        <label id="previewSkills" htmlEnabled="true" width="100%"/>
                    </vbox>
                </vbox>

                <!-- Блок подсказок/недостающих полей -->
                <vbox id="missingFieldsBox" width="100%" spacing="false" visible="false" stylename="edit-card"
                      css="border-left: 4px solid #3b82f6 !important; background: #eff6ff !important;">
                    <label id="missingFieldsLabel" htmlEnabled="true" width="100%"/>
                </vbox>

            </vbox>
        </scrollBox>

        <!-- Нижняя панель действий -->
        <hbox id="footerToolbar" width="100%" spacing="true" align="MIDDLE_RIGHT" stylename="edit-toolbar">
            <button id="saveNewPositionBtn" caption="Открыть вакансию в HRM"
                    icon="CREATE_ACTION" stylename="primary candidate-btn candidate-create-btn" visible="false"/>
            <button id="cancelBtn" caption="Закрыть" icon="CLOSE" stylename="secondary candidate-btn"/>
        </hbox>
    </layout>
</window>
