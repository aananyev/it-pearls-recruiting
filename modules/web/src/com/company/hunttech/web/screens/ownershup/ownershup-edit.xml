<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Edit-экран справочника «Формы собственности»: двухпанельная композиция Split-View 312px
     по общему контракту Edit-экранов HRM HuntTech (hunttech-edit-screen-design). Сохраняет binding и actions. -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://editorCaption"
        focusComponent="shortTypeField"
        messagesPack="com.company.hunttech.web.screens.ownershup"
        icon="icons/icons/wf-user-group-button.png">
    <data>
        <instance id="ownershupDc"
                  class="com.company.hunttech.entity.Ownershup"
                  view="_local">
            <loader/>
        </instance>
    </data>
    <dialogMode height="100%" width="100%" modal="true"/>
    <layout stylename="ownershup-editor job-candidate-editor edit-screen-layout"
            expand="mainLayout"
            spacing="false"
            margin="false"
            width="100%"
            height="100%">
        <hbox id="mainLayout"
              stylename="job-candidate-main-layout edit-screen-layout"
              expand="workspace"
              spacing="false"
              width="100%"
              height="100%">
            <!-- Левая контекстная панель 312px: аватар 120px, идентификация, label-навигация, реквизиты -->
            <vbox id="sidebar"
                  stylename="edit-sidebar job-candidate-sidebar"
                  width="312px"
                  height="100%"
                  spacing="true"
                  margin="false">
                <scrollBox id="sidebarScroll"
                           width="100%"
                           height="100%"
                           orientation="vertical">
                    <vbox id="sidebarContent"
                          width="100%"
                          spacing="true">
                        <!-- Визуальный блок шапки: круглая иллюстрация 120px -->
                        <vbox id="visual"
                              stylename="edit-sidebar-visual job-candidate-profile-header"
                              width="100%"
                              spacing="true"
                              align="TOP_CENTER">
                            <ovaFallbackImage id="ownershupLogoImage"
                                              width="120px"
                                              height="120px"
                                              ovalWidth="120px"
                                              ovalHeight="120px"
                                              align="TOP_CENTER"
                                              stylename="job-candidate-avatar"
                                              fallbackThemePath="icons/briefcase.png"
                                              scaleMode="SCALE_DOWN"/>
                            <!-- Блок идентификации: тип записи и краткое/полное название -->
                            <vbox id="identity"
                                  stylename="edit-sidebar-identity"
                                  width="100%"
                                  spacing="false"
                                  align="MIDDLE_CENTER">
                                <label id="sidebarSubtitle"
                                       value="msg://sidebarSubtitle"
                                       stylename="edit-sidebar-subtitle h4 candidate-sidebar-position bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                                <label id="sidebarTitle"
                                       dataContainer="ownershupDc"
                                       property="shortType"
                                       stylename="edit-sidebar-title h2 candidate-sidebar-fullname bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                            </vbox>
                        </vbox>

                        <!-- Вертикальная label-навигация по разделам формы -->
                        <vbox id="navigation"
                              stylename="label-navigation job-candidate-navigation"
                              width="100%"
                              spacing="false">
                            <label value="Разделы"
                                   stylename="label-nav-title dictionary-navigation-title"
                                   width="100%"/>
                            <button id="mainNav"
                                    caption="msg://mainNav.caption"
                                    stylename="borderless label-nav-item label-nav-item-active"
                                    width="100%"
                                    invoke="focusMainSection"/>
                        </vbox>

                        <!-- Сводка реквизитов формы собственности -->
                        <vbox id="termsCard"
                              width="100%"
                              spacing="true"
                              stylename="job-candidate-navigation label-navigation">
                            <label value="msg://termsTitle"
                                   width="100%"
                                   stylename="label-nav-title job-candidate-section-title"
                                   align="MIDDLE_CENTER"/>
                            <grid id="termsGrid"
                                  spacing="true"
                                  width="100%"
                                  stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row>
                                        <label value="msg://shortTypeCaption" stylename="bold"/>
                                        <label id="sideShortType" dataContainer="ownershupDc" property="shortType"/>
                                    </row>
                                    <row>
                                        <label value="msg://longTypeCaption" stylename="bold"/>
                                        <label id="sideLongType" dataContainer="ownershupDc" property="longType"/>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Контекстная подсказка -->
                        <label value="Форма собственности определяет организационно-правовой статус компании в HRM HuntTech."
                               stylename="edit-sidebar-hint"
                               width="100%"/>

                        <!-- Нижний спейсер 16px -->
                        <vbox id="sidebarSpacer"
                              width="100%"
                              height="16px"
                              stylename="edit-sidebar-spacer"/>
                    </vbox>
                </scrollBox>
            </vbox>

            <!-- Правая рабочая область: toolbar, секции с адаптивной шириной и footer-actions -->
            <vbox id="workspace"
                  stylename="edit-workspace candidate-reestr-workspace"
                  expand="workspaceScroll"
                  width="100%"
                  height="100%"
                  spacing="false">
                <!-- Toolbar с заголовком карточки и пояснением -->
                <hbox id="toolbar"
                      stylename="edit-toolbar"
                      width="100%"
                      spacing="true">
                    <vbox id="toolbarText" width="100%" spacing="false">
                        <label value="Карточка формы собственности" stylename="edit-toolbar-title"/>
                        <label value="Краткое и полное наименование формы собственности" stylename="edit-toolbar-description"/>
                    </vbox>
                </hbox>

                <!-- Прокручиваемая область контента рабочей области -->
                <scrollBox id="workspaceScroll"
                           stylename="edit-workspace-scroll"
                           width="100%"
                           height="100%">
                    <vbox id="sections"
                          stylename="edit-workspace-content"
                          width="100%"
                          spacing="true">
                        <!-- Аккордеон-секция «Основные данные»: реквизиты формы собственности -->
                        <groupBox id="mainSection"
                                  caption="Основные данные"
                                  stylename="edit-accordion-section"
                                  showAsPanel="true"
                                  collapsable="true"
                                  collapsed="false"
                                  width="100%"
                                  spacing="true">
                            <form id="form" dataContainer="ownershupDc" width="100%">
                                <column width="100%">
                                    <!-- Краткое наименование с адаптивной шириной -->
                                    <textField id="shortTypeField"
                                               property="shortType"
                                               caption="msg://msgShortType"
                                               width="100%"
                                               maxWidth="260px"
                                               stylename="edit-form-control"/>
                                    <!-- Полное наименование с адаптивной шириной -->
                                    <textField id="longTypeField"
                                               property="longType"
                                               caption="msg://msgLongType"
                                               width="100%"
                                               maxWidth="560px"
                                               stylename="edit-form-control"/>
                                </column>
                            </form>
                        </groupBox>
                    </vbox>
                </scrollBox>

                <!-- Нижняя панель штатных действий: сохранить и отменить -->
                <hbox id="editActions"
                      stylename="edit-footer-actions"
                      spacing="true"
                      width="100%"
                      expand="actionsSpacer"
                      align="MIDDLE_RIGHT">
                    <vbox id="actionsSpacer" width="100%" height="1px"/>
                    <button id="commitAndCloseBtn"
                            action="windowCommitAndClose"
                            stylename="c-primary-action"/>
                    <button id="closeBtn"
                            action="windowClose"/>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>

