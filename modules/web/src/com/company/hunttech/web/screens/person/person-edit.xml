<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Edit-экран персональных данных «Люди»: двухпанельная композиция по общему контракту Edit-экранов HRM HuntTech (sidebar 270px + рабочая область с карточками). -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://editorCaption"
        focusComponent="firstNameField"
        messagesPack="com.company.hunttech.web.screens.person"
        icon="USER">
    <!-- Секция данных: корневой контейнер человека и коллекции справочников для picker-полей формы. -->
    <data>
        <!-- Корневой контейнер персональных данных с person-edit-view; загрузчик берёт id из editor. -->
        <instance id="personDc"
                  class="com.company.hunttech.entity.Person"
                  view="person-edit-view">
            <!-- Штатный загрузчик контейнера (без собственного запроса). -->
            <loader/>
        </instance>
        <!-- Коллекция городов для picker-поля «Город» (кэшируемая, по алфавиту). -->
        <collection id="positionCityDc" class="com.company.hunttech.entity.City" view="city-picker-view">
            <loader id="positionCityLc" cacheable="true">
                <query><![CDATA[select e from hunttech_City e order by e.cityRuName]]></query>
            </loader>
        </collection>
        <!-- Коллекция стран для picker-поля «Страна» (кэшируемая, по алфавиту). -->
        <collection id="positionCountriesDc" class="com.company.hunttech.entity.Country" view="country-picker-view">
            <loader id="positionCountriesLc" cacheable="true">
                <query><![CDATA[select e from hunttech_Country e order by e.countryRuName]]></query>
            </loader>
        </collection>
        <!-- Коллекция должностей для picker-поля «Должность» (кэшируемая, по алфавиту). -->
        <collection id="personPositionsDc" class="com.company.hunttech.entity.Position" view="_minimal">
            <loader id="personPositionsLc" cacheable="true">
                <query><![CDATA[select e from hunttech_Position e order by e.positionRuName]]></query>
            </loader>
        </collection>
    </data>
    <!-- Полноэкранный модальный редактор справочника «Люди» (sidebar + рабочая область). -->
    <dialogMode height="100%" width="100%" modal="true"/>
    <!-- Корневой layout формы: локальный namespace person-editor + общий контракт Edit-экранов. -->
    <layout stylename="person-editor"
            expand="personMainLayout"
            spacing="false"
            width="100%"
            height="100%">
        <!-- Двухпанельная композиция: постоянная sidebar слева и рабочая область справа. -->
        <hbox id="personMainLayout"
              stylename="edit-screen-layout"
              expand="personWorkspace"
              spacing="false"
              width="100%"
              height="100%">
            <!-- Левая контекстная панель 270px: фото, идентификация, label-навигация, подсказка.
                 Ширина 270px и внутренние отступы — контракт §4.2 для справочников (эталон гео-форм). -->
            <vbox id="personSidebar"
                  stylename="edit-sidebar"
                  width="270px"
                  height="100%"
                  spacing="true"
                  expand="personSidebarSpacer">
                <!-- Визуальный блок sidebar: круглое фото человека с fallback-аватаром. -->
                <vbox id="personVisual"
                      stylename="edit-sidebar-visual"
                      width="100%"
                      spacing="true"
                      align="MIDDLE_CENTER">
                    <!-- Круглый аватар человека: характеристики 1:1 с skillPic эталона SkillTreeEdit —
                         размер 176×176, visible, MIDDLE_CENTER, fallback icons/no-programmer.jpeg, SCALE_DOWN;
                         при отсутствии файла показывает fallback-картинку (applyFallback в контроллере). -->
                    <ovaFallbackImage id="personPic"
                                      dataContainer="personDc"
                                      property="fileImageFace"
                                      width="176px"
                                      height="176px"
                                      ovalWidth="176px"
                                      ovalHeight="176px"
                                      fallbackThemePath="icons/no-programmer.jpeg"
                                      visible="true"
                                      align="MIDDLE_CENTER"
                                      stylename="person-logo-image"
                                      scaleMode="SCALE_DOWN"/>
                    <!-- Загрузка фото: файл сразу кладётся в fileImageFace (IMMEDIATE), перетаскивание на блок визуала. -->
                    <upload id="fileImageFaceUpload"
                            fileStoragePutMode="IMMEDIATE"
                            dataContainer="personDc"
                            align="BOTTOM_LEFT"
                            showFileName="false"
                            dropZone="personVisual"
                            showClearButton="true"
                            property="fileImageFace"/>
                </vbox>
                <!-- Блок идентификации: имя человека из контейнера (живое значение, по центру). -->
                <vbox id="personIdentity"
                      stylename="edit-sidebar-identity"
                      width="100%"
                      spacing="true">
                    <!-- Имя (свойство firstName) — основное название карточки в sidebar, центрируется по горизонтали. -->
                    <label id="personSidebarTitle"
                           dataContainer="personDc"
                           property="firstName"
                           stylename="edit-sidebar-title"
                           width="100%"/>
                </vbox>
                <!-- Вертикальная label-навигация по разделам формы (фокус, без изменения данных). -->
                <vbox id="personNavigation"
                      stylename="label-navigation"
                      width="100%"
                      spacing="false">
                    <!-- Заголовок навигационного блока: полоса-заголовок с двумя inset-линиями (контракт §4.1). -->
                    <label value="Разделы"
                           stylename="label-nav-title person-navigation-title"
                           width="100%"/>
                    <!-- Пункт «Основные данные» — активен по умолчанию, фокусирует имя. -->
                    <button id="personMainNav"
                            caption="Основные данные"
                            stylename="borderless label-nav-item label-nav-item-active"
                            width="100%"
                            invoke="focusMainSection"/>
                    <!-- Пункт «Контакты» — фокусирует email. -->
                    <button id="personContactsNav"
                            caption="Контакты"
                            stylename="borderless label-nav-item"
                            width="100%"
                            invoke="focusContactsSection"/>
                    <!-- Пункт «Местоположение» — фокусирует город проживания. -->
                    <button id="personLocationNav"
                            caption="Местоположение"
                            stylename="borderless label-nav-item"
                            width="100%"
                            invoke="focusLocationSection"/>
                </vbox>
                <!-- Служебный spacer на всю высоту sidebar (100%×100%) прижимает подсказку
                     к нижней границе — как personSidebarSpacer эталона SkillTreeEdit/гео-форм. -->
                <vbox id="personSidebarSpacer" width="100%" height="100%" stylename="edit-sidebar-spacer"/>
                <!-- Нейтральная подсказка о роли персональных данных в справочниках HRM HuntTech. -->
                <label value="Персональные данные сотрудника используются в карточках кандидатов, компаний и вакансий."
                       stylename="edit-sidebar-hint"
                       width="100%"/>
            </vbox>
            <!-- Правая рабочая область: toolbar, прокручиваемые карточки и footer-actions. -->
            <vbox id="personWorkspace"
                  stylename="edit-workspace"
                  expand="personWorkspaceScroll"
                  width="100%"
                  height="100%"
                  spacing="false">
                <!-- Toolbar с заголовком карточки и пояснением. -->
                <hbox id="personToolbar"
                      stylename="edit-toolbar"
                      width="100%"
                      spacing="true">
                    <!-- Текстовый блок toolbar: заголовок и описание. -->
                    <vbox id="personToolbarText" width="100%" spacing="false">
                        <!-- Заголовок рабочей области. -->
                        <label value="Карточка человека" stylename="edit-toolbar-title"/>
                        <!-- Пояснение: реквизиты, контакты и местоположение. -->
                        <label value="Персональные данные, контакты и местоположение" stylename="edit-toolbar-description"/>
                    </vbox>
                </hbox>
                <!-- Прокручиваемая область контента рабочей области. -->
                <scrollBox id="personWorkspaceScroll"
                           stylename="edit-workspace-scroll"
                           width="100%"
                           height="100%">
                    <!-- Поток карточек рабочей области: общий класс контента edit-workspace-content
                         + локальный person-content с отступами 8px 20px 24px (эталон SkillTreeEdit). -->
                    <vbox id="personSections" width="100%" spacing="true"
                          stylename="edit-workspace-content person-content">
                        <!-- Карточка «Основные данные»: ФИО и дата рождения. -->
                        <groupBox id="personMainSection"
                                  caption="Основные данные"
                                  stylename="edit-card"
                                  showAsPanel="true"
                                  width="100%"
                                  spacing="true">
                            <!-- Форма реквизитов: все поля биндятся на personDc (как эталон гео-форм). -->
                            <form id="personMainForm"
                                  width="100%"
                                  dataContainer="personDc">
                                <column width="100%">
                                    <!-- Имя (обязательная часть ФИО). -->
                                    <textField id="firstNameField" property="firstName" caption="mainMsg://msgFirstName" width="100%" stylename="edit-form-control"/>
                                    <!-- Отчество. -->
                                    <textField id="middleNameField" property="middleName" caption="mainMsg://msgMiddleName" width="100%" stylename="edit-form-control"/>
                                    <!-- Фамилия. -->
                                    <textField id="secondNameField" property="secondName" caption="mainMsg://msgSecondName" width="100%" stylename="edit-form-control"/>
                                    <!-- Дата рождения. -->
                                    <dateField id="birdhDateField" property="birdhDate" caption="mainMsg://msgBirthday" width="100%" stylename="edit-form-control"/>
                                </column>
                            </form>
                        </groupBox>
                        <!-- Карточка «Контакты»: email, телефоны и мессенджеры. -->
                        <groupBox id="personContactsSection"
                                  caption="Контакты"
                                  stylename="edit-card"
                                  showAsPanel="true"
                                  width="100%"
                                  spacing="true">
                            <!-- Форма контактов: все поля биндятся на personDc. -->
                            <form id="personContactsForm"
                                  width="100%"
                                  dataContainer="personDc">
                                <column width="100%">
                                    <!-- Электронная почта (с валидацией @Email). -->
                                    <textField id="emailField" property="email" caption="mainMsg://msgEmail" width="100%" stylename="edit-form-control"/>
                                    <!-- Рабочий телефон. -->
                                    <textField id="phoneField" property="phone" caption="mainMsg://msgPhone" width="100%" stylename="edit-form-control"/>
                                    <!-- Мобильный телефон (уникальный). -->
                                    <textField id="mobilePhoneField" property="mobPhone" caption="msg://msgMobPhone" width="100%" stylename="edit-form-control"/>
                                    <!-- Skype (в нижнем регистре, уникальный). -->
                                    <textField id="skypeNameField" property="skypeName" caption="mainMsg://msgSkype" width="100%" stylename="edit-form-control"/>
                                    <!-- Telegram (уникальный). -->
                                    <textField id="telegramNameField" property="telegramName" caption="mainMsg://msgTelegram" width="100%" stylename="edit-form-control"/>
                                    <!-- Viber (уникальный). -->
                                    <textField id="wiberNameField" property="wiberName" caption="mainMsg://msgViber" width="100%" stylename="edit-form-control"/>
                                    <!-- WhatsApp (в нижнем регистре, уникальный). -->
                                    <textField id="watsupNameField" property="watsupName" caption="mainMsg://msgWhatsApp" width="100%" stylename="edit-form-control"/>
                                </column>
                            </form>
                        </groupBox>
                        <!-- Карточка «Местоположение и должность»: город проживания, страна и должность. -->
                        <groupBox id="personLocationSection"
                                  caption="Местоположение и должность"
                                  stylename="edit-card"
                                  showAsPanel="true"
                                  width="100%"
                                  spacing="true">
                            <!-- Форма местоположения: связи Person (city/страна/должность), варианты из коллекций-справочников. -->
                            <form id="personLocationForm"
                                  width="100%"
                                  dataContainer="personDc">
                                <column width="100%">
                                    <!-- Город проживания: lookup по коллекции городов. -->
                                    <lookupPickerField id="positionCityField" property="cityOfResidence"
                                                       caption="msg://msgCityOfResidence"
                                                       optionsContainer="positionCityDc"
                                                       width="100%"
                                                       stylename="edit-form-control">
                                        <actions>
                                            <action id="lookup" type="picker_lookup"/>
                                        </actions>
                                    </lookupPickerField>
                                    <!-- Страна текущего местоположения: lookup по коллекции стран. -->
                                    <lookupPickerField id="positionCountryField" optionsContainer="positionCountriesDc"
                                                       property="positionCountry" caption="mainMsg://msgCountry"
                                                       width="100%"
                                                       stylename="edit-form-control">
                                        <actions>
                                            <action id="lookup" type="picker_lookup"/>
                                        </actions>
                                    </lookupPickerField>
                                    <!-- Должность сотрудника: lookup по коллекции должностей. -->
                                    <lookupPickerField id="personPositionField" optionsContainer="personPositionsDc"
                                                       property="personPosition" caption="mainMsg://msgPersonPosition"
                                                       width="100%"
                                                       stylename="edit-form-control">
                                        <actions>
                                            <action id="lookup" type="picker_lookup"/>
                                        </actions>
                                    </lookupPickerField>
                                </column>
                            </form>
                        </groupBox>
                    </vbox>
                </scrollBox>
                <!-- Нижняя панель штатных действий: спейсер (expand) выталкивает группу
                     к правому краю, как editActionsSpacer + editActionsGroup эталона SkillTreeEdit. -->
                <hbox id="editActions" stylename="edit-footer-actions" spacing="false" width="100%"
                      expand="personActionsSpacer" align="MIDDLE_RIGHT">
                    <!-- Spacer шириной 100% занимает всё свободное место footer. -->
                    <vbox id="personActionsSpacer" width="100%" height="1px"/>
                    <!-- Группа действий AUTO/MIDDLE_RIGHT объединяет primary и secondary команды. -->
                    <hbox id="personActionsGroup" width="AUTO" height="AUTO" spacing="true"
                          align="MIDDLE_RIGHT" stylename="person-footer-actions">
                        <!-- Сохранить и закрыть (штатный action editor-а) — акцентная primary-кнопка, как эталон SkillTreeEdit. -->
                        <button action="windowCommitAndClose" stylename="person-editor-primary-action"/>
                        <!-- Отменить изменения и закрыть — вторичная прозрачная кнопка, как эталон SkillTreeEdit. -->
                        <button action="windowClose" stylename="person-editor-secondary-action"/>
                    </hbox>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>
