<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://personReestrCaption"
        focusComponent="personsTable"
        messagesPack="com.company.hunttech.web.screens.person"
        icon="USERS">
    <data readOnly="true">
        <collection id="personsDc"
                    class="com.company.hunttech.entity.Person">
            <view extends="person-browse-view">
                <property name="firstName"/>
                <property name="middleName"/>
                <property name="secondName"/>
                <property name="email"/>
                <property name="phone"/>
                <property name="mobPhone"/>
                <property name="skypeName"/>
                <property name="telegramName"/>
                <property name="wiberName"/>
                <property name="watsupName"/>
                <property name="sendResumeToEmail"/>
                <property name="personPosition" view="_minimal">
                    <property name="positionRuName"/>
                </property>
                <property name="positionCountry" view="_minimal">
                    <property name="countryRuName"/>
                </property>
                <property name="cityOfResidence" view="_minimal">
                    <property name="cityRuName"/>
                </property>
                <property name="companyDepartment" view="_minimal">
                    <property name="departamentRuName"/>
                    <property name="companyName" view="_minimal">
                        <property name="comanyName"/>
                    </property>
                </property>
                <property name="fileImageFace" view="_minimal"/>
            </view>
            <loader id="personsDl">
                <query><![CDATA[select e from hunttech_Person e order by e.secondName, e.firstName]]></query>
            </loader>
        </collection>
    </data>

    <dialogMode height="700" width="1100"/>

    <layout expand="splitMainLayout" spacing="false" margin="false" stylename="job-candidate-editor edit-screen-layout">
        <split id="splitMainLayout" orientation="horizontal" pos="312px" min="260px" max="500px" width="100%" height="100%">
            <!-- ЛЕВЫЙ САЙДБАР (312px) -->
            <vbox id="detailPane" width="100%" height="100%" spacing="true" margin="false" stylename="edit-sidebar job-candidate-sidebar">
                <scrollBox id="sidebarScrollBox" width="100%" height="100%" spacing="true" scrollBars="vertical">
                    <vbox width="100%" spacing="true">
                        <!-- Шапка профиля человека -->
                        <vbox id="profileHeader" width="100%" spacing="true" align="TOP_CENTER" stylename="job-candidate-profile-header edit-sidebar-visual">
                            <ovaFallbackImage id="logoPic" width="120px" height="120px" ovalWidth="120px" ovalHeight="120px"
                                              align="TOP_CENTER" stylename="job-candidate-avatar" fallbackThemePath="icons/no-programmer.jpeg" scaleMode="SCALE_DOWN"/>
                            <vbox width="100%" spacing="false" align="MIDDLE_CENTER" stylename="edit-sidebar-identity">
                                <label id="detailTitle" value="Выберите человека" width="100%" stylename="edit-sidebar-title h2 candidate-sidebar-fullname" align="MIDDLE_CENTER"/>
                                <label id="detailSubtitle" value="-" width="100%" stylename="edit-sidebar-subtitle h4 candidate-sidebar-position" align="MIDDLE_CENTER"/>
                                <label id="detailLocation" value="-" width="100%" stylename="edit-help candidate-sidebar-city" align="MIDDLE_CENTER"/>
                            </vbox>
                        </vbox>

                        <!-- Кнопки действий сайдбара -->
                        <vbox id="sidebarActionsCard" width="100%" spacing="true" stylename="edit-sidebar-summary">
                            <button id="openEditCardBtn" caption="Открыть карточку" icon="EDIT_ACTION" stylename="primary" enabled="false" width="100%"/>
                        </vbox>

                        <!-- Секция: Контактные данные -->
                        <vbox id="contactsCard" width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="КОНТАКТЫ" width="100%" stylename="label-nav-title job-candidate-section-title"/>
                            <grid id="contactsGrid" spacing="true" width="100%" stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row><label value="Телефон:" stylename="bold"/><label id="detailPhone" value="-"/></row>
                                    <row><label value="Мобильный:" stylename="bold"/><label id="detailMobPhone" value="-"/></row>
                                    <row><label value="Email:" stylename="bold"/><label id="detailEmail" value="-"/></row>
                                    <row><label value="Telegram:" stylename="bold"/><label id="detailTelegram" value="-"/></row>
                                    <row><label value="Skype:" stylename="bold"/><label id="detailSkype" value="-"/></row>
                                    <row><label value="WhatsApp:" stylename="bold"/><label id="detailWhatsApp" value="-"/></row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Секция: Место работы -->
                        <vbox id="workCard" width="100%" spacing="true" stylename="job-candidate-navigation label-navigation">
                            <label value="МЕСТО РАБОТЫ" width="100%" stylename="label-nav-title job-candidate-section-title"/>
                            <vbox spacing="false" width="100%" stylename="edit-sidebar-summary">
                                <label id="detailCompany" value="-" stylename="bold" width="100%"/>
                                <label id="detailDepartment" value="-" stylename="edit-help" width="100%"/>
                            </vbox>
                        </vbox>
                    </vbox>
                </scrollBox>
            </vbox>

            <!-- ПРАВАЯ РАБОЧАЯ ОБЛАСТЬ -->
            <vbox id="workspaceBox" width="100%" height="100%" spacing="true" stylename="edit-workspace candidate-reestr-workspace" expand="tableCard" margin="true,true,true,false">
                
                <!-- Командный тулбар -->
                <hbox id="tableFilterBar" width="100%" spacing="true" align="MIDDLE_LEFT" stylename="candidate-filter-bar edit-card" expand="toolbarSpacer">
                    <hbox id="leftActionButtons" spacing="true" align="MIDDLE_LEFT" stylename="filter-buttons-panel">
                        <button id="createBtn" caption="Создать человека" icon="CREATE_ACTION" stylename="primary candidate-btn candidate-create-btn" action="personsTable.create"/>
                        <button id="editBtn" caption="Редактировать" icon="EDIT_ACTION" stylename="secondary candidate-btn" action="personsTable.edit"/>
                        <button id="removeBtn" caption="Удалить" icon="REMOVE_ACTION" stylename="secondary candidate-btn" action="personsTable.remove"/>
                    </hbox>
                    <hbox id="toolbarSpacer" width="100%"/>
                    <hbox id="rightActionButtons" spacing="true" align="MIDDLE_RIGHT" stylename="filter-buttons-panel">
                        <popupButton id="actionsPopupButton" caption="Действия" icon="BARS" stylename="primary candidate-btn">
                            <actions>
                                <action id="refreshAction" caption="Обновить данные" icon="REFRESH"/>
                                <action id="excelExportAction" caption="Выгрузить в Excel" icon="FILE_EXCEL_O"/>
                            </actions>
                        </popupButton>
                    </hbox>
                </hbox>

                <!-- Generic Filter -->
                <filter id="filter"
                        applyTo="personsTable"
                        dataLoader="personsDl"
                        defaultMode="generic"
                        width="100%"
                        collapsable="true"
                        collapsed="true"
                        stylename="candidate-generic-filter">
                    <properties include=".*"
                                excludeProperties="version,createTs,createdBy,updateTs,updatedBy,deleteTs,deletedBy,sendResumeToEmail,fileImageFace,birdhDate"/>
                </filter>

                <!-- Карточка таблицы с rowsCount -->
                <vbox id="tableCard" width="100%" height="100%" spacing="false" stylename="edit-card candidate-table-card" expand="personsTable">
                    <dataGrid id="personsTable"
                              width="100%"
                              height="100%"
                              dataContainer="personsDc"
                              stylename="borderless grid candidate-browse-grid">
                        <actions>
                            <action id="create" type="create"/>
                            <action id="edit" type="edit"/>
                            <action id="remove" type="remove"/>
                            <action id="excel" type="excelExport"/>
                            <action id="refresh" type="refresh"/>
                        </actions>
                        <columns>
                            <column id="personPicColumn"
                                    caption="Фото"
                                    resizable="false"
                                    collapsible="false"
                                    width="60px"
                                    minimumWidth="50px">
                                <componentRenderer/>
                            </column>
                            <column id="secondName"
                                    property="secondName"
                                    caption="Фамилия"
                                    expandRatio="1"/>
                            <column id="firstName"
                                    property="firstName"
                                    caption="Имя"
                                    expandRatio="1"/>
                            <column id="middleName"
                                    property="middleName"
                                    caption="Отчество"
                                    expandRatio="1"/>
                            <column id="personPosition"
                                    property="personPosition"
                                    caption="Должность"
                                    expandRatio="2"/>
                            <column id="companyDepartment"
                                    property="companyDepartment"
                                    caption="Компания / Отдел"
                                    expandRatio="2"/>
                            <column id="positionCountry"
                                    property="positionCountry"
                                    caption="Страна"
                                    width="120px"/>
                            <column id="cityOfResidence"
                                    property="cityOfResidence"
                                    caption="Город"
                                    width="130px"/>
                        </columns>
                        <rowsCount/>
                    </dataGrid>
                </vbox>
            </vbox>
        </split>
    </layout>
</window>
