<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Edit-экран справочника «Должности»: двухпанельная композиция по общему контракту
     Edit-экранов HRM HuntTech. Сохраняет исходный data binding (positionDc), LOB-поля
     standartDescription/whoIsThisGuy и Java-логику контроллера (textPositionName). -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://editorCaption"
        focusComponent="positionRuNameField"
        messagesPack="com.company.hunttech.web.screens.position" icon="OPENID">
    <!-- Секция данных: корневой контейнер должности. -->
    <data>
        <!-- Редактируемая должность: общий view position-edit-view (без LOB) расширен inline
             LOB-полями standartDescription/whoIsThisGuy — форма содержит два richTextArea,
             привязанных к ним; расширение локально для экрана и не влияет на другие потребители
             position-edit-view (в т.ч. тесты и picker-цепочки OpenPosition). -->
        <instance id="positionDc"
                  class="com.company.hunttech.entity.Position">
            <view extends="position-edit-view">
                <property name="standartDescription"/>
                <property name="whoIsThisGuy"/>
            </view>
            <loader/>
        </instance>
    </data>
    <!-- Режим диалога: полноэкранный модальный редактор справочника. -->
    <dialogMode height="100%" width="100%" modal="true"/>
    <!-- Корневой layout формы: локальный namespace position-editor + общий контракт Edit-экранов. -->
    <layout stylename="position-editor"
            expand="mainLayout"
            spacing="false"
            width="100%"
            height="100%">
        <!-- Двухпанельная композиция: постоянная sidebar слева и рабочая область справа. -->
        <hbox id="mainLayout"
              stylename="edit-screen-layout"
              expand="workspace"
              spacing="false"
              width="100%"
              height="100%">
            <!-- Левая контекстная панель 270px: фирменный логотип, идентификация,
                 label-навигация и подсказка (контракт §4.2). -->
            <vbox id="sidebar"
                  stylename="edit-sidebar"
                  width="270px"
                  height="100%"
                  spacing="true"
                  expand="sidebarSpacer">
                <!-- Визуальный блок sidebar: круглая иллюстрация должности. -->
                <vbox id="visual"
                      stylename="edit-sidebar-visual"
                      width="100%"
                      spacing="true"
                      align="MIDDLE_CENTER">
                    <ovalImage id="positionLogoImage"
                               width="176px"
                               height="176px"
                               ovalWidth="176px"
                               ovalHeight="176px"
                               visible="true"
                               align="MIDDLE_CENTER"
                               scaleMode="SCALE_DOWN"
                               stylename="dictionary-logo-image">
                        <!-- Тематическая иконка справочника должностей. -->
                        <theme path="icons/dictionaries/position.png"/>
                    </ovalImage>
                </vbox>
                <!-- Блок идентификации: русское наименование должности по центру. -->
                <vbox id="identity"
                      stylename="edit-sidebar-identity"
                      width="100%"
                      spacing="false"
                      align="MIDDLE_CENTER">
                    <!-- Русское наименование должности (свойство positionRuName), живое из positionDc. -->
                    <label id="positionSidebarTitle"
                           dataContainer="positionDc"
                           property="positionRuName"
                           stylename="edit-sidebar-title"
                           width="100%"/>
                </vbox>
                <!-- Вертикальная label-навигация по разделам формы (фокус, без изменения данных). -->
                <vbox id="navigation"
                      stylename="label-navigation"
                      width="100%"
                      spacing="false">
                    <!-- Заголовок навигационного блока: полоса-заголовок с двумя inset-линиями (контракт §4.1). -->
                    <label value="msg://msgNavTitle"
                           stylename="label-nav-title position-navigation-title"
                           width="100%"/>
                    <!-- Пункт «Наименование» — активен по умолчанию, фокусирует русское наименование. -->
                    <button id="mainNav"
                            caption="msg://msgNavMain"
                            stylename="borderless label-nav-item label-nav-item-active"
                            width="100%"
                            invoke="focusMainSection"/>
                    <!-- Пункт «Описание» — фокусирует редактор общего описания. -->
                    <button id="descriptionNav"
                            caption="msg://msgNavDescription"
                            stylename="borderless label-nav-item"
                            width="100%"
                            invoke="focusDescriptionSection"/>
                </vbox>
                <!-- Сводка ключевых наименований должности в сайдбаре. -->
                <vbox id="sidebarSummary"
                      stylename="edit-sidebar-summary"
                      width="100%"
                      spacing="true">
                    <label value="msg://msgPositionRuName" stylename="edit-sidebar-subtitle"/>
                    <label dataContainer="positionDc" property="positionRuName" width="100%"/>
                    <label value="msg://msgPositionEnName" stylename="edit-sidebar-subtitle"/>
                    <label dataContainer="positionDc" property="positionEnName" width="100%"/>
                </vbox>
                <!-- Служебный spacer прижимает подсказку к нижней границе sidebar. -->
                <vbox id="sidebarSpacer" stylename="edit-sidebar-spacer" width="100%" height="100%"/>
                <!-- Нейтральная подсказка о роли справочника в HRM HuntTech. -->
                <label value="msg://msgSidebarHint"
                       stylename="edit-sidebar-hint"
                       width="100%"/>
            </vbox>
            <!-- Правая рабочая область: toolbar, прокручиваемые секции и footer-actions. -->
            <vbox id="workspace"
                  stylename="edit-workspace"
                  expand="workspaceScroll"
                  width="100%"
                  height="100%"
                  spacing="false">
                <!-- Toolbar с заголовком карточки и пояснением. -->
                <hbox id="toolbar"
                      stylename="edit-toolbar"
                      width="100%"
                      spacing="true">
                    <!-- Текстовый блок toolbar: заголовок и описание. -->
                    <vbox id="toolbarText" width="100%" spacing="false">
                        <label value="msg://editorCaption" stylename="edit-toolbar-title"/>
                        <label value="msg://msgPositionReestrDescription" stylename="edit-toolbar-description"/>
                    </vbox>
                </hbox>
                <!-- Прокручиваемая область контента рабочей области. -->
                <scrollBox id="workspaceScroll"
                           stylename="edit-workspace-scroll"
                           width="100%"
                           height="100%">
                    <!-- Поток карточек рабочей области. -->
                    <vbox id="sections" stylename="edit-workspace-content" width="100%" spacing="true">
                        <!-- Карточка «Наименование»: составное название и оба наименования должности. -->
                        <groupBox id="mainSection"
                                  caption="msg://msgNavMain"
                                  stylename="edit-card"
                                  showAsPanel="true"
                                  width="100%"
                                  spacing="true">
                            <!-- Составное название «EN - RU», заполняется контроллером при изменении полей. -->
                            <label id="textPositionName" stylename="h1" width="100%"/>
                            <!-- Форма с полями, привязанными к positionDc. -->
                            <form id="form" dataContainer="positionDc" width="100%">
                                <column width="100%">
                                    <!-- Русское наименование должности. -->
                                    <textField id="positionRuNameField"
                                               property="positionRuName"
                                               caption="msg://msgPositionRuName"
                                               width="100%"
                                               stylename="edit-form-control"/>
                                    <!-- Английское наименование должности. -->
                                    <textField id="positionEnNameField"
                                               property="positionEnName"
                                               caption="msg://msgPositionEnName"
                                               width="100%"
                                               stylename="edit-form-control"/>
                                </column>
                            </form>
                        </groupBox>
                        <!-- Карточка «Описание»: два редактора rich-текста (LOB-поля). -->
                        <groupBox id="descriptionSection"
                                  caption="msg://msgNavDescription"
                                  stylename="edit-card"
                                  showAsPanel="true"
                                  width="100%"
                                  spacing="true">
                            <hbox id="textAreaBox" width="100%" spacing="true">
                                <!-- Общее описание вакансии (LOB, загружается на этой вкладке). -->
                                <richTextArea id="standartDescriptionTextArea"
                                              dataContainer="positionDc"
                                              property="standartDescription"
                                              width="100%"
                                              height="220px"
                                              caption="msg://msgStandartDescription"/>
                                <!-- Пояснение «Кто это?» (LOB, загружается на этой вкладке). -->
                                <richTextArea id="whoIsThisGuyTextArea"
                                              dataContainer="positionDc"
                                              property="whoIsThisGuy"
                                              width="100%"
                                              height="220px"
                                              caption="msg://msgWhoThisGuyDescription"/>
                            </hbox>
                        </groupBox>
                    </vbox>
                </scrollBox>
                <!-- Нижняя панель штатных действий: сохранить и отменить. -->
                <hbox id="editActions" stylename="edit-footer-actions" spacing="false" width="100%"
                      expand="actionsSpacer" align="MIDDLE_RIGHT">
                    <!-- Spacer прижимает кнопки к правому краю. -->
                    <vbox id="actionsSpacer" width="100%" height="1px"/>
                    <hbox id="bottomActionsGroup" spacing="true" align="MIDDLE_RIGHT">
                        <!-- Сохранить и закрыть (штатный action editor-а). -->
                        <button id="commitAndCloseBtn" action="windowCommitAndClose"
                                caption="msg://commitAndClose" icon="CHECK"
                                stylename="primary"/>
                        <!-- Отменить изменения и закрыть. -->
                        <button id="closeBtn" action="windowClose"
                                caption="msg://close" icon="BAN"
                                stylename="secondary"/>
                    </hbox>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>
