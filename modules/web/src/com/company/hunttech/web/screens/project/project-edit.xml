<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Окно редактирования проекта (hunttech_Project.edit): полноэкранный модальный редактор
     по контракту Edit-форм — sidebar (визуал логотипа + идентификация + label-навигация
     «Разделы») и workspace (toolbar + tabSheet + footer-действия). -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://editorCaption"
        focusComponent="projectNameField"
        messagesPack="com.company.hunttech.web.screens.project" icon="ARCHIVE">
    <!-- Контейнеры данных формы: главный экземпляр проекта (project-edit-view, LOB-поля
         подгружаются лениво), открытые вакансии проекта (JPQL по projectName),
         справочники родительских проектов, департаментов и владельцев. -->
    <data>
        <instance id="projectDc"
                  class="com.company.hunttech.entity.Project"
                  view="project-edit-view">
            <loader/>
        </instance>
        <collection id="projectOpenPositionsDc"
                    class="com.company.hunttech.entity.OpenPosition"
                    view="openPosition-project-tab-view">
            <loader id="projectOpenPositionsDl">
                <query><![CDATA[select e from hunttech_OpenPosition e
                        where e.projectName = :project
                        order by e.createTs desc]]></query>
            </loader>
        </collection>
        <collection id="projectTreeDc" class="com.company.hunttech.entity.Project"
                    view="project-tree-picker-view">
            <loader id="projectTreeDl">
                <query><![CDATA[select e from hunttech_Project e
                        where not (e.projectIsClosed = true) and
                        e.projectName not like '%(не использовать)'
                        order by e.projectName]]></query>
            </loader>
        </collection>
        <collection id="projectDepartmentsDc"
                    class="com.company.hunttech.entity.CompanyDepartament"
                    view="companyDepartament-picker-view">
            <loader id="projectDepartmentsLc" cacheable="true">
                <query><![CDATA[select e from hunttech_CompanyDepartament e
                                        where e.departamentRuName not like '%(не использовать)'
                                        order by e.departamentRuName]]></query>
            </loader>
        </collection>
        <collection id="projectOwnersDc"
                    class="com.company.hunttech.entity.Person"
                    view="person-picker-view">
            <loader id="projectOwnersLc" cacheable="true">
                <query><![CDATA[select e from hunttech_Person e
                                        order by e.secondName, e.firstName]]></query>
            </loader>
        </collection>
    </data>
    <!-- Полноэкранный модальный режим диалога (контракт §5.3). -->
    <dialogMode height="100%"
                width="100%"
                modal="true"/>
    <!-- Корневой layout: локальный namespace project-editor + общий контракт edit-screen-layout;
         слева sidebar 270px, справа workspace (toolbar + вкладки + footer). -->
    <layout stylename="project-editor"
            expand="projectEditorMainLayout"
            spacing="false">
        <hbox id="projectEditorMainLayout"
              stylename="edit-screen-layout"
              width="100%"
              height="100%"
              expand="projectEditorWorkspace"
              spacing="false">
            <!-- Sidebar проекта: визуальный блок (логотип + загрузка), идентификация,
                 label-навигация «Разделы», spacer и подсказка. -->
            <vbox id="projectEditorSidebar"
                  stylename="edit-sidebar"
                  width="270px"
                  height="100%"
                  spacing="true"
                  expand="projectSidebarSpacer">
                <!-- Визуальный блок: круглый логотип проекта 96×96 (или fallback no-company.png
                     при отсутствии файла) и канонические кнопки «Загрузить»/«Очистить»;
                     dropZone — сам блок, файл IMMEDIATE кладётся в projectLogo. -->
                <vbox id="projectEditorSidebarVisual"
                      stylename="edit-sidebar-visual"
                      width="100%"
                      spacing="true"
                      align="MIDDLE_CENTER">
                    <!-- Обёртка аватара без фиксированного размера (как picVBox эталона
                         JobCandidateEdit): размер задаёт сам OvaFallbackImage 176×176. -->
                    <vbox id="projectLogoPicBox"
                          spacing="false"
                          align="MIDDLE_CENTER">
                        <!-- OvaFallbackImage логотипа проекта: единый элемент по эталону
                             JobCandidateEdit — 176×176 (width/height/ovalWidth/ovalHeight),
                             fallback no-company.png при отсутствии файла, SCALE_DOWN;
                             фон-подложка тёмно-серая (под прозрачный логотип после
                             removeAllWhite); загрузка — upload ниже
                             (dataContainer/property projectLogo). -->
                        <ovaFallbackImage id="projectLogoFileImage"
                                          dataContainer="projectDc"
                                          property="projectLogo"
                                          width="176px"
                                          height="176px"
                                          ovalWidth="176px"
                                          ovalHeight="176px"
                                          ovalBackground="#3a3e44"
                                          fallbackThemePath="icons/no-company.png"
                                          visible="true"
                                          align="MIDDLE_CENTER"
                                          stylename="project-editor-logo-image"
                                          scaleMode="SCALE_DOWN"/>
                    </vbox>
                    <upload id="projectLogoFileUpload"
                            fileStoragePutMode="IMMEDIATE"
                            dataContainer="projectDc"
                            align="MIDDLE_CENTER"
                            showFileName="false"
                            dropZone="projectEditorSidebarVisual"
                            showClearButton="true"
                            property="projectLogo"/>
                </vbox>
                <!-- Идентификация: только наименование проекта (динамическое, по центру);
                     подпись типа записи «Проект» удалена по указанию владельца. -->
                <vbox id="projectEditorSidebarIdentity"
                      stylename="edit-sidebar-identity"
                      width="100%"
                      spacing="false">
                    <label id="projectSidebarTitle"
                           stylename="edit-sidebar-title"
                           width="100%"
                           value="msg://browseCaption"/>
                </vbox>
                <!-- Label-навигация «Разделы»: идёт сразу после идентификации, перед разделом
                     «Коротко»; пункты = вкладки TabSheet в правой части экрана
                     (по явному указанию владельца; правило §3.6 не применяется — навигация
                     видна на всех вкладках); активный пункт управляется контроллером. -->
                <vbox id="projectEditorSidebarNavigation"
                      stylename="label-navigation"
                      width="100%"
                      spacing="false">
                    <label value="Разделы"
                           stylename="label-nav-title project-editor-navigation-title"/>
                    <button id="projectEditorNavMain"
                            stylename="label-nav-item label-nav-item-active"
                            caption="msg://msgProjectName"
                            width="100%"/>
                    <button id="projectEditorNavDescription"
                            stylename="label-nav-item"
                            caption="msg://msgProjectDescription"
                            width="100%"/>
                    <button id="projectEditorNavVacancy"
                            stylename="label-nav-item"
                            caption="msg://msgTabVacancy"
                            width="100%"/>
                    <button id="projectEditorNavTemplate"
                            stylename="label-nav-item"
                            caption="msg://msgTemplateLetter"
                            width="100%"/>
                </vbox>
                <!-- Раздел «Коротко»: краткое описание сути проекта (одно предложение —
                     AI-генерация по кнопке «Кратко» во вкладке «Описание проекта»,
                     поле shortDescription); следует сразу после навигации «Разделы»;
                     виден только при непустом значении — видимость и текст
                     управляются контроллером ProjectEdit. -->
                <vbox id="projectEditorSidebarShortDescription"
                      stylename="edit-sidebar-summary"
                      width="100%"
                      spacing="false"
                      visible="false">
                    <label id="projectSidebarShortDescriptionTitle"
                           value="msg://msgProjectShortDescriptionSection"
                           stylename="label-nav-title project-editor-short-description-title"/>
                    <label id="projectSidebarShortDescriptionText"
                           stylename="project-editor-short-description-text"
                           width="100%"/>
                </vbox>
                <!-- Spacer отделяет навигацию от нижней подсказки (expand в sidebar). -->
                <vbox id="projectSidebarSpacer"
                      stylename="edit-sidebar-spacer"
                      width="100%"
                      height="100%"/>
                <!-- Подсказка о назначении формы в нижней части sidebar. -->
                <label id="projectSidebarHint"
                       stylename="edit-sidebar-hint"
                       width="100%"
                       value="msg://msgProjectSidebarHint"/>
            </vbox>
            <!-- Workspace: toolbar с заголовком, вкладки проекта (ленивая загрузка LOB
                 и вакансий) и footer-действия ОК/Отмена в правом нижнем углу. -->
            <vbox id="projectEditorWorkspace"
                  stylename="edit-workspace"
                  width="100%"
                  height="100%"
                  spacing="false"
                  expand="projectTab">
                <!-- Toolbar: заголовок «Проект» и краткое описание назначения формы. -->
                <hbox id="projectEditorToolbar"
                      stylename="edit-toolbar"
                      width="100%"
                      spacing="false">
                    <vbox id="projectEditorToolbarTitleBox"
                          width="100%"
                          spacing="false">
                        <label id="projectEditorToolbarTitle"
                               stylename="edit-toolbar-title"
                               value="msg://browseCaption"/>
                        <label id="projectEditorToolbarDescription"
                               stylename="edit-toolbar-description"
                               value="msg://msgProjectToolbarDescription"/>
                    </vbox>
                </hbox>
                <!-- Вкладки проекта: «Проект» (карточки основных данных и чатов),
                     «Описание проекта» (LOB), «Вакансии» (dataGrid), «Информация в
                     сопроводительном письме» (LOB); имена вкладок — контракт ленивой
                     загрузки контроллера. -->
                <tabSheet id="projectTab"
                          stylename="edit-tabs"
                          width="100%"
                          height="100%">
                    <tab id="tabProject"
                         caption="msg://msgProjectName"
                         spacing="true"
                         expand="projectTabScroll"
                         stylename="project-main-tab">
                        <!-- Прокручиваемый контент вкладки: две контрактные карточки
                             (edit-card + showAsPanel) — «Основные данные» и «Чаты». -->
                        <scrollBox id="projectTabScroll"
                                   width="100%"
                                   height="100%"
                                   orientation="vertical"
                                   scrollBars="vertical"
                                   stylename="edit-workspace edit-workspace-scroll">
                            <vbox id="projectTabContent"
                                  width="100%"
                                  spacing="true"
                                  stylename="edit-workspace-content">
                                <!-- Карточка «Основные данные»: реквизиты проекта —
                                     закрыт, по умолчанию, родительский проект, наименование,
                                     даты старта/окончания, департамент, владелец. -->
                                <groupBox id="projectMainCard"
                                          stylename="edit-card"
                                          showAsPanel="true"
                                          collapsable="true"
                                          collapsed="false"
                                          width="100%">
                                    <vbox id="projectMainFieldsBox"
                                          width="100%"
                                          spacing="true">
                                        <checkBox id="checkBoxProjectIsClosed"
                                                  dataContainer="projectDc"
                                                  property="projectIsClosed"
                                                  caption="msg://msgProjectIsClosed"/>
                                        <checkBox id="defaultProjectCheckBox"
                                                  dataContainer="projectDc"
                                                  property="defaultProject"
                                                  caption="msg://msgDefault"/>
                                        <lookupPickerField id="highLevelProjectLookupPickerField"
                                                           dataContainer="projectDc"
                                                           property="projectTree"
                                                           caption="msg://msgProjectTree"
                                                           optionsContainer="projectTreeDc"
                                                           stylename="edit-form-control"
                                                           width="100%"/>
                                        <textField id="projectNameField"
                                                   dataContainer="projectDc"
                                                   property="projectName"
                                                   caption="msg://msgProjectName"
                                                   stylename="edit-form-control"
                                                   width="100%"
                                                   required="true"/>
                                        <!-- Строка дат проекта: «Дата старта» и «Дата окончания» делят
                                             строку поровну (box.expandRatio=1 у обоих — 50/50); слоты
                                             полей растягиваются Vaadin-инлайном, shared-стили
                                             edit-screen-shared-styles не перебивают expandRatio. -->
                                        <hbox width="100%" spacing="true">
                                            <dateField id="startProjectDateField"
                                                       dataContainer="projectDc"
                                                       property="startProjectDate"
                                                       caption="msg://msgProjectStartDate"
                                                       stylename="edit-form-control"
                                                       width="100%"
                                                       box.expandRatio="1"/>
                                            <dateField id="endProjectDateField"
                                                       dataContainer="projectDc"
                                                       property="endProjectDate"
                                                       caption="msg://msgProjectEndDate"
                                                       stylename="edit-form-control"
                                                       width="100%"
                                                       box.expandRatio="1"/>
                                        </hbox>
                                        <lookupPickerField id="projectDepartmentField"
                                                           optionsContainer="projectDepartmentsDc"
                                                           dataContainer="projectDc"
                                                           property="projectDepartment"
                                                           required="true"
                                                           caption="msg://msgProjectDepartament"
                                                           stylename="edit-form-control"
                                                           width="100%">
                                            <actions>
                                                <action id="lookup" type="picker_lookup"/>
                                            </actions>
                                        </lookupPickerField>
                                        <lookupPickerField id="projectOwnerField"
                                                           required="true"
                                                           optionsContainer="projectOwnersDc"
                                                           dataContainer="projectDc"
                                                           property="projectOwner"
                                                           caption="msg://msgProjectOwner"
                                                           stylename="edit-form-control"
                                                           width="100%">
                                            <actions>
                                                <action id="lookup" type="picker_lookup"/>
                                            </actions>
                                        </lookupPickerField>
                                    </vbox>
                                </groupBox>
                                <!-- Карточка «Чаты»: ссылки на чат с заказчиком и чат для
                                     резюме; текстовое поле (expand) + кнопка-ссылка. -->
                                <groupBox id="projectChatCard"
                                          stylename="edit-card"
                                          showAsPanel="true"
                                          collapsable="true"
                                          collapsed="false"
                                          width="100%">
                                    <vbox id="projectChatFieldsBox"
                                          width="100%"
                                          spacing="true">
                                        <hbox spacing="true"
                                              width="100%"
                                              expand="generalChatTextField">
                                            <textField id="generalChatTextField"
                                                       dataContainer="projectDc"
                                                       property="generalChat"
                                                       caption="msg://msgGeneralChat"
                                                       description="msg://msgGeneralChatDescription"
                                                       stylename="edit-form-control"
                                                       width="100%"
                                                       inputPrompt="msg://msgChatImputPrompt"/>
                                            <link id="generalChatLink"
                                                  icon="font-icon:FILE_WORD_O"
                                                  align="BOTTOM_LEFT"
                                                  target="_blank"
                                                  width="AUTO"
                                                  caption="msg://msgGoTo"
                                                  description="msg://msgGoTo"/>
                                        </hbox>
                                        <hbox spacing="true"
                                              expand="chatForCVTextField"
                                              width="100%">
                                            <textField id="chatForCVTextField"
                                                       dataContainer="projectDc"
                                                       property="chatForCV"
                                                       caption="msg://msgChatForCV"
                                                       description="msg://msgChatForCVDescription"
                                                       stylename="edit-form-control"
                                                       width="100%"
                                                       inputPrompt="msg://msgChatImputPrompt"/>
                                            <link id="chatForCVLink"
                                                  icon="font-icon:FILE_WORD_O"
                                                  align="BOTTOM_LEFT"
                                                  target="_blank"
                                                  width="AUTO"
                                                  caption="msg://msgGoTo"
                                                  description="msg://msgGoTo"/>
                                        </hbox>
                                    </vbox>
                                </groupBox>
                            </vbox>
                        </scrollBox>
                    </tab>
                    <tab id="tabProjectDescription"
                         caption="msg://msgProjectDescription"
                         spacing="true"
                         expand="projectDescriptionCard"
                         stylename="project-description-tab">
                        <!-- Карточка описания проекта: LOB-редактор, подгружается лениво
                             при первом открытии вкладки (контроллер). -->
                        <groupBox id="projectDescriptionCard"
                                  stylename="edit-card"
                                  showAsPanel="true"
                                  width="100%">
                            <richTextArea id="projectDescriptionRichTextArea"
                                          dataContainer="projectDc"
                                          property="projectDescription"
                                          width="100%"
                                          height="100%"
                                          stylename="edit-form-control"
                                          caption="msg://msgProjectDescription"/>
                        </groupBox>
                    </tab>
                    <tab id="tabVacansy"
                         caption="msg://msgTabVacancy"
                         spacing="true"
                         expand="projectVacancyCard"
                         stylename="project-vacancy-tab">
                        <!-- Карточка вакансий проекта: dataGrid открытых позиций, загрузка
                             выполняется при первом открытии вкладки (JPQL-параметр project). -->
                        <groupBox id="projectVacancyCard"
                                  stylename="edit-card"
                                  showAsPanel="true"
                                  width="100%">
                            <dataGrid id="projectOpenPositionTable"
                                      height="250px" width="100%"
                                      dataContainer="projectOpenPositionsDc">
                                <columns>
                                    <column id="openClose"
                                            property="openClose"
                                            width="35px"/>
                                    <column id="vacansyName"
                                            property="vacansyName"/>
                                    <column id="numberPosition"
                                            property="numberPosition"/>
                                    <column id="positionType"
                                            caption="msg://msgNumberPosition"
                                            property="positionType"/>
                                    <column property="createTs" id="createTs">
                                        <formatter class="com.haulmont.cuba.gui.components.formatters.DateFormatter"
                                                   format="dd.MM.yyyy"
                                                   useUserTimezone="true"/>
                                    </column>
                                </columns>
                            </dataGrid>
                        </groupBox>
                    </tab>
                    <tab id="tabTemplateLetter"
                         caption="msg://msgTemplateLetter"
                         margin="true,true,true,true"
                         expand="projectTemplateCard"
                         spacing="true"
                         stylename="project-template-letter-tab">
                        <!-- Карточка шаблона сопроводительного письма: LOB-редактор,
                             подгружается лениво при первом открытии вкладки. -->
                        <groupBox id="projectTemplateCard"
                                  stylename="edit-card"
                                  showAsPanel="true"
                                  width="100%">
                            <vbox id="templateLetterBox"
                                  width="100%"
                                  height="100%"
                                  expand="templateLetterRichTextArea">
                                <richTextArea id="templateLetterRichTextArea"
                                              dataContainer="projectDc"
                                              property="templateLetter"
                                              width="100%"
                                              height="100%"
                                              stylename="edit-form-control"
                                              required="false"/>
                            </vbox>
                        </groupBox>
                    </tab>
                </tabSheet>
                <!-- Footer-действия: спейсер выталкивает пару ОК/Отмена к правому краю,
                     кнопки получают канонические стили primary/secondary. -->
                <hbox id="editActions"
                      stylename="edit-footer-actions"
                      width="100%"
                      expand="bottomActionsSpacer"
                      align="MIDDLE_RIGHT"
                      spacing="false">
                    <vbox id="bottomActionsSpacer"
                          width="100%"
                          height="1px"/>
                    <hbox id="bottomActionsGroup"
                          width="AUTO"
                          align="MIDDLE_RIGHT"
                          spacing="true">
                        <button action="windowCommitAndClose" stylename="project-editor-primary-action"/>
                        <button action="windowClose" stylename="project-editor-secondary-action"/>
                    </hbox>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>
