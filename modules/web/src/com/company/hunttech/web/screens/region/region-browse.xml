<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://browseCaption"
        focusComponent="regionsTable"
        messagesPack="com.company.hunttech.web.screens.region" icon="TENCENT_WEIBO">
    <data readOnly="true">
        <collection id="regionsDc"
                    class="com.company.hunttech.entity.Region"
                    view="region-browse-view">
            <loader id="regionsDl" cacheable="true">
                <query>
                    <![CDATA[select e from hunttech_Region e
order by e.regionRuName]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="regionsTable"
            spacing="true">
        <filter id="filter"
                applyTo="regionsTable"
                dataLoader="regionsDl">
            <properties include=".*"
                        excludeProperties="regionOfCity,regionCountry.countryOfRegion,version,createTs,createdBy,updateTs,updatedBy,deleteTs,deletedBy"/>
        </filter>
        <groupTable id="regionsTable"
                    width="100%"
                    dataContainer="regionsDc">
            <actions>
                <action id="create" type="create"/>
                <action id="edit" type="edit"/>
                <action id="remove" type="remove"/>
            </actions>
            <columns>
                <column id="regionRuName" caption="mainMsg://msgRegionRuName"/>
                <column id="regionEngName" caption="mainMsg://msgRegionEngName"/>
                <column id="regionCountry" caption="mainMsg://msgCountry"/>
                <column id="regionType" caption="mainMsg://msgRegionType"/>
                <column id="capital" caption="mainMsg://msgAdministrativeCenter"/>
                <column id="regionCode" caption="mainMsg://msgRegionCode"/>
                <column id="isoCode" caption="mainMsg://msgIsoCode"/>
                <column id="timeZone" caption="mainMsg://msgTimeZone"/>
            </columns>
            <rowsCount/>
            <buttonsPanel id="buttonsPanel"
                          alwaysVisible="true">
                <button id="createBtn" action="regionsTable.create"/>
                <button id="editBtn" action="regionsTable.edit"/>
                <button id="removeBtn" action="regionsTable.remove"/>
            </buttonsPanel>
        </groupTable>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>
    </layout>
</window>
