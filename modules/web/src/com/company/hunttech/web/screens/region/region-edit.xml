<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Edit-экран региона: двухпанельная композиция по общему контракту Edit-экранов HRM HuntTech.
     Сохраняет исходные loaders, bindings (regionDc, regionCountriesDc) и actions. -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://editorCaption"
        focusComponent="regionRuNameField"
        messagesPack="com.company.hunttech.web.screens.region"
        icon="TENCENT_WEIBO">
    <!-- Секция данных: контейнер региона, коллекция городов и справочник стран. -->
    <data>
        <!-- Корневой контейнер региона с view region-edit-view и composition-коллекцией городов. -->
        <instance id="regionDc" class="com.company.hunttech.entity.Region" view="region-edit-view">
            <!-- Штатный загрузчик контейнера. -->
            <loader/>
            <!-- Коллекция городов региона (composition-связь regionOfCity) для таблицы. -->
            <collection id="regionRegionOfCitiesDc" property="regionOfCity"/>
        </instance>
        <!-- Справочник стран для picker-поля «Страна» (кэшируется, по русскому названию). -->
        <collection id="regionCountriesDc" class="com.company.hunttech.entity.Country" view="country-picker-view">
            <loader id="regionCountriesLc" cacheable="true">
                <!-- Все страны по алфавиту русских названий. -->
                <query><![CDATA[select e from hunttech_Country e
order by e.countryRuName]]></query>
            </loader>
        </collection>
    </data>
    <!-- Режим диалога: полноэкранный модальный редактор справочника. -->
    <dialogMode height="100%" width="100%" modal="true"/>
    <!-- Корневой layout формы: локальный namespace region-editor + общий контракт Edit-экранов. -->
    <layout stylename="region-editor" expand="regionMainLayout" spacing="false" width="100%" height="100%">
        <!-- Двухпанельная композиция: постоянная sidebar слева и рабочая область справа. -->
        <hbox id="regionMainLayout" stylename="edit-screen-layout" expand="regionWorkspace" spacing="false" width="100%" height="100%">
            <!-- Левая контекстная панель 270px: логотип, идентификация, label-навигация, подсказка. -->
            <vbox id="regionSidebar" stylename="edit-sidebar" width="270px" height="100%" spacing="true" expand="regionSidebarSpacer">
                <!-- Визуальный блок sidebar: круглый герб региона 176×176 с fallback icons/dictionaries/region.png,
                     загрузка файла и кнопка умной обработки герба. -->
                <vbox id="regionVisual" stylename="edit-sidebar-visual" width="100%" spacing="true" align="MIDDLE_CENTER">
                    <vbox id="regionLogoPicBox" spacing="false" align="MIDDLE_CENTER">
                        <ovaFallbackImage id="regionEmblemFileImage"
                                          dataContainer="regionDc"
                                          property="fileRegionEmblem"
                                          width="176px"
                                          height="176px"
                                          ovalWidth="176px"
                                          ovalHeight="176px"
                                          ovalBackground="#3a3e44"
                                          fallbackThemePath="icons/dictionaries/region.png"
                                          visible="true"
                                          align="MIDDLE_CENTER"
                                          stylename="dictionary-logo-image"
                                          scaleMode="SCALE_DOWN"/>
                    </vbox>
                    <upload id="regionEmblemFileUpload"
                            fileStoragePutMode="IMMEDIATE"
                            dataContainer="regionDc"
                            align="MIDDLE_CENTER"
                            showFileName="false"
                            dropZone="regionVisual"
                            showClearButton="true"
                            property="fileRegionEmblem"/>
                    <button id="enhanceRegionEmblemBtn"
                            caption="msg://enhanceRegionEmblemCaption"
                            icon="font-icon:MAGIC"
                            stylename="secondary candidate-btn"
                            width="100%"
                            description="msg://enhanceRegionEmblemDescription"/>
                </vbox>
                <!-- Блок идентификации: название региона из контейнера.
                     Подпись типа записи убрана — название выровнено по центру
                     sidebar (text-align: center в geolocation SCSS). -->
                <vbox id="regionIdentity" stylename="edit-sidebar-identity" width="100%" spacing="true">
                    <!-- Название региона (свойство regionRuName), живое из regionDc,
                         по центру по горизонтали относительно sidebar. -->
                    <label id="regionSidebarTitle" dataContainer="regionDc" property="regionRuName" stylename="edit-sidebar-title" width="100%"/>
                </vbox>
                <!-- Вертикальная label-навигация по разделам формы (фокус, без изменения данных). -->
                <vbox id="regionNavigation" stylename="label-navigation" width="100%" spacing="false">
                    <!-- Заголовок навигационного блока: полоса-заголовок с двумя inset-линиями (контракт §4.1). -->
                    <label value="Разделы" stylename="label-nav-title geolocation-navigation-title" width="100%"/>
                    <!-- Пункт «Основные данные» — активен по умолчанию, фокусирует первое поле. -->
                    <button id="regionMainNav" caption="Основные данные" stylename="borderless label-nav-item label-nav-item-active" width="100%" invoke="focusMainSection"/>
                    <!-- Пункт «Города» — фокусирует таблицу городов региона. -->
                    <button id="regionCitiesNav" caption="Города" stylename="borderless label-nav-item" width="100%" invoke="focusCitiesSection"/>
                </vbox>
                <!-- Служебный spacer прижимает подсказку к нижней границе sidebar
                     (эталонный паттерн: width/height 100%, expand на контейнере). -->
                <vbox id="regionSidebarSpacer"
                      stylename="edit-sidebar-spacer"
                      width="100%"
                      height="100%"/>
                <!-- Нейтральная подсказка о роли региона в иерархии геоданных. -->
                <label value="Регион связывает страну и входящие в него города." stylename="edit-sidebar-hint" width="100%"/>
            </vbox>
            <!-- Правая рабочая область: toolbar, прокручиваемые секции и footer-actions. -->
            <vbox id="regionWorkspace" stylename="edit-workspace" expand="regionWorkspaceScroll" width="100%" height="100%" spacing="false">
                <!-- Toolbar с заголовком карточки, описанием и кнопкой автозаполнения по API. -->
                <hbox id="regionToolbar" stylename="edit-toolbar" width="100%" spacing="true">
                    <!-- Текстовый блок toolbar: заголовок и описание. -->
                    <vbox id="regionToolbarText" width="100%" spacing="false">
                        <label value="Карточка региона" stylename="edit-toolbar-title"/>
                        <label value="Принадлежность стране, коды, герб и перечень городов" stylename="edit-toolbar-description"/>
                    </vbox>
                    <!-- Кнопка умного автозаполнения по API / AI -->
                    <button id="enrichRegionByApiBtn"
                            caption="Умное заполнение по API"
                            icon="MAGIC"
                            stylename="friendly company-search-ai-btn"
                            align="MIDDLE_RIGHT"
                            invoke="onEnrichRegionByApi"/>
                </hbox>
                <!-- Прокручиваемая область контента рабочей области. -->
                <scrollBox id="regionWorkspaceScroll" stylename="edit-workspace-scroll" width="100%" height="100%">
                    <!-- Поток карточек рабочей области. -->
                    <vbox id="regionSections" width="100%" spacing="true">
                        <!-- Карточка «Основные данные»: реквизиты региона. -->
                        <groupBox id="regionMainSection" caption="Основные данные" stylename="edit-card" showAsPanel="true" width="100%" spacing="true">
                            <!-- Форма региона с полями, привязанными к regionDc. -->
                            <form id="form" dataContainer="regionDc" width="100%">
                                <column width="100%">
                                    <!-- Название региона на русском. -->
                                    <textField id="regionRuNameField" property="regionRuName" caption="mainMsg://msgRegionRuName" width="100%" stylename="edit-form-control"/>
                                    <!-- Международное наименование региона. -->
                                    <textField id="regionEngNameField" property="regionEngName" caption="mainMsg://msgRegionEngName" width="100%" stylename="edit-form-control"/>
                                    <!-- Страна региона (picker из кэшируемого справочника стран). -->
                                    <lookupPickerField id="regionCountryField" optionsContainer="regionCountriesDc" property="regionCountry" caption="mainMsg://msgCountry" width="100%" stylename="edit-form-control">
                                        <actions><action id="lookup" type="picker_lookup"/></actions>
                                    </lookupPickerField>
                                    <!-- Тип региона (область, республика, штат...). -->
                                    <textField id="regionTypeField" property="regionType" caption="mainMsg://msgRegionType" width="100%" stylename="edit-form-control"/>
                                    <!-- Административный центр / столица региона. -->
                                    <textField id="capitalField" property="capital" caption="mainMsg://msgAdministrativeCenter" width="100%" stylename="edit-form-control"/>
                                    <!-- Код региона (автомобильный / территориальный). -->
                                    <textField id="regionCodeField" property="regionCode" caption="mainMsg://msgRegionCode" width="100%" stylename="edit-form-control"/>
                                    <!-- Код ISO 3166-2. -->
                                    <textField id="isoCodeField" property="isoCode" caption="mainMsg://msgIsoCode" width="100%" stylename="edit-form-control"/>
                                    <!-- Часовой пояс. -->
                                    <textField id="timeZoneField" property="timeZone" caption="mainMsg://msgTimeZone" width="100%" stylename="edit-form-control"/>
                                    <!-- Идентификатор ФИАС / КЛАДР. -->
                                    <textField id="fiasIdField" property="fiasId" caption="mainMsg://msgFiasId" width="100%" stylename="edit-form-control"/>
                                </column>
                            </form>
                        </groupBox>
                        <!-- Карточка «Города региона»: composition-таблица городов. -->
                        <groupBox id="regionCitiesSection" caption="Города региона" stylename="edit-card" showAsPanel="true" width="100%" spacing="true">
                            <!-- Таблица городов региона (composition-коллекция regionRegionOfCitiesDc). -->
                            <table id="regionRegionOfCityTable" dataContainer="regionRegionOfCitiesDc" height="260px" width="100%">
                                <!-- Колонка «Название города». -->
                                <columns><column id="cityRuName" caption="mainMsg://msgCityRuName"/><!-- Колонка «Телефонный код». --><column id="cityPhoneCode" caption="mainMsg://msgCityPhoneCode"/></columns>
                                <!-- Панель кнопок действий над таблицей городов. -->
                                <buttonsPanel id="regionCitiesActions">
                                    <button id="button" action="regionRegionOfCityTable.add"/>
                                    <button action="regionRegionOfCityTable.edit"/>
                                    <button action="regionRegionOfCityTable.remove"/>
                                </buttonsPanel>
                                <!-- Штатные composition-actions таблицы. -->
                                <actions><action id="add" type="add"/><action id="edit" type="edit"/><action id="remove" type="remove"/></actions>
                            </table>
                        </groupBox>
                    </vbox>
                </scrollBox>
                <!-- Нижняя панель штатных действий: спейсер выталкивает пару
                     ОК/Отмена к правому нижнему углу, кнопки получают канонические
                     стили primary/secondary (эталон ProjectEdit). -->
                <hbox id="editActions"
                      stylename="edit-footer-actions"
                      width="100%"
                      expand="regionActionsSpacer"
                      align="MIDDLE_RIGHT"
                      spacing="false">
                    <!-- Спейсер: растягивает группу кнопок к правому краю панели. -->
                    <vbox id="regionActionsSpacer" width="100%" height="1px"/>
                    <!-- Группа ОК/Отмена: primary (сохранить) и secondary (отмена). -->
                    <hbox id="regionActionsGroup" width="AUTO" align="MIDDLE_RIGHT" spacing="true">
                        <!-- Сохранить и закрыть (штатный action editor-а). -->
                        <button action="windowCommitAndClose" stylename="region-editor-primary-action"/>
                        <!-- Отменить изменения и закрыть. -->
                        <button action="windowClose" stylename="region-editor-secondary-action"/>
                    </hbox>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>
