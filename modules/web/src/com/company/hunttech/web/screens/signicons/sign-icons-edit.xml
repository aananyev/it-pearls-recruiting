<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Edit-экран справочника «Иконки признака»: двухпанельная композиция по общему
     контракту Edit-экранов HRM HuntTech. Сохраняет исходный data binding
     (signIconsDc), валидатор, invoke выбора иконки и обработчики контроллера. -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://signIconsEdit.caption"
        focusComponent="iconNameField"
        messagesPack="com.company.hunttech.web.screens.signicons">
    <!-- Секция данных: корневой контейнер иконки признака. -->
    <data>
        <!-- Корневой контейнер иконки; view signIcons-view покрывает все поля формы. -->
        <instance id="signIconsDc"
                  class="com.company.hunttech.entity.SignIcons">
            <!-- View контейнера: signIcons-view (локальные поля). -->
            <view extends="signIcons-view"/>
            <!-- Штатный загрузчик контейнера (берёт id из editor). -->
            <loader/>
        </instance>
    </data>
    <!-- Режим диалога: полноэкранный модальный редактор справочника. -->
    <dialogMode height="100%" width="100%" modal="true"/>
    <!-- Корневой layout формы: локальный namespace sign-icons-editor + общий контракт Edit-экранов. -->
    <layout stylename="sign-icons-editor"
            expand="mainLayout"
            spacing="false"
            width="100%"
            height="100%">
        <!-- Двухпанельная композиция: постоянная sidebar слева и рабочая область справа. -->
        <hbox id="mainLayout"
              stylename="edit-screen-layout"
              expand="workspace"
              spacing="false"
              width="100%"
              height="100%">
            <!-- Левая контекстная панель 270px: фирменный логотип, идентификация,
                 label-навигация и подсказка (контракт §4.2). -->
            <vbox id="sidebar"
                  stylename="edit-sidebar"
                  width="270px"
                  height="100%"
                  spacing="true"
                  expand="sidebarSpacer">
                <!-- Визуальный блок sidebar: штатная заглушка-логотип HRM HuntTech
                     (круглый OvaFallbackImage 176×176 как candidatePic JobCandidateEdit). -->
                <vbox id="visual"
                      stylename="edit-sidebar-visual"
                      width="100%"
                      spacing="true"
                      align="MIDDLE_CENTER">
                    <!-- Круглый логотип формы: статичная иллюстрация иконки признака
                         (без привязки к данным — иконка признака задаётся font-символом,
                         а не файлом, поэтому иллюстрация обобщённая). -->
                    <ovalImage id="signIconsLogoImage"
                               width="176px"
                               height="176px"
                               ovalWidth="176px"
                               ovalHeight="176px"
                               visible="true"
                               align="MIDDLE_CENTER"
                               scaleMode="SCALE_DOWN"
                               stylename="dictionary-logo-image">
                        <theme path="icons/dictionaries/sign-icons.png"/>
                    </ovalImage>
                </vbox>
                <!-- Блок идентификации: тип записи и русское название из контейнера. -->
                <vbox id="identity"
                      stylename="edit-sidebar-identity"
                      width="100%"
                      spacing="true">
                    <!-- Подпись типа записи. -->
                    <label value="Иконка признака"
                           stylename="edit-sidebar-subtitle"
                           width="100%"/>
                    <!-- Русское название (свойство titleRu), живое из signIconsDc. -->
                    <label id="sidebarTitle"
                           dataContainer="signIconsDc"
                           property="titleRu"
                           stylename="edit-sidebar-title"
                           width="100%"/>
                </vbox>
                <!-- Вертикальная label-навигация по разделам формы (фокус, без изменения данных). -->
                <vbox id="navigation"
                      stylename="label-navigation"
                      width="100%"
                      spacing="false">
                    <!-- Заголовок навигационного блока: полоса-заголовок с двумя inset-линиями (контракт §4.1). -->
                    <label value="Разделы"
                           stylename="label-nav-title dictionary-navigation-title"
                           width="100%"/>
                    <!-- Пункт «Иконка» — активен по умолчанию, фокусирует выбор иконки. -->
                    <button id="iconNav"
                            caption="Иконка"
                            stylename="borderless label-nav-item label-nav-item-active"
                            width="100%"
                            invoke="focusIconSection"/>
                    <!-- Пункт «Описание» — фокусирует текстовую область описания. -->
                    <button id="descriptionNav"
                            caption="Описание"
                            stylename="borderless label-nav-item"
                            width="100%"
                            invoke="focusDescriptionSection"/>
                </vbox>
                <!-- Служебный spacer прижимает подсказку к нижней границе sidebar. -->
                <vbox id="sidebarSpacer" stylename="edit-sidebar-spacer" width="100%" height="100%"/>
                <!-- Нейтральная подсказка о роли справочника в HRM HuntTech. -->
                <label value="Иконки признака используются как наглядные маркеры типов признаков в профилях HRM HuntTech."
                       stylename="edit-sidebar-hint"
                       width="100%"/>
            </vbox>
            <!-- Правая рабочая область: toolbar, прокручиваемые секции и footer-actions. -->
            <vbox id="workspace"
                  stylename="edit-workspace"
                  expand="workspaceScroll"
                  width="100%"
                  height="100%"
                  spacing="false">
                <!-- Toolbar с заголовком карточки и пояснением. -->
                <hbox id="toolbar"
                      stylename="edit-toolbar"
                      width="100%"
                      spacing="true">
                    <!-- Текстовый блок toolbar: заголовок и описание. -->
                    <vbox id="toolbarText" width="100%" spacing="false">
                        <label value="Карточка иконки" stylename="edit-toolbar-title"/>
                        <label value="Font-иконка, цвет и текстовые подписи признака" stylename="edit-toolbar-description"/>
                    </vbox>
                </hbox>
                <colorPicker id="iconColorColorPicker" property="iconColor" width="AUTO"/>
                <textArea id="titleDescription" property="titleDescription" width="100%" stylename="ht-halo-precision-textarea"/>
            </column>
        </form>
        <hbox id="editActions" spacing="true">
            <button id="commitAndCloseBtn" action="windowCommitAndClose"/>
            <button id="closeBtn" action="windowClose"/>
        </hbox>
    </layout>
</window>
