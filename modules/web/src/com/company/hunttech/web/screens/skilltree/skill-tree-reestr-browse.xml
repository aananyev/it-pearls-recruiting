<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Реестр компетенций (SkillTreeReestrBrowse) — двухпанельный экран по контракту HRM реестров.
     Левая панель (312px): TreeTable для иерархии SkillTree (parent-child).
     Правая панель: детали узла (sidebar по эталону CandidateCVReestrBrowse — аватар 120px, 4 уровня типографики,
     быстрые действия, реквизиты, чипы навыков).
     Командный тулбар: Создать, Редактировать, Удалить, Фильтр (collapsable).
     Адаптивность под 7 тем (hunttech-modern, hunttech-modern-dark, hunttech-modern-light, halo, havana, helium, hover). -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://skillTreeReestrCaption"
        focusComponent="skillTreesTreeTable"
        messagesPack="com.company.hunttech.web.screens.skilltree"
        icon="CODE_FORK">
    <data readOnly="true">
        <!-- Коллекция навыков для дерева (иерархия через skillTree parent) -->
        <collection id="skillTreesDc"
                    class="com.company.hunttech.entity.SkillTree"
                    view="skillTree-reestr-browse-view">
            <loader id="skillTreesDl" cacheable="true">
                <query>
                    <![CDATA[select e from hunttech_SkillTree e
                    order by e.skillTree.skillName nulls first, e.skillName]]>
                </query>
            </loader>
        </collection>
    </data>

    <dialogMode height="750" width="1200"/>

    <!-- Корневой layout: двухпанельная композиция (Split View).
         Namespace job-candidate-editor обязателен: общие правила SCSS реестров
         (фон сайдбара, ширина 312px, типографика identity, аватар) вложены в него. -->
    <layout expand="splitMainLayout" spacing="false" width="100%" height="100%"
            stylename="job-candidate-editor edit-screen-layout">
        <hbox id="splitMainLayout" width="100%" height="100%" spacing="true"
              expand="workspaceBox" stylename="job-candidate-main-layout edit-screen-layout">

            <!-- ЛЕВЫЙ САЙДБАР (312px) — TreeTable/Tree для иерархии SkillTree -->
            <vbox id="detailPane" width="312px" height="100%" spacing="true"
                  stylename="job-candidate-sidebar edit-sidebar">
                <scrollBox id="sidebarScrollBox" width="100%" height="100%" orientation="vertical">
                    <vbox width="100%" spacing="true">

                        <!-- Шапка профиля узла (эталон city/cv-reestr: аватар 120px = логотип навыка,
                             4 уровня типографики identity). -->
                        <vbox id="profileHeader" width="100%" spacing="true" align="TOP_CENTER"
                              stylename="job-candidate-profile-header edit-sidebar-visual">
                            <!-- Круглый аватар 120x120 — логотип навыка (fileImageLogo) -->
                            <ovaFallbackImage id="skillLogoPic" width="120px" height="120px"
                                              ovalWidth="120px" ovalHeight="120px"
                                              align="TOP_CENTER"
                                              stylename="job-candidate-avatar"
                                              fallbackThemePath="icons/no-programmer.jpeg"
                                              scaleMode="SCALE_DOWN"/>
                            <vbox width="100%" spacing="false" align="MIDDLE_CENTER"
                                  stylename="edit-sidebar-identity">
                                <!-- Уровень 1: Название навыка (h2) -->
                                <label id="detailSkillName" value="Выберите компетенцию"
                                       width="100%" stylename="edit-sidebar-title h2 candidate-sidebar-fullname"
                                       align="MIDDLE_CENTER" htmlEnabled="true"/>
                                <!-- Уровень 2: Специализация (h4) -->
                                <label id="detailSpecialisation" value="—"
                                       width="100%" stylename="edit-sidebar-subtitle h4 candidate-sidebar-position"
                                       align="MIDDLE_CENTER" htmlEnabled="true"/>
                                <!-- Уровень 3: Родительский навык (help) -->
                                <label id="detailParentSkill" value="—"
                                       width="100%" stylename="edit-help candidate-sidebar-city"
                                       align="MIDDLE_CENTER" htmlEnabled="true"/>
                                <!-- Уровень 4: Приоритет (badge/чип) -->
                                <label id="detailPriority" value="—"
                                       width="100%" stylename="skill-tree-reestr-priority-chip"
                                       align="MIDDLE_CENTER" htmlEnabled="true"/>
                            </vbox>
                        </vbox>

                        <!-- Кнопки быстрых действий сайдбара -->
                        <vbox id="sidebarActionsCard" width="100%" spacing="true"
                              stylename="edit-sidebar-summary">
                            <button id="openEditCardBtn" caption="Открыть карточку" icon="EDIT_ACTION"
                                    stylename="primary" enabled="false" width="100%"/>
                            <button id="createChildBtn" caption="Создать дочерний навык" icon="PLUS"
                                    stylename="secondary" enabled="false" width="100%"/>
                        </vbox>

                        <!-- Секция: Реквизиты навыка (grid 2 колонки, по эталону city-reestr-browse) -->
                        <vbox id="requisitesCard" width="100%" spacing="true"
                              stylename="job-candidate-navigation label-navigation">
                            <label value="РЕКВИЗИТЫ НАВЫКА" width="100%"
                                   stylename="label-nav-title job-candidate-section-title"
                                   align="MIDDLE_CENTER"/>
                            <grid id="requisitesGrid" spacing="true" width="100%"
                                  stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row><label value="Название:" stylename="bold"/><label id="detailSkillNameVal" value="—"/></row>
                                    <row><label value="Специализация:" stylename="bold"/><label id="detailSpecialisationVal" value="—"/></row>
                                    <row><label value="Родительский навык:" stylename="bold"/><label id="detailParentSkillVal" value="—"/></row>
                                    <row><label value="Приоритет:" stylename="bold"/><label id="detailPriorityVal" value="—"/></row>
                                    <row><label value="Wiki страница:" stylename="bold"/><label id="detailWikiPageVal" value="—" htmlEnabled="true"/></row>
                                    <row><label value="CSS стиль:" stylename="bold"/><label id="detailStyleHighlightingVal" value="—"/></row>
                                    <row><label value="Исключить из парсинга:" stylename="bold"/><label id="detailNotParsingVal" value="—"/></row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Секция: Описание навыка (comment) -->
                        <vbox id="descriptionCard" width="100%" spacing="true"
                              stylename="job-candidate-navigation label-navigation">
                            <label value="ОПИСАНИЕ НАВЫКА" width="100%"
                                   stylename="label-nav-title job-candidate-section-title"
                                   align="MIDDLE_CENTER"/>
                            <label id="detailComment" htmlEnabled="true" width="100%"
                                   stylename="edit-help"/>
                        </vbox>

                        <!-- Секция: Чипы навыков (дети текущего узла) -->
                        <vbox id="childrenSkillsCard" width="100%" spacing="true"
                              stylename="job-candidate-navigation label-navigation">
                            <label value="ДОЧЕРНИЕ НАВЫКИ" width="100%"
                                   stylename="label-nav-title job-candidate-section-title"
                                   align="MIDDLE_CENTER"/>
                            <flowBox id="childrenSkillsChips" width="100%" spacing="true"/>
                        </vbox>

                    </vbox>
                </scrollBox>
            </vbox>

            <!-- ПРАВАЯ РАБОЧАЯ ОБЛАСТЬ — TreeTable иерархии -->
            <vbox id="workspaceBox" width="100%" height="100%" spacing="true"
                  stylename="edit-workspace candidate-reestr-workspace" expand="tableCard"
                  margin="true,true,true,false">

                <!-- Командный тулбар (адаптивный, по эталону OpenPositionReestrBrowse/ProjectReestrBrowse) -->
                <cssLayout id="tableFilterBar" width="100%" stylename="candidate-filter-bar edit-card">
                    <!-- Левая группа: основные действия -->
                    <cssLayout id="leftActionButtons" stylename="filter-buttons-panel left-action-buttons">
                        <button id="createBtn" caption="Создать" icon="CREATE_ACTION"
                                stylename="primary candidate-btn candidate-create-btn"
                                action="skillTreesTreeTable.create"/>
                        <button id="editBtn" caption="Редактировать" icon="EDIT_ACTION"
                                stylename="secondary candidate-btn candidate-edit-btn"
                                action="skillTreesTreeTable.edit"/>
                        <button id="removeBtn" caption="Удалить" icon="REMOVE_ACTION"
                                stylename="secondary candidate-btn candidate-remove-btn"
                                action="skillTreesTreeTable.remove"/>
                    </cssLayout>

                    <!-- Правая группа: действия -->
                    <cssLayout id="rightActionButtons" stylename="filter-buttons-panel right-action-buttons">
                        <popupButton id="actionsPopupButton" caption="Действия" icon="BARS" showActionIcons="true"
                                     stylename="primary candidate-btn">
                            <actions>
                                <action id="refreshAction" caption="Обновить данные" icon="REFRESH"/>
                                <action id="excelExportAction" caption="Выгрузить в Excel" icon="FILE_EXCEL_O"/>
                                <action id="expandAllAction" caption="Развернуть всё" icon="font-icon:EXPAND"/>
                                <action id="collapseAllAction" caption="Свернуть всё" icon="font-icon:COMPRESS"/>
                            </actions>
                        </popupButton>
                    </cssLayout>
                </cssLayout>

                <!-- Generic Filter (collapsable, collapsed по умолчанию) -->
                <filter id="filter"
                        applyTo="skillTreesTreeTable"
                        dataLoader="skillTreesDl"
                        defaultMode="generic"
                        width="100%"
                        collapsable="true"
                        collapsed="true"
                        stylename="candidate-generic-filter">
                    <properties include=".*"
                                excludeProperties="openPosition,candidates,candidateCV,fileImageLogo,styleHighlighting,notParsing,version,createTs,createdBy,updateTs,updatedBy,deleteTs,deletedBy"/>
                </filter>

                <!-- Карточка TreeTable с rowsCount -->
                <vbox id="tableCard" width="100%" height="100%" spacing="false"
                      stylename="edit-card candidate-table-card" expand="skillTreesTreeTable">
                    <!-- Дерево навыков (hierarchyProperty = skillTree): корни верхнего уровня,
                         раскрытие узлов expander'ом — настоящее дерево, а не группировка по родителю.
                         Высота гарантирована min-height в SCSS (.skill-tree-reestr-grid). -->
                    <treeDataGrid id="skillTreesTreeTable"
                                  width="100%"
                                  height="100%"
                                  dataContainer="skillTreesDc"
                                  hierarchyProperty="skillTree"
                                  stylename="borderless grid candidate-browse-grid">
                        <actions>
                            <action id="create" type="create"/>
                            <action id="edit" type="edit"/>
                            <action id="remove" type="remove"/>
                            <action id="excel" type="excel"/>
                            <action id="refresh" type="refresh"/>
                        </actions>
                        <columns>
                            <!-- Превью логотипа навыка (генерируется контроллером) -->
                            <column id="skillLogoColumn" caption="Лого" width="60px" sortable="false"/>
                            <!-- Иерархическая колонка: название навыка (раскрытие узлов дерева) -->
                            <column id="skillName" property="skillName"
                                    caption="msg://msgSkill" expandRatio="1" minWidth="220px"/>
                            <!-- Специализация -->
                            <column id="specialisation" property="specialisation.specRuName"
                                    caption="msg://msgSpecialisation" width="200px"/>
                            <!-- Приоритет навыка -->
                            <column id="prioritySkill" property="prioritySkill"
                                    caption="msg://msgPrioritySkill" width="110px" align="CENTER"/>
                        </columns>
                        <rowsCount/>
                    </treeDataGrid>
                </vbox>
            </vbox>
        </hbox>
    </layout>
</window>