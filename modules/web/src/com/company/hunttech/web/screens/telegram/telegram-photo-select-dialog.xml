<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://telegramPhotoSelectDialog.caption"
        messagesPack="com.company.hunttech.web.screens.telegram">
    <dialogMode height="AUTO"
                width="640px"
                forceDialog="true"
                closeOnClickOutside="false"
                resizable="false"/>
    <layout spacing="true" expand="photosScrollBox" width="100%" height="AUTO" stylename="telegram-photo-dialog-layout">
        <vbox spacing="false" width="100%" stylename="telegram-photo-dialog-header">
            <label stylename="h2" value="msg://telegramPhotoSelectDialog.title"/>
            <label stylename="telegram-photo-dialog-hint" value="msg://telegramPhotoSelectDialog.hint"/>
        </vbox>
        <scrollBox id="photosScrollBox"
                   width="100%"
                   height="340px"
                   spacing="false"
                   stylename="telegram-photos-scrollbox">
            <flowBox id="photosFlowBox"
                     width="100%"
                     spacing="true"
                     stylename="telegram-photos-flowbox"/>
        </scrollBox>
        <hbox spacing="true"
              width="100%"
              align="BOTTOM_RIGHT"
              stylename="telegram-photo-dialog-footer">
            <label id="footerSpacer" width="100%"/>
            <button id="cancelButton"
                    caption="msg://msgCancel"
                    icon="font-icon:BAN"
                    invoke="onCancelButtonClick"
                    stylename="secondary"/>
        </hbox>
    </layout>
</window>
