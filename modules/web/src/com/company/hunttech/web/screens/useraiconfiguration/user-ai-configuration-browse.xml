<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://userAiConfigurationBrowse.caption"
        focusComponent="userAiConfigurationsTable"
        messagesPack="com.company.hunttech.web.screens.useraiconfiguration">
    <data>
        <collection id="userAiConfigurationsDc"
                    class="com.company.hunttech.entity.UserAiConfiguration">
            <view extends="userAiConfiguration-browse-view"/>
            <loader id="userAiConfigurationsDl">
                <query>
                    <![CDATA[select e from hunttech_UserAiConfiguration e order by e.user.login, e.providerCode]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="600"
                width="1000"/>
    <layout expand="userAiConfigurationsTable"
            spacing="true">
        <filter id="filter"
                applyTo="userAiConfigurationsTable"
                dataLoader="userAiConfigurationsDl">
            <properties include=".*"/>
        </filter>
        <hbox spacing="true">
            <button action="userAiConfigurationsTable.create"/>
            <button action="userAiConfigurationsTable.edit"/>
            <button action="userAiConfigurationsTable.remove"/>
            <button id="makeCurrentBtn"
                    caption="msg://makeCurrentBtn.caption"
                    description="msg://makeCurrentBtn.description"
                    invoke="onMakeCurrentBtnClick"
                    icon="CHECK"/>
            <button id="testBtn"
                    caption="msg://testBtn.caption"
                    description="msg://testBtn.description"
                    invoke="onTestBtnClick"
                    icon="CHECK"/>
        </hbox>
        <table id="userAiConfigurationsTable"
               width="100%"
               dataContainer="userAiConfigurationsDc">
            <actions>
                <action id="create" type="create"/>
                <action id="edit" type="edit"/>
                <action id="remove" type="remove"/>
            </actions>
            <columns>
                <column id="user.login" caption="msg://UserAiConfiguration.user"/>
                <column id="providerCode" caption="msg://UserAiConfiguration.providerCode"/>
                <column id="isActive" caption="msg://UserAiConfiguration.currentForAnalysis"/>
                <column id="defaultModelName" caption="msg://UserAiConfiguration.defaultModelName"/>
            </columns>
            <rowsCount/>
        </table>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>
    </layout>
</window>
