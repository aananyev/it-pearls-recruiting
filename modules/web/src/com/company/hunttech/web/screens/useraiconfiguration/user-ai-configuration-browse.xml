<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://userAiConfigurationBrowse.caption"
        focusComponent="userAiConfigurationsTable"
        messagesPack="com.company.hunttech.web.screens.useraiconfiguration">
    <data>
        <collection id="userAiConfigurationsDc"
                    class="com.company.hunttech.entity.UserAiConfiguration">
            <view extends="userAiConfiguration-browse-view"/>
            <loader id="userAiConfigurationsDl">
                <query>
                    <![CDATA[select e from hunttech_UserAiConfiguration e]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="600"
                width="1000"/>
    <layout expand="tableCard"
            spacing="true"
            stylename="browse-screen-layout edit-screen-layout">
        <filter id="filter"
                applyTo="userAiConfigurationsTable"
                dataLoader="userAiConfigurationsDl"
                collapsable="true"
                collapsed="true">
            <properties include=".*"/>
        </filter>
        <hbox id="buttonsPanel" spacing="true" stylename="edit-toolbar">
            <button id="createBtn" action="userAiConfigurationsTable.create" stylename="primary" icon="PLUS"/>
            <button id="editBtn" action="userAiConfigurationsTable.edit" icon="EDIT_ACTION"/>
            <button id="removeBtn" action="userAiConfigurationsTable.remove" icon="REMOVE"/>
            <button id="refreshBtn" action="userAiConfigurationsTable.refresh" icon="REFRESH"/>
            <button id="testBtn" caption="Тест AI" invoke="onTestBtnClick" icon="CHECK"/>
        </hbox>
        <vbox id="tableCard" width="100%" height="100%" spacing="false" expand="userAiConfigurationsTable" stylename="edit-card candidate-table-card">
            <table id="userAiConfigurationsTable"
                   width="100%"
                   height="100%"
                   dataContainer="userAiConfigurationsDc">
                <actions>
                    <action id="create" type="create"/>
                    <action id="edit" type="edit"/>
                    <action id="remove" type="remove"/>
                    <action id="refresh" type="refresh"/>
                </actions>
                <columns>
                    <column id="user.login" width="180px"/>
                    <column id="providerCode" width="140px"/>
                    <column id="isActive" width="100px"/>
                    <column id="defaultModelName" minimumWidth="220px"/>
                </columns>
                <rowsCount/>
            </table>
        </vbox>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>
    </layout>
</window>
