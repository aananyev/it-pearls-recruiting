<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Edit персональной AI-конфигурации пользователя: перестройка 2026-08-12 из legacy-диалога 450px
     в двухпанельную композицию по общему контракту Edit-экранов HRM HuntTech (образец —
     vacancy-prompt-template-edit.xml). Сохранены все id полей, property, dataContainer,
     loaders и actions; добавлены caption, edit-form-control и полоса-заголовок навигации.
     Java-контроллер не изменён (focus-методов нет — пункты навигации display-only). -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://userAiConfigurationEdit.caption"
        focusComponent="providerCodeField"
        messagesPack="com.company.hunttech.web.screens.useraiconfiguration">
    <!-- Секция данных: единственный edit-контейнер персональной конфигурации. -->
    <data>
        <!-- Редактируемая персональная AI-конфигурация с полным edit-view. -->
        <instance id="userAiConfigurationDc"
                  class="com.company.hunttech.entity.UserAiConfiguration"
                  view="userAiConfiguration-edit-view">
            <!-- Стандартный editor-loader по id открытой записи. -->
            <loader/>
        </instance>
    </data>
    <dialogMode height="560"
                width="650"
                modal="true"
                forceDialog="true"/>
    <layout expand="contentScrollBox"
            spacing="true"
            margin="true"
            height="100%"
            width="100%">
        <scrollBox id="contentScrollBox"
                   height="100%"
                   width="100%">
            <form id="form"
                  dataContainer="userAiConfigurationDc"
                  captionPosition="TOP"
                  width="100%">
                <column width="100%">
                    <lookupField id="providerCodeField"
                                 property="providerCode"
                                 caption="msg://UserAiConfiguration.providerCode"
                                 required="true"
                                 width="100%"/>
                    <passwordField id="apiKeyField"
                                   property="apiKey"
                                   caption="msg://UserAiConfiguration.apiKey"
                                   secret="true"
                                   required="true"
                                   width="100%"/>
                    <textField id="defaultModelNameField"
                               property="defaultModelName"
                               caption="msg://UserAiConfiguration.defaultModelName"
                               width="100%"/>
                    <checkBox id="isActiveField"
                              property="isActive"
                              caption="msg://UserAiConfiguration.currentForAnalysis"
                              description="msg://currentProviderHint"
                              editable="false"/>
                </column>
            </form>
        </scrollBox>
        <hbox id="editActions" spacing="true">
            <button id="commitAndCloseBtn" action="windowCommitAndClose"/>
            <button id="closeBtn" action="windowClose"/>
        </hbox>
    </layout>
</window>