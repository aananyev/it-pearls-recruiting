<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Edit персональной AI-конфигурации пользователя: двухпанельная композиция Split-View 312px
     по общему контракту Edit-экранов HRM HuntTech (hunttech-edit-screen-design). -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://userAiConfigurationEdit.caption"
        focusComponent="providerCodeField"
        messagesPack="com.company.hunttech.web.screens.useraiconfiguration">
    <data>
        <instance id="userAiConfigurationDc"
                  class="com.company.hunttech.entity.UserAiConfiguration"
                  view="userAiConfiguration-edit-view">
            <loader/>
        </instance>
    </data>
    <dialogMode width="100%" height="100%" modal="true"/>
    <layout stylename="user-ai-configuration-editor job-candidate-editor edit-screen-layout"
            expand="mainLayout"
            spacing="false"
            margin="false"
            width="100%"
            height="100%">
        <hbox id="mainLayout"
              stylename="job-candidate-main-layout edit-screen-layout"
              expand="workspace"
              spacing="false"
              width="100%"
              height="100%">
            <!-- Левая контекстная панель 312px: аватар 120px, идентификация, навигация, реквизиты -->
            <vbox id="sidebar"
                  stylename="edit-sidebar job-candidate-sidebar"
                  width="312px"
                  height="100%"
                  spacing="true"
                  margin="false">
                <scrollBox id="sidebarScroll"
                           width="100%"
                           height="100%"
                           orientation="vertical">
                    <vbox id="sidebarContent"
                          width="100%"
                          spacing="true">
                        <!-- Блок визуализации и идентификации: аватар 120px -->
                        <vbox id="identity"
                              stylename="edit-sidebar-visual job-candidate-profile-header"
                              width="100%"
                              spacing="true"
                              align="TOP_CENTER">
                            <ovaFallbackImage id="userAiConfigurationLogoImage"
                                              width="120px"
                                              height="120px"
                                              ovalWidth="120px"
                                              ovalHeight="120px"
                                              align="TOP_CENTER"
                                              stylename="job-candidate-avatar"
                                              fallbackThemePath="icons/ai/user-ai-configuration.png"
                                              scaleMode="SCALE_DOWN"/>
                            <vbox id="identityTexts"
                                  width="100%"
                                  spacing="false"
                                  align="MIDDLE_CENTER"
                                  stylename="edit-sidebar-identity">
                                <label dataContainer="userAiConfigurationDc"
                                       property="providerCode"
                                       stylename="edit-sidebar-title h2 candidate-sidebar-fullname bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                                <label dataContainer="userAiConfigurationDc"
                                       property="defaultModelName"
                                       stylename="edit-sidebar-subtitle h4 candidate-sidebar-position bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                                <label value="msg://sidebarSubtitle"
                                       stylename="edit-help candidate-sidebar-city bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                            </vbox>
                        </vbox>

                        <!-- Label-навигация по разделам формы -->
                        <vbox id="navigation"
                              stylename="label-navigation job-candidate-navigation"
                              width="100%"
                              spacing="false">
                            <label value="Разделы"
                                   stylename="label-nav-title user-ai-configuration-navigation-title"
                                   width="100%"/>
                            <button id="mainNav"
                                    caption="msg://navMain"
                                    stylename="borderless label-nav-item label-nav-item-active"
                                    width="100%"
                                    invoke="focusMainSection"/>
                            <button id="securityNav"
                                    caption="msg://navSecurity"
                                    stylename="borderless label-nav-item"
                                    width="100%"
                                    invoke="focusSecuritySection"/>
                        </vbox>

                        <!-- Сводка параметров подключения -->
                        <vbox id="termsCard"
                              width="100%"
                              spacing="true"
                              stylename="job-candidate-navigation label-navigation">
                            <label value="msg://termsTitle"
                                   width="100%"
                                   stylename="label-nav-title job-candidate-section-title"
                                   align="MIDDLE_CENTER"/>
                            <grid id="termsGrid"
                                  spacing="true"
                                  width="100%"
                                  stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row>
                                        <label value="Провайдер:" stylename="bold"/>
                                        <label dataContainer="userAiConfigurationDc" property="providerCode"/>
                                    </row>
                                    <row>
                                        <label value="Модель:" stylename="bold"/>
                                        <label dataContainer="userAiConfigurationDc" property="defaultModelName"/>
                                    </row>
                                    <row>
                                        <label value="Приоритет:" stylename="bold"/>
                                        <label dataContainer="userAiConfigurationDc" property="priority"/>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Контекстная подсказка -->
                        <label value="Ключ используется только для ваших замещений AI-функций; корпоративные подключения настраивает администратор."
                               stylename="edit-sidebar-hint"
                               width="100%"/>

                        <!-- Нижний спейсер 16px -->
                        <vbox id="sidebarSpacer"
                              width="100%"
                              height="16px"
                              stylename="edit-sidebar-spacer"/>
                    </vbox>
                </scrollBox>
            </vbox>

            <!-- Правая рабочая область: toolbar, секции с адаптивной шириной и footer-actions -->
            <vbox id="workspace"
                  stylename="edit-workspace candidate-reestr-workspace"
                  expand="workspaceScroll"
                  width="100%"
                  height="100%"
                  spacing="false">
                <!-- Toolbar с заголовком и пояснением формы -->
                <hbox id="toolbar"
                      stylename="edit-toolbar"
                      width="100%"
                      spacing="true">
                    <vbox id="toolbarText" width="100%" spacing="false">
                        <label value="Персональная AI-конфигурация" stylename="edit-toolbar-title"/>
                        <label value="Личный провайдер, модель по умолчанию и API-ключ" stylename="edit-toolbar-description"/>
                    </vbox>
                </hbox>

                <!-- Прокручиваемая область карточек рабочей области -->
                <scrollBox id="workspaceScroll"
                           stylename="edit-workspace-scroll"
                           width="100%"
                           height="100%">
                    <vbox id="sections"
                          stylename="edit-workspace-content"
                          width="100%"
                          spacing="true">
                        <!-- Аккордеон-секция «Основное» -->
                        <groupBox id="mainSection"
                                  caption="msg://navMain"
                                  stylename="edit-accordion-section"
                                  showAsPanel="true"
                                  collapsable="true"
                                  collapsed="false"
                                  width="100%"
                                  spacing="true">
                            <lookupField id="providerCodeField"
                                         dataContainer="userAiConfigurationDc"
                                         property="providerCode"
                                         required="true"
                                         width="320px"
                                         stylename="edit-form-control"
                                         caption="msg://userProviderCode.caption"/>
                            <textField id="defaultModelNameField"
                                       dataContainer="userAiConfigurationDc"
                                       property="defaultModelName"
                                       width="100%"
                                       maxWidth="480px"
                                       stylename="edit-form-control"
                                       caption="msg://userDefaultModelName.caption"/>
                            <checkBox id="isPrimaryField"
                                      dataContainer="userAiConfigurationDc"
                                      property="isPrimary"
                                      width="100%"
                                      caption="msg://userIsPrimary.caption"/>
                            <checkBox id="isActiveField"
                                      dataContainer="userAiConfigurationDc"
                                      property="isActive"
                                      width="100%"
                                      caption="msg://userIsActive.caption"/>
                            <textField id="maxRetriesField"
                                       dataContainer="userAiConfigurationDc"
                                       property="maxRetries"
                                       width="160px"
                                       stylename="edit-form-control"
                                       inputPrompt="3"
                                       caption="msg://userMaxRetries.caption"
                                       description="msg://userMaxRetries.description">
                                <validators>
                                    <min value="1" message="msg://maxRetriesValidationMin"/>
                                    <max value="10" message="msg://maxRetriesValidationMax"/>
                                </validators>
                            </textField>
                            <textField id="priorityField"
                                       dataContainer="userAiConfigurationDc"
                                       property="priority"
                                       width="160px"
                                       stylename="edit-form-control"
                                       caption="msg://userPriority.caption"/>
                            <textField id="maxContextTokensField"
                                       dataContainer="userAiConfigurationDc"
                                       property="maxContextTokens"
                                       width="160px"
                                       stylename="edit-form-control"
                                       caption="msg://userMaxContextTokens.caption"
                                       description="msg://userMaxContextTokens.description"/>
                        </groupBox>

                        <!-- Аккордеон-секция «Безопасность» -->
                        <groupBox id="securitySection"
                                  caption="msg://navSecurity"
                                  stylename="edit-accordion-section"
                                  showAsPanel="true"
                                  collapsable="true"
                                  collapsed="false"
                                  width="100%"
                                  spacing="true">
                            <passwordField id="apiKeyField"
                                           secret="true"
                                           width="100%"
                                           maxWidth="500px"
                                           stylename="edit-form-control"
                                           caption="msg://userApiKey.caption"/>
                            <button id="testConnectionBtn"
                                    caption="msg://testConnectionBtn.caption"
                                    icon="font-icon:CHECK"
                                    invoke="onTestConnectionClick"
                                    stylename="user-ai-configuration-test-btn"/>
                        </groupBox>
                    </vbox>
                </scrollBox>

                <!-- Нижняя панель штатных действий: сохранить и отменить -->
                <hbox id="editActions"
                      stylename="edit-footer-actions"
                      width="100%"
                      expand="editActionsSpacer"
                      align="MIDDLE_RIGHT">
                    <vbox id="editActionsSpacer" width="100%" height="1px"/>
                    <hbox id="editActionsGroup" width="AUTO" align="MIDDLE_RIGHT" spacing="true">
                        <button id="commitAndCloseBtn"
                                action="windowCommitAndClose"
                                stylename="c-primary-action"/>
                        <button id="closeBtn"
                                action="windowClose"/>
                    </hbox>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>
