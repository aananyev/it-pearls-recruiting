<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Browse персональных per-function override текущего пользователя:
     двухпанельная композиция Split-View 312px по стандарту HRM HuntTech (hunttech-browse-screen-design). -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://browseCaption"
        focusComponent="overridesTable"
        messagesPack="com.company.hunttech.web.screens.useraifunctionoverride">
    <data>
        <collection id="overridesDc"
                    class="com.company.hunttech.entity.ai.UserAiFunctionOverride"
                    view="user-ai-function-override-browse-view">
            <loader id="overridesDl">
                <query><![CDATA[select e from hunttech_UserAiFunctionOverride e where e.user = :user order by e.aiFunction.name]]></query>
            </loader>
        </collection>
    </data>
    <dialogMode width="1240" height="740"/>
    <layout expand="splitMainLayout"
            spacing="false"
            margin="false"
            width="100%"
            height="100%"
            stylename="browse-screen-layout edit-screen-layout user-ai-function-override-browse job-candidate-editor">
        <hbox id="splitMainLayout"
              width="100%"
              height="100%"
              spacing="true"
              expand="workspaceBox"
              stylename="job-candidate-main-layout edit-screen-layout">
            <!-- ЛЕВЫЙ САЙДБАР (312px на 100% высоты) -->
            <vbox id="detailPane"
                  width="312px"
                  height="100%"
                  spacing="true"
                  margin="false"
                  stylename="edit-sidebar job-candidate-sidebar">
                <scrollBox id="detailScroll"
                           width="100%"
                           height="100%"
                           orientation="vertical">
                    <vbox id="sidebarInnerBox"
                          width="100%"
                          spacing="true">
                        <!-- Шапка профиля -->
                        <vbox id="profileHeader"
                              width="100%"
                              spacing="true"
                              align="TOP_CENTER"
                              stylename="job-candidate-profile-header edit-sidebar-visual">
                            <ovaFallbackImage id="logoPic"
                                              width="120px"
                                              height="120px"
                                              ovalWidth="120px"
                                              ovalHeight="120px"
                                              align="TOP_CENTER"
                                              stylename="job-candidate-avatar"
                                              fallbackThemePath="icons/ai/user-ai-function-override.png"
                                              scaleMode="SCALE_DOWN"/>
                            <vbox id="identityBox"
                                  width="100%"
                                  spacing="false"
                                  align="MIDDLE_CENTER"
                                  stylename="edit-sidebar-identity">
                                <label id="detailTitle"
                                       value="msg://sidebarDefaultTitle"
                                       stylename="edit-sidebar-title h2 candidate-sidebar-fullname bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                                <label id="detailSubtitle"
                                       value="msg://sidebarSubtitle"
                                       stylename="edit-sidebar-subtitle h4 candidate-sidebar-position bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                                <label id="detailStatusBadge"
                                       value=""
                                       stylename="edit-help candidate-sidebar-city bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                            </vbox>
                        </vbox>

                        <!-- Кнопки действий сайдбара -->
                        <vbox id="sidebarActionsCard"
                              width="100%"
                              spacing="true"
                              stylename="edit-sidebar-summary">
                            <button id="openEditCardBtn"
                                    caption="msg://openEditCardBtn"
                                    icon="EDIT_ACTION"
                                    stylename="primary"
                                    enabled="false"
                                    width="100%"/>
                        </vbox>

                        <!-- Статус замещения -->
                        <vbox id="statusCard"
                              width="100%"
                              spacing="true"
                              stylename="job-candidate-navigation label-navigation">
                            <label value="msg://statusTitle"
                                   width="100%"
                                   stylename="label-nav-title job-candidate-section-title"
                                   align="MIDDLE_CENTER"/>
                            <grid id="statusGrid"
                                  spacing="true"
                                  width="100%"
                                  stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row>
                                        <label value="Статус:" stylename="bold"/>
                                        <label id="detailEnabled" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Код функции:" stylename="bold"/>
                                        <label id="detailFunctionCode" value="-"/>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Параметры функции -->
                        <vbox id="termsCard"
                              width="100%"
                              spacing="true"
                              stylename="job-candidate-navigation label-navigation">
                            <label value="msg://termsTitle"
                                   width="100%"
                                   stylename="label-nav-title job-candidate-section-title"
                                   align="MIDDLE_CENTER"/>
                            <grid id="termsGrid"
                                  spacing="true"
                                  width="100%"
                                  stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row>
                                        <label value="Провайдер:" stylename="bold"/>
                                        <label id="detailProvider" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Модель:" stylename="bold"/>
                                        <label id="detailModel" value="-"/>
                                    </row>
                                    <row>
                                        <label value="Замещение:" stylename="bold"/>
                                        <label id="detailOverrideModel" value="-"/>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Нижний спейсер 16px -->
                        <vbox id="detailSidebarSpacer"
                              width="100%"
                              height="16px"
                              stylename="edit-sidebar-spacer"/>
                    </vbox>
                </scrollBox>
            </vbox>

            <!-- ПРАВАЯ РАБОЧАЯ ОБЛАСТЬ -->
            <vbox id="workspaceBox"
                  width="100%"
                  height="100%"
                  spacing="true"
                  stylename="edit-workspace candidate-reestr-workspace"
                  expand="tableCard"
                  margin="true,true,true,false">
                <!-- Главный командный тулбар -->
                <hbox id="browseActions"
                      spacing="true"
                      width="100%"
                      stylename="candidate-filter-bar edit-card edit-toolbar">
                    <button id="createBtn"
                            action="overridesTable.create"
                            stylename="primary"
                            icon="PLUS"/>
                    <button id="editBtn"
                            action="overridesTable.edit"
                            icon="EDIT_ACTION"/>
                    <button id="removeBtn"
                            action="overridesTable.remove"
                            icon="REMOVE"/>
                    <button id="refreshBtn"
                            action="overridesTable.refresh"
                            icon="REFRESH"/>
                </hbox>

                <!-- Safe DataGrid текущих override в карточке-контейнере -->
                <vbox id="tableCard"
                      width="100%"
                      height="100%"
                      spacing="false"
                      expand="overridesTable"
                      stylename="edit-card candidate-table-card">
                    <dataGrid id="overridesTable"
                              width="100%"
                              height="100%"
                              dataContainer="overridesDc">
                        <actions>
                            <action id="create" type="create"/>
                            <action id="edit" type="edit"/>
                            <action id="remove" type="remove"/>
                            <action id="refresh" type="refresh"/>
                        </actions>
                        <columns>
                            <column property="aiFunction.code" width="180px"/>
                            <column property="aiFunction.name" minimumWidth="200px"/>
                            <column property="userAiConfiguration.providerCode" width="130px"/>
                            <column property="userAiConfiguration.defaultModelName" width="200px"/>
                            <column property="modelName" width="180px"/>
                            <column property="enabled" width="100px"/>
                        </columns>
                        <rowsCount/>
                    </dataGrid>
                </vbox>

                <hbox id="lookupActions" spacing="true" visible="false">
                    <button action="lookupSelectAction"/>
                    <button action="lookupCancelAction"/>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>

