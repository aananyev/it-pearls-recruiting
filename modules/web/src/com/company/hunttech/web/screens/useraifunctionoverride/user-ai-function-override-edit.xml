<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Edit персонального замещения одной AI-функции: двухпанельная композиция Split-View 312px
     по общему контракту Edit-экранов HRM HuntTech (hunttech-edit-screen-design). -->
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://editorCaption"
        focusComponent="aiFunctionField"
        messagesPack="com.company.hunttech.web.screens.useraifunctionoverride">
    <data>
        <instance id="overrideDc"
                  class="com.company.hunttech.entity.ai.UserAiFunctionOverride"
                  view="user-ai-function-override-edit-view">
            <loader/>
        </instance>
        <collection id="functionsDc"
                    class="com.company.hunttech.entity.ai.AiFunctionConfiguration"
                    view="ai-function-configuration-browse-view">
            <loader id="functionsDl">
                <query><![CDATA[select e from hunttech_AiFunctionConfiguration e where e.active = true and e.executionPolicy <> 'ADMIN_ONLY' order by e.name]]></query>
            </loader>
        </collection>
        <collection id="userConfigurationsDc"
                    class="com.company.hunttech.entity.UserAiConfiguration"
                    view="user-ai-configuration-override-picker-view">
            <loader id="userConfigurationsDl">
                <query><![CDATA[select e from hunttech_UserAiConfiguration e where e.user = :user and e.isActive = true order by e.providerCode]]></query>
            </loader>
        </collection>
    </data>
    <dialogMode width="100%" height="100%" modal="true"/>
    <layout stylename="user-ai-function-override-editor job-candidate-editor edit-screen-layout"
            expand="mainLayout"
            spacing="false"
            margin="false"
            width="100%"
            height="100%">
        <hbox id="mainLayout"
              stylename="job-candidate-main-layout edit-screen-layout"
              expand="workspace"
              spacing="false"
              width="100%"
              height="100%">
            <!-- Левая контекстная панель 312px: аватар 120px, навигация, реквизиты -->
            <vbox id="sidebar"
                  stylename="edit-sidebar job-candidate-sidebar"
                  width="312px"
                  height="100%"
                  spacing="true"
                  margin="false">
                <scrollBox id="sidebarScroll"
                           width="100%"
                           height="100%"
                           orientation="vertical">
                    <vbox id="sidebarContent"
                          width="100%"
                          spacing="true">
                        <!-- Визуальный блок шапки: аватар 120px -->
                        <vbox id="identity"
                              stylename="edit-sidebar-visual job-candidate-profile-header"
                              width="100%"
                              spacing="true"
                              align="TOP_CENTER">
                            <ovaFallbackImage id="userAiFunctionOverrideLogoImage"
                                              width="120px"
                                              height="120px"
                                              ovalWidth="120px"
                                              ovalHeight="120px"
                                              align="TOP_CENTER"
                                              stylename="job-candidate-avatar"
                                              fallbackThemePath="icons/ai/user-ai-function-override.png"
                                              scaleMode="SCALE_DOWN"/>
                            <vbox id="identityTexts"
                                  width="100%"
                                  spacing="false"
                                  align="MIDDLE_CENTER"
                                  stylename="edit-sidebar-identity">
                                <label value="Моё AI-замещение"
                                       stylename="edit-sidebar-title h2 candidate-sidebar-fullname bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                                <label dataContainer="overrideDc"
                                       property="aiFunction.name"
                                       stylename="edit-sidebar-subtitle h4 candidate-sidebar-position bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                                <label value="Одна функция → одно личное подключение"
                                       stylename="edit-help candidate-sidebar-city bold"
                                       width="100%"
                                       align="MIDDLE_CENTER"/>
                            </vbox>
                        </vbox>

                        <!-- Label-навигация по разделам формы -->
                        <vbox id="navigation"
                              stylename="label-navigation job-candidate-navigation"
                              width="100%"
                              spacing="false">
                            <label value="Разделы"
                                   stylename="label-nav-title user-ai-function-override-navigation-title"
                                   width="100%"/>
                            <button id="mainNav"
                                    caption="AI-функция"
                                    stylename="borderless label-nav-item label-nav-item-active"
                                    width="100%"
                                    invoke="focusMainSection"/>
                            <button id="modelNav"
                                    caption="Моё подключение"
                                    stylename="borderless label-nav-item"
                                    width="100%"
                                    invoke="focusModelSection"/>
                        </vbox>

                        <!-- Сводка параметров замещения -->
                        <vbox id="termsCard"
                              width="100%"
                              spacing="true"
                              stylename="job-candidate-navigation label-navigation">
                            <label value="msg://termsTitle"
                                   width="100%"
                                   stylename="label-nav-title job-candidate-section-title"
                                   align="MIDDLE_CENTER"/>
                            <grid id="termsGrid"
                                  spacing="true"
                                  width="100%"
                                  stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row>
                                        <label value="Функция:" stylename="bold"/>
                                        <label dataContainer="overrideDc" property="aiFunction.name"/>
                                    </row>
                                    <row>
                                        <label value="Статус:" stylename="bold"/>
                                        <label dataContainer="overrideDc" property="enabled"/>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Контекстная подсказка -->
                        <label value="Если замещение выключено или отсутствует, функция использует корпоративное подключение согласно политике администратора."
                               stylename="edit-sidebar-hint"
                               width="100%"/>

                        <!-- Нижний спейсер 16px -->
                        <vbox id="sidebarSpacer"
                              width="100%"
                              height="16px"
                              stylename="edit-sidebar-spacer"/>
                    </vbox>
                </scrollBox>
            </vbox>

            <!-- Правая рабочая область: toolbar, секции с адаптивной шириной и footer-actions -->
            <vbox id="workspace"
                  stylename="edit-workspace candidate-reestr-workspace"
                  expand="workspaceScroll"
                  width="100%"
                  height="100%"
                  spacing="false">
                <!-- Toolbar с заголовком и описанием -->
                <hbox id="toolbar"
                      stylename="edit-toolbar"
                      width="100%"
                      spacing="true">
                    <vbox id="toolbarText" width="100%" spacing="false">
                        <label value="Персональное замещение AI-функции" stylename="edit-toolbar-title"/>
                        <label value="Выберите разрешённую функцию и своё активное API-подключение" stylename="edit-toolbar-description"/>
                    </vbox>
                </hbox>

                <!-- Прокручиваемая область карточек рабочей области -->
                <scrollBox id="workspaceScroll"
                           stylename="edit-workspace-scroll"
                           width="100%"
                           height="100%">
                    <vbox id="sections"
                          stylename="edit-workspace-content"
                          width="100%"
                          spacing="true">
                        <!-- Аккордеон-секция «AI-функция» -->
                        <groupBox id="mainSection"
                                  caption="AI-функция"
                                  stylename="edit-accordion-section"
                                  showAsPanel="true"
                                  collapsable="true"
                                  collapsed="false"
                                  width="100%"
                                  spacing="true">
                            <lookupPickerField id="aiFunctionField"
                                               dataContainer="overrideDc"
                                               property="aiFunction"
                                               optionsContainer="functionsDc"
                                               required="true"
                                               width="100%"
                                               maxWidth="520px"
                                               stylename="edit-form-control"
                                               caption="msg://overrideAiFunction.caption"/>
                            <checkBox id="enabledField"
                                      dataContainer="overrideDc"
                                      property="enabled"
                                      width="100%"
                                      caption="msg://overrideEnabled.caption"/>
                        </groupBox>

                        <!-- Аккордеон-секция «Моё подключение» -->
                        <groupBox id="modelSection"
                                  caption="Моё подключение"
                                  stylename="edit-accordion-section"
                                  showAsPanel="true"
                                  collapsable="true"
                                  collapsed="false"
                                  width="100%"
                                  spacing="true">
                            <lookupPickerField id="userAiConfigurationField"
                                               dataContainer="overrideDc"
                                               property="userAiConfiguration"
                                               optionsContainer="userConfigurationsDc"
                                               required="true"
                                               width="100%"
                                               maxWidth="520px"
                                               stylename="edit-form-control"
                                               caption="msg://overrideUserAiConfiguration.caption"/>
                            <textField id="modelNameField"
                                       dataContainer="overrideDc"
                                       property="modelName"
                                       width="100%"
                                       maxWidth="450px"
                                       stylename="edit-form-control"
                                       caption="msg://overrideModelName.caption"/>
                        </groupBox>
                    </vbox>
                </scrollBox>

                <!-- Нижняя панель действий: сохранить и отменить -->
                <hbox id="editActions"
                      stylename="edit-footer-actions"
                      width="100%"
                      expand="editActionsSpacer"
                      align="MIDDLE_RIGHT">
                    <vbox id="editActionsSpacer" width="100%" height="1px"/>
                    <hbox id="editActionsGroup" width="AUTO" align="MIDDLE_RIGHT" spacing="true">
                        <button action="windowCommitAndClose"
                                stylename="c-primary-action"/>
                        <button action="windowClose"/>
                    </hbox>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>