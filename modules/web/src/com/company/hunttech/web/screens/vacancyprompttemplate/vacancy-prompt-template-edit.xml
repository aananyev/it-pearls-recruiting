<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://vacancyPromptTemplateEdit.caption"
        focusComponent="codeField"
        messagesPack="com.company.hunttech.web.screens.vacancyprompttemplate">
    <data>
        <instance id="vacancyPromptTemplateDc"
                  class="com.company.hunttech.entity.VacancyPromptTemplate"
                  view="vacancyPromptTemplate-edit-view">
            <loader/>
        </instance>
    </data>
    <dialogMode height="100%" width="100%" modal="true"/>
    <layout stylename="vacancy-prompt-template-editor"
            expand="vacancyPromptTemplateMainLayout"
            spacing="false"
            width="100%"
            height="100%">
        <hbox id="vacancyPromptTemplateMainLayout"
              stylename="edit-screen-layout"
              expand="vacancyPromptTemplateWorkspace"
              spacing="false"
              width="100%"
              height="100%">
            <!-- Сайдбар 312px -->
            <vbox id="vacancyPromptTemplateSidebar"
                  stylename="job-candidate-sidebar edit-sidebar"
                  width="312px"
                  height="100%"
                  spacing="false"
                  margin="false">
                <scrollBox id="vacancyPromptTemplateSidebarScroll"
                           width="100%"
                           height="100%"
                           orientation="vertical"
                           stylename="sidebar-scrollbox">
                    <vbox width="100%" spacing="true">

                        <!-- Шапка профиля: Аватар 120px + 4 уровня типографики -->
                        <vbox id="vacancyPromptTemplateProfileHeader"
                              width="100%"
                              spacing="true"
                              align="TOP_CENTER"
                              stylename="job-candidate-profile-header edit-sidebar-visual">
                            <ovaFallbackImage id="vacancyPromptTemplateLogoImage"
                                              width="120px"
                                              height="120px"
                                              ovalWidth="120px"
                                              ovalHeight="120px"
                                              align="TOP_CENTER"
                                              stylename="job-candidate-avatar ovaFallbackImage"
                                              scaleMode="SCALE_DOWN"
                                              fallbackThemePath="icons/ai/vacancy-prompt-template.png"/>
                            <vbox width="100%"
                                  spacing="false"
                                  align="MIDDLE_CENTER"
                                  stylename="edit-sidebar-identity">
                                <label id="vacancyPromptTemplateSidebarTitle"
                                       dataContainer="vacancyPromptTemplateDc"
                                       property="name"
                                       stylename="edit-sidebar-title h2 candidate-sidebar-fullname bold"
                                       align="MIDDLE_CENTER"
                                       width="100%"/>
                                <label value="msg://sidebarSubtitle"
                                       stylename="edit-sidebar-subtitle h4 candidate-sidebar-position bold"
                                       align="MIDDLE_CENTER"
                                       width="100%"/>
                                <label id="vacancyPromptTemplateSidebarCode"
                                       dataContainer="vacancyPromptTemplateDc"
                                       property="code"
                                       stylename="edit-help candidate-sidebar-city bold"
                                       align="MIDDLE_CENTER"
                                       width="100%"/>
                            </vbox>
                        </vbox>

                        <!-- Label-навигация разделов -->
                        <vbox id="vacancyPromptTemplateNavigation"
                              stylename="label-navigation"
                              width="100%"
                              spacing="false">
                            <label value="msg://navSections"
                                   stylename="label-nav-title vacancy-prompt-template-navigation-title"
                                   width="100%"/>
                            <button id="vacancyPromptTemplateMainNav"
                                    caption="msg://mainSection"
                                    stylename="borderless label-nav-item label-nav-item-active"
                                    width="100%"
                                    invoke="focusMainSection"/>
                            <button id="vacancyPromptTemplatePromptNav"
                                    caption="msg://promptSection"
                                    stylename="borderless label-nav-item"
                                    width="100%"
                                    invoke="focusPromptSection"/>
                        </vbox>

                        <!-- Сводка параметров в сайдбаре Edit -->
                        <vbox id="vacancyPromptTemplateSummarySection"
                              width="100%"
                              spacing="true"
                              stylename="job-candidate-navigation label-navigation">
                            <label value="msg://parametersSection"
                                   width="100%"
                                   stylename="label-nav-title job-candidate-section-title vacancy-prompt-template-navigation-title"
                                   align="MIDDLE_CENTER"/>
                            <grid id="vacancyPromptTemplateSummaryGrid"
                                  spacing="true"
                                  width="100%"
                                  stylename="edit-sidebar-summary">
                                <columns count="2"/>
                                <rows>
                                    <row>
                                        <label value="msg://templateCodeCaption" stylename="bold"/>
                                        <label id="summaryCodeVal" dataContainer="vacancyPromptTemplateDc" property="code" value="-"/>
                                    </row>
                                    <row>
                                        <label value="msg://templateTemperatureCaption" stylename="bold"/>
                                        <label id="summaryTempVal" dataContainer="vacancyPromptTemplateDc" property="temperature" value="-"/>
                                    </row>
                                </rows>
                            </grid>
                        </vbox>

                        <!-- Фиксированный спейсер отступа 16px -->
                        <vbox id="vacancyPromptTemplateSidebarSpacer"
                              width="100%"
                              height="16px"
                              stylename="edit-sidebar-spacer"/>

                        <!-- Нейтральная подсказка -->
                        <label value="msg://templateSidebarHint"
                               stylename="edit-sidebar-hint"
                               width="100%"/>
                    </vbox>
                </scrollBox>
            </vbox>


            <!-- Правая рабочая область -->
            <vbox id="vacancyPromptTemplateWorkspace"
                  stylename="edit-workspace"
                  expand="vacancyPromptTemplateWorkspaceScroll"
                  width="100%"
                  height="100%"
                  spacing="false">
                <hbox id="vacancyPromptTemplateToolbar"
                      stylename="edit-toolbar"
                      width="100%"
                      spacing="true">
                    <vbox id="vacancyPromptTemplateToolbarText" width="100%" spacing="false">
                        <label value="msg://vacancyPromptTemplateEdit.caption" stylename="edit-toolbar-title"/>
                        <label value="msg://templateSidebarHint" stylename="edit-toolbar-description"/>
                    </vbox>
                </hbox>

                <scrollBox id="vacancyPromptTemplateWorkspaceScroll"
                           stylename="edit-workspace-scroll"
                           width="100%"
                           height="100%"
                           margin="false">
                    <vbox id="vacancyPromptTemplateSections" width="100%" spacing="true">
                        <!-- Секция «Основные данные» -->
                        <groupBox id="vacancyPromptTemplateMainSection"
                                  caption="msg://mainSection"
                                  collapsable="true"
                                  stylename="edit-card edit-accordion-section"
                                  width="100%"
                                  spacing="true">
                            <form id="vacancyPromptTemplateForm" dataContainer="vacancyPromptTemplateDc" width="100%">
                                <column width="100%">
                                    <textField id="codeField"
                                               property="code"
                                               caption="msg://templateCodeCaption"
                                               description="msg://VacancyPromptTemplate.code.description"
                                               width="280px"
                                               stylename="edit-form-control"/>
                                    <textField id="nameField"
                                               property="name"
                                               caption="msg://templateName.caption"
                                               description="msg://templateNameDescription"
                                               width="100%"
                                               stylename="edit-form-control"/>
                                    <textField id="temperatureField"
                                               property="temperature"
                                               caption="msg://templateTemperatureCaption"
                                               description="msg://VacancyPromptTemplate.temperature.description"
                                               width="140px"
                                               stylename="edit-form-control"/>
                                </column>
                            </form>
                        </groupBox>

                        <!-- Секция «Текст промпта» -->
                        <groupBox id="vacancyPromptTemplatePromptSection"
                                  caption="msg://promptSection"
                                  collapsable="true"
                                  stylename="edit-card edit-accordion-section"
                                  width="100%"
                                  spacing="true">
                            <textArea id="systemContextField"
                                      caption="msg://aiRole.caption"
                                      description="msg://aiRoleDescription"
                                      dataContainer="vacancyPromptTemplateDc"
                                      property="systemContext"
                                      width="100%"
                                      rows="4"
                                      height="110px"
                                      stylename="edit-form-control"/>
                            <textArea id="promptTextField"
                                      caption="msg://mainTask.caption"
                                      description="msg://mainTaskDescription"
                                      dataContainer="vacancyPromptTemplateDc"
                                      property="promptText"
                                      width="100%"
                                      rows="14"
                                      height="240px"
                                      stylename="edit-form-control"/>
                        </groupBox>
                    </vbox>
                </scrollBox>

                <!-- Нижний тулбар действий -->
                <hbox id="editActions" stylename="edit-footer-actions" spacing="true" width="100%">
                    <vbox id="vacancyPromptTemplateActionsSpacer" width="100%"/>
                    <button id="commitAndCloseBtn" action="windowCommitAndClose" stylename="primary" icon="CHECK"/>
                    <button id="closeBtn" action="windowClose" icon="BAN"/>
                </hbox>
            </vbox>
        </hbox>
    </layout>
</window>