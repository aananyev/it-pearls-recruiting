/* ── JobCandidate Editor — shared theme-aware styles ────────────────── */
/* Uses only standard CUBA SCSS variables: $v-font-color, $v-background-color,
   $v-panel-background-color, $v-border-color, $v-border-radius             */
/* Scoped under .job-candidate-editor to avoid polluting other screens.     */

.job-candidate-editor {
  background: $v-background-color;
}

.job-candidate-main-layout {
  background: $v-background-color;
}

.job-candidate-sidebar {
  background: $v-panel-background-color;
  border-right: 1px solid $v-border-color;
  padding: 20px 16px;
  overflow-y: auto;
  overflow-x: hidden;
}

.job-candidate-workspace {
  background: $v-background-color;
  padding: 16px 20px 20px 20px;
  overflow: hidden;
}

.job-candidate-profile-header {
  text-align: center !important;
  padding-bottom: 4px;
}

.job-candidate-avatar {
  width: 120px !important;
  height: 120px !important;
  border-radius: 50%;
  border: 3px solid $v-panel-background-color;
  box-shadow: 0 2px 8px rgba(0,0,0,0.10);
  object-fit: cover;
  overflow: hidden;
}

.job-candidate-avatar-actions {
  text-align: center;
}

.job-candidate-profile-name {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.3;
  color: $v-font-color;
  margin-top: 8px;
}

.job-candidate-profile-position {
  font-size: 12px;
  color: lighten($v-font-color, 25%);
  line-height: 1.4;
}

.job-candidate-profile-meta {
  font-size: 12px;
  color: lighten($v-font-color, 15%);
}

.job-candidate-sidebar-section {
  border-top: 1px solid $v-border-color;
  padding-top: 12px;
  margin-top: 4px;
}

.job-candidate-sidebar-section-title {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  color: lighten($v-font-color, 30%);
  letter-spacing: 0.5px;
  margin-bottom: 8px;
}

.job-candidate-info-grid {
  font-size: 13px;
  line-height: 1.5;
}

.job-candidate-info-label {
  color: lighten($v-font-color, 20%);
  font-size: 12px;
  white-space: nowrap;
  padding-right: 8px;
}

.job-candidate-info-value {
  color: $v-font-color;
  font-size: 13px;
  word-break: break-word;
}

.job-candidate-secondary-text {
  color: lighten($v-font-color, 20%);
  font-size: 12px;
}

.job-candidate-quick-actions {
  border-top: 1px solid $v-border-color;
  padding-top: 12px;
  margin-top: 4px;
}

.job-candidate-toolbar {
  background: $v-panel-background-color;
  border: 1px solid $v-border-color;
  border-radius: $v-border-radius;
  padding: 8px 14px;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.job-candidate-tabs {
  background: $v-panel-background-color;
  border: 1px solid $v-border-color;
  border-radius: $v-border-radius;
}

.job-candidate-tab-content {
  padding: 16px;
}

.job-candidate-card {
  background: $v-panel-background-color !important;
  border: 1px solid $v-border-color !important;
  border-radius: $v-border-radius !important;
  padding: 16px !important;
}

.job-candidate-card-title {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 12px;
  color: $v-font-color;
}

.job-candidate-table {
  font-size: 13px;
}

.job-candidate-card-row {
  width: 100%;
}

.job-candidate-quick-action {
  text-align: center;
}

.job-candidate-empty-state {
  text-align: center;
  padding: 40px;
  color: lighten($v-font-color, 30%);
}
